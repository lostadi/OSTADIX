" Source: crates/ostadix-api/src/parser.rs and tools/syntax/languages.json.
" Included language syntaxes supply lexical coloring; O markers retain priority.
if exists('b:current_syntax')
  finish
endif
let s:saved_cpo = &cpo
set cpo&vim
