      \{"key": "html", "tags": ["html"], "syntax": "html", "keywords": "DOCTYPE html head body div span script style title meta"},
      \{"key": "sql", "tags": ["sql"], "syntax": "sql", "keywords": "SELECT FROM WHERE INSERT INTO VALUES UPDATE DELETE CREATE DROP TABLE ALTER JOIN LEFT RIGHT INNER OUTER ON AS AND OR NOT ORDER BY GROUP HAVING LIMIT UNION DISTINCT WITH NULL IS"},
