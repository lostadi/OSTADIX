      \{"key": "markdown", "tags": ["markdown", "md"], "syntax": "markdown", "keywords": ""},
      \{"key": "latex", "tags": ["latex", "tex"], "syntax": "tex", "keywords": "begin end documentclass usepackage section subsection textbf emph"},
