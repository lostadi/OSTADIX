# Generated by ../editors/generate.py from ../languages.json.
# GNU nano uses POSIX ERE. These body colors distinguish language regions
# until the first matching family closer; they cannot balance nested blocks
# or compare the opener's environment/attributes with the closer.
# Token accents are global: nano cannot delegate a region to another syntax.
syntax "ostadix" "\.(O|olang)$"
header "^#!.*(/|[[:space:]])(O|o)([[:space:]]|$)"
comment "#"

# host: O, o, quote
color white start="(O|o|quote)(\[([0-9]+|\*)\])?(\{[^{}]*\})?\^\(" end="\)_(O|o|quote)(\[([0-9]+|\*)\])?(\{[^{}]*\})?"
# python: python, py
color yellow start="(python|py)(\[([0-9]+|\*)\])?(\{[^{}]*\})?\^\(" end="\)_(python|py)(\[([0-9]+|\*)\])?(\{[^{}]*\})?"
# javascript: javascript
color cyan start="(javascript)(\[([0-9]+|\*)\])?(\{[^{}]*\})?\^\(" end="\)_(javascript)(\[([0-9]+|\*)\])?(\{[^{}]*\})?"
# shell: bash, shell, ubuntu_vm, ubuntu
color green start="(bash|shell|ubuntu_vm|ubuntu)(\[([0-9]+|\*)\])?(\{[^{}]*\})?\^\(" end="\)_(bash|shell|ubuntu_vm|ubuntu)(\[([0-9]+|\*)\])?(\{[^{}]*\})?"
# html: html
color cyan start="(html)(\[([0-9]+|\*)\])?(\{[^{}]*\})?\^\(" end="\)_(html)(\[([0-9]+|\*)\])?(\{[^{}]*\})?"
# sql: sql
color magenta start="(sql)(\[([0-9]+|\*)\])?(\{[^{}]*\})?\^\(" end="\)_(sql)(\[([0-9]+|\*)\])?(\{[^{}]*\})?"
# rust: rust
color red start="(rust)(\[([0-9]+|\*)\])?(\{[^{}]*\})?\^\(" end="\)_(rust)(\[([0-9]+|\*)\])?(\{[^{}]*\})?"
# cpp: cpp
color cyan start="(cpp)(\[([0-9]+|\*)\])?(\{[^{}]*\})?\^\(" end="\)_(cpp)(\[([0-9]+|\*)\])?(\{[^{}]*\})?"
# csharp: csharp
color magenta start="(csharp)(\[([0-9]+|\*)\])?(\{[^{}]*\})?\^\(" end="\)_(csharp)(\[([0-9]+|\*)\])?(\{[^{}]*\})?"
# c: c
color cyan start="(c)(\[([0-9]+|\*)\])?(\{[^{}]*\})?\^\(" end="\)_(c)(\[([0-9]+|\*)\])?(\{[^{}]*\})?"
# java: java
color yellow start="(java)(\[([0-9]+|\*)\])?(\{[^{}]*\})?\^\(" end="\)_(java)(\[([0-9]+|\*)\])?(\{[^{}]*\})?"
# ruby: ruby
color red start="(ruby)(\[([0-9]+|\*)\])?(\{[^{}]*\})?\^\(" end="\)_(ruby)(\[([0-9]+|\*)\])?(\{[^{}]*\})?"
# lisp: lisp, common_lisp
color green start="(lisp|common_lisp)(\[([0-9]+|\*)\])?(\{[^{}]*\})?\^\(" end="\)_(lisp|common_lisp)(\[([0-9]+|\*)\])?(\{[^{}]*\})?"
# racket: racket
color green start="(racket)(\[([0-9]+|\*)\])?(\{[^{}]*\})?\^\(" end="\)_(racket)(\[([0-9]+|\*)\])?(\{[^{}]*\})?"
# nix: nix, nix_expr, nix_store, nixos_test
color blue start="(nix|nix_expr|nix_store|nixos_test)(\[([0-9]+|\*)\])?(\{[^{}]*\})?\^\(" end="\)_(nix|nix_expr|nix_store|nixos_test)(\[([0-9]+|\*)\])?(\{[^{}]*\})?"
# markdown: markdown, md
color white start="(markdown|md)(\[([0-9]+|\*)\])?(\{[^{}]*\})?\^\(" end="\)_(markdown|md)(\[([0-9]+|\*)\])?(\{[^{}]*\})?"
# latex: latex, tex
color yellow start="(latex|tex)(\[([0-9]+|\*)\])?(\{[^{}]*\})?\^\(" end="\)_(latex|tex)(\[([0-9]+|\*)\])?(\{[^{}]*\})?"
# text: text, plain
color white start="(text|plain)(\[([0-9]+|\*)\])?(\{[^{}]*\})?\^\(" end="\)_(text|plain)(\[([0-9]+|\*)\])?(\{[^{}]*\})?"
# haskell: haskell
color magenta start="(haskell)(\[([0-9]+|\*)\])?(\{[^{}]*\})?\^\(" end="\)_(haskell)(\[([0-9]+|\*)\])?(\{[^{}]*\})?"
# ocaml: ocaml
color yellow start="(ocaml)(\[([0-9]+|\*)\])?(\{[^{}]*\})?\^\(" end="\)_(ocaml)(\[([0-9]+|\*)\])?(\{[^{}]*\})?"
# webassembly: webassembly
color cyan start="(webassembly)(\[([0-9]+|\*)\])?(\{[^{}]*\})?\^\(" end="\)_(webassembly)(\[([0-9]+|\*)\])?(\{[^{}]*\})?"
# matlab: matlab
color blue start="(matlab)(\[([0-9]+|\*)\])?(\{[^{}]*\})?\^\(" end="\)_(matlab)(\[([0-9]+|\*)\])?(\{[^{}]*\})?"
# mathematica: mathematica
color magenta start="(mathematica)(\[([0-9]+|\*)\])?(\{[^{}]*\})?\^\(" end="\)_(mathematica)(\[([0-9]+|\*)\])?(\{[^{}]*\})?"

# Common lexical accents; these do not claim language-specific dispatch.
color magenta "\<(let|if|else|elif|for|while|return|def|class|fn|pub|use|import|from|as|match|struct|enum|impl|const|function|var|do|then|fi|done)\>"
color cyan "\<(True|False|None|true|false|null|nil)\>"
color yellow "\<[0-9]+([.][0-9]+)?\>"
color green "\"([^\"\\]|\\.)*\"" "'([^'\\]|\\.)*'"
color brightblack "#.*$" "//.*$"

# Structural markers take priority even in foreign strings/comments.
color brightmagenta "(O|o|quote|python|py|javascript|bash|shell|ubuntu_vm|ubuntu|html|sql|rust|cpp|csharp|c|java|ruby|lisp|common_lisp|racket|nix|nix_expr|nix_store|nixos_test|markdown|md|latex|tex|text|plain|haskell|ocaml|webassembly|matlab|mathematica)(\[([0-9]+|\*)\])?(\{[^{}]*\})?\^\(" "\)_(O|o|quote|python|py|javascript|bash|shell|ubuntu_vm|ubuntu|html|sql|rust|cpp|csharp|c|java|ruby|lisp|common_lisp|racket|nix|nix_expr|nix_store|nixos_test|markdown|md|latex|tex|text|plain|haskell|ocaml|webassembly|matlab|mathematica)(\[([0-9]+|\*)\])?(\{[^{}]*\})?"
color brightcyan "\$[A-Za-z_][A-Za-z0-9_]*"
color yellow "\\\$" "\\(O|o|quote|python|py|javascript|bash|shell|ubuntu_vm|ubuntu|html|sql|rust|cpp|csharp|c|java|ruby|lisp|common_lisp|racket|nix|nix_expr|nix_store|nixos_test|markdown|md|latex|tex|text|plain|haskell|ocaml|webassembly|matlab|mathematica)(\[([0-9]+|\*)\])?(\{[^{}]*\})?\^\(" "\\\)_(O|o|quote|python|py|javascript|bash|shell|ubuntu_vm|ubuntu|html|sql|rust|cpp|csharp|c|java|ruby|lisp|common_lisp|racket|nix|nix_expr|nix_store|nixos_test|markdown|md|latex|tex|text|plain|haskell|ocaml|webassembly|matlab|mathematica)(\[([0-9]+|\*)\])?(\{[^{}]*\})?"
