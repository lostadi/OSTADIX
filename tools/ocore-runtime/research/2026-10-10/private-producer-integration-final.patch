+            "module_kind": record["module_kind"], "module_identifier_bytes": record["module_identifier_bytes"],
+            "target_triple_bytes": record["target_triple_bytes"], "data_layout_bytes": record["data_layout_bytes"],
+            "ir_stage": record["ir_stage"], "codegen_phase": record["codegen_phase"], "lto_configuration": record["lto_configuration"],
+            "source_production_edge_verified": True, "later_machine_semantics_verified": False}
