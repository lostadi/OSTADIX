+#!/usr/bin/env python3
+"""Read original source-issued rustc packets, not O-core or whole-link admission.
+
+Registration is a caller trust input. Packet locators, compiler version strings,
+CGU names, and a launcher hash cannot select that trust input. The production
+worker must bind its finalized manifest in the original invocation journal.
+"""
+from __future__ import annotations
+
+import hashlib
+import json
+import os
+from pathlib import Path
+import re
+
+POLICY = "rust-producer-native-link-v1"
+FLAGS = {name: False for name in (
+    "per_invocation_loaded_driver_verified", "source_production_inventory_complete",
+    "actual_driver_descendants_verified", "actual_linker_membership_verified",
+    "archive_member_selection_verified", "ordered_full_link_inputs_verified",
+    "lto_contribution_edges_complete", "native_machine_equivalence_verified",
+    "dependency_closure_complete", "whole_original_compiler_ocore_lowered",
+    "ocore_lowering_complete", "runtime_complete")}
+
+
+class ProducerError(ValueError):
+    pass
+
+
+def require(condition, message):
+    if not condition:
+        raise ProducerError(message)
+
+
+def file_info(path):
+    path = Path(path).absolute()
+    h = hashlib.sha256()
+    with path.open("rb") as stream:
+        for raw in iter(lambda: stream.read(1024 * 1024), b""):
+            h.update(raw)
+    return {"path": str(path), "sha256": h.hexdigest(), "bytes": path.stat().st_size}
+
+
+def checked(ref, *, optional_original=False):
+    require(isinstance(ref, dict) and set(ref) in (
+        {"path", "sha256", "bytes"}, {"path", "path_bytes", "sha256", "bytes"}), "artifact fields differ")
+    require(isinstance(ref["path"], str) and Path(ref["path"]).is_absolute(), "artifact requires absolute locator")
+    require(type(ref["bytes"]) is int and ref["bytes"] >= 0 and isinstance(ref["sha256"], str)
+        and re.fullmatch(r"[0-9a-f]{64}", ref["sha256"]), "artifact size/hash invalid")
+    if "path_bytes" in ref:
+        require(raw_bytes(ref["path_bytes"]).decode("utf-8", errors="replace") == ref["path"], "artifact lossy display differs from raw locator")
+    path = ref_path(ref)
+    if not (optional_original and not path.exists()):
+        actual = file_info(path)
+        require(all(actual[k] == ref[k] for k in ("sha256", "bytes")), "artifact bytes differ: " + str(path))
+    return path
+
+
+def ref_path(ref):
+    raw = raw_bytes(ref["path_bytes"]) if "path_bytes" in ref else os.fsencode(ref["path"])
+    require(b"\0" not in raw, "artifact OS locator contains NUL")
+    path = Path(os.fsdecode(raw))
+    require(path.is_absolute(), "raw artifact locator must be absolute")
+    return path
+
+
+def raw_bytes(value):
+    require(isinstance(value, list) and all(type(x) is int and 0 <= x <= 255 for x in value), "raw OS bytes invalid")
+    return bytes(value)
+
+
+def read_json(path):
+    def pairs(items):
+        result = {}
+        for key, value in items:
+            require(key not in result, "duplicate JSON key: " + key)
+            result[key] = value
+        return result
+    value = json.loads(Path(path).read_bytes(), object_pairs_hook=pairs)
+    require(isinstance(value, dict), "packet must be object")
+    return value
+
+
+def same_artifact(a, b):
+    return all(a.get(k) == b.get(k) for k in ("path", "sha256", "bytes"))
+
+
+def schema_validate(value, spec, root):
+    """The pinned source-hook schema subset; no network or package dependency."""
+    if "$ref" in spec:
+        require(spec["$ref"].startswith("#/$defs/"), "nonlocal schema reference")
+        schema_validate(value, root["$defs"][spec["$ref"].split("/")[-1]], root)
+        return
+    for name in ("allOf", "oneOf", "anyOf"):
+        if name in spec:
+            matches = 0
+            for branch in spec[name]:
+                try:
+                    schema_validate(value, branch, root)
+                    matches += 1
+                except ProducerError:
+                    pass
+            require(matches == len(spec[name]) if name == "allOf" else matches == 1 if name == "oneOf" else matches > 0,
+                "schema " + name + " differs")
+    if "if" in spec:
+        try:
+            schema_validate(value, spec["if"], root)
+            branch = "then"
+        except ProducerError:
+            branch = "else"
+        if branch in spec:
+            schema_validate(value, spec[branch], root)
+    types = {"object": isinstance(value, dict), "array": isinstance(value, list),
+        "integer": type(value) is int, "string": isinstance(value, str),
+        "boolean": type(value) is bool, "null": value is None}
+    if "type" in spec:
+        require(types.get(spec["type"], False), "schema type differs")
+    if "const" in spec:
+        require(type(value) is type(spec["const"]) and value == spec["const"], "schema constant differs")
+    if "enum" in spec:
+        require(any(type(value) is type(x) and value == x for x in spec["enum"]), "schema enum differs")
+    if isinstance(value, dict):
+        require(set(spec.get("required", [])) <= set(value), "schema required field missing")
+        properties = spec.get("properties", {})
+        if spec.get("additionalProperties") is False:
+            require(set(value) <= set(properties), "schema unknown field")
+        for key, child in value.items():
+            if key in properties:
+                schema_validate(child, properties[key], root)
+    if isinstance(value, list) and "items" in spec:
+        for child in value:
+            schema_validate(child, spec["items"], root)
+    if type(value) is int:
+        require("minimum" not in spec or value >= spec["minimum"], "schema minimum differs")
+        require("maximum" not in spec or value <= spec["maximum"], "schema maximum differs")
+    if isinstance(value, str) and "pattern" in spec:
+        require(re.search(spec["pattern"], value) is not None, "schema pattern differs")
+
+
+def validate_registration(ref, expected_sha256, selected_compiler):
+    """expected_sha256 comes from an independently fixed worker/recipe registry."""
+    require(ref.get("sha256") == expected_sha256, "hook registration differs from trusted registry")
+    registration = read_json(checked(ref))
+    require(set(registration) == {"schema", "compiler", "loaded_driver", "compiler_image_manifest",
+        "hook_build_manifest", "native_schema", "original_source_revision", "scope"}, "hook registration fields differ")
+    require(registration["schema"] == "ocore-rust-hook-registration-v1", "hook registration schema differs")
+    require(registration["original_source_revision"] == "8bab26f4f68e0e26f0bb7960be334d5b520ea452",
+        "unregistered original source revision")
+    for name in ("compiler", "loaded_driver", "compiler_image_manifest", "hook_build_manifest", "native_schema"):
+        checked(registration[name])
+    require(same_artifact(registration["compiler"], selected_compiler), "actual selected compiler is not registered image")
+    image = read_json(Path(registration["compiler_image_manifest"]["path"]))
+    require(same_artifact(image["compiler"], registration["compiler"])
+        and same_artifact(image["actually_loaded_driver"], registration["loaded_driver"]), "image driver/compiler registration differs")
+    require(same_artifact(image["build_readback"], registration["hook_build_manifest"]), "image build lineage differs")
+    require(image["same_payload_bytes_distinct_inodes"] is True, "image copy has no independent payload observation")
+    readback = read_json(Path(registration["hook_build_manifest"]["path"]))
+    require(all(readback["actually_loaded_driver"][k] == registration["loaded_driver"][k] for k in ("sha256", "bytes")),
+        "compiled driver bytes differ from copied image build readback")
+    for name in ("source_manifest", "cached_native_manifest", "actual_loader_evidence"):
+        checked({key: readback[name][key] for key in ("path", "sha256", "bytes")})
+    require(readback["version_status"] == 0 and readback["all_source_and_native_input_hashes_match"] is True,
+        "original build readback incomplete")
+    # Validate payload bytes, not a launcher/version/sysroot label. This proves
+    # the registered image now exists, not which image every invocation mapped.
+    payloads = image["payloads"]
+    require(image["payload_count"] == len(payloads), "image payload count differs")
+    for payload in payloads:
+        checked(payload["copied"])
+    return registration
+
+
+def packet_manifest(root, destination, context):
+    """Finalize AFTER original process exits, outside the packet directory."""
+    root = Path(root).absolute()
+    require(root.is_dir() and not root.is_symlink(), "packet root is not a real directory")
+    entries = []
+    for path in sorted(root.rglob("*")):
+        require(not path.is_symlink(), "packet symlink not allowed")
+        if path.is_file():
+            entries.append({"relative_path": str(path.relative_to(root)), "artifact": file_info(path)})
+    value = {"schema": "ocore-rust-original-packet-manifest-v1", "root": str(root), "context": context,
+        "entries": entries, "packet_count": len(entries), "source_production_inventory_complete": False}
+    Path(destination).write_text(json.dumps(value, indent=2, sort_keys=True) + "\n")
+    return file_info(destination)
+
+
+def decode(manifest_ref, context_ref, registration, *, invocation_id, compiler, cargo_parent=None,
+           observed_compiler_status=None):
+    """Reconstruct exact source-issued graph; return candidates plus typed gaps."""
+    manifest = read_json(checked(manifest_ref))
+    require(set(manifest) == {"schema", "root", "context", "entries", "packet_count", "source_production_inventory_complete"}
+        and manifest["schema"] == "ocore-rust-original-packet-manifest-v1", "packet manifest fields differ")
+    require(same_artifact(manifest["context"], context_ref), "manifest context differs")
+    context = read_json(checked(context_ref))
+    require(set(context) == {"schema", "compiler_invocation_id", "cargo_parent_invocation_id", "cargo_parent",
+        "output_directory", "invocation_seed", "source_capture_worker", "hook_build_manifest"}, "producer context fields differ")
+    require(context["schema"] == "ocore-rust-producer-context-v1" and context["compiler_invocation_id"] == invocation_id,
+        "producer context invocation differs")
+    require(context["cargo_parent"] == cargo_parent and context["cargo_parent_invocation_id"] ==
+        (None if cargo_parent is None else cargo_parent["id"]), "producer Cargo parent differs")
+    require(same_artifact(context["hook_build_manifest"], registration["hook_build_manifest"]), "context selected unregistered build")
+    for name in ("invocation_seed", "source_capture_worker", "hook_build_manifest"):
+        checked(context[name])
+    seed = read_json(Path(context["invocation_seed"]["path"]))
+    require(seed["compiler_invocation_id"] == invocation_id, "original invocation seed differs")
+    require(seed.get("argv", [None])[0] == compiler["path"], "original invocation seed compiler differs")
+    root = Path(manifest["root"])
+    require(root.is_absolute() and str(root) == context["output_directory"], "packet directory differs from original context")
+    require(not root.is_symlink(), "packet root symlink not allowed")
+    entries = manifest["entries"]
+    require(isinstance(entries, list) and manifest["packet_count"] == len(entries), "packet count differs")
+    paths = {}
+    for entry in entries:
+        require(set(entry) == {"relative_path", "artifact"}, "packet entry fields differ")
+        rel = Path(entry["relative_path"])
+        require(not rel.is_absolute() and ".." not in rel.parts and str(rel) not in paths, "packet path duplicate/outside directory")
+        path = checked(entry["artifact"])
+        require(path == root / rel and not path.is_symlink(), "packet artifact moved outside original directory")
+        paths[str(path)] = entry["artifact"]
+    actual_paths = set()
+    for path in root.rglob("*"):
+        require(not path.is_symlink(), "unexpected packet symlink")
+        if path.is_file():
+            actual_paths.add(str(path))
+    require(actual_paths == set(paths), "packet directory inventory differs from finalized manifest")
+    schema = read_json(checked(registration["native_schema"]))
+
+    def packet(ref, *, native=False):
+        path = checked(ref)
+        require(str(path) in paths and same_artifact(paths[str(path)], ref), "packet reference lacks finalized original binding")
+        value = read_json(path)
+        if native:
+            schema_validate(value, schema, schema)
+        return value
+
+    def load(path, native=False):
+        require(str(path) in paths, "source-issued packet absent: " + str(path))
+        return packet(paths[str(path)], native=native)
+
+    def original(ref):
+        checked(ref, optional_original=True)
+
+    def snapshot(ref, retained):
+        original(ref)
+        checked(retained)
+        require(ref["sha256"] == retained["sha256"] and ref["bytes"] == retained["bytes"], "retained source byte edge differs")
+        require(str(Path(retained["path"])) in paths, "retained source bytes not in finalized directory")
+
+    def identity(record):
+        require(record["compiler_invocation_id"] == invocation_id and same_artifact(record["context"], context_ref),
+            "source-issued packet compiler/context differs")
+
+    session = load(root / "producer-session.json")
+    require(set(session) == {"schema", "compiler_invocation_id", "context", "executable", "pid",
+        "source_production_inventory_complete"} and session["schema"] == "ocore-rust-producer-session-v1", "producer session fields differ")
+    identity(session)
+    require(type(session["pid"]) is int and session["pid"] > 0, "producer PID invalid")
+    checked(session["executable"])
+    require(same_artifact(session["executable"], compiler) and same_artifact(compiler, registration["compiler"]),
+        "producer executable differs from actual registered compiler")
+    producers = []
+    producer_paths = {}
+    used_emission_json = set()
+    emission_ids = set()
+    producer_fields = {"schema", "compiler_invocation_id", "cargo_parent_invocation_id", "context", "producer_executable",
+        "emission_id", "module_identifier_bytes", "module_kind", "crate_types", "target_triple_bytes", "data_layout_bytes",
+        "ir_stage", "codegen_phase", "lto_configuration", "use_linker_plugin_lto", "input_bitcode", "object",
+        "retained_object", "dwarf_object", "object_locator_bytes", "original_object_locator_bytes", "observation",
+        "source_production_inventory_complete", "lto_contribution_edges_complete", "dependency_closure_complete",
+        "native_machine_equivalence_verified", "runtime_complete"}
+    for path in sorted((root / "emissions").glob("*/producer.json")):
