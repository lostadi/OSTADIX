+            'source': {'revision': '8bab26f4f68e0e26f0bb7960be334d5b520ea452', 'url': 'https://github.com/rust-lang/rust'},
+            'toolchain': toolchain, 'commands': [{'argv': ['original-x.py']}],
+            'coverage': {'required_units': [{'id': 'rust-source', 'kind': 'rustc', 'source': '*.rs'}]}}
