+    def clone(self, change, *, invocation_seed=None):
+        """Derived mutation fixture, explicitly not another producer invocation.
+
+        Rebind copied packet refs to test semantic edges beyond byte-hash checks.
+        The original immutable context/seed/compiler/source files are untouched.
+        """
+        original_root = DIRECT / 'producer'
+        cloned = self.root / 'producer'
+        shutil.copytree(original_root, cloned)
+        context_path = self.root / 'context.json'
+        context = h.read_json(DIRECT / 'context.json')
+        context['output_directory'] = str(cloned)
+        if invocation_seed is not None:
+            seed_path = self.root / 'seed.json'
+            seed_path.write_text(json.dumps(invocation_seed) + '\n')
+            context['invocation_seed'] = h.file_info(seed_path)
+            context['source_capture_worker'] = invocation_seed['capture_worker']
+        context_path.write_text(json.dumps(context) + '\n')
+        packets = {str(p): h.read_json(p) for p in cloned.rglob('*.json')}
+        before_packet_paths = set(packets)
+        change(packets)
+        for dropped in before_packet_paths - set(packets):
+            Path(dropped).unlink(missing_ok=True)
+        old_context = str(DIRECT / 'context.json')
+        old_root = str(original_root)
+        visited = set()
+        visiting = set()
+
+        def mapped(path):
+            if path == old_context:
+                return str(context_path)
+            if path.startswith(old_root + '/'):
+                return str(cloned) + path[len(old_root):]
+            return path
+
+        def rewrite(value):
+            if isinstance(value, dict):
+                if set(value) in ({'path', 'sha256', 'bytes'}, {'path', 'path_bytes', 'sha256', 'bytes'}):
+                    new = mapped(value['path'])
+                    if new != value['path']:
+                        if new in packets:
+                            save(new)
+                        result = h.file_info(new)
+                        if 'path_bytes' in value:
+                            result['path_bytes'] = list(new.encode())
+                        return result
+                return {k: rewrite(v) for k, v in value.items()}
+            if isinstance(value, list):
+                if value and all(type(v) is int and 0 <= v <= 255 for v in value):
+                    raw = bytes(value)
+                    for old, new in ((old_root, str(cloned)), (old_context, str(context_path))):
+                        if raw.startswith(old.encode()):
+                            raw = new.encode() + raw[len(old.encode()):]
+                    return list(raw)
+                return [rewrite(v) for v in value]
+            return value
+
+        def save(path):
+            if path in visited:
+                return
+            if path in visiting:
+                raise AssertionError('fixture reference cycle')
+            visiting.add(path)
+            packets[path] = rewrite(packets[path])
+            Path(path).write_text(json.dumps(packets[path], sort_keys=True) + '\n')
+            visiting.remove(path)
+            visited.add(path)
+
+        for path in packets:
+            save(path)
+        context_ref = h.file_info(context_path)
+        manifest = h.packet_manifest(cloned, self.root / 'manifest.json', context_ref)
+        return lambda: h.decode(manifest, context_ref, self.registration,
+            invocation_id=context['compiler_invocation_id'], compiler=self.registration['compiler'], observed_compiler_status=0)
