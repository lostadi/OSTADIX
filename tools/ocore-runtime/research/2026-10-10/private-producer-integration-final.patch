+        if record["role"] != "metadata_resource" and record["gap"] is None:
+            require(len(candidates) == 1 and record["producer_record"] is not None, "consumer sole original producer selection missing")
+        has_edge = record["role"] != "metadata_resource" and record["gap"] is None and len(candidates) == 1 and record["producer_record"] is not None
+        if has_edge:
