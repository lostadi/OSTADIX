+        producer_paths[str(path)] = record
+    gaps = [{"kind": key, "scope": "whole_original_program"} for key in (
+        "per_invocation_loaded_driver_unobserved", "descendant_exec_chain_unobserved",
+        "ordered_link_inputs_unobserved", "selected_archive_members_unobserved", "provider_source_closure_unresolved")]
+    for path in sorted((root / "emissions").glob("*/pending.json")):
+        if str(path) not in used_emission_json:
+            pending = load(path)
+            identity(pending)
+            require(set(pending) == producer_fields - {"object", "retained_object", "dwarf_object"}
+                and pending["observation"] == "pending_native_emission", "unfinished producer pending fields differ")
+            checked(pending["input_bitcode"])
+            used_emission_json.add(str(path))
+            gaps.append({"kind": "original_native_emission_unfinished", "pending": paths[str(path)]})
+    emission_json = {p for p in paths if p.startswith(str(root / "emissions") + os.sep) and p.endswith(".json")}
+    require(emission_json == used_emission_json, "source-issued emission packet omitted or extra")
+    consumers = []
+    referenced_consumers = set()
+    consumer_paths = {}
+    for path in sorted((root / "consumers").glob("*.json")):
+        record = load(path)
+        require(record.get("schema") == "ocore-rust-link-consumer-v1", "unsupported original archive/resource packet; retain explicit gap")
+        identity(record)
+        expected = {"schema", "compiler_invocation_id", "context", "scope_id", "scope_kind", "scope_ordinal", "role",
+            "module_identifier_bytes", "object", "original_locator_bytes", "retained_object", "producer_ir_requirement",
+            "producer_candidates", "producer_record", "gap", "scope", "actual_linker_membership_verified",
+            "archive_member_selection_verified", "dependency_closure_complete", "runtime_complete"}
+        require(set(record) == expected, "consumer fields differ")
+        snapshot(record["object"], record["retained_object"])
+        incoming_locator = os.path.abspath(os.path.join(os.fsencode(seed["cwd"]), raw_bytes(record["original_locator_bytes"])))
+        require(incoming_locator == os.fsencode(ref_path(record["object"])), "consumer object locator differs from original cwd")
+        candidates = record["producer_candidates"]
