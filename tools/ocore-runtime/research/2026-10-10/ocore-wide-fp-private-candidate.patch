+#[test]
+fn poison_edge_flags_remain_explicit_and_do_not_introduce_eager_traps() {
+    for bits in 1..=64 {
+        for (kind, edge) in [
+            (IntegerUnaryIntrinsicKind::Abs, 1_u64 << (bits - 1)),
+            (IntegerUnaryIntrinsicKind::LeadingZeros, 0),
+            (IntegerUnaryIntrinsicKind::TrailingZeros, 0),
+        ] {
+            let plain = fixture(bits, kind, false);
+            let mut poisoned = fixture(bits, kind, true);
+            // freeze makes the selected permitted poison refinement observable.
+            poisoned.functions[0].blocks[0]
+                .instructions
+                .push(Instruction {
+                    fp: FloatInstructionSemantics::default(),
+                    result: Some(Value { id: 2, ty: INT }),
+                    operation: Operation::Freeze {
+                        value: Operand::Value { id: OUT },
+                    },
+                });
+            poisoned.functions[0].blocks[0].terminator = Terminator::Return {
+                value: Some(Operand::Value { id: 2 }),
+            };
+            accepted(&poisoned);
+            assert_eq!(calculate(&plain, edge), calculate(&poisoned, edge));
+            assert_eq!(
+                calculate(&poisoned, edge),
+                BigUint::from(expected(kind, bits, edge))
+            );
+        }
+    }
