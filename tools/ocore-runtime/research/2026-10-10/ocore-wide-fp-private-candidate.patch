+    fn integer_count_zeros(
+        &mut self,
+        out: &mut String,
+        kind: IntegerZeroCountKind,
+        value: &Operand,
+        _zero_poison: bool,
+    ) {
+        // The source flag is retained. The defined false-flag result N for
+        // zero is also a permitted stable refinement of the true-flag poison
+        // edge under LlvmDefinedBehaviorV1. Do not emit an eager trap.
+        self.operand(out, 0, value);
+        let bits = self.bits(value);
+        self.mask(out, 0, bits);
+        match (self.target, kind) {
+            (Target::X86_64UnknownNone, IntegerZeroCountKind::Leading) => {
+                // BSR leaves its destination unspecified on zero. MOV and
+                // CMOVZ preserve its zero flag; repair the index before use.
+                // Nonzero: N-1-floor(log2(x)). Zero: N-1-(-1) = N.
+                writeln!(
+                    out,
+                    "  bsr rcx, rax\n  mov rdx, -1\n  cmovz rcx, rdx\n  mov rax, {}\n  sub rax, rcx",
+                    bits - 1
+                )
+                .unwrap();
+            }
+            (Target::X86_64UnknownNone, IntegerZeroCountKind::Trailing) => {
+                writeln!(out, "  bsf rax, rax\n  mov rcx, {bits}\n  cmovz rax, rcx")
+                    .unwrap();
+            }
+            (Target::Aarch64UnknownNone, IntegerZeroCountKind::Leading) => {
+                out.push_str("  clz x9, x9\n");
+                if bits < 64 {
+                    writeln!(out, "  sub x9, x9, #{}", 64 - bits).unwrap();
+                }
+            }
+            (Target::Aarch64UnknownNone, IntegerZeroCountKind::Trailing) => {
+                if bits < 64 {
+                    // The sentinel is above every original bit. It cannot
+                    // change a nonzero count, and makes zero count exactly N.
+                    self.immediate(out, 1, 1u64 << bits);
+                    out.push_str("  orr x9, x9, x10\n");
+                }
+                out.push_str("  rbit x9, x9\n  clz x9, x9\n");
+            }
+            (Target::Riscv64UnknownNone, _) => {
+                // RV64GC has no mandatory Zbb count operation. Search six
+                // binary partitions of the full zero-extended 64-bit value.
+                // The explicit zero branch avoids the nonzero search invariant
+                // failing when the original flag allows a defined zero result.
