+    fn rv_hard_float(&self) -> Result<bool, Diagnostic> {
+        match self.module.target.abi.as_deref() {
+            Some("lp64d") => Ok(true), Some("lp64") => Ok(false),
+            _ => Err(fail("RISC-V floating calling ABI requires explicit original lp64/lp64d identity")),
