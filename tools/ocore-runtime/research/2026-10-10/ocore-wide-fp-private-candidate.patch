+#[test]
+fn poison_flags_are_required_boolean_fields_and_ctpop_has_no_flag() {
+    for (kind, _) in KINDS {
+        let operation = operation(kind, Operand::Value { id: 0 }, true);
+        let wire = serde_json::to_value(&operation).unwrap();
+        for extra in [
+            "flags",
+            "width",
+            "signed",
+            "ordering",
+            "volatile",
+            "predicate",
+        ] {
+            let mut invalid = wire.clone();
+            invalid[extra] = json!(true);
+            assert!(
+                serde_json::from_value::<Operation>(invalid).is_err(),
+                "accepted extra {extra}"
+            );
+        }
+        if kind == IntegerUnaryIntrinsicKind::PopulationCount {
+            for flag in ["zero_poison", "int_min_poison"] {
+                let mut invalid = wire.clone();
+                invalid[flag] = json!(false);
+                assert!(serde_json::from_value::<Operation>(invalid).is_err());
+            }
+        } else {
+            let flag = if kind == IntegerUnaryIntrinsicKind::Abs {
+                "int_min_poison"
+            } else {
+                "zero_poison"
+            };
+            let mut missing = wire.clone();
+            missing.as_object_mut().unwrap().remove(flag);
+            assert!(serde_json::from_value::<Operation>(missing).is_err());
+            for value in [
+                json!(0),
+                json!(1),
+                json!(null),
+                json!("true"),
+                json!({"kind":"value","id":0}),
+            ] {
+                let mut invalid = wire.clone();
+                invalid[flag] = value;
+                assert!(serde_json::from_value::<Operation>(invalid).is_err());
+            }
+        }
+        let mut missing = wire;
+        missing.as_object_mut().unwrap().remove("value");
+        assert!(serde_json::from_value::<Operation>(missing).is_err());
+    }
+}
