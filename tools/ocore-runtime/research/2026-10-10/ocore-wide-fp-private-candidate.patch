+fn exact_float_bits(bits: &str, width: u32, context: &str) -> Result<()> {
+    if bits.is_empty() || !bits.bytes().all(|b| b.is_ascii_digit()) {
+        return Err(fail(
+            context,
+            "floating constant must use exact unsigned decimal bits",
+        ));
+    }
+    let digits = bits.trim_start_matches('0');
+    if !digits.is_empty()
+        && (digits.len() as u64 > u64::from(width) * 30103 / 100000 + 1
+            || BigUint::parse_bytes(digits.as_bytes(), 10).unwrap().bits() > u64::from(width))
+    {
+        return Err(fail(
+            context,
+            "floating constant exceeds original format payload width",
+        ));
+    }
+    Ok(())
