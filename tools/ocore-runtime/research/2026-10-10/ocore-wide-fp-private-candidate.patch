+        ));
+    }
+    if fp.flags.iter().collect::<BTreeSet<_>>().len() != fp.flags.len() {
+        return Err(fail(context, "duplicate original floating math flag"));
+    }
+    let floating_result =
+        result.is_some_and(|v| matches!(module.types.get(v.ty), Some(Type::Float { .. })));
+    let allowed = matches!(
+        operation,
+        Operation::FloatingBinary { .. }
+            | Operation::FloatingNegate { .. }
+            | Operation::FloatingCompare { .. }
+            | Operation::FloatingConvert { .. }
+    ) || (floating_result
+        && matches!(
+            operation,
+            Operation::Phi { .. } | Operation::Select { .. } | Operation::Call { .. }
+        ));
+    if !fp.flags.is_empty() && !allowed {
+        return Err(fail(
+            context,
+            "floating flags attached to non-FP-math source operation",
+        ));
+    }
+    if let Some(accuracy) = &fp.accuracy {
+        if !floating_result || !allowed {
