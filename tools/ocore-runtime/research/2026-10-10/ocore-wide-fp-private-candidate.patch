+#[test]
+fn declarations_retain_exact_arity_types_abi_and_compiler_ownership() {
+    for (kind, _) in KINDS {
+        let original = fixture(21, kind, false);
+        for mutation in 0..12 {
+            let mut invalid = original.clone();
+            let declaration = &mut invalid.functions[1];
+            match mutation {
+                0 => declaration.intrinsic = None,
+                1 => declaration.intrinsic = Some("llvm.ctpop.i1".into()),
+                2 => declaration.signature.params.clear(),
+                3 => declaration.signature.params.push(INT),
+                4 => declaration.signature.params[0] = 1,
+                5 => declaration.signature.result = 1,
+                6 => declaration.signature.variadic = true,
+                7 => declaration.signature.abi = "fastcc".into(),
+                8 => declaration.linkage = "weak".into(),
+                9 => declaration.visibility = Visibility::Hidden,
+                10 => {
+                    declaration.signature.param_attributes = vec![vec![]; declaration.signature.params.len()];
+                    declaration.signature.param_attributes[0] = vec!["zeroext".into()];
+                },
+                11 => declaration.signature.result_attributes = vec!["signext".into()],
+                _ => unreachable!(),
+            }
+            rejected(&invalid, "intrinsic declaration");
+        }
+        if kind != IntegerUnaryIntrinsicKind::PopulationCount {
+            let mut invalid = original.clone();
+            invalid.functions[1].signature.params[1] = INT;
+            rejected(&invalid, "intrinsic declaration");
+        }
+        let mut invalid = original;
+        invalid.functions.pop();
+        rejected(&invalid, "source declaration/definition inventory");
+    }
