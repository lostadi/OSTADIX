+    fn integer_population_count(&self, out: &mut String, value: &Operand) {
+        self.operand(out, 0, value);
+        self.mask(out, 0, self.bits(value));
+        // Count the zero-extended original N-bit value with 64-bit SWAR. Each
+        // two-bit lane holds <=2, each nibble <=4, and each byte <=8. The final
+        // modular multiply sums all eight bytes into the highest byte, <=64.
+        // This uses no POPCNT, SIMD, Zbb, compiler helper, or extra live value.
+        match self.target {
+            Target::X86_64UnknownNone => out.push_str(
+                "  mov rcx, rax\n  shr rcx, 1\n  mov rdx, 0x5555555555555555\n  and rcx, rdx\n  sub rax, rcx\n  mov rcx, rax\n  shr rcx, 2\n  mov rdx, 0x3333333333333333\n  and rax, rdx\n  and rcx, rdx\n  add rax, rcx\n  mov rcx, rax\n  shr rcx, 4\n  add rax, rcx\n  mov rcx, 0x0f0f0f0f0f0f0f0f\n  and rax, rcx\n  mov rcx, 0x0101010101010101\n  imul rax, rcx\n  shr rax, 56\n",
+            ),
+            Target::Aarch64UnknownNone => out.push_str(
+                "  lsr x10, x9, #1\n  and x10, x10, #0x5555555555555555\n  sub x9, x9, x10\n  and x10, x9, #0x3333333333333333\n  lsr x9, x9, #2\n  and x9, x9, #0x3333333333333333\n  add x9, x9, x10\n  lsr x10, x9, #4\n  add x9, x9, x10\n  and x9, x9, #0x0f0f0f0f0f0f0f0f\n  mov x10, #0x0101010101010101\n  mul x9, x9, x10\n  lsr x9, x9, #56\n",
+            ),
+            Target::Riscv64UnknownNone => out.push_str(
+                "  srli t1, t0, 1\n  li t2, 0x5555555555555555\n  and t1, t1, t2\n  sub t0, t0, t1\n  srli t1, t0, 2\n  li t2, 0x3333333333333333\n  and t0, t0, t2\n  and t1, t1, t2\n  add t0, t0, t1\n  srli t1, t0, 4\n  add t0, t0, t1\n  li t1, 0x0f0f0f0f0f0f0f0f\n  and t0, t0, t1\n  li t1, 0x0101010101010101\n  mul t0, t0, t1\n  srli t0, t0, 56\n",
+            ),
+        }
+    }
