+    fn integer_abs(
+        &self,
+        out: &mut String,
+        value: &Operand,
+        _int_min_poison: bool,
+    ) {
+        // Preserve the original flag in NativeIR. With false, INT_MIN has its
+        // original modular bit pattern. With true, that input produces source
+        // poison, which the declared LlvmDefinedBehaviorV1 policy refines to the
+        // same stable bit pattern. Do not trap: freeze may observe a defined
+        // continuation after a poisoned intrinsic result.
+        // Materialize undef/poison only once, before any sign decision.
+        self.operand(out, 0, value);
+        let bits = self.bits(value);
+        self.mask(out, 0, bits);
+        match self.target {
+            Target::X86_64UnknownNone => writeln!(
+                out,
+                "  mov rcx, rax\n  shr rcx, {}\n  neg rcx\n  xor rax, rcx\n  sub rax, rcx",
+                bits - 1
+            )
+            .unwrap(),
+            Target::Aarch64UnknownNone => writeln!(
+                out,
+                "  lsr x10, x9, #{}\n  neg x10, x10\n  eor x9, x9, x10\n  sub x9, x9, x10",
+                bits - 1
+            )
+            .unwrap(),
+            Target::Riscv64UnknownNone => writeln!(
+                out,
+                "  srli t1, t0, {}\n  neg t1, t1\n  xor t0, t0, t1\n  sub t0, t0, t1",
+                bits - 1
+            )
+            .unwrap(),
+        }
+        // The common result path masks to iN. Modular arithmetic also handles
+        // i1 and i64 INT_MIN without host signed negation or optional ISA ops.
+    }
