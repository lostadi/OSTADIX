+    fn floating_argument(&self, format: super::native_ir::FloatFormat, abi: &str,
+        next: &mut usize, placement: &mut Placement) -> Result<(AbiLocation, AbiRegisterClass, u8), Diagnostic>
+    {
+        let bits = format.native_scalar_bits().ok_or_else(|| fail("floating ABI format requires explicit lowering"))?;
+        let registers: &'static [&'static str] = match self.target {
+            Target::X86_64UnknownNone => &["xmm0","xmm1","xmm2","xmm3","xmm4","xmm5","xmm6","xmm7"],
+            Target::Aarch64UnknownNone if bits == 32 => &["s0","s1","s2","s3","s4","s5","s6","s7"],
+            Target::Aarch64UnknownNone => &["d0","d1","d2","d3","d4","d5","d6","d7"],
+            Target::Riscv64UnknownNone if abi == "fastcc" => &["fa0","fa1","fa2","fa3","fa4","fa5","fa6","fa7","ft0","ft1","ft2","ft3","ft4","ft5","ft6","ft7","ft8","ft9","ft10","ft11"],
+            Target::Riscv64UnknownNone if !self.rv_hard_float()? => return Ok((placement.ordinary()?, AbiRegisterClass::General, 8)),
+            Target::Riscv64UnknownNone => &["fa0","fa1","fa2","fa3","fa4","fa5","fa6","fa7"],
+        };
+        if let Some(register) = registers.get(*next) {
+            *next += 1;
+            return Ok((AbiLocation::Register(register), AbiRegisterClass::Float, 8));
+        }
+        if self.target == Target::Riscv64UnknownNone && abi == "c" {
+            return Ok((placement.ordinary()?, AbiRegisterClass::General, 8));
+        }
+        // RV FastCC f32 occupies4 bytes, unlike C ABI and AAPCS/x86 slots8.
+        let bytes = if self.target == Target::Riscv64UnknownNone && abi == "fastcc" && bits == 32 { 4 } else { 8 };
+        placement.stack = align_up(placement.stack, bytes)?;
+        let offset = placement.stack;
+        placement.stack = add(offset, bytes)?;
+        Ok((AbiLocation::Stack { offset }, AbiRegisterClass::General, bytes as u8))
+    }
+
+    fn floating_return(&self, format: super::native_ir::FloatFormat) -> Result<(AbiLocation, AbiRegisterClass), Diagnostic> {
+        let bits = format.native_scalar_bits().ok_or_else(|| fail("floating return format requires explicit lowering"))?;
+        let register = match self.target {
+            Target::X86_64UnknownNone => "xmm0",
+            Target::Aarch64UnknownNone if bits == 32 => "s0",
+            Target::Aarch64UnknownNone => "d0",
+            Target::Riscv64UnknownNone if !self.rv_hard_float()? => return Ok((AbiLocation::Register("a0"), AbiRegisterClass::General)),
+            Target::Riscv64UnknownNone => "fa0",
+        };
+        Ok((AbiLocation::Register(register), AbiRegisterClass::Float))
+    }
