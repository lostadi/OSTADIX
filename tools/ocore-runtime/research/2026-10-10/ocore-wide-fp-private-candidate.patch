+impl FloatFormat {
+    pub const fn value_bits(self) -> u32 {
+        match self {
+            Self::Half | Self::BFloat => 16,
+            Self::Float => 32,
+            Self::Double => 64,
+            Self::X86Fp80 => 80,
+            Self::Fp128 | Self::PpcFp128 => 128,
+        }
+    }
+    pub const fn native_scalar_bits(self) -> Option<u16> {
+        match self {
+            Self::Float => Some(32),
+            Self::Double => Some(64),
+            _ => None,
+        }
+    }
+}
