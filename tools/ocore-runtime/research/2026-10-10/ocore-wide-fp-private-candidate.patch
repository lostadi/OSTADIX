+//! Private realization of source IEEE binary32/binary64 operations. Values are
+//! stored as exact GP bit words; only arithmetic uses caller-saved FP scratch.
+//! Default IEEE environment is an explicit whole-image realization contract.
+use super::*;
+use std::collections::BTreeMap;
+use std::fmt::Write;
+
+fn fail(message: impl Into<String>) -> Diagnostic {
+    error_diagnostic(format!("native floating-point: {}", message.into()))
+}
+fn format(module: &NativeModule, ty: TypeId) -> Result<FloatFormat, Diagnostic> {
+    match module.types.get(ty) {
+        Some(Type::Float { format }) => Ok(*format),
+        _ => Err(fail("expected original floating format")),
+    }
+}
+fn operand_type(types: &BTreeMap<ValueId, TypeId>, o: &Operand) -> TypeId {
+    match o {
+        Operand::Value { id } => types[id],
+        Operand::Int { ty, .. }
+        | Operand::FloatBits { ty, .. }
+        | Operand::PointerBits { ty, .. }
+        | Operand::Null { ty }
+        | Operand::Symbol { ty, .. }
+        | Operand::SymbolOffset { ty, .. }
+        | Operand::Aggregate { ty, .. }
+        | Operand::AggregateZero { ty }
+        | Operand::Undef { ty }
+        | Operand::Poison { ty } => *ty,
+    }
+}
+pub(super) fn audit_function(
+    _module: &NativeModule,
+    function: &Function,
+    _target: Target,
+) -> Result<(), Diagnostic> {
+    if function
+        .blocks
+        .iter()
+        .flat_map(|b| &b.instructions)
+        .any(|i| is_fp(&i.operation))
+        && function.fp_environment != FloatFunctionEnvironment::default()
+    {
+        return Err(fail(
+            "non-default function FP environment requires source-owned environment realization",
+        ));
+    }
+    Ok(())
+}
+fn is_fp(o: &Operation) -> bool {
+    matches!(
+        o,
+        Operation::FloatingBinary { .. }
+            | Operation::FloatingNegate { .. }
+            | Operation::FloatingCompare { .. }
+            | Operation::FloatingConvert { .. }
+    )
+}
+pub(super) fn audit_instruction(
+    module: &NativeModule,
+    i: &Instruction,
+    types: &BTreeMap<ValueId, TypeId>,
+    _target: Target,
+) -> Result<(), Diagnostic> {
+    if !is_fp(&i.operation) {
+        return Ok(());
+    }
+    if module.target.fp_profile != Some(FloatingPointProfile::IeeeDefaultV1) {
+        return Err(fail(
+            "floating operation requires explicit ieee-default-v1 FP profile",
+        ));
+    }
+    let check = |o: &Operand| -> Result<(), Diagnostic> {
+        match module.types.get(operand_type(types,o)) {
+            Some(Type::Float{format}) if format.native_scalar_bits().is_some()=>Ok(()),
+            Some(Type::Int{bits:1..=64})=>Ok(()),
+            _=>Err(fail("operation requires source-owned helper realization for unsupported FP format or integer width")),
+        }
+    };
+    for o in instruction_operands(&i.operation) {
+        check(o)?;
+    }
+    check(&Operand::Undef {
+        ty: i.result.ok_or_else(|| fail("floating result missing"))?.ty,
+    })?;
+    match &i.operation {
+        Operation::FloatingBinary{kind:FloatBinaryOp::Rem,..}=>Err(fail("frem requires source-owned truncating-fmod helper closure, not IEEE remainder")),
+        Operation::FloatingBinary{constrained:Some(_),..}|Operation::FloatingCompare{constrained:Some(_),..}
+        |Operation::FloatingConvert{constrained:Some(_),..}=>Err(fail("constrained FP rounding/exceptions require explicit native or source-owned environment support")),
+        _=>Ok(()),
+    }
+}
+/// Bit transfers preserve payloads, signed zero and NaNs. No arithmetic or
+/// canonicalization is performed at ABI/data-flow boundaries.
+pub(super) fn from_fp(out: &mut String, target: Target, gp: &str, fp: &str, f: FloatFormat) {
+    match (target, f) {
+        (Target::X86_64UnknownNone, FloatFormat::Float) => {
+            let r32 = match gp {
+                "rax" => "eax",
+                "rcx" => "ecx",
+                "rdx" => "edx",
+                _ => panic!("audited GP scratch"),
+            };
+            writeln!(out, "  movd {r32}, {fp}").unwrap();
+        }
+        (Target::X86_64UnknownNone, FloatFormat::Double) => {
+            writeln!(out, "  movq {gp}, {fp}").unwrap()
+        }
+        (Target::Aarch64UnknownNone, FloatFormat::Float) => {
+            writeln!(out, "  fmov {}, {fp}", gp.replacen('x', "w", 1)).unwrap()
+        }
+        (Target::Aarch64UnknownNone, FloatFormat::Double) => {
+            writeln!(out, "  fmov {gp}, {fp}").unwrap()
+        }
+        (Target::Riscv64UnknownNone, FloatFormat::Float) => writeln!(
+            out,
+            "  fmv.x.w {gp}, {fp}\n  slli {gp}, {gp}, 32\n  srli {gp}, {gp}, 32"
+        )
+        .unwrap(),
+        (Target::Riscv64UnknownNone, FloatFormat::Double) => {
+            writeln!(out, "  fmv.x.d {gp}, {fp}").unwrap()
+        }
+        _ => panic!("unsupported FP location reached emission"),
+    }
+}
+pub(super) fn to_fp(out: &mut String, target: Target, fp: &str, gp: &str, f: FloatFormat) {
+    match (target, f) {
+        (Target::X86_64UnknownNone, FloatFormat::Float) => {
+            let r32 = match gp {
+                "rax" => "eax",
+                "rcx" => "ecx",
+                "rdx" => "edx",
+                _ => panic!("audited GP scratch"),
+            };
+            writeln!(out, "  movd {fp}, {r32}").unwrap();
+        }
+        (Target::X86_64UnknownNone, FloatFormat::Double) => {
+            writeln!(out, "  movq {fp}, {gp}").unwrap()
+        }
+        (Target::Aarch64UnknownNone, FloatFormat::Float) => {
+            writeln!(out, "  fmov {fp}, {}", gp.replacen('x', "w", 1)).unwrap()
+        }
+        (Target::Aarch64UnknownNone, FloatFormat::Double) => {
+            writeln!(out, "  fmov {fp}, {gp}").unwrap()
+        }
+        (Target::Riscv64UnknownNone, FloatFormat::Float) => {
+            writeln!(out, "  fmv.w.x {fp}, {gp}").unwrap()
+        }
+        (Target::Riscv64UnknownNone, FloatFormat::Double) => {
+            writeln!(out, "  fmv.d.x {fp}, {gp}").unwrap()
+        }
+        _ => panic!("unsupported FP location reached emission"),
+    }
+}
+impl Emitter<'_> {
+    pub(super) fn fp_from_location(
+        &self,
+        out: &mut String,
+        gp: &str,
+        register: &str,
+        format: FloatFormat,
+    ) {
+        from_fp(out, self.target, gp, register, format);
+    }
+    pub(super) fn fp_to_location(
+        &self,
+        out: &mut String,
+        register: &str,
+        gp: &str,
+        format: FloatFormat,
+    ) {
+        to_fp(out, self.target, register, gp, format);
+    }
+
+    fn fp_scratch(&self, f: FloatFormat, n: usize) -> &'static str {
+        match (self.target, f, n) {
+            (Target::X86_64UnknownNone, _, 0) => "xmm14",
+            (Target::X86_64UnknownNone, _, 1) => "xmm15",
+            (Target::Aarch64UnknownNone, FloatFormat::Float, 0) => "s16",
+            (Target::Aarch64UnknownNone, FloatFormat::Float, 1) => "s17",
+            (Target::Aarch64UnknownNone, FloatFormat::Double, 0) => "d16",
+            (Target::Aarch64UnknownNone, FloatFormat::Double, 1) => "d17",
+            (Target::Riscv64UnknownNone, _, 0) => "ft0",
+            (Target::Riscv64UnknownNone, _, 1) => "ft1",
+            _ => unreachable!(),
+        }
+    }
+    fn fp_read(&self, out: &mut String, o: &Operand, n: usize) -> FloatFormat {
+        let f = format(self.module, self.ty(o)).unwrap();
+        self.operand_leaf(out, n, o, 0);
+        to_fp(out, self.target, self.fp_scratch(f, n), self.reg(n), f);
+        f
+    }
+    fn fp_math_result(&mut self, out: &mut String, f: FloatFormat) {
+        let fp = self.fp_scratch(f, 0);
+        from_fp(out, self.target, self.reg(0), fp, f);
+        let done = self.label();
+        match self.target {
+            Target::X86_64UnknownNone => writeln!(
+                out,
+                "  ucomi{} {fp}, {fp}\n  jnp {done}",
+                if f == FloatFormat::Float { "ss" } else { "sd" }
+            )
+            .unwrap(),
+            Target::Aarch64UnknownNone => {
+                writeln!(out, "  fcmp {fp}, {fp}\n  b.vc {done}").unwrap()
+            }
+            Target::Riscv64UnknownNone => writeln!(
+                out,
+                "  fclass.{} t1, {fp}\n  andi t1, t1, 768\n  beqz t1, {done}",
+                if f == FloatFormat::Float { "s" } else { "d" }
+            )
+            .unwrap(),
+        }
+        self.immediate(
+            out,
+            0,
+            if f == FloatFormat::Float {
+                0x7fc00000
+            } else {
+                0x7ff8000000000000
+            },
+        );
+        writeln!(out, "{done}:").unwrap();
+    }
+    pub(super) fn floating_instruction(
+        &mut self,
+        out: &mut String,
+        i: &Instruction,
+    ) -> Result<bool, Diagnostic> {
+        let result = match i.result {
+            Some(v) => v,
+            None => return Ok(false),
+        };
+        match &i.operation {
+            Operation::FloatingBinary { kind, lhs, rhs, .. } => {
+                let f = self.fp_read(out, lhs, 0);
+                self.fp_read(out, rhs, 1);
+                let (a, b) = (self.fp_scratch(f, 0), self.fp_scratch(f, 1));
+                let op = match kind {
+                    FloatBinaryOp::Add => "add",
+                    FloatBinaryOp::Sub => "sub",
+                    FloatBinaryOp::Mul => "mul",
+                    FloatBinaryOp::Div => "div",
+                    FloatBinaryOp::Rem => return Err(fail("frem helper not linked")),
+                };
+                match self.target {
+                    Target::X86_64UnknownNone => writeln!(
+                        out,
+                        "  {op}{} {a}, {b}",
+                        if f == FloatFormat::Float { "ss" } else { "sd" }
+                    )
+                    .unwrap(),
+                    Target::Aarch64UnknownNone => writeln!(out, "  f{op} {a}, {a}, {b}").unwrap(),
+                    Target::Riscv64UnknownNone => writeln!(
+                        out,
+                        "  f{op}.{} {a}, {a}, {b}, rne",
+                        if f == FloatFormat::Float { "s" } else { "d" }
+                    )
+                    .unwrap(),
+                }
+                self.fp_math_result(out, f);
+            }
+            Operation::FloatingNegate { value } => {
+                let f = format(self.module, self.ty(value))?;
+                self.operand_leaf(out, 0, value, 0);
+                self.immediate(out, 1, 1u64 << (f.value_bits() - 1));
+                match self.target {
+                    Target::X86_64UnknownNone => writeln!(out, "  xor rax, rcx").unwrap(),
+                    Target::Aarch64UnknownNone => writeln!(out, "  eor x9, x9, x10").unwrap(),
+                    Target::Riscv64UnknownNone => writeln!(out, "  xor t0, t0, t1").unwrap(),
+                }
+            }
+            Operation::FloatingCompare {
+                predicate,
+                lhs,
+                rhs,
+                ..
+            } => {
+                let f = self.fp_read(out, lhs, 0);
+                self.fp_read(out, rhs, 1);
+                self.fp_compare(out, f, *predicate);
+            }
+            Operation::FloatingConvert { kind, value, .. } => {
+                self.fp_convert(out, *kind, value, result.ty)?
+            }
+            _ => return Ok(false),
+        }
+        self.spill_leaf(out, result, 0);
+        Ok(true)
+    }
