+                    Ord => writeln!(out, "  xori t0, t2, 1").unwrap(),
+                    Uno => writeln!(out, "  mv t0, t2").unwrap(),
+                    Oeq | Ueq => writeln!(out, "  feq.{suffix} t0, {a}, {b}").unwrap(),
+                    One | Une => {
+                        writeln!(out, "  feq.{suffix} t0, {a}, {b}\n  xori t0, t0, 1").unwrap()
+                    }
+                    Ogt | Ugt => writeln!(out, "  flt.{suffix} t0, {b}, {a}").unwrap(),
+                    Oge | Uge => writeln!(out, "  fle.{suffix} t0, {b}, {a}").unwrap(),
+                    Olt | Ult => writeln!(out, "  flt.{suffix} t0, {a}, {b}").unwrap(),
+                    Ole | Ule => writeln!(out, "  fle.{suffix} t0, {a}, {b}").unwrap(),
+                    _ => unreachable!(),
+                }
+                if matches!(p, Ueq | Ugt | Uge | Ult | Ule) {
+                    writeln!(out, "  or t0, t0, t2").unwrap();
+                }
+                if p == One {
+                    writeln!(out, "  xori t2, t2, 1\n  and t0, t0, t2").unwrap();
+                }
+            }
+        }
+    }
+    fn fp_convert(
+        &mut self,
+        out: &mut String,
+        kind: FloatConvertOp,
+        value: &Operand,
+        to: TypeId,
+    ) -> Result<(), Diagnostic> {
+        use FloatConvertOp::*;
+        match kind {
+            Ext | Trunc => {
+                let from = self.fp_read(out, value, 0);
+                let target = format(self.module, to)?;
+                let a = self.fp_scratch(from, 0);
+                let b = self.fp_scratch(target, 0);
+                match self.target {
+                    Target::X86_64UnknownNone => writeln!(
+                        out,
+                        "  cvt{}2{} {b}, {a}",
+                        if from == FloatFormat::Float {
+                            "ss"
+                        } else {
+                            "sd"
+                        },
+                        if target == FloatFormat::Float {
+                            "ss"
+                        } else {
+                            "sd"
+                        }
+                    )
+                    .unwrap(),
+                    Target::Aarch64UnknownNone => writeln!(out, "  fcvt {b}, {a}").unwrap(),
+                    Target::Riscv64UnknownNone => writeln!(
+                        out,
+                        "  fcvt.{}.{} {b}, {a}{}",
+                        if target == FloatFormat::Float {
+                            "s"
+                        } else {
+                            "d"
+                        },
+                        if from == FloatFormat::Float { "s" } else { "d" },
+                        if kind == Trunc { ", rne" } else { "" }
+                    )
+                    .unwrap(),
+                }
+                self.fp_math_result(out, target);
+            }
+            FromSignedInt | FromUnsignedInt => {
+                let f = format(self.module, to)?;
+                let fp = self.fp_scratch(f, 0);
+                let bits = self.bits(value);
+                self.operand_leaf(out, 0, value, 0);
+                if kind == FromSignedInt {
+                    self.signed(out, 0, bits);
+                } else {
+                    self.mask(out, 0, bits);
+                }
+                match self.target {
+                    Target::X86_64UnknownNone => {
+                        let suffix = if f == FloatFormat::Float { "ss" } else { "sd" };
+                        if kind == FromUnsignedInt && bits == 64 {
+                            let low = self.label();
+                            let done = self.label();
+                            writeln!(out,"  test rax, rax\n  jns {low}\n  mov rcx, rax\n  and ecx, 1\n  shr rax, 1\n  or rax, rcx\n  cvtsi2{suffix} {fp}, rax\n  add{suffix} {fp}, {fp}\n  jmp {done}\n{low}:\n  cvtsi2{suffix} {fp}, rax\n{done}:").unwrap();
+                        } else {
+                            writeln!(out, "  cvtsi2{suffix} {fp}, rax").unwrap();
+                        }
+                    }
+                    Target::Aarch64UnknownNone => writeln!(
+                        out,
+                        "  {} {fp}, x9",
+                        if kind == FromSignedInt {
+                            "scvtf"
+                        } else {
+                            "ucvtf"
+                        }
+                    )
+                    .unwrap(),
+                    Target::Riscv64UnknownNone => writeln!(
+                        out,
+                        "  fcvt.{}.{} {fp}, t0, rne",
+                        if f == FloatFormat::Float { "s" } else { "d" },
+                        if kind == FromSignedInt { "l" } else { "lu" }
+                    )
+                    .unwrap(),
+                }
+                from_fp(out, self.target, self.reg(0), fp, f);
+            }
+            ToSignedInt | ToUnsignedInt => {
+                let f = self.fp_read(out, value, 0);
+                let fp = self.fp_scratch(f, 0);
+                let Type::Int { bits } = self.module.types[to] else {
+                    return Err(fail("FP-to-int result not integer"));
+                };
+                match self.target {
+                    Target::X86_64UnknownNone => {
+                        let suffix = if f == FloatFormat::Float { "ss" } else { "sd" };
+                        if kind == ToUnsignedInt && bits == 64 {
+                            let low = self.label();
+                            let done = self.label();
+                            self.immediate(
+                                out,
+                                1,
+                                if f == FloatFormat::Float {
+                                    0x5f000000
+                                } else {
+                                    0x43e0000000000000
+                                },
+                            );
+                            to_fp(out, self.target, "xmm15", "rcx", f);
+                            writeln!(out,"  ucomi{suffix} {fp}, xmm15\n  jb {low}\n  sub{suffix} {fp}, xmm15\n  cvtt{suffix}2si rax, {fp}\n  mov rcx, -9223372036854775808\n  or rax, rcx\n  jmp {done}\n{low}:\n  cvtt{suffix}2si rax, {fp}\n{done}:").unwrap();
+                        } else {
+                            writeln!(out, "  cvtt{suffix}2si rax, {fp}").unwrap();
+                        }
+                    }
+                    Target::Aarch64UnknownNone => writeln!(
+                        out,
+                        "  {} x9, {fp}",
+                        if kind == ToSignedInt {
+                            "fcvtzs"
+                        } else {
+                            "fcvtzu"
+                        }
+                    )
+                    .unwrap(),
+                    Target::Riscv64UnknownNone => writeln!(
+                        out,
+                        "  fcvt.{}.{} t0, {fp}, rtz",
+                        if kind == ToSignedInt { "l" } else { "lu" },
+                        if f == FloatFormat::Float { "s" } else { "d" }
+                    )
+                    .unwrap(),
+                }
+                self.mask(out, 0, bits.try_into().unwrap());
+            }
+        }
+        Ok(())
+    }
+}
