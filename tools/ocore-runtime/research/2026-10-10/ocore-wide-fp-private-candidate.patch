+#[test]
+fn every_scalar_width_matches_independent_bit_iteration_and_signed_mathematics() {
+    for bits in 1..=64 {
+        let full = mask(bits);
+        let sign = 1_u64 << (bits - 1);
+        let mut inputs = if bits <= 6 {
+            (0..=full).collect::<Vec<_>>()
+        } else {
+            vec![0, 1, 2, full, full - 1, sign, sign - 1, (sign + 1) & full]
+        };
+        for position in 0..bits {
+            inputs.push(1_u64 << position);
+            inputs.push(full ^ (1_u64 << position));
+        }
+        let mut noise = 0x6a09e667f3bcc909_u64 ^ u64::from(bits);
+        for _ in 0..8 {
+            noise = noise.wrapping_mul(0x9e3779b185ebca87).rotate_left(11);
+            inputs.push(noise & full);
+        }
+        inputs.sort_unstable();
+        inputs.dedup();
+        for (kind, _) in KINDS {
+            for poison in [false, true] {
+                let module = fixture(bits, kind, poison);
+                for &input in &inputs {
+                    assert_eq!(
+                        calculate(&module, input),
+                        BigUint::from(expected(kind, bits, input)),
+                        "{kind:?} i{bits}({input}) poison={poison}"
+                    );
+                }
+            }
+        }
+    }
+}
