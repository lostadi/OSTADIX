+    pub(crate) source_type: TypeId,
+    pub(crate) source_offset_bits: u32,
+    pub(crate) payload_bits: u8,
+    pub(crate) memory_offset: u64,
+}
+
+impl ValueBitPart {
+    pub fn source_type(&self) -> TypeId { self.source_type }
+    pub fn source_offset_bits(&self) -> u32 { self.source_offset_bits }
+    pub fn payload_bits(&self) -> u8 { self.payload_bits }
+    pub fn memory_offset_bytes(&self) -> u64 { self.memory_offset }
+    pub fn memory_bytes(&self) -> u8 { self.payload_bits.div_ceil(8) }
+    pub fn private_slot_bytes(&self) -> u8 { 8 }
+}
+
+pub type ValuePartLayouts = BTreeMap<TypeId, Vec<ValueBitPart>>;
+
+pub fn value_part_layouts(module: &NativeModule, types: &[TypeId]) -> Result<ValuePartLayouts, Diagnostic> {
+    if !module.target.little_endian {
+        return Err(error_diagnostic("source bit-part memory mapping requires explicit big-endian lowering"));
+    }
+    let source_leaves = value_leaf_layouts(module, types)?;
+    let mut result = BTreeMap::new();
+    for (ty, leaves) in source_leaves {
+        let mut parts = Vec::new();
+        for (source_type, base) in leaves {
+            let width = match module.types[source_type] {
+                Type::Int { bits } => bits,
+                Type::Float { format } => format.value_bits(),
+                Type::Pointer { address_space: 0 } => 64,
+                _ => return Err(error_diagnostic("unsupported scalar source leaf for private bit parts")),
+            };
+            let count = usize::try_from(u64::from(width).div_ceil(64))
+                .map_err(|_| error_diagnostic("private bit-part extent exceeds host address space"))?;
+            parts.try_reserve(count).map_err(|e| error_diagnostic(format!("private bit-part allocation failed: {e}")))?;
+            for index in 0..count {
+                let source_offset_bits = u32::try_from(index).ok().and_then(|n| n.checked_mul(64))
+                    .ok_or_else(|| error_diagnostic("source bit-part offset overflow"))?;
+                let payload_bits = (width - source_offset_bits).min(64) as u8;
+                let memory_offset = base.checked_add(u64::from(source_offset_bits / 8))
+                    .ok_or_else(|| error_diagnostic("source bit-part memory offset overflow"))?;
+                parts.push(ValueBitPart { source_type, source_offset_bits, payload_bits, memory_offset });
+            }
+        }
+        result.insert(ty, parts);
+    }
+    Ok(result)
+}
