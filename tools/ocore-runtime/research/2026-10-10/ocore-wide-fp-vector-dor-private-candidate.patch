+//! Exact original integer-vector intrinsic spellings and source signatures.
+use super::native_ir::{BinaryOp, IntegerMinMaxKind, NativeModule, Signature, Type, TypeId};
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum VectorIntrinsicKind {
+    Reduce(BinaryOp),
+    PopulationCount,
+    ByteSwap,
+    MinMax(IntegerMinMaxKind),
+    SignedPairMultiplyAdd,
+    UnsignedByteSad,
+    CarrylessMultiply,
+}
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct VectorIntrinsicContract {
+    pub kind: VectorIntrinsicKind,
+    pub lanes: u32,
