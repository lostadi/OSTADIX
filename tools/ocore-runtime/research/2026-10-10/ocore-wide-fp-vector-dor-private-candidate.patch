+                self.fi_sign(out, result, magnitude, Some(sign))?
+            }
+            Operation::FloatingClassTest { value, mask } => {
+                self.fi_class(out, value, *mask)?;
+                self.spill_leaf(out, result, 0);
+            }
+            Operation::FloatingSqrt { value } => {
+                let f = self.fp_read(out, value, 0);
+                let r = self.fp_scratch(f, 0);
+                match self.target {
+                    Target::X86_64UnknownNone => writeln!(
+                        out,
+                        "  sqrt{} {r}, {r}",
+                        if f == FloatFormat::Float { "ss" } else { "sd" }
+                    )
+                    .unwrap(),
+                    Target::Aarch64UnknownNone => writeln!(out, "  fsqrt {r}, {r}").unwrap(),
+                    Target::Riscv64UnknownNone => writeln!(
+                        out,
+                        "  fsqrt.{} {r}, {r}, rne",
+                        if f == FloatFormat::Float { "s" } else { "d" }
+                    )
+                    .unwrap(),
+                }
+                self.fp_math_result(out, f);
+                self.spill_leaf(out, result, 0);
+            }
+            Operation::FloatingMinMax { kind, lhs, rhs } => {
+                self.fi_minmax(out, result, *kind, lhs, rhs)?;
+                self.spill_leaf(out, result, 0);
+            }
+            Operation::FloatingSaturatingConvert { signed, value } => {
+                self.fi_saturate(out, result, *signed, value)?
+            }
+            _ => return Ok(false),
+        }
+        Ok(true)
+    }
+    fn fi_sign(
+        &self,
+        out: &mut String,
+        result: Value,
+        value: &Operand,
+        sign: Option<&Operand>,
+    ) -> Result<(), Diagnostic> {
+        let f = format(self.module, self.ty(value))?;
+        let bit = f.value_bits() - 1;
+        let sign_leaf = usize::try_from(bit / 64).unwrap();
+        for leaf in 0..self.leaf_layouts[&result.ty].len() {
+            self.operand_leaf(out, 0, value, leaf);
+            if leaf == sign_leaf {
+                self.fi_imm(out, 2, !(1u64 << (bit % 64)));
+                self.fi_bin(out, "and", 0, 0, 2);
+                if let Some(sign) = sign {
+                    self.operand_leaf(out, 1, sign, leaf);
+                    self.fi_imm(out, 2, 1u64 << (bit % 64));
+                    self.fi_bin(out, "and", 1, 1, 2);
+                    self.fi_bin(out, "or", 0, 0, 1);
+                }
+            }
+            self.spill_leaf(out, result, leaf);
+        }
+        Ok(())
+    }
+    fn fi_class(&mut self, out: &mut String, value: &Operand, mask: u16) -> Result<(), Diagnostic> {
+        let f = format(self.module, self.ty(value))?;
+        let (frac, exp) = ieee_fields(f).unwrap();
+        self.operand_leaf(out, 0, value, 0);
+        if f.value_bits() > 64 {
+            self.operand_leaf(out, 1, value, 1);
+        } else {
+            self.mov(out, self.fi_reg(1), self.fi_reg(0));
+        }
+        self.mov(out, self.fi_reg(2), self.fi_reg(1));
+        self.fi_shift(out, false, 2, frac % 64);
+        self.fi_imm(out, 3, low_mask(exp));
+        self.fi_bin(out, "and", 2, 2, 3);
+        if frac > 64 {
+            self.fi_imm(out, 3, low_mask(frac - 64));
+            self.fi_bin(out, "and", 3, 1, 3);
+            self.fi_bin(out, "or", 0, 0, 3);
+        } else {
+            self.fi_imm(out, 3, low_mask(frac));
+            self.fi_bin(out, "and", 0, 0, 3);
+        }
+        let zeroexp = self.label();
+        let maxexp = self.label();
+        let zero = self.label();
+        let sub = self.label();
+        let normal = self.label();
+        let inf = self.label();
+        let nan = self.label();
+        let qnan = self.label();
+        let done = self.label();
+        self.fi_zero_branch(out, 2, true, &zeroexp);
+        self.fi_imm(out, 3, low_mask(exp));
+        self.fi_branch(out, "eq", 2, 3, &maxexp);
+        self.fi_jump(out, &normal);
+        writeln!(out, "{zeroexp}:").unwrap();
+        self.fi_zero_branch(out, 0, true, &zero);
+        self.fi_jump(out, &sub);
+        writeln!(out, "{maxexp}:").unwrap();
+        self.fi_zero_branch(out, 0, true, &inf);
+        self.fi_jump(out, &nan);
+        for (label, negative, positive) in [
+            (&zero, 32, 64),
+            (&sub, 16, 128),
+            (&normal, 8, 256),
+            (&inf, 4, 512),
+        ] {
+            writeln!(out, "{label}:").unwrap();
+            self.mov(out, self.fi_reg(2), self.fi_reg(1));
+            self.fi_shift(out, false, 2, (f.value_bits() - 1) % 64);
+            self.fi_imm(out, 0, positive);
+            let positive_label = self.label();
+            self.fi_zero_branch(out, 2, true, &positive_label);
+            self.fi_imm(out, 0, negative);
+            writeln!(out, "{positive_label}:").unwrap();
+            self.fi_jump(out, &done);
+        }
+        writeln!(out, "{nan}:").unwrap();
+        self.fi_imm(out, 3, 1u64 << ((frac - 1) % 64));
+        self.fi_bin(out, "and", 2, 1, 3);
+        self.fi_zero_branch(out, 2, false, &qnan);
+        self.fi_imm(out, 0, 1);
+        self.fi_jump(out, &done);
+        writeln!(out, "{qnan}:").unwrap();
+        self.fi_imm(out, 0, 2);
+        writeln!(out, "{done}:").unwrap();
+        self.fi_imm(out, 1, u64::from(mask));
+        self.fi_bin(out, "and", 0, 0, 1);
+        let false_label = self.label();
+        self.fi_zero_branch(out, 0, true, &false_label);
+        self.fi_imm(out, 0, 1);
+        writeln!(out, "{false_label}:").unwrap();
+        Ok(())
+    }
+    fn fi_minmax(
+        &mut self,
+        out: &mut String,
+        result: Value,
+        kind: FloatMinMaxKind,
+        lhs: &Operand,
+        rhs: &Operand,
+    ) -> Result<(), Diagnostic> {
+        let f = format(self.module, self.ty(lhs))?;
+        let (frac, exp) = ieee_fields(f).unwrap();
+        let width = f.value_bits();
+        let sign = 1u64 << (width - 1);
+        let infinity = low_mask(exp) << frac;
+        let quiet = 1u64 << (frac - 1);
+        self.operand_leaf(out, 0, lhs, 0);
+        self.operand_leaf(out, 1, rhs, 0);
+        self.stack_store(out, 0, self.slots[&result.id]);
+        to_fp(out, self.target, self.fp_scratch(f, 1), self.fi_reg(1), f);
+        let lhs_nan = self.label();
+        let rhs_nan = self.label();
+        let rhs_number = self.label();
+        let left = self.label();
+        let right = self.label();
+        let nan = self.label();
+        let numeric = self.label();
+        let done = self.label();
+        self.fi_imm(out, 2, sign - 1);
+        self.fi_bin(out, "and", 3, 0, 2);
+        self.fi_imm(out, 2, infinity);
+        self.fi_branch(out, "gt", 3, 2, &lhs_nan);
+        self.fi_imm(out, 2, sign - 1);
+        self.fi_bin(out, "and", 3, 1, 2);
+        self.fi_imm(out, 2, infinity);
+        self.fi_branch(out, "gt", 3, 2, &rhs_nan);
+        self.fi_jump(out, &numeric);
+        writeln!(out, "{lhs_nan}:").unwrap();
+        if matches!(kind, FloatMinMaxKind::Minimum | FloatMinMaxKind::Maximum) {
+            self.fi_jump(out, &nan);
+        } else {
+            if matches!(kind, FloatMinMaxKind::MinNum | FloatMinMaxKind::MaxNum) {
+                self.fi_imm(out, 2, quiet);
+                self.fi_bin(out, "and", 3, 0, 2);
+                self.fi_zero_branch(out, 3, true, &nan);
+            }
+            self.fi_imm(out, 2, sign - 1);
+            self.fi_bin(out, "and", 3, 1, 2);
+            self.fi_imm(out, 2, infinity);
+            self.fi_branch(out, "le", 3, 2, &rhs_number);
+            self.fi_jump(out, &nan);
+        }
+        writeln!(out, "{rhs_nan}:").unwrap();
+        if matches!(kind, FloatMinMaxKind::Minimum | FloatMinMaxKind::Maximum) {
+            self.fi_jump(out, &nan);
+        } else {
+            if matches!(kind, FloatMinMaxKind::MinNum | FloatMinMaxKind::MaxNum) {
+                self.fi_imm(out, 2, quiet);
+                self.fi_bin(out, "and", 3, 1, 2);
+                self.fi_zero_branch(out, 3, true, &nan);
+            }
+            self.fi_jump(out, &left);
+        }
+        writeln!(out, "{rhs_number}:").unwrap();
+        self.fi_jump(out, &right);
+        writeln!(out, "{numeric}:").unwrap();
+        // Total ordered integer keys preserve exact numeric bits and choose
+        // -0 below +0, the source ordering for every family, also valid with nsz.
+        self.mov(out, self.fi_reg(2), self.fi_reg(0));
+        self.fi_shift(out, false, 2, width - 1);
+        self.fi_negate(out, 2);
+        self.fi_imm(out, 3, sign);
+        self.fi_bin(out, "or", 2, 2, 3);
+        self.fi_bin(out, "xor", 0, 0, 2);
+        self.mask(out, 0, width as u16);
+        self.mov(out, self.fi_reg(3), self.fi_reg(1));
+        self.mov(out, self.fi_reg(2), self.fi_reg(3));
+        self.fi_shift(out, false, 2, width - 1);
+        self.fi_negate(out, 2);
+        self.fi_imm(out, 1, sign);
+        self.fi_bin(out, "or", 2, 2, 1);
+        self.fi_bin(out, "xor", 3, 3, 2);
+        if width < 64 {
+            self.fi_imm(out, 1, low_mask(width));
+            self.fi_bin(out, "and", 3, 3, 1);
+        }
+        self.fi_branch(
+            out,
+            if matches!(
+                kind,
+                FloatMinMaxKind::MinNum | FloatMinMaxKind::Minimum | FloatMinMaxKind::MinimumNum
+            ) {
+                "le"
+            } else {
+                "ge"
+            },
+            0,
+            3,
+            &left,
+        );
+        self.fi_jump(out, &right);
+        writeln!(out, "{left}:").unwrap();
+        self.stack_load(out, 0, self.slots[&result.id]);
+        self.fi_jump(out, &done);
+        writeln!(out, "{right}:").unwrap();
+        from_fp(out, self.target, self.fi_reg(0), self.fp_scratch(f, 1), f);
+        self.fi_jump(out, &done);
+        writeln!(out, "{nan}:").unwrap();
+        self.fi_imm(out, 0, infinity | quiet);
+        writeln!(out, "{done}:").unwrap();
+        Ok(())
+    }
+    fn fi_saturate(
+        &mut self,
+        out: &mut String,
+        result: Value,
+        signed: bool,
+        value: &Operand,
+    ) -> Result<(), Diagnostic> {
+        let f = format(self.module, self.ty(value))?;
+        let (frac, exp) = ieee_fields(f).unwrap();
+        let width = f.value_bits();
+        let Type::Int { bits: n } = self.module.types[result.ty] else {
+            unreachable!()
+        };
+        let bias = (1u32 << (exp - 1)) - 1;
+        let zero = self.label();
+        let clamp = self.label();
+        let finite = self.label();
+        let right = self.label();
+        let left = self.label();
+        let wide = self.label();
+        let shift_zero = self.label();
+        let magnitude = self.label();
+        let negative = self.label();
+        let positive = self.label();
+        let done = self.label();
+        self.operand_leaf(out, 0, value, 0);
+        self.stack_store(out, 0, self.slots[&result.id]);
+        self.mov(out, self.fi_reg(2), self.fi_reg(0));
+        self.fi_shift(out, false, 2, frac);
+        self.fi_imm(out, 3, low_mask(exp));
+        self.fi_bin(out, "and", 2, 2, 3);
+        self.fi_imm(out, 3, low_mask(exp));
+        self.fi_branch(out, "ne", 2, 3, &finite);
+        self.fi_imm(out, 3, low_mask(frac));
+        self.fi_bin(out, "and", 1, 0, 3);
+        self.fi_zero_branch(out, 1, false, &zero);
+        self.fi_jump(out, &clamp);
+        writeln!(out, "{finite}:").unwrap();
+        if !signed {
+            self.mov(out, self.fi_reg(1), self.fi_reg(0));
+            self.fi_shift(out, false, 1, width - 1);
+            self.fi_zero_branch(out, 1, false, &zero);
+        }
+        self.fi_imm(out, 3, u64::from(bias));
+        self.fi_branch(out, "lt", 2, 3, &zero);
+        self.fi_imm(out, 3, u64::from(bias + n - u32::from(signed)));
+        self.fi_branch(out, "ge", 2, 3, &clamp);
+        self.fi_imm(out, 3, u64::from(bias));
+        self.fi_bin(out, "sub", 2, 2, 3);
+        self.fi_imm(out, 3, low_mask(frac));
+        self.fi_bin(out, "and", 0, 0, 3);
+        self.fi_imm(out, 3, 1u64 << frac);
+        self.fi_bin(out, "or", 0, 0, 3);
+        self.fi_imm(out, 3, u64::from(frac));
+        self.fi_branch(out, "le", 2, 3, &right);
+        self.fi_jump(out, &left);
+        writeln!(out, "{right}:").unwrap();
+        self.fi_imm(out, 1, u64::from(frac));
+        self.fi_bin(out, "sub", 1, 1, 2);
+        self.fi_variable_shift(out, false, 0);
+        self.fi_imm(out, 1, 0);
+        self.fi_jump(out, &magnitude);
+        writeln!(out, "{left}:").unwrap();
+        self.fi_imm(out, 1, u64::from(frac));
+        self.fi_bin(out, "sub", 2, 2, 1);
+        self.fi_zero_branch(out, 2, true, &shift_zero);
+        self.fi_imm(out, 3, 64);
+        self.fi_branch(out, "ge", 2, 3, &wide);
+        self.mov(out, self.fi_reg(3), self.fi_reg(0));
+        self.mov(out, self.fi_reg(1), self.fi_reg(2));
+        self.fi_variable_shift(out, true, 0);
+        self.fi_imm(out, 1, 64);
+        self.fi_bin(out, "sub", 1, 1, 2);
+        self.fi_variable_shift(out, false, 3);
+        self.mov(out, self.fi_reg(1), self.fi_reg(3));
+        self.fi_jump(out, &magnitude);
+        writeln!(out, "{wide}:").unwrap();
+        self.fi_imm(out, 1, 64);
+        self.fi_bin(out, "sub", 2, 2, 1);
+        self.mov(out, self.fi_reg(1), self.fi_reg(2));
+        self.fi_variable_shift(out, true, 0);
+        self.mov(out, self.fi_reg(1), self.fi_reg(0));
+        self.fi_imm(out, 0, 0);
+        self.fi_jump(out, &magnitude);
+        writeln!(out, "{shift_zero}:").unwrap();
+        self.fi_imm(out, 1, 0);
+        self.fi_jump(out, &magnitude);
+        writeln!(out, "{clamp}:").unwrap();
+        self.stack_load(out, 2, self.slots[&result.id]);
+        self.fi_shift(out, false, 2, width - 1);
+        self.fi_zero_branch(out, 2, false, &negative);
+        // Positive overflow, including +infinity.
+        self.fi_imm(out, 0, low_mask((n - u32::from(signed)).min(64)));
+        self.fi_imm(
+            out,
+            1,
+            if n - u32::from(signed) > 64 {
+                low_mask(n - u32::from(signed) - 64)
+            } else {
+                0
+            },
+        );
+        self.fi_jump(out, &done);
+        writeln!(out, "{negative}:").unwrap();
+        if signed {
+            self.fi_imm(out, 0, if n <= 64 { 1u64 << (n - 1) } else { 0 });
+            self.fi_imm(out, 1, if n > 64 { 1u64 << (n - 65) } else { 0 });
+        } else {
+            self.fi_imm(out, 0, 0);
+            self.fi_imm(out, 1, 0);
+        }
+        self.fi_jump(out, &done);
+        writeln!(out, "{magnitude}:").unwrap();
+        if signed {
+            self.stack_load(out, 2, self.slots[&result.id]);
+            self.fi_shift(out, false, 2, width - 1);
+            self.fi_zero_branch(out, 2, true, &positive);
+            self.fi_negate(out, 0);
+            self.fi_not(out, 1);
+            self.fi_zero_branch(out, 0, false, &positive);
+            self.fi_imm(out, 2, 1);
+            self.fi_bin(out, "add", 1, 1, 2);
+            writeln!(out, "{positive}:").unwrap();
+        }
+        self.fi_jump(out, &done);
+        writeln!(out, "{zero}:").unwrap();
+        self.fi_imm(out, 0, 0);
+        self.fi_imm(out, 1, 0);
+        writeln!(out, "{done}:").unwrap();
+        self.spill_leaf(out, result, 0);
+        if n > 64 {
+            self.mov(out, self.fi_reg(0), self.fi_reg(1));
+            self.spill_leaf(out, result, 1);
+        }
+        Ok(())
+    }
+}
