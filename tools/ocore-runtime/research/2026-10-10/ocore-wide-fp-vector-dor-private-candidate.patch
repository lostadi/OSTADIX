+        let ty = match lhs {
+            Operand::Value { id } => values[id],
+            _ => constant_type(lhs).unwrap(),
+        };
+        if matches!(module.types[ty], Type::Int { bits: 65.. }) {
+            return Err(error_diagnostic(
+                "wide signed division requires its separate source-owned native realization",
+            ));
+        }
+    }
+    Ok(())
