+//! Native legalization of source-owned integer bit parts. No foreign helper,
+//! handwritten runtime replacement or altered public function type is used.
+//! Original LLVM poison may be refined to deterministic bits by this existing
+//! nonoptimizing execution profile. Undefined unsigned division by zero is a
+//! separate source boundary, not a trap or a claim of defined behavior.
+use super::*;
+
+#[derive(Clone, Copy)]
+pub(super) enum Words<'a> {
+    Operand(&'a Operand),
+    OperandAt(&'a Operand, usize),
+    Slot(i64),
+}
+
+impl Emitter<'_> {
+    pub(super) fn integer_width(&self, ty: TypeId) -> Option<u32> {
+        match self.module.types[ty] {
+            Type::Int { bits } => Some(bits),
+            Type::Pointer { address_space: 0 } => Some(64),
+            _ => None,
+        }
+    }
+
+    pub(super) fn wide_count(bits: u32) -> usize {
+        bits.div_ceil(64) as usize
+    }
+    pub(super) fn wide_tail(bits: u32) -> u16 {
+        ((bits - 1) % 64 + 1) as u16
+    }
+    pub(super) fn wide_temp(&self, array: usize) -> i64 {
+        self.wide_workspace + (array * self.wide_words * 8) as i64
+    }
+    pub(super) fn wide_scalar(&self, index: usize) -> i64 {
+        self.wide_workspace + ((4 * self.wide_words + index) * 8) as i64
+    }
+    pub(super) fn wide_read(&self, out: &mut String, reg: usize, words: Words<'_>, index: usize) {
+        match words {
+            Words::Operand(value) => self.operand_leaf(out, reg, value, index),
+            Words::OperandAt(value, first) => self.operand_leaf(out, reg, value, first + index),
+            Words::Slot(base) => self.stack_load(out, reg, base + (index * 8) as i64),
+        }
+    }
+    pub(super) fn wide_write(&self, out: &mut String, base: i64, index: usize, bits: u32) {
+        if index + 1 == Self::wide_count(bits) {
+            self.mask(out, 0, Self::wide_tail(bits));
+        }
+        self.stack_store(out, 0, base + (index * 8) as i64);
+    }
+    pub(super) fn wide_copy(&self, out: &mut String, source: Words<'_>, base: i64, bits: u32) {
+        for index in 0..Self::wide_count(bits) {
+            self.wide_read(out, 0, source, index);
+            self.wide_write(out, base, index, bits);
+        }
+    }
+    pub(super) fn wide_zero(&self, out: &mut String, base: i64, bits: u32) {
+        self.immediate(out, 0, 0);
+        for index in 0..Self::wide_count(bits) {
+            self.stack_store(out, 0, base + (index * 8) as i64);
+        }
+    }
+    pub(super) fn wide_imm_shift(
+        &self,
+        out: &mut String,
+        reg: usize,
+        count: u16,
+        right: bool,
+        signed: bool,
+    ) {
+        if count == 0 {
+            return;
+        }
+        let r = self.reg(reg);
+        match self.target {
+            Target::X86_64UnknownNone => writeln!(
+                out,
+                "  {} {r}, {count}",
+                if !right {
+                    "shl"
+                } else if signed {
+                    "sar"
+                } else {
+                    "shr"
+                }
+            )
+            .unwrap(),
+            Target::Aarch64UnknownNone => writeln!(
+                out,
+                "  {} {r}, {r}, #{count}",
+                if !right {
+                    "lsl"
+                } else if signed {
+                    "asr"
+                } else {
+                    "lsr"
+                }
+            )
+            .unwrap(),
+            Target::Riscv64UnknownNone => writeln!(
+                out,
+                "  {} {r}, {r}, {count}",
+                if !right {
+                    "slli"
+                } else if signed {
+                    "srai"
+                } else {
+                    "srli"
+                }
+            )
+            .unwrap(),
+        }
+    }
+    pub(super) fn wide_or(&self, out: &mut String) {
+        self.simple_binary(
+            out,
+            if self.target == Target::Aarch64UnknownNone {
+                "orr"
+            } else {
+                "or"
+            },
+        );
+    }
+
+    // Produce arithmetic carry/borrow in scratch2 immediately. Stack-address
+    // helpers may clobber machine flags, so no flag is carried across a load.
+    fn wide_word_arithmetic(&self, out: &mut String, subtract: bool) {
+        match self.target {
+            Target::X86_64UnknownNone => writeln!(
+                out,
+                "  {} rax, rcx\n  setb dl\n  movzx edx, dl",
+                if subtract { "sub" } else { "add" }
+            )
+            .unwrap(),
+            Target::Aarch64UnknownNone => writeln!(
+                out,
+                "  {} x9, x9, x10\n  cset x11, {}",
+                if subtract { "subs" } else { "adds" },
+                if subtract { "cc" } else { "cs" }
+            )
+            .unwrap(),
+            Target::Riscv64UnknownNone if subtract => {
+                out.push_str("  sltu t2, t0, t1\n  sub t0, t0, t1\n")
+            }
+            Target::Riscv64UnknownNone => out.push_str("  add t0, t0, t1\n  sltu t2, t0, t1\n"),
+        }
+    }
+    pub(super) fn wide_add(
+        &self,
+        out: &mut String,
+        destination: i64,
+        lhs: Words<'_>,
+        rhs: Words<'_>,
+        bits: u32,
+        subtract: bool,
+    ) {
+        self.immediate(out, 2, 0);
+        self.stack_store(out, 2, self.wide_scalar(0));
+        for index in 0..Self::wide_count(bits) {
+            self.wide_read(out, 0, lhs, index);
+            self.wide_read(out, 1, rhs, index);
+            self.wide_word_arithmetic(out, subtract);
+            self.stack_store(out, 2, self.wide_scalar(1));
+            self.stack_load(out, 1, self.wide_scalar(0));
+            self.wide_word_arithmetic(out, subtract);
+            self.stack_load(out, 1, self.wide_scalar(1));
+            match self.target {
+                Target::X86_64UnknownNone => out.push_str("  or rdx, rcx\n"),
+                Target::Aarch64UnknownNone => out.push_str("  orr x11, x11, x10\n"),
+                Target::Riscv64UnknownNone => out.push_str("  or t2, t2, t1\n"),
+            }
+            self.stack_store(out, 2, self.wide_scalar(0));
+            self.wide_write(out, destination, index, bits);
+        }
+    }
+
+    fn wide_shift_one(
+        &self,
+        out: &mut String,
+        base: i64,
+        bits: u32,
+        right: bool,
+        arithmetic: bool,
+    ) {
+        let count = Self::wide_count(bits);
+        self.immediate(out, 2, 0);
+        self.stack_store(out, 2, self.wide_scalar(0));
+        for ordinal in 0..count {
+            let index = if right { count - ordinal - 1 } else { ordinal };
+            self.stack_load(out, 0, base + (index * 8) as i64);
+            if right && arithmetic && ordinal == 0 {
+                self.signed(out, 0, Self::wide_tail(bits));
+            }
+            self.mov(out, self.reg(2), self.reg(0));
+            if right {
+                self.mask(out, 2, 1);
+                self.wide_imm_shift(out, 2, 63, false, false);
+            } else {
+                self.wide_imm_shift(out, 2, 63, true, false);
+            }
+            self.wide_imm_shift(out, 0, 1, right, right && arithmetic && ordinal == 0);
+            self.stack_load(out, 1, self.wide_scalar(0));
+            self.wide_or(out);
+            self.wide_write(out, base, index, bits);
+            self.stack_store(out, 2, self.wide_scalar(0));
+        }
+    }
+
+    // scratch0 and scratch1 contain source words. Result is scratch2, while
+    // preserving both source registers; signed is used only for the top part.
+    fn wide_word_condition(&self, out: &mut String, equality: bool, signed: bool) {
+        match self.target {
+            Target::X86_64UnknownNone => writeln!(
+                out,
+                "  cmp rax, rcx\n  set{} dl\n  movzx edx, dl",
+                if equality {
+                    "e"
+                } else if signed {
+                    "l"
+                } else {
+                    "b"
+                }
+            )
+            .unwrap(),
+            Target::Aarch64UnknownNone => writeln!(
+                out,
+                "  cmp x9, x10\n  cset x11, {}",
+                if equality {
+                    "eq"
+                } else if signed {
+                    "lt"
+                } else {
+                    "lo"
+                }
+            )
+            .unwrap(),
+            Target::Riscv64UnknownNone if equality => {
+                out.push_str("  xor t2, t0, t1\n  seqz t2, t2\n")
+            }
+            Target::Riscv64UnknownNone => {
+                writeln!(out, "  {} t2, t0, t1", if signed { "slt" } else { "sltu" }).unwrap()
+            }
+        }
+    }
+    pub(super) fn wide_compare_words(
+        &mut self,
+        out: &mut String,
+        predicate: IntPredicate,
+        lhs: Words<'_>,
+        rhs: Words<'_>,
+        bits: u32,
+    ) {
+        let yes = self.label();
+        let no = self.label();
+        let done = self.label();
+        let signed = matches!(
+            predicate,
+            IntPredicate::Slt | IntPredicate::Sle | IntPredicate::Sgt | IntPredicate::Sge
+        );
+        let less = matches!(
+            predicate,
+            IntPredicate::Ne
+                | IntPredicate::Ult
+                | IntPredicate::Ule
+                | IntPredicate::Slt
+                | IntPredicate::Sle
+        );
+        let greater = matches!(
+            predicate,
+            IntPredicate::Ne
+                | IntPredicate::Ugt
+                | IntPredicate::Uge
+                | IntPredicate::Sgt
+                | IntPredicate::Sge
+        );
+        let equal = matches!(
+            predicate,
+            IntPredicate::Eq
+                | IntPredicate::Ule
+                | IntPredicate::Uge
+                | IntPredicate::Sle
+                | IntPredicate::Sge
+        );
+        for index in (0..Self::wide_count(bits)).rev() {
+            self.wide_read(out, 0, lhs, index);
+            self.wide_read(out, 1, rhs, index);
+            let top_signed = signed && index + 1 == Self::wide_count(bits);
+            if top_signed {
+                self.signed(out, 0, Self::wide_tail(bits));
+                self.signed(out, 1, Self::wide_tail(bits));
+            }
+            self.wide_word_condition(out, false, top_signed);
+            self.zero_jump(out, 2, if less { &yes } else { &no }, false);
+            self.wide_word_condition(out, true, false);
+            self.zero_jump(out, 2, if greater { &yes } else { &no }, true);
+        }
+        self.jump(out, if equal { &yes } else { &no });
+        writeln!(out, "{yes}:").unwrap();
+        self.immediate(out, 0, 1);
+        self.jump(out, &done);
+        writeln!(out, "{no}:").unwrap();
+        self.immediate(out, 0, 0);
+        writeln!(out, "{done}:").unwrap();
+    }
+    pub(super) fn wide_compare(
+        &mut self,
+        out: &mut String,
+        predicate: IntPredicate,
+        lhs: &Operand,
+        rhs: &Operand,
+    ) {
+        let bits = self.integer_width(self.ty(lhs)).unwrap();
+        self.wide_compare_words(
+            out,
+            predicate,
+            Words::Operand(lhs),
+            Words::Operand(rhs),
+            bits,
+        );
+    }
+
+    fn wide_loop_tail(&self, out: &mut String, loop_label: &str, done: &str) {
+        self.stack_load(out, 0, self.wide_scalar(3));
+        self.immediate(out, 1, 1);
+        self.simple_binary(out, "sub");
+        self.stack_store(out, 0, self.wide_scalar(3));
+        self.zero_jump(out, 0, done, true);
+        self.jump(out, loop_label);
+    }
+    pub(super) fn wide_multiply(
+        &mut self,
+        out: &mut String,
+        lhs: Words<'_>,
+        rhs: Words<'_>,
+        destination: i64,
+        bits: u32,
+    ) {
+        let a = self.wide_temp(0);
+        let b = self.wide_temp(1);
+        self.wide_copy(out, lhs, a, bits);
+        self.wide_copy(out, rhs, b, bits);
+        self.wide_zero(out, destination, bits);
+        self.immediate(out, 0, u64::from(bits));
+        self.stack_store(out, 0, self.wide_scalar(3));
+        let again = self.label();
+        let skip = self.label();
+        let done = self.label();
+        writeln!(out, "{again}:").unwrap();
+        self.stack_load(out, 0, b);
+        self.mask(out, 0, 1);
+        self.zero_jump(out, 0, &skip, true);
+        self.wide_add(
+            out,
+            destination,
+            Words::Slot(destination),
+            Words::Slot(a),
+            bits,
+            false,
+        );
+        writeln!(out, "{skip}:").unwrap();
+        self.wide_shift_one(out, a, bits, false, false);
+        self.wide_shift_one(out, b, bits, true, false);
+        self.wide_loop_tail(out, &again, &done);
+        writeln!(out, "{done}:").unwrap();
+    }
+    pub(super) fn wide_division(
+        &mut self,
+        out: &mut String,
+        lhs: Words<'_>,
+        rhs: Words<'_>,
+        destination: i64,
+        bits: u32,
+        remainder: bool,
+    ) {
+        let a = self.wide_temp(0);
+        let b = self.wide_temp(1);
+        let r = self.wide_temp(2);
+        self.wide_copy(out, lhs, a, bits);
+        self.wide_copy(out, rhs, b, bits);
+        self.wide_zero(out, destination, bits);
+        self.wide_zero(out, r, bits);
+        let done = self.label();
+        let again = self.label();
+        let skip = self.label();
+        self.immediate(out, 0, 0);
+        for index in 0..Self::wide_count(bits) {
+            self.stack_load(out, 1, b + (index * 8) as i64);
+            self.wide_or(out);
+        }
+        // Source unsigned division/remainder by zero is UB. Deterministic zero
+        // here does not make that source case defined and inserts no trap.
+        self.zero_jump(out, 0, &done, true);
+        self.immediate(out, 0, u64::from(bits));
+        self.stack_store(out, 0, self.wide_scalar(3));
+        writeln!(out, "{again}:").unwrap();
+        self.stack_load(out, 0, a + ((Self::wide_count(bits) - 1) * 8) as i64);
+        self.wide_imm_shift(out, 0, Self::wide_tail(bits) - 1, true, false);
+        self.mask(out, 0, 1);
+        self.stack_store(out, 0, self.wide_scalar(4));
+        self.wide_shift_one(out, a, bits, false, false);
+        self.wide_shift_one(out, r, bits, false, false);
+        self.stack_load(out, 0, r);
+        self.stack_load(out, 1, self.wide_scalar(4));
+        self.wide_or(out);
+        self.stack_store(out, 0, r);
+        self.wide_shift_one(out, destination, bits, false, false);
+        // In this same-width n-bit recurrence no extra remainder carry occurs
+        // before the final input bit; all source bits still participate.
+        self.wide_compare_words(out, IntPredicate::Uge, Words::Slot(r), Words::Slot(b), bits);
+        self.zero_jump(out, 0, &skip, true);
+        self.wide_add(out, r, Words::Slot(r), Words::Slot(b), bits, true);
+        self.stack_load(out, 0, destination);
+        self.immediate(out, 1, 1);
+        self.wide_or(out);
+        self.stack_store(out, 0, destination);
+        writeln!(out, "{skip}:").unwrap();
+        self.wide_loop_tail(out, &again, &done);
+        writeln!(out, "{done}:").unwrap();
+        if remainder {
+            self.wide_copy(out, Words::Slot(r), destination, bits);
+        }
+    }
+    pub(super) fn wide_shift(
+        &mut self,
+        out: &mut String,
+        kind: BinaryOp,
+        lhs: Words<'_>,
+        rhs: Words<'_>,
+        destination: i64,
+        bits: u32,
+    ) {
+        let poison = self.label();
+        let done = self.label();
+        let again = self.label();
+        // Inspect every typed amount word before narrowing it to a loop count.
+        for index in 1..Self::wide_count(bits) {
+            self.wide_read(out, 0, rhs, index);
+            self.zero_jump(out, 0, &poison, false);
+        }
+        self.wide_read(out, 0, rhs, 0);
+        self.immediate(out, 1, u64::from(bits));
+        self.wide_word_condition(out, false, false);
+        self.zero_jump(out, 2, &poison, true);
+        self.stack_store(out, 0, self.wide_scalar(3));
