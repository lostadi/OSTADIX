+                    && self.integer_width(instruction.result.unwrap().ty).is_some()
+                    && (self.integer_width(self.ty(value)).unwrap() > 64
+                        || self.integer_width(instruction.result.unwrap().ty).unwrap() > 64) =>
+            {
+                self.wide_cast(out, *kind, value, instruction.result.unwrap());
+                Ok(true)
+            }
+            _ => Ok(false),
+        }
