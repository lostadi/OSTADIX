+//! LLVM-owned scalar FP intrinsics. Transport and classification operate on
+//! original APFloat bits; numerical operations have an explicit FP profile.
+use super::*;
+
+fn ieee_fields(f: FloatFormat) -> Option<(u32, u32)> {
+    match f {
+        FloatFormat::Half => Some((10, 5)),
+        FloatFormat::BFloat => Some((7, 8)),
+        FloatFormat::Float => Some((23, 8)),
+        FloatFormat::Double => Some((52, 11)),
+        FloatFormat::Fp128 => Some((112, 15)),
+        _ => None,
+    }
+}
+fn low_mask(bits: u32) -> u64 {
+    if bits == 64 {
+        u64::MAX
+    } else {
+        (1u64 << bits) - 1
+    }
+}
+pub(super) fn audit_intrinsic(
+    module: &NativeModule,
+    i: &Instruction,
+    types: &BTreeMap<ValueId, TypeId>,
+) -> Result<bool, Diagnostic> {
+    let operand_format = |v: &Operand| format(module, operand_type(types, v));
+    match &i.operation {
+        Operation::FloatingAbs { value } | Operation::FloatingNegate { value } => {
+            if operand_format(value)? == FloatFormat::PpcFp128 {
+                return Err(fail(
+                    "PPC double-double fabs requires exact source-owned two-component realization",
+                ));
+            }
+        }
+        Operation::FloatingCopySign { magnitude, .. } => {
+            if operand_format(magnitude)? == FloatFormat::PpcFp128 {
+                return Err(fail("PPC double-double copysign requires exact source-owned two-component realization"));
+            }
+        }
+        Operation::FloatingClassTest { value, .. } => {
+            if ieee_fields(operand_format(value)?).is_none() {
+                return Err(fail(
+                    "fpclass requires exact x87/PPC encoding realization for this source format",
+                ));
+            }
+        }
+        Operation::FloatingSqrt { value } | Operation::FloatingMinMax { lhs: value, .. } => {
+            if operand_format(value)?.native_scalar_bits().is_none() {
+                return Err(fail(
+                    "numerical FP intrinsic requires source-owned helper for this original format",
+                ));
+            }
+            if module.target.fp_profile != Some(FloatingPointProfile::IeeeDefaultV1) {
+                return Err(fail(
+                    "numerical FP intrinsic requires explicit ieee-default-v1 FP profile",
+                ));
+            }
+            if i.fp.strict {
+                return Err(fail("strict numerical FP intrinsic requires explicit exception/environment realization"));
+            }
+        }
+        Operation::FloatingSaturatingConvert { value, .. } => {
+            let f = operand_format(value)?;
+            if ieee_fields(f).is_none() || f.value_bits() > 64 {
+                return Err(fail("saturating conversion requires source-owned legalization for this original FP format"));
+            }
+            if !matches!(
+                module.types[i.result.unwrap().ty],
+                Type::Int { bits: 1..=128 }
+            ) {
+                return Err(fail("saturating conversion result exceeds implemented exact integer bit-part realization"));
+            }
+            // Saturation is integer classification of the source bits. It has
+            // no rounding-mode dependence and raises no FP exception.
+        }
+        _ => return Ok(false),
+    }
+    Ok(true)
+}
