+//! Private realization words of original source values. Scalar/lane identity,
+//! logical bit offsets, packed memory bit offsets and private slots are distinct.
+//! No vector type is substituted with an array or rounded integer source type.
+use std::collections::BTreeMap;
+
+use super::native_ir::{error_diagnostic, NativeModule, Type, TypeId};
+use super::native_verify::value_leaf_layouts;
+use super::Diagnostic;
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct ValueBitPart {
+    pub(crate) source_type: TypeId,
+    pub(crate) source_offset_bits: u32,
+    pub(crate) payload_bits: u8,
+    pub(crate) memory_offset: u64,
+    /// Bit within memory_offset's byte. Vector i1/i7/i65 lanes pack tightly.
+    pub(crate) memory_bit_offset: u8,
+    pub(crate) vector_lane: Option<u32>,
+}
+impl ValueBitPart {
+    pub fn source_type(&self) -> TypeId {
+        self.source_type
+    }
+    pub fn source_offset_bits(&self) -> u32 {
+        self.source_offset_bits
+    }
+    pub fn payload_bits(&self) -> u8 {
+        self.payload_bits
+    }
+    pub fn memory_offset_bytes(&self) -> u64 {
+        self.memory_offset
+    }
+    pub fn memory_bit_offset(&self) -> u8 {
+        self.memory_bit_offset
+    }
+    pub fn vector_lane(&self) -> Option<u32> {
+        self.vector_lane
+    }
+    pub fn memory_bytes(&self) -> u8 {
+        self.payload_bits.div_ceil(8)
+    }
+    pub fn private_slot_bytes(&self) -> u8 {
+        8
+    }
+}
+pub type ValuePartLayouts = BTreeMap<TypeId, Vec<ValueBitPart>>;
+fn width(module: &NativeModule, source_type: TypeId) -> Result<u32, Diagnostic> {
+    match module.types[source_type] {
+        Type::Int { bits } => Ok(bits),
+        Type::Float { format } => Ok(format.value_bits()),
+        Type::Pointer { address_space: 0 } => Ok(64),
+        _ => Err(error_diagnostic(
+            "unsupported original scalar source leaf for private bit parts",
+        )),
+    }
+}
+pub fn value_part_layouts(
+    module: &NativeModule,
+    types: &[TypeId],
+) -> Result<ValuePartLayouts, Diagnostic> {
+    if !module.target.little_endian {
+        return Err(error_diagnostic(
+            "source bit-part memory mapping requires explicit big-endian lowering",
+        ));
+    }
+    let source_leaves = value_leaf_layouts(module, types)?;
+    let mut result = BTreeMap::new();
+    for (ty, leaves) in source_leaves {
+        let mut parts = Vec::new();
+        for (leaf_type, base) in leaves {
+            let (source_type, lanes, vector) = match module.types[leaf_type] {
+                Type::Vector {
+                    element,
+                    lanes,
+                    scalable: false,
+                } => (element, lanes, true),
+                Type::Vector { scalable: true, .. } => {
+                    return Err(error_diagnostic(
+                        "scalable vector private parts are unsupported",
+                    ))
+                }
+                _ => (leaf_type, 1, false),
+            };
+            let bits = width(module, source_type)?;
+            let count = usize::try_from(u64::from(bits).div_ceil(64)).map_err(|_| {
+                error_diagnostic("private bit-part extent exceeds host address space")
+            })?;
+            let total = count.checked_mul(lanes as usize).ok_or_else(|| {
+                error_diagnostic("private vector part extent exceeds host address space")
+            })?;
+            parts.try_reserve(total).map_err(|e| {
+                error_diagnostic(format!("private bit-part allocation failed: {e}"))
+            })?;
+            for lane in 0..lanes {
+                for index in 0..count {
+                    let source_offset_bits = u32::try_from(index)
+                        .ok()
+                        .and_then(|n| n.checked_mul(64))
+                        .ok_or_else(|| error_diagnostic("source bit-part offset overflow"))?;
+                    let payload_bits = (bits - source_offset_bits).min(64) as u8;
+                    let lane_offset = u64::from(lane)
+                        .checked_mul(u64::from(bits))
+                        .and_then(|n| n.checked_add(u64::from(source_offset_bits)))
+                        .ok_or_else(|| error_diagnostic("source vector bit offset overflow"))?;
+                    let memory_offset = base.checked_add(lane_offset / 8).ok_or_else(|| {
+                        error_diagnostic("source bit-part memory offset overflow")
+                    })?;
+                    parts.push(ValueBitPart {
+                        source_type,
+                        source_offset_bits,
+                        payload_bits,
+                        memory_offset,
+                        memory_bit_offset: (lane_offset % 8) as u8,
+                        vector_lane: vector.then_some(lane),
+                    });
+                }
+            }
+        }
+        result.insert(ty, parts);
+    }
+    Ok(result)
+}
