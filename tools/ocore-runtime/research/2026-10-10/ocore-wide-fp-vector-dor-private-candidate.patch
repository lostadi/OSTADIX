+pub(super) fn audit_instruction(
+    module: &NativeModule,
+    instruction: &Instruction,
+    values: &BTreeMap<ValueId, TypeId>,
+) -> Result<(), Diagnostic> {
+    if let Operation::Binary {
+        kind: BinaryOp::SDiv | BinaryOp::SRem,
+        lhs,
+        ..
+    } = &instruction.operation
