+//! Scalar legalization of original fixed vectors on all owned 64-bit targets.
+//! Lane payloads remain original-width; source memory is tightly bitpacked and
+//! allocation padding never becomes a private slot or a store obligation.
+use super::wide::Words;
+use super::*;
+
+fn operand_type(value: &Operand, types: &BTreeMap<ValueId, TypeId>) -> TypeId {
+    match value {
+        Operand::Value { id } => types[id],
+        _ => constant_type(value).unwrap(),
+    }
+}
+pub(super) fn audit_instruction(
+    module: &NativeModule,
+    instruction: &Instruction,
+    types: &BTreeMap<ValueId, TypeId>,
+) -> Result<(), Diagnostic> {
+    if let Operation::Binary {
+        kind: BinaryOp::SDiv | BinaryOp::SRem,
+        lhs,
+        ..
+    } = &instruction.operation
+    {
+        if let Type::Vector { element, .. } = module.types[operand_type(lhs, types)] {
+            if matches!(module.types[element], Type::Int { bits: 65.. }) {
+                return Err(error_diagnostic("wide signed vector division requires the explicit source-width signed legalization"));
+            }
+        }
+    }
+    Ok(())
+}
+
+impl Emitter<'_> {
+    fn vector_shape(&self, ty: TypeId) -> Option<(TypeId, usize, u32)> {
+        match self.module.types[ty] {
+            Type::Vector {
+                element,
+                lanes,
+                scalable: false,
+            } => {
+                let bits = match self.module.types[element] {
+                    Type::Int { bits } => bits,
+                    Type::Float { format } => format.value_bits(),
+                    Type::Pointer { address_space: 0 } => 64,
+                    _ => unreachable!("verified vector element"),
+                };
+                Some((element, lanes as usize, bits))
+            }
+            _ => None,
+        }
+    }
+    fn vector_accumulate(&self, out: &mut String) {
+        self.stack_load(out, 1, self.vector_workspace);
+        self.wide_or(out);
+        self.stack_store(out, 0, self.vector_workspace);
+    }
+    fn vector_accumulator_zero(&self, out: &mut String) {
+        self.immediate(out, 0, 0);
+        self.stack_store(out, 0, self.vector_workspace);
+    }
+    /// Select bits from the logical bitstream, independent of source memory
+    /// padding or the per-lane 64-bit private legalization boundaries.
+    fn vector_bits(&self, out: &mut String, value: &Operand, start: u64, width: u8) {
+        self.vector_accumulator_zero(out);
+        let end = start + u64::from(width);
+        let mut source_start = 0;
+        for (part_index, part) in self.leaf_layouts[&self.ty(value)].iter().enumerate() {
+            let source_end = source_start + u64::from(part.payload_bits);
+            let lo = start.max(source_start);
+            let hi = end.min(source_end);
+            if lo < hi {
+                self.operand_leaf(out, 0, value, part_index);
+                self.wide_imm_shift(out, 0, (lo - source_start) as u16, true, false);
+                self.mask(out, 0, (hi - lo) as u16);
+                self.wide_imm_shift(out, 0, (lo - start) as u16, false, false);
+                self.vector_accumulate(out);
+            }
+            source_start = source_end;
+            if source_start >= end {
+                break;
+            }
+        }
+        self.stack_load(out, 0, self.vector_workspace);
+    }
+    fn vector_bitcast(&self, out: &mut String, value: &Operand, result: Value) {
+        let mut logical = 0;
+        for (index, part) in self.leaf_layouts[&result.ty].iter().enumerate() {
+            self.vector_bits(out, value, logical, part.payload_bits);
+            self.spill_leaf(out, result, index);
+            logical += u64::from(part.payload_bits);
+        }
+    }
+    /// Every original payload bit is loaded. In particular, a 64-bit lane
+    /// starting at bit 7 reads its ninth source byte without truncating it.
+    fn vector_load(&self, out: &mut String, pointer: &Operand, result: Value) {
+        for (index, part) in self.leaf_layouts[&result.ty].iter().enumerate() {
+            self.vector_accumulator_zero(out);
+            let mut consumed = 0u16;
+            while consumed < u16::from(part.payload_bits) {
+                let bit = u64::from(part.memory_bit_offset) + u64::from(consumed);
+                let in_byte = (bit % 8) as u16;
+                let take = (8 - in_byte).min(u16::from(part.payload_bits) - consumed);
+                self.operand(out, 1, pointer);
+                self.address_offset(out, part.memory_offset + bit / 8);
+                self.load(out, 1, 1);
+                self.wide_imm_shift(out, 0, in_byte, true, false);
+                self.mask(out, 0, take);
+                self.wide_imm_shift(out, 0, consumed, false, false);
+                self.vector_accumulate(out);
+                consumed += take;
+            }
+            self.stack_load(out, 0, self.vector_workspace);
+            self.spill_leaf(out, result, index);
+        }
+    }
+    /// Write each occupied source byte once, with no read-modify-write and no
+    /// writes to allocation/aggregate padding. Non-payload final byte bits are
+    /// a deterministic allowed realization, not claimed defined source bits.
+    fn vector_store(&self, out: &mut String, pointer: &Operand, value: &Operand) {
+        let mut bytes: BTreeMap<u64, Vec<(usize, u16, u16, u16)>> = BTreeMap::new();
+        for (index, part) in self.leaf_layouts[&self.ty(value)].iter().enumerate() {
+            let mut consumed = 0u16;
+            while consumed < u16::from(part.payload_bits) {
+                let bit = u64::from(part.memory_bit_offset) + u64::from(consumed);
+                let in_byte = (bit % 8) as u16;
+                let take = (8 - in_byte).min(u16::from(part.payload_bits) - consumed);
+                bytes
+                    .entry(part.memory_offset + bit / 8)
+                    .or_default()
+                    .push((index, consumed, in_byte, take));
+                consumed += take;
+            }
+        }
+        for (byte, pieces) in bytes {
+            self.vector_accumulator_zero(out);
+            for (index, consumed, in_byte, take) in pieces {
+                self.operand_leaf(out, 0, value, index);
+                self.wide_imm_shift(out, 0, consumed, true, false);
+                self.mask(out, 0, take);
+                self.wide_imm_shift(out, 0, in_byte, false, false);
+                self.vector_accumulate(out);
+            }
+            self.stack_load(out, 0, self.vector_workspace);
+            self.operand(out, 1, pointer);
+            self.address_offset(out, byte);
+            self.store(out, 1, 1);
+        }
+    }
+    fn vector_binary(
+        &mut self,
+        out: &mut String,
+        kind: BinaryOp,
+        lhs: &Operand,
+        rhs: &Operand,
+        result: Value,
+    ) {
+        let (_, lanes, bits) = self.vector_shape(self.ty(lhs)).unwrap();
+        let words = Self::wide_count(bits);
+        for lane in 0..lanes {
+            let first = lane * words;
+            let destination = self.slots[&result.id] + (first * 8) as i64;
+            if bits <= 64 {
+                self.operand_leaf(out, 0, lhs, first);
+                self.operand_leaf(out, 1, rhs, first);
+                self.binary_loaded(out, kind, bits as u16);
+                self.spill_leaf(out, result, first);
+            } else {
+                let a = Words::OperandAt(lhs, first);
+                let b = Words::OperandAt(rhs, first);
+                match kind {
+                    BinaryOp::Add | BinaryOp::Sub => {
+                        self.wide_add(out, destination, a, b, bits, kind == BinaryOp::Sub)
+                    }
+                    BinaryOp::Mul => self.wide_multiply(out, a, b, destination, bits),
+                    BinaryOp::UDiv | BinaryOp::URem => {
+                        self.wide_division(out, a, b, destination, bits, kind == BinaryOp::URem)
+                    }
+                    BinaryOp::Shl | BinaryOp::LShr | BinaryOp::AShr => {
+                        self.wide_shift(out, kind, a, b, destination, bits)
+                    }
+                    BinaryOp::And | BinaryOp::Or | BinaryOp::Xor => {
+                        for word in 0..words {
+                            self.operand_leaf(out, 0, lhs, first + word);
+                            self.operand_leaf(out, 1, rhs, first + word);
+                            self.simple_binary(
+                                out,
+                                match kind {
+                                    BinaryOp::And => "and",
+                                    BinaryOp::Or if self.target == Target::Aarch64UnknownNone => {
+                                        "orr"
+                                    }
+                                    BinaryOp::Or => "or",
+                                    BinaryOp::Xor if self.target == Target::Aarch64UnknownNone => {
+                                        "eor"
+                                    }
+                                    _ => "xor",
+                                },
+                            );
+                            self.spill_leaf(out, result, first + word);
+                        }
+                    }
+                    _ => unreachable!("whole-module vector signed division audit"),
+                }
+            }
+        }
+    }
+    fn vector_compare(
+        &mut self,
+        out: &mut String,
+        predicate: IntPredicate,
+        lhs: &Operand,
+        rhs: &Operand,
+        result: Value,
+    ) {
+        let (_, lanes, bits) = self.vector_shape(self.ty(lhs)).unwrap();
+        let words = Self::wide_count(bits);
+        for lane in 0..lanes {
+            if bits <= 64 {
+                self.operand_leaf(out, 0, lhs, lane);
+                self.operand_leaf(out, 1, rhs, lane);
+                self.compare_loaded(out, predicate, bits as u16);
+            } else {
+                self.wide_compare_words(
+                    out,
+                    predicate,
+                    Words::OperandAt(lhs, lane * words),
+                    Words::OperandAt(rhs, lane * words),
+                    bits,
+                );
+            }
+            self.spill_leaf(out, result, lane);
+        }
+    }
+    fn vector_cast(&self, out: &mut String, kind: CastOp, value: &Operand, result: Value) {
+        let (_, lanes, from_bits) = self.vector_shape(self.ty(value)).unwrap();
+        let (_, _, to_bits) = self.vector_shape(result.ty).unwrap();
+        let source_words = Self::wide_count(from_bits);
+        let target_words = Self::wide_count(to_bits);
+        for lane in 0..lanes {
+            for word in 0..target_words {
+                if word < source_words {
+                    self.operand_leaf(out, 0, value, lane * source_words + word);
+                    if kind == CastOp::SExt && word + 1 == source_words {
+                        self.signed(out, 0, Self::wide_tail(from_bits));
+                    }
+                } else if kind == CastOp::SExt {
+                    self.operand_leaf(out, 0, value, lane * source_words + source_words - 1);
+                    self.signed(out, 0, Self::wide_tail(from_bits));
+                    self.wide_imm_shift(out, 0, 63, true, true);
+                } else {
+                    self.immediate(out, 0, 0);
+                }
+                self.spill_leaf(out, result, lane * target_words + word);
+            }
+        }
+    }
+    fn vector_select(
+        &mut self,
+        out: &mut String,
+        condition: &Operand,
+        on_true: &Operand,
+        on_false: &Operand,
+        result: Value,
+    ) {
+        let (_, lanes, bits) = self.vector_shape(result.ty).unwrap();
+        let words = Self::wide_count(bits);
+        let mask_vector = self.vector_shape(self.ty(condition)).is_some();
+        for lane in 0..lanes {
+            self.operand_leaf(out, 0, condition, if mask_vector { lane } else { 0 });
+            let no = self.label();
+            let done = self.label();
+            self.zero_jump(out, 0, &no, true);
+            for word in 0..words {
+                self.operand_leaf(out, 0, on_true, lane * words + word);
+                self.spill_leaf(out, result, lane * words + word);
+            }
+            self.jump(out, &done);
+            writeln!(out, "{no}:").unwrap();
+            for word in 0..words {
+                self.operand_leaf(out, 0, on_false, lane * words + word);
+                self.spill_leaf(out, result, lane * words + word);
+            }
+            writeln!(out, "{done}:").unwrap();
+        }
+    }
+    /// Compare every original index part. A high nonzero index part is never
+    /// silently truncated into an in-range lane. Out-of-range is source poison.
+    fn vector_index_jump(&self, out: &mut String, index: &Operand, lane: usize, mismatch: &str) {
+        for part in 1..self.leaf_layouts[&self.ty(index)].len() {
+            self.operand_leaf(out, 0, index, part);
+            self.zero_jump(out, 0, mismatch, false);
+        }
+        self.operand_leaf(out, 0, index, 0);
+        self.immediate(out, 1, lane as u64);
+        self.compare_loaded(out, IntPredicate::Eq, 64);
+        self.zero_jump(out, 0, mismatch, true);
+    }
+    fn vector_extract(
+        &mut self,
+        out: &mut String,
+        vector: &Operand,
+        index: &Operand,
+        result: Value,
+    ) {
+        let (_, lanes, bits) = self.vector_shape(self.ty(vector)).unwrap();
+        let words = Self::wide_count(bits);
+        let done = self.label();
+        for lane in 0..lanes {
+            let next = self.label();
+            self.vector_index_jump(out, index, lane, &next);
+            for word in 0..words {
+                self.operand_leaf(out, 0, vector, lane * words + word);
+                self.spill_leaf(out, result, word);
+            }
+            self.jump(out, &done);
+            writeln!(out, "{next}:").unwrap();
+        }
+        // The IR retains the poison contract; zero is chosen only by lowering.
+        for word in 0..words {
+            self.immediate(out, 0, 0);
+            self.spill_leaf(out, result, word);
+        }
+        writeln!(out, "{done}:").unwrap();
+    }
+    fn vector_insert(
+        &mut self,
+        out: &mut String,
+        vector: &Operand,
+        value: &Operand,
+        index: &Operand,
+        result: Value,
+    ) {
+        let (_, lanes, bits) = self.vector_shape(result.ty).unwrap();
+        let words = Self::wide_count(bits);
+        // Copy original vector first; a defined in-range index replaces one lane.
+        for part in 0..self.leaf_layouts[&result.ty].len() {
+            self.operand_leaf(out, 0, vector, part);
+            self.spill_leaf(out, result, part);
+        }
+        let done = self.label();
+        for lane in 0..lanes {
+            let next = self.label();
+            self.vector_index_jump(out, index, lane, &next);
+            for word in 0..words {
+                self.operand_leaf(out, 0, value, word);
+                self.spill_leaf(out, result, lane * words + word);
+            }
+            self.jump(out, &done);
+            writeln!(out, "{next}:").unwrap();
+        }
+        for part in 0..self.leaf_layouts[&result.ty].len() {
+            self.immediate(out, 0, 0);
+            self.spill_leaf(out, result, part);
+        }
+        writeln!(out, "{done}:").unwrap();
+    }
+    fn vector_intrinsic(
+        &mut self,
+        out: &mut String,
+        intrinsic: &str,
+        args: &[Operand],
+        result: Value,
+    ) {
+        use super::super::native_vector_contract::{vector_intrinsic, VectorIntrinsicKind::*};
+        let contract = vector_intrinsic(intrinsic).unwrap();
+        let bits = contract.bits;
+        let lanes = contract.lanes as usize;
+        let words = Self::wide_count(bits);
+        match contract.kind {
+            Reduce(kind) => {
+                let destination = self.slots[&result.id];
+                self.wide_copy(out, Words::OperandAt(&args[0], 0), destination, bits);
+                for lane in 1..lanes {
+                    let rhs = Words::OperandAt(&args[0], lane * words);
+                    if bits <= 64 {
+                        self.stack_load(out, 0, destination);
+                        self.operand_leaf(out, 1, &args[0], lane);
+                        self.binary_loaded(out, kind, bits as u16);
+                        self.spill_leaf(out, result, 0);
+                    } else {
+                        match kind {
+                            BinaryOp::Add => self.wide_add(
+                                out,
+                                destination,
+                                Words::Slot(destination),
+                                rhs,
+                                bits,
+                                false,
+                            ),
+                            BinaryOp::Mul => self.wide_multiply(
+                                out,
+                                Words::Slot(destination),
+                                rhs,
+                                destination,
+                                bits,
+                            ),
+                            BinaryOp::And | BinaryOp::Or | BinaryOp::Xor => {
+                                for word in 0..words {
+                                    self.stack_load(out, 0, destination + (word * 8) as i64);
+                                    self.operand_leaf(out, 1, &args[0], lane * words + word);
+                                    self.simple_binary(
+                                        out,
+                                        match kind {
+                                            BinaryOp::And => "and",
+                                            BinaryOp::Or
+                                                if self.target == Target::Aarch64UnknownNone =>
+                                            {
+                                                "orr"
+                                            }
+                                            BinaryOp::Or => "or",
+                                            BinaryOp::Xor
+                                                if self.target == Target::Aarch64UnknownNone =>
+                                            {
+                                                "eor"
+                                            }
+                                            _ => "xor",
+                                        },
+                                    );
+                                    self.spill_leaf(out, result, word);
+                                }
+                            }
+                            _ => unreachable!("verified integer reduction kind"),
+                        }
+                    }
+                }
+            }
+            PopulationCount => {
+                for lane in 0..lanes {
+                    self.immediate(out, 0, 0);
+                    self.stack_store(out, 0, self.vector_workspace + 8);
+                    for word in 0..words {
+                        self.operand_leaf(out, 0, &args[0], lane * words + word);
+                        self.population_count_loaded(
+                            out,
+                            if word + 1 == words {
+                                Self::wide_tail(bits)
+                            } else {
+                                64
+                            },
+                        );
+                        self.stack_load(out, 1, self.vector_workspace + 8);
+                        self.simple_binary(out, "add");
+                        self.stack_store(out, 0, self.vector_workspace + 8);
+                    }
+                    self.stack_load(out, 0, self.vector_workspace + 8);
+                    self.spill_leaf(out, result, lane * words);
+                    for word in 1..words {
+                        self.immediate(out, 0, 0);
+                        self.spill_leaf(out, result, lane * words + word);
+                    }
+                }
+            }
+            ByteSwap => {
+                let lane_bytes = bits / 8;
+                for lane in 0..lanes {
+                    for word in 0..words {
+                        let payload =
+                            self.leaf_layouts[&result.ty][lane * words + word].payload_bits;
+                        self.immediate(out, 0, 0);
+                        self.stack_store(out, 0, self.vector_workspace + 8);
+                        for byte in 0..u32::from(payload / 8) {
+                            let destination_byte = word as u32 * 8 + byte;
+                            let source_byte = lane_bytes - 1 - destination_byte;
+                            self.vector_bits(
+                                out,
+                                &args[0],
+                                lane as u64 * u64::from(bits) + u64::from(source_byte) * 8,
+                                8,
+                            );
+                            self.wide_imm_shift(out, 0, (byte * 8) as u16, false, false);
+                            self.stack_load(out, 1, self.vector_workspace + 8);
+                            self.wide_or(out);
+                            self.stack_store(out, 0, self.vector_workspace + 8);
+                        }
+                        self.stack_load(out, 0, self.vector_workspace + 8);
+                        self.spill_leaf(out, result, lane * words + word);
+                    }
+                }
+            }
+            MinMax(kind) => {
+                let predicate = match kind {
+                    IntegerMinMaxKind::Smin => IntPredicate::Slt,
+                    IntegerMinMaxKind::Smax => IntPredicate::Sgt,
+                    IntegerMinMaxKind::Umin => IntPredicate::Ult,
+                    IntegerMinMaxKind::Umax => IntPredicate::Ugt,
+                };
+                for lane in 0..lanes {
+                    if bits <= 64 {
+                        self.operand_leaf(out, 0, &args[0], lane);
+                        self.operand_leaf(out, 1, &args[1], lane);
+                        self.compare_loaded(out, predicate, bits as u16);
+                    } else {
+                        self.wide_compare_words(
+                            out,
+                            predicate,
+                            Words::OperandAt(&args[0], lane * words),
+                            Words::OperandAt(&args[1], lane * words),
+                            bits,
+                        );
+                    }
+                    let no = self.label();
+                    let done = self.label();
+                    self.zero_jump(out, 0, &no, true);
+                    for word in 0..words {
+                        self.operand_leaf(out, 0, &args[0], lane * words + word);
+                        self.spill_leaf(out, result, lane * words + word);
+                    }
+                    self.jump(out, &done);
+                    writeln!(out, "{no}:").unwrap();
+                    for word in 0..words {
+                        self.operand_leaf(out, 0, &args[1], lane * words + word);
+                        self.spill_leaf(out, result, lane * words + word);
+                    }
+                    writeln!(out, "{done}:").unwrap();
+                }
+            }
+            SignedPairMultiplyAdd => {
+                for lane in 0..4 {
+                    self.immediate(out, 0, 0);
+                    self.stack_store(out, 0, self.vector_workspace + 8);
+                    for member in 0..2 {
+                        self.operand_leaf(out, 0, &args[0], lane * 2 + member);
+                        self.signed(out, 0, 16);
+                        self.operand_leaf(out, 1, &args[1], lane * 2 + member);
+                        self.signed(out, 1, 16);
+                        self.simple_binary(
+                            out,
+                            if self.target == Target::X86_64UnknownNone {
+                                "imul"
+                            } else {
+                                "mul"
+                            },
+                        );
+                        self.stack_load(out, 1, self.vector_workspace + 8);
+                        self.simple_binary(out, "add");
+                        self.stack_store(out, 0, self.vector_workspace + 8);
+                    }
+                    self.spill_leaf(out, result, lane);
+                }
+            }
+            UnsignedByteSad => {
+                for lane in 0..2 {
+                    self.immediate(out, 0, 0);
+                    self.stack_store(out, 0, self.vector_workspace + 8);
+                    for member in 0..8 {
+                        self.operand_leaf(out, 0, &args[0], lane * 8 + member);
+                        self.operand_leaf(out, 1, &args[1], lane * 8 + member);
+                        self.simple_binary(out, "sub");
+                        // Signed difference is in [-255,255], so abs is exact.
+                        self.mov(out, self.reg(1), self.reg(0));
+                        self.wide_imm_shift(out, 1, 63, true, true);
+                        self.simple_binary(
+                            out,
+                            if self.target == Target::Aarch64UnknownNone {
+                                "eor"
+                            } else {
+                                "xor"
+                            },
+                        );
+                        self.simple_binary(out, "sub");
+                        self.stack_load(out, 1, self.vector_workspace + 8);
+                        self.simple_binary(out, "add");
+                        self.stack_store(out, 0, self.vector_workspace + 8);
+                    }
+                    self.spill_leaf(out, result, lane);
+                }
+            }
+            CarrylessMultiply => {
+                let Operand::Int { bits: control, .. } = &args[2] else {
+                    unreachable!("verified literal control");
+                };
+                let control = control.parse::<u8>().unwrap();
+                self.operand_leaf(out, 0, &args[0], usize::from(control & 1));
+                self.stack_store(out, 0, self.vector_workspace + 8);
+                self.operand_leaf(out, 0, &args[1], usize::from((control >> 4) & 1));
+                self.stack_store(out, 0, self.vector_workspace + 16);
+                self.immediate(out, 0, 0);
+                self.stack_store(out, 0, self.vector_workspace + 24);
+                self.stack_store(out, 0, self.vector_workspace + 32);
+                for bit in 0..64 {
+                    self.stack_load(out, 0, self.vector_workspace + 16);
+                    self.wide_imm_shift(out, 0, bit, true, false);
+                    self.mask(out, 0, 1);
+                    let skip = self.label();
+                    self.zero_jump(out, 0, &skip, true);
+                    self.stack_load(out, 0, self.vector_workspace + 8);
+                    self.wide_imm_shift(out, 0, bit, false, false);
+                    self.stack_load(out, 1, self.vector_workspace + 24);
+                    self.simple_binary(
+                        out,
+                        if self.target == Target::Aarch64UnknownNone {
+                            "eor"
+                        } else {
+                            "xor"
+                        },
+                    );
+                    self.stack_store(out, 0, self.vector_workspace + 24);
+                    if bit != 0 {
+                        self.stack_load(out, 0, self.vector_workspace + 8);
+                        self.wide_imm_shift(out, 0, 64 - bit, true, false);
+                        self.stack_load(out, 1, self.vector_workspace + 32);
+                        self.simple_binary(
+                            out,
+                            if self.target == Target::Aarch64UnknownNone {
+                                "eor"
+                            } else {
+                                "xor"
+                            },
+                        );
+                        self.stack_store(out, 0, self.vector_workspace + 32);
+                    }
+                    writeln!(out, "{skip}:").unwrap();
+                }
+                self.stack_load(out, 0, self.vector_workspace + 24);
+                self.spill_leaf(out, result, 0);
+                self.stack_load(out, 0, self.vector_workspace + 32);
+                self.spill_leaf(out, result, 1);
+            }
+        }
+    }
+
+    pub(super) fn vector_instruction(
+        &mut self,
+        out: &mut String,
+        instruction: &Instruction,
+    ) -> Result<bool, Diagnostic> {
+        match &instruction.operation {
+            Operation::VectorIntrinsic { intrinsic, args } => {
+                self.vector_intrinsic(out, intrinsic, args, instruction.result.unwrap())
+            }
+            Operation::Binary { kind, lhs, rhs, .. }
+                if self.vector_shape(self.ty(lhs)).is_some() =>
+            {
+                self.vector_binary(out, *kind, lhs, rhs, instruction.result.unwrap())
+            }
+            Operation::ICmp {
+                predicate,
+                lhs,
+                rhs,
+            } if self.vector_shape(self.ty(lhs)).is_some() => {
+                self.vector_compare(out, *predicate, lhs, rhs, instruction.result.unwrap())
+            }
+            Operation::Cast {
+                kind: CastOp::Bitcast,
+                value,
+            } if self.vector_shape(self.ty(value)).is_some()
+                || instruction
+                    .result
+                    .is_some_and(|v| self.vector_shape(v.ty).is_some()) =>
+            {
+                self.vector_bitcast(out, value, instruction.result.unwrap())
+            }
+            Operation::Cast { kind, value } if self.vector_shape(self.ty(value)).is_some() => {
+                self.vector_cast(out, *kind, value, instruction.result.unwrap())
+            }
+            Operation::Select {
+                condition,
+                on_true,
+                on_false,
+            } if instruction
+                .result
+                .is_some_and(|v| self.vector_shape(v.ty).is_some()) =>
+            {
+                self.vector_select(
+                    out,
+                    condition,
+                    on_true,
+                    on_false,
+                    instruction.result.unwrap(),
+                )
+            }
+            Operation::ExtractElement { vector, index } => {
+                self.vector_extract(out, vector, index, instruction.result.unwrap())
+            }
+            Operation::InsertElement {
+                vector,
+                value,
+                index,
+            } => self.vector_insert(out, vector, value, index, instruction.result.unwrap()),
+            Operation::ShuffleVector { lhs, rhs, mask } => {
+                let (_, lanes, bits) = self.vector_shape(self.ty(lhs)).unwrap();
+                let words = Self::wide_count(bits);
+                let result = instruction.result.unwrap();
+                for (lane, selected) in mask.iter().enumerate() {
+                    for word in 0..words {
+                        if let Some(selected) = selected {
+                            let n = *selected as usize;
+                            self.operand_leaf(
+                                out,
+                                0,
+                                if n < lanes { lhs } else { rhs },
+                                (n % lanes) * words + word,
+                            );
+                        } else {
+                            self.immediate(out, 0, 0);
+                        }
+                        self.spill_leaf(out, result, lane * words + word);
+                    }
+                }
+            }
+            Operation::Load { pointer, .. }
+                if instruction.result.is_some_and(|v| {
+                    self.leaf_layouts[&v.ty]
+                        .iter()
+                        .any(|p| p.vector_lane.is_some())
+                }) =>
+            {
+                self.vector_load(out, pointer, instruction.result.unwrap())
+            }
+            Operation::Store { pointer, value, .. }
+                if self.leaf_layouts[&self.ty(value)]
+                    .iter()
+                    .any(|p| p.vector_lane.is_some()) =>
+            {
+                self.vector_store(out, pointer, value)
+            }
+            _ => return Ok(false),
+        }
+        Ok(true)
+    }
