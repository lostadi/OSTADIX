+fn intrinsic_unit(triple: &str, f: FloatFormat, op: Operation, output: Type) -> NativeModule {
+    let mut m = module(f);
+    m.target.triple = triple.into();
+    m.target.abi = triple.starts_with("riscv64").then(|| "lp64d".into());
+    // All public crossings are pointers. The test exercises original FP data
+    // formats and integer128 results without fabricating their foreign ABI.
+    m.types.push(Type::Pointer { address_space: 0 });
+    m.types.push(output);
+    let pointer = 4;
+    let output = 5;
+    let function = &mut m.functions[0];
+    function.signature.params = vec![pointer, pointer, pointer];
+    function.signature.result = 0;
+    function.params = vec![
+        Value { id: 0, ty: pointer },
+        Value { id: 1, ty: pointer },
+        Value { id: 2, ty: pointer },
+    ];
+    function.blocks[0].instructions = vec![
+        Instruction {
+            result: Some(Value { id: 3, ty: 3 }),
+            fp: FloatInstructionSemantics::default(),
+            operation: Operation::Load {
+                pointer: Operand::Value { id: 1 },
+                alignment: 1,
+                volatile: false,
+            },
+        },
+        Instruction {
+            result: Some(Value { id: 4, ty: 3 }),
+            fp: FloatInstructionSemantics::default(),
+            operation: Operation::Load {
+                pointer: Operand::Value { id: 2 },
+                alignment: 1,
+                volatile: false,
+            },
+        },
+        Instruction {
+            result: Some(Value { id: 5, ty: output }),
+            fp: FloatInstructionSemantics::default(),
+            operation: op,
+        },
+        Instruction {
+            result: None,
+            fp: FloatInstructionSemantics::default(),
+            operation: Operation::Store {
+                pointer: Operand::Value { id: 0 },
+                value: Operand::Value { id: 5 },
+                alignment: 1,
+                volatile: false,
+            },
+        },
+    ];
+    function.blocks[0].terminator = Terminator::Return { value: None };
+    m
+}
