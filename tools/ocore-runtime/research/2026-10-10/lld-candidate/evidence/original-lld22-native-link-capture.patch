+  void selected(const InputFile *);
+  void ltoModule(unsigned task, const llvm::Module &);
+  void ltoObject(const InputFile *, unsigned task, llvm::MemoryBufferRef, bool cacheHit);
+  void finish(Ctx &, bool sourceSuccess);
+};
