{
  "schema": "ocore-runtime-recipe-v1",
  "name": "cpython-full-hosted-profile",
  "source": {
    "url": "https://github.com/python/cpython.git",
    "revision": "c35ca4cb6e296d1770fe45f9414b58eb06242e02",
    "submodules": true
  },
  "toolchain": {
    "llvm_version": "22.1.6"
  },
  "capture_profile": "hosted-source-build",
  "intended_execution_profile": "ostadix-kernel",
  "intended_targets": [
    "x86_64-unknown-none",
    "aarch64-unknown-none",
    "riscv64-unknown-none"
  ],
  "env": {
    "CFLAGS": "-O2 -g0",
    "CXXFLAGS": "-O2 -g0"
  },
  "commands": [
    {
      "name": "configure-full-runtime",
      "argv": [
        "{source}/configure",
        "--prefix={build}/install"
      ],
      "cwd": "{build}"
    },
    {
      "name": "plan-full-native-runtime",
      "argv": [
        "python3",
        "-c",
        "import hashlib,pathlib,sys; p=pathlib.Path(sys.argv.pop(1)); s=p.read_bytes(); assert hashlib.sha256(s).hexdigest()=='d3aa2499d30f0455a85649952efa1458a0e9dcd27d303ede3b471c0ebfb90b4f', 'pinned build inventory helper changed'; sys.argv[0]=str(p); exec(compile(s,str(p),'exec'),dict(__name__='__main__',__file__=str(p)))",
        "{recipe_dir}/build_inventory.py",
        "plan",
        "--source",
        "{source}",
        "--build",
        "{build}",
        "--capture",
        "{output}",
        "--output",
        "{build}/native-build-plan.json"
      ],
      "cwd": "{build}"
    },
    {
      "name": "build-runtime-and-extensions",
      "argv": [
        "make",
        "-j{jobs}"
      ],
      "cwd": "{build}"
    },
    {
      "name": "inventory-whole-source-build",
      "argv": [
        "python3",
        "-c",
        "import hashlib,pathlib,sys; p=pathlib.Path(sys.argv.pop(1)); s=p.read_bytes(); assert hashlib.sha256(s).hexdigest()=='d3aa2499d30f0455a85649952efa1458a0e9dcd27d303ede3b471c0ebfb90b4f', 'pinned build inventory helper changed'; sys.argv[0]=str(p); exec(compile(s,str(p),'exec'),dict(__name__='__main__',__file__=str(p)))",
        "{recipe_dir}/build_inventory.py",
        "inventory",
        "--source",
        "{source}",
        "--build",
        "{build}",
        "--capture",
        "{output}",
        "--output",
        "{build}/full-unit-inventory.json"
      ],
      "cwd": "{build}"
    }
  ],
  "coverage": {
    "require_full_unit_inventory": true,
    "audit_roots": [
      "{build}"
    ],
