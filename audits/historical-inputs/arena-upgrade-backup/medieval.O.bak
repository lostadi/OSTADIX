python[90]^(
import os
kind = $combat_engine
mode = os.environ.get('OSTADIX_COMBAT_MODE', 'counterfactual')
if mode not in ('counterfactual', 'classic'):
    raise ValueError('OSTADIX_COMBAT_MODE must be counterfactual or classic')
programs = {
    'arena/session.O': $session_program, 'arena/analyze.O': $analyze_program,
    'arena/judge.O': $judge_program, 'arena/view.O': $view_program,
    'arena/terminal.O': $terminal_program, 'arena/raster.O': $raster_program,
}
if mode == 'classic':
    runner = 'run_championship_match' if kind == 'boxing' else 'run_tournament'
    classic = 'python' + '[91]^(\n' + runner + '()\n)_' + 'python[91]'
    __oval_result__ = O.eval(O.quote(classic))
else:
    bank = {'Pressure': $pressure_strategy, 'Adaptive': $adaptive_strategy, 'Guard': $guard_strategy}
    __oval_result__ = O.eval(programs['arena/session.O'], O.scope({
        'combat_kind': kind, 'strategy_bank': bank, 'engine_expression': $combat_engine_source,
        'program_expressions': programs}))
)_python[90]
