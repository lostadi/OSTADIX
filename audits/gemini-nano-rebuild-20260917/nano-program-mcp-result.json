    "source": "let parts = autonomous(batch(\npython^(\n    csv_data = '2,north,6\\n3,south,9\\n4,north,5\\n5,west,8\\n8,south,4\\n13,north,7\\n21,south,100'\n    rows = []\n    for line in csv_data.splitlines():\n        row = line.split(',')\n        id = int(row[0])\n        depot = row[1]\n        units = int(row[2])\n        rows.append((id, depot, units))\n    __oval_result__ = rows\n)_python,\nrust^(\n    fn main() {\n        let mut a = 2;\n        let mut b = 3;\n        let mut fib_numbers: Vec<i32> = Vec::new();\n        fib_numbers.push(a);\n        fib_numbers.push(b);\n\n        loop {\n            let next = a + b;\n            if next > 20 {\n                break;\n            }\n            fib_numbers.push(next);\n            a = b;\n            b = next;\n        }\n\n        println!(\"{:?}\", fib_numbers);\n    }\n)_rust,\nbash^(\n    printf '%s\\n' 'south' 'north' 'south' | sort -u\n)_bash\n))\npython^(\n    rows, ids, sites = $parts\n    enabled = set(sites.split())\n    selected_ids = []\n    totals = {}\n    total_units = 0\n\n    for id, depot, units in rows:\n        if id in ids and depot in enabled:\n            selected_ids.append(id)\n            if depot in totals:\n                totals[depot] += units\n            else:\n                totals[depot] = units\n            total_units += units\n\n    __oval_result__ = {\n        \"selected_ids\": selected_ids,\n        \"totals\": totals,\n        \"total_units\": total_units\n    }\n)_python\n"
  },
