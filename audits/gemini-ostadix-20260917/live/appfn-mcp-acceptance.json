      "parameters": {
        "source": "# Generated for the 2026-09-17 source-first acceptance test.\n# Three runtimes supply independent inputs to one dependent inventory decision.\nlet parts = autonomous(batch(\npython^(\nimport csv\nimport io\nrows = csv.DictReader(io.StringIO(\"id,name,quantity,unit_price\\n2,bolt,7,4\\n4,washer,20,1\\n5,gear,2,11\\n7,belt,3,9\\n\"))\n__oval_result__ = [dict(id=int(r[\"id\"]), name=r[\"name\"], quantity=int(r[\"quantity\"]), unit_price=int(r[\"unit_price\"])) for r in rows]\n)_python,\nrust^(\nfn main() {\n    let ids: Vec<String> = (2..=9)\n        .filter(|n| (2..*n).all(|d| n % d != 0))\n        .map(|n| n.to_string())\n        .collect();\n    println!(\"[{}]\", ids.join(\",\"));\n}\n)_rust,\nbash^(\nreadarray -t allowed < <(printf '%s\\n' gear bolt | sort)\nprintf '[\"%s\",\"%s\"]\\n' \"\\${allowed[0]}\" \"\\${allowed[1]}\"\n)_bash\n))\n\npython^(\nrows, eligible_ids, allowed_names = $parts\nchosen = [dict(row, line_total=row[\"quantity\"] * row[\"unit_price\"])\n          for row in rows if row[\"id\"] in eligible_ids and row[\"name\"] in allowed_names]\n__oval_result__ = {\n    \"selected_items\": chosen,\n    \"total\": sum(row[\"line_total\"] for row in chosen),\n    \"excluded_ids\": sorted(row[\"id\"] for row in rows if row[\"id\"] not in [r[\"id\"] for r in chosen]),\n    \"prime_ids_from_rust\": eligible_ids,\n    \"allowed_names_from_bash\": allowed_names,\n}\n)_python\n",
