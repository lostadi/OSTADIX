O^(
let bundle = python^(
# Packs the OSTADIX vs GraalVM comparison into one self-contained .O file:
# dist/graalvm_compare_bundle.O. Run it with O or olangc on any machine that
# has OSTADIX, python3 and node; it rebuilds everything there.
# Source dir: GRAALVM_COMPARE_DIR, else O_LANG_ROOT/benchmarks/graalvm_compare.
import base64, gzip, io, os, tarfile, textwrap
from pathlib import Path

base = Path(os.environ.get("GRAALVM_COMPARE_DIR")
            or Path(os.environ.get("O_LANG_ROOT", ".")) / "benchmarks" / "graalvm_compare")
files = sorted([str(p.relative_to(base)) for p in (base / "ostadix").glob("*.O")]) + [
    "graal/GraalBench.java", "graal/build.gradle", "graal/settings.gradle",
    "run.py", "RESULTS.md", "bundle_setup.py", "pack.O",
]

# Reproducible archive: fixed order, owner and mtime.
raw = io.BytesIO()
with tarfile.open(fileobj=raw, mode="w", format=tarfile.PAX_FORMAT) as tar:
    for rel in files:
        data = (base / rel).read_bytes()
        info = tarfile.TarInfo(rel)
        info.size = len(data)
        info.mtime = 0
        info.mode = 0o755 if rel.endswith(".py") else 0o644
        tar.addfile(info, io.BytesIO(data))
gz = io.BytesIO()
with gzip.GzipFile(fileobj=gz, mode="wb", mtime=0) as f:
    f.write(raw.getvalue())
payload = "\n".join(textwrap.wrap(base64.b64encode(gz.getvalue()).decode("ascii"), 76))

setup = (base / "bundle_setup.py").read_text()
opener = "python" + "^" + "("
closer = ")" + "_python"
dollar = chr(36)
for bad in (dollar, "^" + "(", ")" + "_"):
    if bad in setup:
        raise RuntimeError("bundle_setup.py contains a sequence O would interpret: " + repr(bad))

header = (
    "# graalvm_compare_bundle.O: self-contained OSTADIX vs GraalVM comparison.\n"
    "# Generated by pack.O; do not edit. Run on the target machine with:\n"
    "#   O graalvm_compare_bundle.O <backends-dir>\n"
    "#   olangc graalvm_compare_bundle.O --target script --shim-dir <backends-dir>\n"
    "# Options (environment): OSTADIX_BENCH_DIR, OSTADIX_BENCH_NATIVE=1,\n"
    "# OSTADIX_BENCH_ROUNDS=N. See bundle_setup.py inside the payload.\n"
)
body = 'PAYLOAD = """\n' + payload + '\n"""\n' + setup
text = header + "O" + "^" + "(\nlet setup = " + opener + "\n" + body + "\n" + closer + "\n" + ")" + "_O\n"

out = base / "dist" / "graalvm_compare_bundle.O"
out.parent.mkdir(exist_ok=True)
out.write_text(text)
__oval_result__ = {"bundle": str(out), "files": len(files), "bytes": len(text)}
)_python
)_O
