import sys, time, random, os, shutil, math
import json, hashlib, base64, copy, uuid, subprocess
from pathlib import Path

# ==============================================================================
# 64-BIT HALF-BLOCK TRUECOLOR PIXEL ENGINE & PALETTE
# ==============================================================================
W_PX = 76   # 76 pixels wide (76 terminal columns)
H_PX = 28   # 28 pixels tall (14 terminal lines)

PAL = {
    '.': None,                      # Transparent
    'bg': (24, 24, 37),            # Deep arena backdrop
    'crowd': (35, 36, 54),         # Silhouette crowd
    'spotlight': (48, 50, 75),     # Overhead arena lights
    'rope_top': (203, 166, 247),   # Mauve top rope
    'rope_mid': (166, 173, 200),   # Subtext mid rope
    'rope_bot': (137, 180, 250),   # Cyan bottom rope
    'post_red': (243, 139, 168),   # Red corner turnbuckle
    'post_blu': (137, 180, 250),   # Blue corner turnbuckle
    'canvas': (45, 48, 68),        # Canvas base
    'apron': (30, 32, 46),         # Ring apron
    'shadow': (18, 18, 28),        # Fighter foot shadow
    
    # Anatomy & Gear
    'skin_light': (250, 215, 195),
    'skin_mid': (220, 175, 150),
    'skin_dark': (175, 125, 100),
    'hair_titan': (45, 28, 20),
    'hair_phantom': (20, 22, 30),
    'glove_titan': (243, 50, 75),   # Crimson gloves
    'glove_phantom': (60, 190, 255),# Electric cyan gloves
    'trunks_titan': (220, 35, 50),
    'trunks_phantom': (40, 110, 230),
    'waist_gold': (249, 226, 175),  # Gold waistband
    'boot': (32, 32, 42),
    
    # Dynamic Injury & Visceral Gore Palette
    'blood': (235, 25, 45),         # Arterial cut blood
    'blood_dark': (120, 12, 22),    # Dried coagulated venous blood
    'blood_bright': (255, 40, 55),  # Fresh spraying arterial blood
    'blood_pool': (60, 8, 12),      # Deep coagulated floor pool
    'bruise': (140, 45, 125),       # Mottled violet contusion
    'hematoma': (48, 14, 62),       # Severe blackened periorbital hematoma
    'gash': (145, 10, 20),          # Open gaping flesh laceration
    'wound': (175, 25, 35),         # Raw abraded subcutaneous tissue
    'bone': (240, 235, 220),        # Dislodged tooth / nasal bone
    'eye_white': (245, 245, 250),
    'pupil': (20, 25, 35),
    'mouthguard': (240, 245, 255),  # Molded mouthguard
    'spark': (255, 255, 255),       # Impact flash
    'spark_yel': (255, 230, 80),    # Core spark yellow
    'star': (255, 230, 90),         # Concussion stars
    'sweat': (200, 230, 255),       # Sweat aerosol
    'trail': (90, 105, 140),        # Speed blur trail
    'ref_white': (240, 240, 245),   # Referee white stripe
    'ref_black': (20, 22, 28),      # Referee black stripe
    'ref_skin': (230, 195, 175),    # Referee skin
    'doc_coat': (245, 245, 250),    # Physician white coat
    'doc_cross': (230, 35, 45),     # Medical red cross
}

# ==============================================================================
# 2D REAL-TIME PHYSICS ENGINE
# ==============================================================================
class PhysicsEngine:
    def __init__(self, w=W_PX, h=H_PX):
        self.w = w
        self.h = h
        self.gravity = 0.42
        self.floor_y = 23.0
        
        # 1. Elastic Ring Ropes (Coupled Harmonic Oscillators)
        self.ropes = [
            {'y_rest': 5.0,  'nodes': [5.0]*w,  'vel': [0.0]*w, 'k': 0.35, 'd': 0.88, 'col': PAL['rope_top']},
            {'y_rest': 11.0, 'nodes': [11.0]*w, 'vel': [0.0]*w, 'k': 0.32, 'd': 0.89, 'col': PAL['rope_mid']},
            {'y_rest': 17.0, 'nodes': [17.0]*w, 'vel': [0.0]*w, 'k': 0.28, 'd': 0.90, 'col': PAL['rope_bot']},
        ]
        
        # 2. Ballistic Projectiles (Blood drops, sweat vapor, mouthguard)
        self.projectiles = []
        
        # 3. Canvas persistent debris (Mouthguard on floor, blood stains)
        self.canvas_objects = []

    def deform_ropes(self, x_center, depth_y):
        for rope in self.ropes:
            radius = 8
            for dx in range(-radius, radius + 1):
                x = int(x_center) + dx
                if 4 <= x < self.w - 4:
                    falloff = math.cos((dx / radius) * (math.pi / 2))
                    rope['vel'][x] += depth_y * falloff * 0.45

    def step_ropes(self):
        for rope in self.ropes:
            y0 = rope['y_rest']
            k = rope['k']
            d = rope['d']
            nodes = rope['nodes']
            vel = rope['vel']
            for x in range(5, self.w - 5):
                f = -k * (nodes[x] - y0)
                f += 0.24 * (nodes[x-1] + nodes[x+1] - 2.0 * nodes[x])
                vel[x] = (vel[x] + f) * d
                nodes[x] += vel[x]

    def spawn_blood_spray(self, hit_x, hit_y, intensity=1.0):
        count = int(7 * intensity)
        for _ in range(count):
            angle = random.uniform(-math.pi * 0.8, -math.pi * 0.2)
            spd = random.uniform(1.2, 3.2) * intensity
            self.projectiles.append({
                'type': 'blood',
                'x': float(hit_x),
                'y': float(hit_y),
                'vx': spd * math.cos(angle),
                'vy': spd * math.sin(angle),
                'drag': 0.03,
                'restitution': 0.0,
                'life': 24,
                'col': PAL['blood']
            })

    def spawn_sweat_cloud(self, hit_x, hit_y):
        for _ in range(5):
            self.projectiles.append({
                'type': 'sweat',
                'x': float(hit_x),
                'y': float(hit_y),
                'vx': random.uniform(-1.5, 1.5),
                'vy': random.uniform(-1.8, 0.0),
                'drag': 0.12,
                'restitution': 0.0,
                'life': random.randint(6, 10),
                'col': PAL['sweat']
            })

    def spawn_mouthguard(self, hit_x, hit_y, direction=1):
        self.projectiles.append({
            'type': 'mouthguard',
            'x': float(hit_x),
            'y': float(hit_y),
            'vx': direction * random.uniform(1.8, 2.6),
            'vy': random.uniform(-2.8, -1.8),
            'drag': 0.02,
            'restitution': 0.44,
            'life': 999,
            'col': PAL['mouthguard']
        })

    def step_projectiles(self, blood_stains_dict):
        alive = []
        for p in self.projectiles:
            p['x'] += p['vx']
            p['y'] += p['vy']
            p['vx'] *= (1.0 - p['drag'])
            p['vy'] = (p['vy'] * (1.0 - p['drag'])) + self.gravity
            p['life'] -= 1

            if p['y'] >= self.floor_y:
                if p['type'] == 'blood':
                    ix = max(4, min(self.w - 5, int(p['x'])))
                    iy = max(18, min(self.h - 4, int(p['y'])))
                    blood_stains_dict[(ix, iy)] = PAL['blood_dark']
                    continue
                elif p['type'] == 'mouthguard':
                    p['y'] = self.floor_y
                    p['vy'] = -p['vy'] * p['restitution']
                    p['vx'] *= 0.65
                    if abs(p['vy']) < 0.35 and abs(p['vx']) < 0.2:
                        self.canvas_objects.append({
                            'x': int(p['x']),
                            'y': int(self.floor_y),
                            'col': PAL['mouthguard']
                        })
                        continue
                elif p['type'] == 'sweat':
                    continue

            if p['life'] > 0 and 0 <= p['x'] < self.w and p['y'] < self.h:
                alive.append(p)
        self.projectiles = alive

# ==============================================================================
# VERLET RAGDOLL KNOCKDOWN SIMULATION
# ==============================================================================
class VerletRagdoll:
    def __init__(self, x_base, y_base, facing=1):
        self.points = [
            {'x': float(x_base), 'y': float(y_base - 14), 'ox': float(x_base), 'oy': float(y_base - 14)},
            {'x': float(x_base), 'y': float(y_base - 10), 'ox': float(x_base), 'oy': float(y_base - 10)},
            {'x': float(x_base), 'y': float(y_base - 6),  'ox': float(x_base), 'oy': float(y_base - 6)},
            {'x': float(x_base), 'y': float(y_base),      'ox': float(x_base), 'oy': float(y_base)},
        ]
        self.lengths = [4.0, 4.0, 6.0]
        self.facing = facing
        self.settled = False

    def apply_knockdown_impulse(self, impulse_x, impulse_y):
        self.points[0]['ox'] -= impulse_x * 1.8
        self.points[0]['oy'] -= impulse_y * 1.2
        self.points[1]['ox'] -= impulse_x * 0.9

    def step(self, floor_y=23.0, gravity=0.48, friction=0.78):
        if self.settled:
            return
        for p in self.points:
            vx = (p['x'] - p['ox']) * 0.95
            vy = (p['y'] - p['oy']) * 0.95 + gravity
            p['ox'] = p['x']
            p['oy'] = p['y']
            p['x'] += vx
            p['y'] += vy

            if p['y'] >= floor_y:
                p['y'] = floor_y
                p['oy'] = floor_y + (p['y'] - p['oy']) * 0.22
                p['ox'] = p['x'] - (p['x'] - p['ox']) * friction

        for _ in range(4):
            for i in range(len(self.lengths)):
                p1 = self.points[i]
                p2 = self.points[i + 1]
                dx = p2['x'] - p1['x']
                dy = p2['y'] - p1['y']
                dist = math.hypot(dx, dy) or 0.001
                diff = (dist - self.lengths[i]) / dist
                p1['x'] += dx * 0.5 * diff
                p1['y'] += dy * 0.5 * diff
                p2['x'] -= dx * 0.5 * diff
                p2['y'] -= dy * 0.5 * diff

# ==============================================================================
# DYNAMIC ANATOMICAL INJURY MODEL
# ==============================================================================
class InjurySystem:
    def __init__(self, fighter_name):
        self.name = fighter_name
        self.l_eye_swelling = 0.0
        self.r_eye_swelling = 0.0
        self.l_brow_cut = 0.0
        self.r_brow_cut = 0.0
        self.nose_fracture = 0.0
        self.jaw_concussion = 0.0
        self.liver_trauma = 0.0
        self.rib_fracture = 0.0
        self.blood_loss_ml = 0.0
        self.delayed_liver_timer = 0
        self.doc_checked = False
        self.doc_stopped = False
        self.has_mouthguard = True

    def is_left_eye_shut(self):
        return self.l_eye_swelling >= 60.0

    def is_right_eye_shut(self):
        return self.r_eye_swelling >= 60.0

    def has_severe_cut(self):
        return max(self.l_brow_cut, self.r_brow_cut) >= 70.0

    def apply_cutman_treatments(self):
        self.l_eye_swelling = max(0.0, self.l_eye_swelling - 22.0)
        self.r_eye_swelling = max(0.0, self.r_eye_swelling - 22.0)
        self.l_brow_cut = max(0.0, self.l_brow_cut - 26.0)
        self.r_brow_cut = max(0.0, self.r_brow_cut - 26.0)
        self.jaw_concussion = max(0.0, self.jaw_concussion - 35.0)

# ==============================================================================
# FIGHTER STATE MACHINE & SPRITE COMPOSITION
# ==============================================================================
class Fighter:
    def __init__(self, name, corner, style, start_x, mass_kg=95.0, is_titan=True):
        self.name = name
        self.corner = corner
        self.style = style
        self.is_titan = is_titan
        self.mass = mass_kg
        self.facing_right = is_titan
        self.x = float(start_x)
        self.y = 10.0
        self.vx = 0.0
        self.traction = 0.22
        self.hp = 100.0
        self.stamina = 100.0
        self.guard = 100.0
        self.state = 'IDLE'
        self.state_frame = 0
        self.state_duration = 10
        self.injury = InjurySystem(name)
        self.ragdoll = None
        
        self.punches_thrown = 0
        self.punches_landed = 0
        self.power_landed = 0
        self.knockdowns_scored = 0
        self.knockdowns_taken = 0
        self.damage_dealt = 0.0
        self.finishing_threat = 0.0

        # Dynamic combat animation telemetry
        self.slip_ticks = 0
        self.punch_type = None
        self.punch_target = None
        self.target_zone = 'HEAD'
        self.last_hurt_zone = 'HEAD'
        self.last_punch_taken = None
        self.has_impacted = False

    def get_hitboxes(self):
        fx = self.x
        fy = self.y
        facing = self.facing_right
        hx = fx + 7.0
        hy = fy + 3.0
        if self.state == 'SLIP':
            hy = fy + 7.5
            hx = fx + (3.0 if facing else 11.0)
        elif self.state == 'HURT':
            hx = fx + (5.0 if facing else 9.0)
            hy = fy + 2.5
        elif self.state == 'WOBBLE':
            hx = fx + 7.0 + math.sin(self.state_frame * 0.8) * 2.0

        guard_box = None
        if self.state == 'GUARD':
            gx = fx + (8.5 if facing else 5.5)
            gy = fy + 4.0
            guard_box = (gx, gy, 3.2)

        return {
            'head': (hx, hy, 2.2),
            'jaw': (hx + (1.0 if facing else -1.0), hy + 1.8, 1.4),
            'nose': (hx + (1.4 if facing else -1.4), hy + 0.8, 1.1),
            'liver': (fx + (5.5 if facing else 8.5), fy + (8.5 if self.state != 'SLIP' else 11.5), 2.0),
            'guard': guard_box
        }

    def get_glove_kinematics(self, dfn):
        if self.state not in ('JAB', 'CROSS', 'HOOK', 'UPPERCUT'):
            return None
        p = self.state_frame / max(1, self.state_duration)
        ext = math.sin(p * math.pi)
        sx = self.x + (10.0 if self.facing_right else 3.0)
        sy = self.y + 6.0
        if self.punch_target:
            tx, ty = self.punch_target
        else:
            tx = dfn.x + (4.0 if not self.facing_right else 9.0)
            ty = dfn.y + 4.0
        gx = sx + (tx - sx) * ext
        gy = sy + (ty - sy) * ext
        if self.state == 'UPPERCUT':
            gy += math.sin(p * math.pi) * -3.5 + (1.0 - p) * 2.0
        elif self.state == 'HOOK':
            if self.target_zone == 'LIVER':
                gy += math.sin(p * math.pi) * 1.8
            else:
                gy -= math.sin(p * math.pi) * 1.5
        ext_vel = math.pi * math.cos(p * math.pi)
        vx = (tx - sx) * ext_vel / max(1, self.state_duration)
        vy = (ty - sy) * ext_vel / max(1, self.state_duration)
        return {
            'x': gx, 'y': gy, 'vx': vx, 'vy': vy,
            'speed': math.hypot(vx, vy), 'radius': 1.6,
            'ext': ext, 'ext_vel': ext_vel
        }

    def get_pixel_matrix(self, tick):
        # Base matrix is strictly 14 characters wide to guarantee perfect flipping
        rows = [
            "....HHHHHH....",  # 0
            "...HHHHHHHH...",  # 1
            "...LMDDMDDL...",  # 2 brow
            "...L E  E L...",  # 3 eyes
            "...LM M M L...",  # 4 nose/cheeks
            "...LM === L...",  # 5 mouth/chin
            "..G LMMMMML G.",  # 6 neck / guard
            ".GG LMMMMML GG",  # 7 chest / gloves
            "..G LMMMMML G.",  # 8 ribs / forearms
            "... LDDDDDL ...", # 9 waist
            "..  WWWWWWW  .", # 10 waistband
            "..  TTTTTTT  .", # 11 trunks
            "..  TTTTTTT  .", # 12
            "..  TT   TT  .", # 13
            "... MM   MM ...", # 14 thighs
            "... MM   MM ...", # 15 knees
            "... BB   BB ...", # 16 boots
            "... BBB BBB ...", # 17 soles
        ]
        m = [list(r) for r in rows]

        # --- LOCOMOTION & STANCE ---
        if self.state in ('IDLE', 'ADVANCE', 'RETREAT'):
            bob = (tick // 3) % 2
            if bob == 1:
                m[16] = list("... BBB BBB ...")
                m[17] = list("... BB   BB ...")
            if self.state == 'ADVANCE':
                # Lean forward into stride
                m[1] = list("....HHHHHHHH..")
                m[2] = list("....LMDDMDDL..")
                m[3] = list("....L E  E L..")
            elif self.state == 'RETREAT':
                # Lean away on back foot
                m[1] = list("..HHHHHHHH....")
                m[2] = list("..LMDDMDDL....")
                m[3] = list("..L E  E L....")

        # --- BLOOD TRACTION SLIP ANIMATION ---
        if self.slip_ticks > 0:
            m[6] = list("GG. LMMMMML .G")
            m[7] = list(".G. LMMMMML .G")
            m[14] = list(".. MM   MM ...")
            m[15] = list(". MM     MM ..")
            m[16] = list("BB        BB .")
            m[17] = list("BBB      BBB .")

        # --- ATTACK POSES (Body rotation & tucked guard) ---
        elif self.state == 'JAB':
            m[6] = list("..G LMMMMML G.")
            m[7] = list("..G LMMMMML ..")
        elif self.state == 'CROSS':
            m[6] = list("..  LMMMMML G.")
            m[7] = list("..G LMMMMML ..")
            m[10] = list("... WWWWWWW . ")
        elif self.state == 'HOOK':
            if self.target_zone == 'LIVER':
                # Stance dropped low for liver hook
                m[6] = list("..G LMMMMML ..")
                m[7] = list(".GG LMMMMML ..")
            else:
                m[6] = list(".G  LMMMMML ..")
                m[7] = list("..G LMMMMML .G")
        elif self.state == 'UPPERCUT':
            m[1] = list("...HHHHHHHH...")
            m[2] = list("...LMDDMDDL...")
            m[6] = list("..G LMMMMML ..")
            m[7] = list("..G LMMMMML G.")

        # --- DEFENSE & EVASION ---
        elif self.state == 'GUARD':
            # Tight high peek-a-boo guard covering face
            m[3] = list("..GG E  E GG..")
            m[4] = list("..GG M  M GG..")
            m[5] = list("..GG ==== GG..")
            m[6] = list("..GG LMMML GG.")
            m[7] = list(".GG  LMMML  GG")
        elif self.state == 'SLIP':
            # Evasive duck & roll beneath punch line
            m[0] = list("..............")
            m[1] = list("..............")
            m[2] = list("....HHHHHH....")
            m[3] = list("...HHHHHHHH...")
            m[4] = list("...LMDDMDDL...")
            m[5] = list("...L E  E L...")
            m[6] = list(".GG LM == L GG")
            m[7] = list(".GG LMMMMML GG")
            m[16] = list("... BBB BBB ...")
            m[17] = list("... BBB BBB ...")

        # --- HIT REACTIONS ---
        elif self.state == 'HURT':
            if self.last_hurt_zone == 'LIVER' or self.injury.delayed_liver_timer > 0:
                # Doubled over in severe liver agony
                m[3] = list("...L X  X L...")
                m[4] = list("...LM == L ...")
                m[6] = list("... LMMMMML ...")
                m[7] = list("..GGGGGGGGGG..")  # Both arms clamped over liver
                m[8] = list("..GGGGGGGGGG..")
            elif self.last_punch_taken == 'UPPERCUT':
                # Violent head snap upward
                m[0] = list("...HHHHHHHH...")
                m[1] = list("...LMDDMDDL...")
                m[2] = list("...L X  X L...")
                m[3] = list("...LM == L....")
                m[6] = list(".G. LMMMMML .G")
            else:
                # Recoil twist from cross or hook
                m[2] = list("....LMDDMDL...")
                m[3] = list("....L X  X L..")
                m[6] = list(".G. LMMMMML .G")

        elif self.state == 'WOBBLE':
            # Rubber legs sinusoidal sway
            w_bob = (tick // 2) % 3
            if w_bob == 0:
                m[2] = list(".. LMDDMDDL ..")
                m[3] = list(".. L X  X L ..")
            elif w_bob == 2:
                m[2] = list(".... LMDDMDDL.")
                m[3] = list(".... L X  X L.")
            # Drooping heavy gloves
            m[7] = list("... LMMMMML ...")
            m[8] = list(".G. LMMMMML .G.")
            m[9] = list("GG. LDDDDDL .GG")

        elif self.state == 'VICTORY':
            m[0] = list("GGG........GGG")
            m[1] = list("..G.HHHHHH.G..")
            m[6] = list("....LMMMMML...")

        # --- DYNAMIC VISCERAL INJURY & FACIAL TRAUMA OVERLAYS ---
        # 1. Periorbital Hematomas & Swelling (Blackened eyes completely shut)
        if self.injury.l_eye_swelling > 15.0:
            m[3][8] = 'b'  # Purple swelling
            if self.injury.l_eye_swelling > 40.0:
                m[2][8] = 'h'  # Blackened hematoma spreading across brow
                m[3][8] = 'h'
                m[3][7] = 'h'
                m[4][8] = 'b'
            if self.injury.l_eye_swelling > 70.0:
                m[2][7] = 'h'
                m[4][7] = 'h'
                m[3][9] = 'g'  # Split swollen lid weeping blood
        if self.injury.r_eye_swelling > 15.0:
            m[3][4] = 'b'
            if self.injury.r_eye_swelling > 40.0:
                m[2][4] = 'h'
                m[3][4] = 'h'
                m[3][5] = 'h'
                m[4][4] = 'b'
            if self.injury.r_eye_swelling > 70.0:
                m[2][5] = 'h'
                m[4][5] = 'h'
                m[3][3] = 'g'

        # 2. Eyebrow Arterial Lacerations & Streaming Face Blood
        if self.injury.l_brow_cut > 15.0:
            m[2][8] = 'g'  # Open arterial tear
            m[2][9] = 'c'
            if self.injury.l_brow_cut > 40.0:
                m[3][9] = 'C'  # Fresh arterial red dripping down temple
                m[4][9] = 'c'  # Blood running down cheek
                m[5][9] = 'k'  # Coagulated drip on jaw
                m[6][8] = 'c'  # Dropping onto shoulder
                m[7][7] = 'k'  # Blood smeared across chest
        if self.injury.r_brow_cut > 15.0:
            m[2][4] = 'g'
            m[2][3] = 'c'
            if self.injury.r_brow_cut > 40.0:
                m[3][3] = 'C'
                m[4][3] = 'c'
                m[5][3] = 'k'
                m[6][5] = 'c'
                m[7][6] = 'k'

        # 3. Shattered Deviated Nose & Hemorrhaging Nostrils
        if self.injury.nose_fracture > 18.0:
            m[4][6] = 'g'  # Broken nasal bridge gash
            m[4][7] = 'o'  # Exposed white cartilage/bone fragment
            m[5][6] = 'C'  # Heavy arterial blood dripping down over lips
            m[5][7] = 'c'
            m[6][6] = 'k'  # Blood trickling down throat
            if self.injury.nose_fracture > 50.0:
                m[3][6] = 'h'  # Blackened hematoma between eyes
                m[7][6] = 'C'  # Blood pouring over sternum
                m[8][6] = 'k'

        # 4. Bloody Gaping Mouth & Missing Teeth
        if self.injury.jaw_concussion > 20.0:
            m[5][4] = 'c'  # Split lip corner
            m[5][8] = 'c'
        if not self.injury.has_mouthguard:
            m[5][5] = 'g'  # Gaping bloody mouth
            m[5][6] = 'o'  # Broken tooth stub
            m[5][7] = 'C'  # Spitting blood

        # 5. Massive Flank / Liver Hematoma & Subcutaneous Abrasion
        if self.injury.liver_trauma > 20.0:
            m[8][4] = 'h'  # Deep blackened flank hematoma
            m[8][5] = 'b'
            m[9][4] = 'w'  # Raw dermis tissue
            m[9][5] = 'h'
            if self.injury.liver_trauma > 50.0:
                m[7][4] = 'b'
                m[8][3] = 'w'
                m[9][3] = 'h'
                m[9][6] = 'b'

        # 6. Blood Spatter Splattered on Trunks & Waistband
        if (self.injury.l_brow_cut > 35.0 or self.injury.r_brow_cut > 35.0 or self.injury.nose_fracture > 35.0):
            m[10][6] = 'c'  # Drops on gold waistband
            m[11][5] = 'k'  # Dried blood stains on trunks
            m[11][7] = 'C'  # Fresh red drops
            m[12][6] = 'k'

        return [''.join(r) for r in m]

# ==============================================================================
# BOXING ARENA CONTROLLER WITH INTEGRATED PHYSICS
# ==============================================================================
class BoxingArena:
    def __init__(self):
        self.w = W_PX
        self.h = H_PX
        self.buf = [[PAL['bg'] for _ in range(self.w)] for _ in range(self.h)]
        self.blood_stains = {}
        self.hit_sparks = []
        
        self.physics = PhysicsEngine(self.w, self.h)
        
        self.f1 = Fighter("TITAN", "RED", "Slugger / Infighter", start_x=16, mass_kg=105.0, is_titan=True)
        self.f2 = Fighter("PHANTOM", "BLU", "Out-Boxer / Counter", start_x=46, mass_kg=84.0, is_titan=False)
        
        self.round_num = 1
        self.max_rounds = 3
        self.round_time_sec = 60
        self.clock_tick = 0
        self.round_tick = 0
        self.current_tick = 0
        self.seed = 42
        self.match_id = uuid.uuid4().hex
        self.scores = [0, 0]
        self.scorecards = []
        self.round_baseline = [(0.0, 0.0), (0.0, 0.0)]
        self.events = []
        self.match_over = False
        self.winner = None
        self.ko_type = None
        self.referee_count = 0
        self.referee_counting = False
        self.doctor_inspecting = False
        self.doctor_timer = 0
        self.doctor_fighter = None
        self.commentary_log = [
            "⚙️ Real-time 2D physics engine active: coupled elastic ropes, impulse kinematics, and Verlet ragdolls.",
            "⚡ Referee signals the bell: 'Touch gloves and fight clean!' Let's go!"
        ]

    def add_commentary(self, msg):
        self.commentary_log.append(msg)
        if len(self.commentary_log) > 5:
            self.commentary_log.pop(0)

    def step_kinematics(self, f: Fighter):
        boot_x = int(f.x + 7)
        boot_y = int(self.physics.floor_y)
        if (boot_x, boot_y) in self.blood_stains:
            f.traction = 0.04
            if abs(f.vx) > 0.4 and random.random() < 0.2:
                f.vx *= 1.4
                f.slip_ticks = 6
                self.physics.spawn_sweat_cloud(f.x + 7, self.physics.floor_y - 2)
                self.add_commentary(f"⚠️ TRACTION LOSS! {f.name} slips on a slick patch of canvas blood!")
        else:
            f.traction = 0.22

        if f.slip_ticks > 0:
            f.slip_ticks -= 1

        f.x += f.vx
        if f.vx > 0:
            f.vx = max(0.0, f.vx - f.traction)
        elif f.vx < 0:
            f.vx = min(0.0, f.vx + f.traction)

        # Rope elastic rebound
        if f.x <= 10.0:
            depth = 10.0 - f.x
            self.physics.deform_ropes(f.x, depth * 0.8)
            f.vx += depth * 0.35
            f.x = 10.0
            if abs(f.vx) > 0.6:
                self.add_commentary(f"➰ SLINGSHOT! {f.name} rebounds off the elastic ropes with kinetic momentum!")
        elif f.x >= self.w - 24.0:
            depth = f.x - (self.w - 24.0)
            self.physics.deform_ropes(f.x + 10, depth * 0.8)
            f.vx -= depth * 0.35
            f.x = self.w - 24.0
            if abs(f.vx) > 0.6:
                self.add_commentary(f"➰ SLINGSHOT! {f.name} rebounds off the elastic ropes with kinetic momentum!")

    def update_ai_fighter(self, atk: Fighter, dfn: Fighter, tick):
        if atk.injury.delayed_liver_timer > 0:
            atk.injury.delayed_liver_timer -= 1
            if atk.injury.delayed_liver_timer == 0 and atk.state != 'DOWN':
                atk.state = 'DOWN'
                atk.state_frame = 0
                atk.state_duration = 80
                atk.hp = max(0.0, atk.hp - 18.0)
                atk.ragdoll = VerletRagdoll(atk.x, self.physics.floor_y, facing=1 if atk.facing_right else -1)
                atk.ragdoll.apply_knockdown_impulse(0.5 if atk.facing_right else -0.5, 1.2)
                atk.knockdowns_taken += 1
                dfn.knockdowns_scored += 1
                self.add_commentary(f"🚨 LIVER SHUTDOWN! {atk.name} collapses to the canvas from the delayed liver trauma!")
                self.referee_counting = True
                self.referee_count = 1
                return

        atk.state_frame += 1
        dist = abs(dfn.x - atk.x)

        if atk.state == 'DOWN':
            if atk.ragdoll:
                atk.ragdoll.step(self.physics.floor_y)
            return

        if atk.state in ('HURT', 'WOBBLE'):
            if atk.state_frame >= atk.state_duration:
                atk.state = 'IDLE'
                atk.state_frame = 0
            return

        if atk.state in ('JAB', 'CROSS', 'HOOK', 'UPPERCUT', 'GUARD', 'SLIP'):
            if atk.state_frame >= atk.state_duration:
                atk.state = 'IDLE'
                atk.state_frame = 0
                atk.stamina = min(100.0, atk.stamina + 2.0)
            return

        stamina_regen = 1.2
        if atk.injury.liver_trauma > 40.0:
            stamina_regen *= 0.45
        atk.stamina = min(100.0, atk.stamina + stamina_regen)
        atk.guard = min(100.0, atk.guard + 0.8)

        ideal_dist = 11 if atk.is_titan else 15
        if atk.injury.is_left_eye_shut() or atk.injury.is_right_eye_shut():
            ideal_dist += 4

        force_stride = 75.0 if atk.injury.liver_trauma < 50.0 else 35.0
        accel = force_stride / atk.mass

        if dist > ideal_dist + 2:
            direction = 1 if atk.facing_right else -1
            atk.vx += direction * accel
            atk.state = 'ADVANCE'
        elif dist < ideal_dist - 2:
            direction = -1 if atk.facing_right else 1
            atk.vx += direction * accel
            atk.state = 'RETREAT'
        else:
            atk.state = 'IDLE'

        # Defensive reactions belong to this fighter's machine. Both machines
        # see the same previous tick, including an opponent's incoming punch.
        if dfn.state in ('JAB', 'CROSS', 'HOOK', 'UPPERCUT') and dfn.state_frame <= 1:
            blind = atk.injury.is_left_eye_shut() if dfn.facing_right else atk.injury.is_right_eye_shut()
            slip_chance = 0.05 if blind else (0.30 if atk.style.startswith('Out') else 0.18)
            if dfn.state in ('JAB', 'CROSS') and random.random() < slip_chance:
                atk.state, atk.state_frame, atk.state_duration = 'SLIP', 0, 5
                return
            if not blind and atk.guard > 20 and random.random() < 0.35:
                atk.state, atk.state_frame, atk.state_duration = 'GUARD', 0, 4
                return

        if atk.stamina > 15.0 and dist <= 18:
            roll = random.random()
            if roll < 0.28:
                self.execute_punch(atk, dfn, dist)

    def execute_punch(self, atk: Fighter, dfn: Fighter, dist=None, punch=None):
        atk.punches_thrown += 1
        if dist is None:
            dist = abs(atk.x - dfn.x)
        elif isinstance(dist, str) and punch is None:
            punch = dist
            dist = abs(atk.x - dfn.x)
        
        if punch is None:
            if dist > 13:
                punch = 'JAB'
                dur = 5
                stamina_cost = 6
            elif dist > 8:
                punch = 'CROSS' if random.random() < 0.6 else 'HOOK'
                dur = 6
                stamina_cost = 14
            else:
                punch = 'UPPERCUT' if random.random() < 0.5 else 'HOOK'
                dur = 7
                stamina_cost = 18
        else:
            dur = 5 if punch == 'JAB' else (6 if punch in ('CROSS', 'HOOK') else 7)
            stamina_cost = 6 if punch == 'JAB' else (14 if punch in ('CROSS', 'HOOK') else 18)

        atk.state = punch
        atk.state_frame = 0
        atk.state_duration = dur
        atk.stamina = max(0.0, atk.stamina - stamina_cost)
        atk.punch_type = punch
        atk.has_impacted = False

        # Target zone preference
        target_zone = 'HEAD'
        if punch == 'HOOK' and random.random() < 0.55:
            target_zone = 'LIVER'
        elif punch == 'JAB' and random.random() < 0.3:
            target_zone = 'NOSE'
        atk.target_zone = target_zone

        # Target coordinates in ring
        target_x = dfn.x + (4.0 if not atk.facing_right else 9.0)
        target_y = dfn.y + (7.0 if target_zone == 'LIVER' else (4.0 if target_zone == 'NOSE' else (2.0 if punch == 'UPPERCUT' else 3.0)))
        atk.punch_target = (target_x, target_y)

    def check_punch_collisions(self, atk: Fighter, dfn: Fighter):
        if atk.state not in ('JAB', 'CROSS', 'HOOK', 'UPPERCUT') or atk.has_impacted:
            return
            
        glove = atk.get_glove_kinematics(dfn)
        if not glove or glove['ext'] < 0.20:
            return
            
        if glove['ext_vel'] <= 0.0:
            return

        hboxes = dfn.get_hitboxes()
        gx, gy, gr = glove['x'], glove['y'], glove['radius']

        # 1. Physical Guard collision
        if hboxes['guard']:
            hx, hy, hr = hboxes['guard']
            if math.hypot(gx - hx, gy - hy) < (gr + hr):
                atk.has_impacted = True
                base_dmg = {'JAB': 6.0, 'CROSS': 14.0, 'HOOK': 18.0, 'UPPERCUT': 24.0}[atk.punch_type]
                blocked_dmg = base_dmg * 0.25
                dfn.guard = max(0.0, dfn.guard - 15.0)
                dfn.hp = max(0.0, dfn.hp - blocked_dmg)
                self.hit_sparks.append({'x': int(gx), 'y': int(gy), 'life': 3})
                self.physics.spawn_sweat_cloud(gx, gy)
                self.add_commentary(f"🛡️ {dfn.name} absorbs {atk.name}'s {atk.punch_type.lower()} on high guard!")
                if dfn.hp <= 0:
                    knock_down(self, dfn, atk, 1.5 if atk.facing_right else -1.5)
                return

        # 2. Anatomical zones collision
        hit_zone = None
        for zone in ('jaw', 'nose', 'liver', 'head'):
            hx, hy, hr = hboxes[zone]
            if math.hypot(gx - hx, gy - hy) < (gr + hr):
                hit_zone = zone
                break

        if hit_zone:
            atk.has_impacted = True
            atk.punches_landed += 1

            rel_vx = abs(glove['vx'] - dfn.vx)
            rel_spd = math.hypot(rel_vx, glove['vy'])
            vel_scale = max(0.65, min(1.75, rel_spd * 0.75))

            base_dmg = {'JAB': 6.0, 'CROSS': 14.0, 'HOOK': 18.0, 'UPPERCUT': 24.0}[atk.punch_type]
            is_counter = dfn.state in ('JAB', 'CROSS', 'HOOK', 'UPPERCUT')
            counter_mult = 1.65 if is_counter else 1.0

            actual_dmg = base_dmg * vel_scale * counter_mult
            impulse_force = (base_dmg * 14.0) * vel_scale * counter_mult

            knockback_dir = 1.0 if atk.facing_right else -1.0
            recoil_vel = (impulse_force / dfn.mass) * 0.65
            dfn.vx += knockback_dir * recoil_vel
            dfn.hp = max(0.0, dfn.hp - actual_dmg)

            dfn.state = 'HURT'
            dfn.state_frame = 0
            dfn.state_duration = 6
            dfn.last_hurt_zone = hit_zone.upper()
            dfn.last_punch_taken = atk.punch_type

            self.hit_sparks.append({'x': int(gx), 'y': int(gy), 'life': 3})
            self.physics.spawn_sweat_cloud(gx, gy)

            if is_counter:
                self.add_commentary(f"⚡ CRITICAL COUNTER! {atk.name} intercepts {dfn.name} with a flush {atk.punch_type}!")

            if hit_zone == 'liver':
                dfn.injury.liver_trauma += actual_dmg * 1.3
                dfn.injury.rib_fracture += actual_dmg * 0.2
                self.physics.spawn_blood_spray(gx, gy + 3, intensity=0.9)
                self.add_commentary(f"💥 THUD! {atk.name}'s {atk.punch_type} collides with {dfn.name}'s liver at ({gx:.1f}, {gy:.1f})!")
                if dfn.injury.liver_trauma >= 65.0 and random.random() < 0.5:
                    dfn.injury.delayed_liver_timer = 12
                    self.add_commentary(f"⚠️ {dfn.name}'s legs turn to stone! The liver shot is setting in...")
            elif hit_zone == 'nose':
                dfn.injury.nose_fracture += 18.0
                self.physics.spawn_blood_spray(gx, gy, intensity=1.2)
                self.add_commentary(f"🩸 SNAP! {atk.name}'s punch shatters {dfn.name}'s nose! Blood trickles over his lips!")
            elif hit_zone in ('jaw', 'head'):
                if atk.punch_type in ('UPPERCUT', 'CROSS'):
                    dfn.injury.jaw_concussion += actual_dmg * 0.9
                    atk.power_landed += 1
                    if (atk.punch_type == 'UPPERCUT' or is_counter) and dfn.injury.has_mouthguard and random.random() < 0.4:
                        dfn.injury.has_mouthguard = False
                        self.physics.spawn_mouthguard(gx, gy, direction=int(knockback_dir))
                        self.add_commentary(f"🦷 MOUTHGUARD EJECTED! {dfn.name}'s mouthguard flies into orbit from that vicious {atk.punch_type.lower()}!")
                    if dfn.injury.jaw_concussion > 50.0 and random.random() < 0.5:
                        dfn.state = 'WOBBLE'
                        dfn.state_duration = 10
                        self.add_commentary(f"💫 CONCUSSION ROCK! {dfn.name} is on rubber legs from that thunderous {atk.punch_type.lower()}!")

                if atk.facing_right:
                    dfn.injury.l_eye_swelling += actual_dmg * 0.75
                    if random.random() < 0.35:
                        dfn.injury.l_brow_cut += random.uniform(15.0, 30.0)
                        self.physics.spawn_blood_spray(gx, gy, intensity=1.5)
                        self.add_commentary(f"🩸 GASH OPENED! A deep cut erupts over {dfn.name}'s left eye!")
                else:
                    dfn.injury.r_eye_swelling += actual_dmg * 0.75
                    if random.random() < 0.35:
                        dfn.injury.r_brow_cut += random.uniform(15.0, 30.0)
                        self.physics.spawn_blood_spray(gx, gy, intensity=1.5)
                        self.add_commentary(f"🩸 GASH OPENED! A vicious cut tears across {dfn.name}'s right brow!")

            severity = injury_severity(dfn)
            if severity >= 70.0 and severity >= getattr(dfn.injury, 'last_exam_severity', 0) + 15:
                self.doctor_fighter = 'red' if dfn is self.f1 else 'blue'
                dfn.injury.doc_checked = True
                dfn.injury.last_exam_severity = severity
                self.doctor_inspecting = True
                self.doctor_timer = 12
                self.add_commentary("🩺 TIME OUT! The ringside physician examines " + dfn.name + ".")

            if dfn.hp <= 0.0 or (dfn.injury.jaw_concussion >= 85.0 and random.random() < 0.6):
                dfn.state = 'DOWN'
                dfn.state_frame = 0
                dfn.state_duration = 90
                dfn.knockdowns_taken += 1
                atk.knockdowns_scored += 1
                dfn.ragdoll = VerletRagdoll(dfn.x, self.physics.floor_y, facing=1 if dfn.facing_right else -1)
                dfn.ragdoll.apply_knockdown_impulse(knockback_dir * (impulse_force / dfn.mass) * 0.8, -1.6)
                self.referee_counting = True
                self.referee_count = 1
                self.add_commentary(f"🚨 DOWN GOES {dfn.name}! Physical impact knockdown! The referee starts the count!")
    def step(self, tick):
        advance_match(self, tick)

    # --------------------------------------------------------------------------
    # VERLET RAGDOLL RENDERING
    # --------------------------------------------------------------------------
    def render_ragdoll(self, f: Fighter, tick: int):
        rd = f.ragdoll
        if not rd:
            return

        h_x, h_y = int(round(rd.points[0]['x'])), int(round(rd.points[0]['y']))
        c_x, c_y = int(round(rd.points[1]['x'])), int(round(rd.points[1]['y']))
        w_x, w_y = int(round(rd.points[2]['x'])), int(round(rd.points[2]['y']))
        f_x, f_y = int(round(rd.points[3]['x'])), int(round(rd.points[3]['y']))

        glove_col = PAL['glove_titan'] if f.is_titan else PAL['glove_phantom']
        trunks_col = PAL['trunks_titan'] if f.is_titan else PAL['trunks_phantom']
        hair_col = PAL['hair_titan'] if f.is_titan else PAL['hair_phantom']

        def set_px(px, py, col):
            if 0 <= px < self.w and 0 <= py < self.h and col:
                self.buf[py][px] = col

        def draw_line(x0, y0, x1, y1, col, thick=1):
            dist = max(1, int(math.hypot(x1 - x0, y1 - y0) * 1.5))
            for step_i in range(dist + 1):
                t = step_i / dist
                ix = int(round(x0 + (x1 - x0) * t))
                iy = int(round(y0 + (y1 - y0) * t))
                for d in range(-thick, thick + 1):
                    if abs(x1 - x0) > abs(y1 - y0):
                        set_px(ix, iy + d, col)
                    else:
                        set_px(ix + d, iy, col)

        # ----------------------------------------------------------------------
        # A. DYNAMIC EXPANDING VISCERAL BLOOD POOL ON CANVAS
        # ----------------------------------------------------------------------
        # Pool expands under head and upper torso as referee counts
        pool_rx = min(9, 4 + int(self.referee_count * 0.7))
        pool_ry = min(3, 1 + int(self.referee_count * 0.3))
        for pdy in range(-pool_ry, pool_ry + 1):
            for pdx in range(-pool_rx, pool_rx + 1):
                norm_d = (pdx * pdx) / max(1, pool_rx * pool_rx) + (pdy * pdy) / max(1, pool_ry * pool_ry)
                if norm_d <= 1.0:
                    bx = h_x + pdx
                    by = int(self.physics.floor_y) + pdy
                    if 4 <= bx < self.w - 4 and 0 <= by < self.h:
                        if norm_d < 0.45:
                            b_col = PAL['blood_pool']
                        elif norm_d < 0.8:
                            b_col = PAL['blood_dark']
                        else:
                            b_col = PAL['blood']
                        self.blood_stains[(bx, by)] = b_col
                        set_px(bx, by, b_col)

        # Blood trail splatters radiating from knockout impact
        for sp_dx, sp_dy in [(-pool_rx - 1, 0), (pool_rx + 2, 0), (pool_rx - 2, 1), (-pool_rx + 1, -1)]:
            sx, sy = h_x + sp_dx, int(self.physics.floor_y) + sp_dy
            if 4 <= sx < self.w - 4 and 0 <= sy < self.h:
                self.blood_stains[(sx, sy)] = PAL['blood_dark']
                set_px(sx, sy, PAL['blood_dark'])

        # ----------------------------------------------------------------------
        # B. FLESH VOLUME ANATOMY — CONTORTED MANGLED LIMBS & TORSO
        # ----------------------------------------------------------------------
        # 1. Lower Limbs (Pelvis to Feet): thick muscular legs sprawling on canvas
        draw_line(w_x, w_y, f_x, f_y, PAL['skin_mid'], thick=1)
        draw_line(w_x + 1, w_y, f_x + 1, f_y, PAL['skin_dark'], thick=0)
        # Bruised twisted knee
        mid_lx = (w_x + f_x) // 2
        mid_ly = (w_y + f_y) // 2
        set_px(mid_lx, mid_ly, PAL['bruise'])
        set_px(mid_lx + 1, mid_ly, PAL['wound'])
        # Trunks covering upper thighs
        draw_line(w_x, w_y, mid_lx, mid_ly, trunks_col, thick=1)
        set_px(mid_lx - 1, mid_ly, PAL['blood_dark']) # blood on trunks

        # Sprawled boxing boots
        for bdx in (-1, 0, 1):
            for bdy in (0, 1):
                set_px(f_x + bdx, f_y + bdy, PAL['boot'])

        # 2. Torso (Chest to Pelvis): thick torso with bruised ribs and gold waistband
        draw_line(c_x - 1, c_y, w_x - 1, w_y, PAL['skin_mid'], thick=0)
        draw_line(c_x, c_y, w_x, w_y, PAL['skin_mid'], thick=1)
        draw_line(c_x + 1, c_y, w_x + 1, w_y, PAL['skin_dark'], thick=0)
        # Gold waistband draped over pelvis
        for dx in (-2, -1, 0, 1, 2):
            set_px(w_x + dx, w_y, PAL['waist_gold'])
            set_px(w_x + dx, w_y + 1, trunks_col)
        # Liver trauma purple hematoma on flank
        set_px(w_x - 1, w_y - 1, PAL['hematoma'])
        set_px(w_x, w_y - 1, PAL['wound'])

        # 3. Sprawled Flung Arms & Heavy Gloves
        g_off = -3 if f.facing_right else 3
        # Left arm flung behind
        draw_line(c_x, c_y, c_x + g_off, c_y - 1, PAL['skin_mid'], thick=1)
        for gdx in (-1, 0):
            for gdy in (-1, 0):
                set_px(c_x + g_off + gdx, c_y - 1 + gdy, glove_col)
        # Right arm limp on the floor
        draw_line(c_x, c_y, c_x - g_off, int(self.physics.floor_y), PAL['skin_mid'], thick=1)
        for gdx in (-1, 0, 1):
            for gdy in (-1, 0):
                set_px(c_x - g_off + gdx, int(self.physics.floor_y) + gdy, glove_col)

        # 4. Upper neck & throat connecting to head
        draw_line(h_x, h_y, c_x, c_y, PAL['skin_mid'], thick=1)
        set_px(c_x, c_y - 1, PAL['blood_dark']) # blood running down neck

        # ----------------------------------------------------------------------
        # C. SMASHED BLOODY HEAD & MANGLED FACIAL TRAUMA
        # ----------------------------------------------------------------------
        # Head volume 3x3 at (h_x, h_y)
        for dx in (-1, 0, 1):
            for dy in (-1, 0, 1):
                if dy == -1 or abs(dx) == 1:
                    set_px(h_x + dx, h_y + dy, hair_col)
                else:
                    set_px(h_x + dx, h_y + dy, PAL['skin_light'])

        # Blackened swollen shut hematoma eye
        set_px(h_x, h_y, PAL['hematoma'])
        # Deep open eyebrow gash weeping fresh arterial blood
        set_px(h_x + 1, h_y - 1, PAL['gash'])
        set_px(h_x + 1, h_y, PAL['blood_bright'])
        # Crushed bloody nose streaming down into the floor pool
        set_px(h_x, h_y + 1, PAL['blood_bright'])
        set_px(h_x - 1, h_y + 1, PAL['blood'])

        # ----------------------------------------------------------------------
        # D. SCATTERED TEETH & DISLODGED MOUTHGUARD
        # ----------------------------------------------------------------------
        # Dislodged white tooth stubs scattered on the canvas beside the face
        tooth_dir = 1 if f.facing_right else -1
        set_px(h_x + (tooth_dir * 3), int(self.physics.floor_y), PAL['bone'])
        set_px(h_x + (tooth_dir * 5), int(self.physics.floor_y), PAL['bone'])
        if f.injury.jaw_concussion > 30.0:
            set_px(h_x + (tooth_dir * 4), int(self.physics.floor_y) - 1, PAL['bone'])

        # Bloody ejected mouthguard lying in the pool
        if not f.injury.has_mouthguard:
            mg_x = h_x + (tooth_dir * 4)
            mg_y = int(self.physics.floor_y)
            set_px(mg_x, mg_y, PAL['mouthguard'])
            set_px(mg_x + 1, mg_y, PAL['blood'])    # --------------------------------------------------------------------------
    # DYNAMIC PUNCH EXTENSION RENDERING
    # --------------------------------------------------------------------------
    def render_punch_extension(self, atk: Fighter, dfn: Fighter):
        if atk.state not in ('JAB', 'CROSS', 'HOOK', 'UPPERCUT'):
            return
        p = atk.state_frame / max(1, atk.state_duration)
        ext = math.sin(p * math.pi)
        if ext < 0.15:
            return

        sx = int(atk.x + (10 if atk.facing_right else 3))
        sy = int(atk.y + 6)
        
        if atk.punch_target:
            tx, ty = atk.punch_target
        else:
            tx = int(dfn.x + (4 if not atk.facing_right else 9))
            ty = int(dfn.y + 4)
        
        gx = sx + (tx - sx) * ext
        gy = sy + (ty - sy) * ext

        if atk.state == 'UPPERCUT':
            gy += math.sin(p * math.pi) * -3.5 + (1.0 - p) * 2.0
        elif atk.state == 'HOOK':
            if atk.target_zone == 'LIVER':
                gy += math.sin(p * math.pi) * 1.8
            else:
                gy -= math.sin(p * math.pi) * 1.5

        glove_col = PAL['glove_titan'] if atk.is_titan else PAL['glove_phantom']

        def set_px(px, py, col):
            ix, iy = int(round(px)), int(round(py))
            if 0 <= ix < self.w and 0 <= iy < self.h and col:
                self.buf[iy][ix] = col

        # Forearm line
        steps = max(2, int(math.hypot(gx - sx, gy - sy)))
        for s_i in range(steps):
            t = s_i / steps
            ax = sx + (gx - sx) * t
            ay = sy + (gy - sy) * t
            arm_col = PAL['skin_light'] if s_i > steps // 2 else PAL['skin_mid']
            set_px(ax, ay, arm_col)
            set_px(ax, ay + 1, PAL['skin_dark'])

        # Speed trail on power punches
        if ext > 0.65 and atk.state in ('CROSS', 'HOOK', 'UPPERCUT'):
            trail_x = sx + (gx - sx) * (ext * 0.72)
            trail_y = sy + (gy - sy) * (ext * 0.72)
            set_px(trail_x, trail_y, PAL['trail'])
            set_px(trail_x, trail_y + 1, PAL['sweat'])

        # Glove block
        igx, igy = int(round(gx)), int(round(gy))
        for dx in (0, 1 if atk.facing_right else -1):
            for dy in (-1, 0):
                set_px(igx + dx, igy + dy, glove_col)

    # --------------------------------------------------------------------------
    # RINGSIDE DRAMA: REFEREE & DOCTOR
    # --------------------------------------------------------------------------
    def render_referee(self, down_f: Fighter):
        rx = max(18, min(self.w - 18, int(down_f.x + (13 if down_f.x < self.w // 2 else -13))))
        ry = 13
        
        def set_px(px, py, col):
            if 0 <= px < self.w and 0 <= py < self.h and col:
                self.buf[py][px] = col

        # Head
        for dx in (-1, 0, 1):
            set_px(rx + dx, ry, PAL['hair_phantom'])
            set_px(rx + dx, ry + 1, PAL['ref_skin'])
        set_px(rx, ry + 2, PAL['ref_skin'])
        
        # Striped Shirt
        for y in range(ry + 3, ry + 7):
            for dx, ch in enumerate(['w', 'b', 'w', 'b']):
                col = PAL['ref_white'] if ch == 'w' else PAL['ref_black']
                set_px(rx - 1 + dx, y, col)
        
        # Trousers
        for y in range(ry + 7, ry + 10):
            set_px(rx - 1, y, PAL['ref_black'])
            set_px(rx + 1, y, PAL['ref_black'])
        set_px(rx - 1, ry + 10, PAL['boot'])
        set_px(rx + 1, ry + 10, PAL['boot'])

        # Counting gesture
        arm_down = (self.clock_tick % 10) >= 5
        arm_y = ry + (5 if arm_down else 0)
        arm_x = rx + (3 if down_f.x > rx else -3)
        set_px(arm_x, arm_y, PAL['ref_skin'])
        set_px(arm_x, arm_y + 1, PAL['ref_white'])
        # Star flash on count
        set_px(arm_x, arm_y - 1, PAL['star'])

    def render_doctor(self, injured_f: Fighter):
        dx = int(injured_f.x + (13 if injured_f.facing_right else -5))
        dy = 13

        def set_px(px, py, col):
            if 0 <= px < self.w and 0 <= py < self.h and col:
                self.buf[py][px] = col

        # Doctor head
        for ox in (-1, 0, 1):
            set_px(dx + ox, dy, PAL['hair_titan'])
            set_px(dx + ox, dy + 1, PAL['skin_light'])
        
        # White coat with red cross
        for y in range(dy + 2, dy + 8):
            for ox in (-1, 0, 1):
                set_px(dx + ox, y, PAL['doc_coat'])
        set_px(dx, dy + 4, PAL['doc_cross'])
        set_px(dx - 1, dy + 4, PAL['doc_cross'])
        set_px(dx + 1, dy + 4, PAL['doc_cross'])
        set_px(dx, dy + 3, PAL['doc_cross'])
        set_px(dx, dy + 5, PAL['doc_cross'])

        # Penlight inspection
        target_eye_x = int(injured_f.x + (8 if injured_f.facing_right else 5))
        set_px(target_eye_x, int(injured_f.y + 3), PAL['spark'])

    # --------------------------------------------------------------------------
    # 64-BIT PIXEL COMPOSITOR & TERMINAL RENDERER
    # --------------------------------------------------------------------------
    def render_frame(self, tick):
        # 1. Arena backdrop and overhead spotlights
        for y in range(self.h):
            for x in range(self.w):
                spot = max(0.0, 1.0 - (((x - self.w//2)**2 + (y - 4)**2) / 680.0))
                r = int(PAL['bg'][0] + spot * 32)
                g = int(PAL['bg'][1] + spot * 32)
                b = int(PAL['bg'][2] + spot * 42)
                self.buf[y][x] = (r, g, b)

        # 2. Ring Corner Turnbuckles
        for y in range(3, 23):
            for x in range(2, 5):
                self.buf[y][x] = PAL['post_red']
            for x in range(self.w - 5, self.w - 2):
                self.buf[y][x] = PAL['post_blu']

        # 3. Canvas base & Apron
        for y in range(17, 26):
            shade = 1.0 + (y - 17) * 0.035
            for x in range(4, self.w - 4):
                self.buf[y][x] = (min(255, int(PAL['canvas'][0] * shade)),
                                  min(255, int(PAL['canvas'][1] * shade)),
                                  min(255, int(PAL['canvas'][2] * shade)))

        for y in range(26, self.h):
            for x in range(self.w):
                self.buf[y][x] = PAL['apron']

        # 4. Canvas persistent blood stains
        for (sx, sy), col in self.blood_stains.items():
            if 0 <= sx < self.w and 0 <= sy < self.h:
                self.buf[sy][sx] = col

        # 5. Canvas Debris (ejected mouthguards)
        for obj in self.physics.canvas_objects:
            ox = obj['x']
            oy = obj['y']
            if 0 <= ox < self.w and 0 <= oy < self.h:
                self.buf[oy][ox] = obj['col']
                if ox + 1 < self.w:
                    self.buf[oy][ox+1] = PAL['blood']

        # 6. Back Ropes (rendered before fighters)
        for rope in self.physics.ropes[:2]:
            col = rope['col']
            nodes = rope['nodes']
            for x in range(5, self.w - 5):
                ry = int(round(nodes[x]))
                if 0 <= ry < self.h:
                    self.buf[ry][x] = col

        # 7. Referee / Doctor ringside presence
        if self.referee_counting:
            down_f = self.f1 if self.f1.state == 'DOWN' else self.f2
            self.render_referee(down_f)
        elif self.doctor_inspecting:
            inj_f = self.f1 if self.f1.injury.has_severe_cut() else self.f2
            self.render_doctor(inj_f)

        # 8. Slingshot momentum speed lines
        for f in (self.f1, self.f2):
            if abs(f.vx) > 0.6:
                streak_dir = -1 if f.vx > 0 else 1
                for s_dist in (1, 2, 3):
                    sx = int(f.x + 7 + streak_dir * s_dist * 3)
                    sy = int(self.physics.floor_y - 1)
                    if 4 <= sx < self.w - 4:
                        self.buf[sy][sx] = PAL['trail']

        # 9. Fighters (Sprites or Ragdolls)
        if self.f1.state == 'DOWN' and self.f1.ragdoll:
            self.render_ragdoll(self.f1, tick)
        else:
            m1 = self.f1.get_pixel_matrix(tick)
            self.stamp_sprite(m1, int(self.f1.x), int(self.f1.y), is_titan=True, flip=False)

        if self.f2.state == 'DOWN' and self.f2.ragdoll:
            self.render_ragdoll(self.f2, tick)
        else:
            m2 = self.f2.get_pixel_matrix(tick)
            self.stamp_sprite(m2, int(self.f2.x), int(self.f2.y), is_titan=False, flip=True)

        # 10. Dynamic Punch Extensions across distance
        if self.f1.state in ('JAB', 'CROSS', 'HOOK', 'UPPERCUT'):
            self.render_punch_extension(self.f1, self.f2)
        if self.f2.state in ('JAB', 'CROSS', 'HOOK', 'UPPERCUT'):
            self.render_punch_extension(self.f2, self.f1)

        # 11. Bottom Front Rope (rendered over fighters for 3D ring depth)
        bot_rope = self.physics.ropes[2]
        col = bot_rope['col']
        nodes = bot_rope['nodes']
        for x in range(5, self.w - 5):
            ry = int(round(nodes[x]))
            if 0 <= ry < self.h:
                # Wrap over fighters when pressed into ropes
                self.buf[ry][x] = col

        # 12. Projectiles (Blood drops, sweat mist, flying mouthguard)
        for p in self.physics.projectiles:
            px = int(p['x'])
            py = int(p['y'])
            if 0 <= px < self.w and 0 <= py < self.h:
                self.buf[py][px] = p['col']
                if p['type'] == 'mouthguard' and px + 1 < self.w:
                    self.buf[py][px+1] = PAL['eye_white']

        # 13. Directional Hit Spark Bursts
        for s in self.hit_sparks:
            sx = int(s['x'])
            sy = int(s['y'])
            rad = 3 - s['life']
            if 0 <= sx < self.w and 0 <= sy < self.h:
                self.buf[sy][sx] = PAL['spark']
            if rad >= 1:
                for (dx, dy) in [(-rad, 0), (rad, 0), (0, -rad), (0, rad)]:
                    qx, qy = sx + dx, sy + dy
                    if 0 <= qx < self.w and 0 <= qy < self.h:
                        self.buf[qy][qx] = PAL['spark_yel']
            if rad >= 2:
                for (dx, dy) in [(-rad, -rad), (rad, -rad), (-rad, rad), (rad, rad)]:
                    qx, qy = sx + dx, sy + dy
                    if 0 <= qx < self.w and 0 <= qy < self.h:
                        self.buf[qy][qx] = PAL['spark']

        # 14. Compose 64-bit Half-Block TrueColor Terminal Output
        terminal_lines = []
        for row in range(self.h // 2):
            y_top = row * 2
            y_bot = row * 2 + 1
            line = []
            cur_top, cur_bot = None, None
            for x in range(self.w):
                top = self.buf[y_top][x]
                bot = self.buf[y_bot][x]
                if top != cur_top or bot != cur_bot:
                    line.append(f'\033[38;2;{top[0]};{top[1]};{top[2]};48;2;{bot[0]};{bot[1]};{bot[2]}m')
                    cur_top, cur_bot = top, bot
                line.append('▀')
            line.append('\033[0m')
            terminal_lines.append(''.join(line))

        return terminal_lines

    def stamp_sprite(self, matrix, x_pos, y_pos, is_titan=True, flip=False):
        for r, row in enumerate(matrix):
            if flip:
                row = row[::-1]
            py = y_pos + r
            if 0 <= py < self.h:
                for c, ch in enumerate(row):
                    px = x_pos + c
                    if 0 <= px < self.w:
                        col = None
                        if ch == 'G':
                            col = PAL['glove_titan'] if is_titan else PAL['glove_phantom']
                        elif ch == 'T':
                            col = PAL['trunks_titan'] if is_titan else PAL['trunks_phantom']
                        elif ch == 'H':
                            col = PAL['hair_titan'] if is_titan else PAL['hair_phantom']
                        elif ch == 'L':
                            col = PAL['skin_light']
                        elif ch == 'M':
                            col = PAL['skin_mid']
                        elif ch == 'D':
                            col = PAL['skin_dark']
                        elif ch == 'E':
                            col = PAL['eye_white']
                        elif ch == 'W':
                            col = PAL['waist_gold']
                        elif ch == 'B':
                            col = PAL['boot']
                        elif ch == 'b':
                            col = PAL['bruise']
                        elif ch == 'h':
                            col = PAL['hematoma']
                        elif ch == 'g':
                            col = PAL['gash']
                        elif ch == 'w':
                            col = PAL['wound']
                        elif ch == 'c':
                            col = PAL['blood']
                        elif ch == 'C':
                            col = PAL['blood_bright']
                        elif ch == 'k':
                            col = PAL['blood_dark']
                        elif ch == 'o':
                            col = PAL['bone']
                        elif ch == '=':
                            col = PAL['mouthguard']
                        elif ch == 'X':
                            col = PAL['bruise']
                        if col:
                            self.buf[py][px] = col

# ==============================================================================
# TERMINAL HUD & LIVE TELEMETRY DISPLAY
# ==============================================================================
def draw_bar(pct, width=16, fill_color="\033[38;2;166;227;161m", empty_char="░"):
    pct = max(0.0, min(100.0, float(pct)))
    fill_n = int(round(width * pct / 100.0))
    bar = f"{fill_color}{'█' * fill_n}\033[38;2;88;91;112m{empty_char * (width - fill_n)}\033[0m"
    return bar

def render_full_screen(arena: BoxingArena, tick: int):
    C_RST = "\033[0m"
    C_RED = "\033[38;2;243;139;168m"
    C_BLU = "\033[38;2;137;180;250m"
    C_MAU = "\033[38;2;203;166;247m"
    C_YEL = "\033[38;2;249;226;175m"
    C_GRN = "\033[38;2;166;227;161m"
    C_SUB = "\033[38;2;147;154;183m"
    C_BLD = "\033[1m"

    out = []
    
    sec_left = max(0, arena.round_time_sec - (getattr(arena, 'round_tick', arena.clock_tick) // 4))
    clock_str = f"{sec_left // 60:02d}:{sec_left % 60:02d}"
    out.append(f"{C_MAU}{C_BLD}  OSTADIX BOXING · 64-BIT PIXEL INJURY & 2D PHYSICS ENGINE{C_RST}  {C_YEL}R{arena.round_num}/{arena.max_rounds} [{clock_str}]{C_RST}")

    f1_hp_col = C_GRN if arena.f1.hp > 60 else (C_YEL if arena.f1.hp > 30 else C_RED)
    f2_hp_col = C_GRN if arena.f2.hp > 60 else (C_YEL if arena.f2.hp > 30 else C_RED)
    
    hp1 = draw_bar(arena.f1.hp, 14, f1_hp_col)
    hp2 = draw_bar(arena.f2.hp, 14, f2_hp_col)
    stm1 = draw_bar(arena.f1.stamina, 8, C_BLU)
    stm2 = draw_bar(arena.f2.stamina, 8, C_BLU)

    out.append(f"  {C_RED}{C_BLD}TITAN{C_RST} {hp1} {arena.f1.hp:4.0f} HP │ {stm1} STM  {C_SUB}VS{C_RST}  STM {stm2} │ {hp2} {arena.f2.hp:4.0f} HP {C_BLU}{C_BLD}PHANTOM{C_RST}")

    for f, color in ((arena.f1, C_RED), (arena.f2, C_BLU)):
        inj = f.injury
        eyes = f"L {inj.l_eye_swelling:.0f}{' SHUT' if inj.is_left_eye_shut() else ''} / R {inj.r_eye_swelling:.0f}{' SHUT' if inj.is_right_eye_shut() else ''}"
        out.append(f"  {color}{f.name:7}{C_RST} EYES {eyes} · CUTS L {inj.l_brow_cut:.0f} / R {inj.r_brow_cut:.0f} · JAW {inj.jaw_concussion:.0f} · LIVER {inj.liver_trauma:.0f}")
    out.append(f"  {C_SUB}PHYS:{C_RST} TITAN {arena.f1.mass:.0f}kg / vx {arena.f1.vx:+.1f} │ PHANTOM {arena.f2.mass:.0f}kg / vx {arena.f2.vx:+.1f}")
    for f, color in ((arena.f1, C_RED), (arena.f2, C_BLU)):
        out.append(f"  {color}{f.name:7}{C_RST} DAMAGE {f.damage_dealt:.1f} + DANGER {f.finishing_threat:.1f} = {f.damage_dealt + f.finishing_threat:.1f}")

    ring_lines = arena.render_frame(tick)
    for line in ring_lines:
        out.append("  " + line)

    out.append(f"  {C_MAU}{'─' * 74}{C_RST}")
    for c_msg in arena.commentary_log[-2:]:
        out.append(f"  {c_msg}")
    out.append(f"  {C_SUB}Space pause · 1/2 inspect fighter · i inspect both · q stop · full injury replay saved after match{C_RST}")

    return "\n".join(out)

# ==============================================================================
# LOCKSTEP FIGHTER WORKERS AND SHARED MATCH RULES
# ==============================================================================
def canonical_json(value):
    return json.dumps(value, sort_keys=True, separators=(',', ':'), allow_nan=False)

def state_digest(value):
    return hashlib.sha256(canonical_json(value).encode()).hexdigest()

def fighter_to_data(fighter):
    data = copy.deepcopy(vars(fighter))
    data['injury'] = copy.deepcopy(vars(fighter.injury))
    data['ragdoll'] = copy.deepcopy(vars(fighter.ragdoll)) if fighter.ragdoll else None
    return data

def fighter_from_data(data):
    # Explicit JSON state only; no pickle or executable object deserialization.
    data = copy.deepcopy(data)
    fighter = Fighter(data['name'], data['corner'], data['style'], data['x'], data['mass'], data['is_titan'])
    expected = set(vars(fighter))
    if set(data) != expected:
        raise ValueError('fighter state fields do not match this engine')
    for key, default in vars(fighter).items():
        value = data[key]
        if isinstance(default, bool):
            if type(value) is not bool:
                raise ValueError('invalid fighter flag: ' + key)
        elif isinstance(default, (int, float)):
            require_number(value)
        elif isinstance(default, str) and not isinstance(value, str):
            raise ValueError('invalid fighter text: ' + key)
    if data['state'] not in ('IDLE', 'ADVANCE', 'RETREAT', 'JAB', 'CROSS', 'HOOK', 'UPPERCUT',
                              'GUARD', 'SLIP', 'HURT', 'WOBBLE', 'DOWN', 'VICTORY'):
        raise ValueError('unknown fighter state')
    if data['punch_type'] not in (None, 'JAB', 'CROSS', 'HOOK', 'UPPERCUT'):
        raise ValueError('unknown punch type')
    if data['punch_target'] is not None:
        if not isinstance(data['punch_target'], (list, tuple)) or len(data['punch_target']) != 2:
            raise ValueError('invalid punch target')
        for value in data['punch_target']:
            require_number(value)
    injury = InjurySystem(data['name'])
    if not set(vars(injury)) <= set(data['injury']) or set(data['injury']) - set(vars(injury)) - {'last_exam_severity'}:
        raise ValueError('invalid injury fields')
    for key, value in data['injury'].items():
        if key == 'name':
            if value != data['name']:
                raise ValueError('injury owner mismatch')
        elif key in ('doc_checked', 'doc_stopped', 'has_mouthguard'):
            if type(value) is not bool:
                raise ValueError('invalid injury flag')
        else:
            require_number(value)
            if value < 0:
                raise ValueError('negative injury value')
    injury.__dict__.update(data.pop('injury'))
    ragdoll_data = data.pop('ragdoll')
    ragdoll = None
    if ragdoll_data is not None:
        ragdoll = VerletRagdoll(data['x'], 23.0)
        if set(ragdoll_data) != set(vars(ragdoll)) or len(ragdoll_data['points']) != 4:
            raise ValueError('invalid ragdoll state')
        for point in ragdoll_data['points']:
            if set(point) != {'x', 'y', 'ox', 'oy'}:
                raise ValueError('invalid ragdoll point')
            for value in point.values():
                require_number(value)
        if len(ragdoll_data['lengths']) != 3:
            raise ValueError('invalid ragdoll lengths')
        for value in ragdoll_data['lengths']:
            require_number(value)
        require_number(ragdoll_data['facing'])
        if type(ragdoll_data['settled']) is not bool:
            raise ValueError('invalid ragdoll flag')
        ragdoll.__dict__.update(ragdoll_data)
    fighter.__dict__.update(data)
    fighter.injury, fighter.ragdoll = injury, ragdoll
    return fighter

def match_snapshot(arena, tick):
    return {
        'schema': 'boxing.snapshot/v1', 'match_id': arena.match_id,
        'tick': tick, 'seed': arena.seed,
        'fighters': {'red': fighter_to_data(arena.f1), 'blue': fighter_to_data(arena.f2)},
        'physics': copy.deepcopy(vars(arena.physics)),
        'blood_stains': [[x, y, list(col)] for (x, y), col in sorted(arena.blood_stains.items())],
        'active': not (arena.match_over or arena.doctor_inspecting or arena.referee_counting),
    }

def compute_fighter(snapshot, side):
    if snapshot['schema'] != 'boxing.snapshot/v1' or side not in ('red', 'blue'):
        raise ValueError('invalid fighter request')
    # A per-tick, per-fighter seed makes results independent of network ordering.
    saved_rng = random.getstate()
    random.seed(str(snapshot['seed']) + ':' + str(snapshot['tick']) + ':' + side)
    try:
        world = BoxingArena()
        world.f1 = fighter_from_data(snapshot['fighters']['red'])
        world.f2 = fighter_from_data(snapshot['fighters']['blue'])
        world.physics.__dict__.update(copy.deepcopy(snapshot['physics']))
        world.blood_stains = {(x, y): col for x, y, col in snapshot['blood_stains']}
        world.commentary_log = []
        fighter, opponent = (world.f1, world.f2) if side == 'red' else (world.f2, world.f1)
        old_rope_vel = [r['vel'][:] for r in world.physics.ropes]
        old_projectiles = len(world.physics.projectiles)
        world.step_kinematics(fighter)
        if snapshot['active']:
            world.update_ai_fighter(fighter, opponent, snapshot['tick'])
        elif fighter.ragdoll:
            fighter.ragdoll.step(world.physics.floor_y)
        return {
            'schema': 'boxing.fighter-step/v1', 'match_id': snapshot['match_id'],
            'tick': snapshot['tick'], 'side': side, 'snapshot_sha256': state_digest(snapshot),
            'fighter': fighter_to_data(fighter),
            'rope_impulses': [[v - old for v, old in zip(r['vel'], prior)]
                              for r, prior in zip(world.physics.ropes, old_rope_vel)],
            'projectiles': world.physics.projectiles[old_projectiles:],
            'commentary': world.commentary_log,
            'down': fighter.state == 'DOWN' and snapshot['fighters'][side]['state'] != 'DOWN',
        }
    finally:
        random.setstate(saved_rng)

def validate_plain_state(value):
    if isinstance(value, float) and not math.isfinite(value):
        raise ValueError('non-finite worker state')
    if isinstance(value, dict):
        for child in value.values():
            validate_plain_state(child)
    elif isinstance(value, (list, tuple)):
        for child in value:
            validate_plain_state(child)

def require_number(value):
    if type(value) not in (int, float) or not math.isfinite(value):
        raise ValueError('worker physics value must be a finite number')

def apply_fighter_steps(arena, snapshot, replies):
    # Validate the complete pair before committing either fighter.
    if set(replies) != {'red', 'blue'}:
        raise ValueError('both fighter replies required')
    fighters = []
    digest = state_digest(snapshot)
    for side in ('red', 'blue'):
        reply = replies[side]
        validate_plain_state(reply)
        for key, expected in [('schema', 'boxing.fighter-step/v1'), ('match_id', snapshot['match_id']),
                              ('tick', snapshot['tick']), ('side', side), ('snapshot_sha256', digest)]:
            if reply.get(key) != expected:
                raise ValueError('stale or mismatched worker reply: ' + key)
        fighter = fighter_from_data(reply['fighter'])
        original = snapshot['fighters'][side]
        for key in ('name', 'corner', 'style', 'mass', 'is_titan', 'facing_right'):
            if getattr(fighter, key) != original[key]:
                raise ValueError('worker changed fighter identity: ' + key)
        for key in ('damage_dealt', 'finishing_threat'):
            if getattr(fighter, key) != original[key]:
                raise ValueError('only the referee may credit inflicted damage: ' + key)
        if not (10 <= fighter.x <= arena.w - 24 and 0 <= fighter.hp <= 100 and 0 <= fighter.stamina <= 100):
            raise ValueError('worker fighter bounds invalid')
        if len(reply['rope_impulses']) != 3 or any(len(row) != arena.w for row in reply['rope_impulses']):
            raise ValueError('invalid rope impulses')
        for row in reply['rope_impulses']:
            for value in row:
                require_number(value)
        if not isinstance(reply['projectiles'], list):
            raise ValueError('invalid worker projectiles')
        for projectile in reply['projectiles']:
            if set(projectile) != {'type', 'x', 'y', 'vx', 'vy', 'drag', 'restitution', 'life', 'col'}:
                raise ValueError('invalid worker projectile fields')
            if projectile['type'] != 'sweat':
                raise ValueError('fighter workers may only emit traction sweat')
            for key in ('x', 'y', 'vx', 'vy', 'drag', 'restitution', 'life'):
                require_number(projectile[key])
            if len(projectile['col']) != 3:
                raise ValueError('invalid projectile color')
            for component in projectile['col']:
                require_number(component)
                if not 0 <= component <= 255:
                    raise ValueError('projectile color out of range')
        if not isinstance(reply['down'], bool) or not all(isinstance(msg, str) for msg in reply['commentary']):
            raise ValueError('invalid fighter events')
        fighters.append(fighter)
    arena.f1, arena.f2 = fighters
    for side in ('red', 'blue'):
        reply = replies[side]
        for rope, impulse in zip(arena.physics.ropes, reply['rope_impulses']):
            rope['vel'] = [v + dv for v, dv in zip(rope['vel'], impulse)]
        arena.physics.projectiles.extend(reply['projectiles'])
        for message in reply['commentary']:
            arena.add_commentary(message)
        if reply['down']:
            opponent = arena.f2 if side == 'red' else arena.f1
            fighter = arena.f1 if side == 'red' else arena.f2
            opponent.knockdowns_scored += 1
            opponent.damage_dealt += max(0, snapshot['fighters'][side]['hp'] - fighter.hp)
            opponent.finishing_threat += 20.0
            arena.referee_counting, arena.referee_count = True, 1

def injury_severity(fighter):
    return max(fighter.injury.l_brow_cut, fighter.injury.r_brow_cut,
               fighter.injury.l_eye_swelling, fighter.injury.r_eye_swelling)

def knock_down(arena, fighter, opponent, impulse):
    if fighter.state == 'DOWN':
        return
    fighter.state, fighter.state_frame = 'DOWN', 0
    fighter.knockdowns_taken += 1
    opponent.knockdowns_scored += 1
    fighter.ragdoll = VerletRagdoll(fighter.x, arena.physics.floor_y, 1 if fighter.facing_right else -1)
    fighter.ragdoll.apply_knockdown_impulse(impulse, -1.6)
    arena.referee_counting, arena.referee_count = True, 1

def finish_match(arena, winner, method):
    arena.match_over, arena.winner, arena.ko_type = True, winner, method
    arena.scores = [f.damage_dealt + f.finishing_threat for f in (arena.f1, arena.f2)]
    if winner:
        winner.state = 'VICTORY'
    arena.add_commentary('RESULT: ' + (winner.name if winner else 'DRAW') + ' — ' + method)

def record_injury_change(arena, fighter, before, attacker=None, punch=None, zone=None, damage=0, finishing_threat=0):
    changes = {key: {'before': value, 'after': vars(fighter.injury).get(key)}
               for key, value in before.items() if vars(fighter.injury).get(key) != value}
    if changes or damage:
        arena.events.append({'tick': arena.current_tick, 'round': arena.round_num,
                             'fighter': fighter.name, 'attacker': attacker, 'punch': punch,
                             'zone': zone, 'damage': damage, 'finishing_threat': finishing_threat, 'changes': changes})

def finishing_threat_delta(before, after, knockdowns=0):
    # Arcade finishing danger, not a clinical scale or mortality probability.
    weights = {'jaw_concussion': 1.5, 'liver_trauma': 1.25, 'rib_fracture': 0.5,
               'nose_fracture': 0.25, 'l_eye_swelling': 0.25, 'r_eye_swelling': 0.25,
               'l_brow_cut': 0.15, 'r_brow_cut': 0.15}
    return sum(max(0, after.get(key, 0) - before.get(key, 0)) * weight
               for key, weight in weights.items()) + 20.0 * knockdowns

def score_round(arena):
    # Damage and finishing danger accumulate across the entire match. Hit count
    # alone earns no points, and corner recovery does not erase inflicted harm.
    totals = [(f.damage_dealt, f.finishing_threat) for f in (arena.f1, arena.f2)]
    delta = [[now - old for now, old in zip(total, base)] for total, base in zip(totals, arena.round_baseline)]
    # SCORE POLICY: this small block is the customization point for judging.
    arena.scores = [damage + threat for damage, threat in totals]
    arena.scorecards.append({'round': arena.round_num, 'points': [sum(d) for d in delta],
                            'damage': [d[0] for d in delta], 'finishing_threat': [d[1] for d in delta]})
    arena.round_baseline = totals
    if arena.round_num >= arena.max_rounds:
        winner = None if math.isclose(arena.scores[0], arena.scores[1], abs_tol=1e-9) else (arena.f1 if arena.scores[0] > arena.scores[1] else arena.f2)
        finish_match(arena, winner, 'DRAW (damage + finishing danger)' if winner is None else 'DECISION (damage + finishing danger)')
    else:
        arena.round_num += 1
        arena.round_tick = 0
        for f, x in ((arena.f1, 16), (arena.f2, 46)):
            before = dict(vars(f.injury))
            f.injury.apply_cutman_treatments()
            f.injury.last_exam_severity = 0
            f.hp, f.stamina, f.guard = min(100, f.hp + 12), min(100, f.stamina + 35), 100
            f.x, f.vx, f.state, f.state_frame, f.ragdoll = x, 0, 'IDLE', 0, None
            record_injury_change(arena, f, before, zone='CORNER TREATMENT')
        arena.add_commentary('BELL! Round ' + str(arena.round_num))

def advance_match(arena, tick, transport=None):
    if arena.match_over:
        return
    snapshot = match_snapshot(arena, tick)
    replies = transport.steps(snapshot) if transport else {side: compute_fighter(snapshot, side) for side in ('red', 'blue')}
    apply_fighter_steps(arena, snapshot, replies)
    arena.current_tick = tick
    arena.clock_tick += 1
    arena.scores = [f.damage_dealt + f.finishing_threat for f in (arena.f1, arena.f2)]
    for side, fighter in (('red', arena.f1), ('blue', arena.f2)):
        collapse = replies[side]['down']
        opponent = arena.f2 if side == 'red' else arena.f1
        record_injury_change(arena, fighter, snapshot['fighters'][side]['injury'],
                             attacker=opponent.name if collapse else None,
                             punch='DELAYED LIVER COLLAPSE' if collapse else None,
                             zone='LIVER' if collapse else 'FIGHTER UPDATE',
                             damage=max(0, snapshot['fighters'][side]['hp'] - fighter.hp),
                             finishing_threat=20.0 if collapse else 0)
    # Shared torso contact: fighters cannot pass through each other. Preserve
    # their combined horizontal momentum when approaching into contact.
    if arena.f1.state != 'DOWN' and arena.f2.state != 'DOWN' and arena.f2.x - arena.f1.x < 8:
        a, b = arena.f1, arena.f2
        overlap = 8 - (b.x - a.x)
        a.x -= overlap * b.mass / (a.mass + b.mass)
        b.x += overlap * a.mass / (a.mass + b.mass)
        shift = max(0, 10 - a.x) - max(0, b.x - (arena.w - 24))
        a.x, b.x = a.x + shift, b.x + shift
        if a.vx > b.vx:
            a.vx = b.vx = (a.mass * a.vx + b.mass * b.vx) / (a.mass + b.mass)
    random.seed(str(arena.seed) + ':' + str(tick) + ':referee')
    arena.physics.step_ropes()
    arena.physics.step_projectiles(arena.blood_stains)
    arena.hit_sparks = [dict(s, life=s['life'] - 1) for s in arena.hit_sparks if s['life'] > 1]
    for f in (arena.f1, arena.f2):
        before = dict(vars(f.injury))
        f.injury.blood_loss_ml += (f.injury.l_brow_cut + f.injury.r_brow_cut + f.injury.nose_fracture) * 0.0025
        record_injury_change(arena, f, before, zone='BLEEDING')

    # A count takes precedence over a physician exam initiated by the same hit.
    if arena.referee_counting:
        down = [f for f in (arena.f1, arena.f2) if f.state == 'DOWN']
        if not down:
            arena.referee_counting = False
            return
        if arena.clock_tick % 4 == 0:
            arena.referee_count += 1
            if arena.referee_count >= 10:
                winner = None if len(down) == 2 else (arena.f2 if down[0] is arena.f1 else arena.f1)
                finish_match(arena, winner, 'DOUBLE KNOCKOUT' if winner is None else 'KNOCKOUT (10-count)')
            elif arena.referee_count >= 8:
                for f in down:
                    if f.knockdowns_taken < 3 and f.injury.jaw_concussion < 85 and random.random() < 0.65:
                        f.state, f.state_frame, f.hp, f.ragdoll = 'IDLE', 0, 25.0, None
                arena.referee_counting = any(f.state == 'DOWN' for f in down)
        return
    if arena.doctor_inspecting:
        arena.doctor_timer -= 1
        if arena.doctor_timer <= 0:
            arena.doctor_inspecting = False
            fighter = arena.f1 if arena.doctor_fighter == 'red' else arena.f2
            if injury_severity(fighter) >= 95:
                fighter.injury.doc_stopped = True
                finish_match(arena, arena.f2 if fighter is arena.f1 else arena.f1, 'TKO (ringside physician)')
        return

    # Alternate contact priority, independent of response arrival order.
    pairs = [(arena.f1, arena.f2), (arena.f2, arena.f1)]
    if tick % 2:
        pairs.reverse()
    for attacker, defender in pairs:
        if arena.referee_counting:
            break
        before, hp, knockdowns = dict(vars(defender.injury)), defender.hp, defender.knockdowns_taken
        arena.check_punch_collisions(attacker, defender)
        damage = max(0, hp - defender.hp)
        threat = finishing_threat_delta(before, vars(defender.injury), defender.knockdowns_taken - knockdowns)
        attacker.damage_dealt += damage
        attacker.finishing_threat += threat
        record_injury_change(arena, defender, before, attacker.name, attacker.punch_type,
                             defender.last_hurt_zone, damage, threat)
    arena.scores = [f.damage_dealt + f.finishing_threat for f in (arena.f1, arena.f2)]
    arena.round_tick += 1
    if arena.round_tick >= arena.round_time_sec * 4 and not (arena.referee_counting or arena.doctor_inspecting):
        score_round(arena)

class BoxingNodes:
    def __init__(self, engine_source, controllers, output_dir):
        from concurrent.futures import ThreadPoolExecutor
        self.engine_source, self.controllers, self.output_dir = engine_source, controllers, Path(output_dir)
        self.octl = os.environ.get('OSTADIX_BOXING_OCTL') or shutil.which('octl')
        self.timeout = int(os.environ.get('OSTADIX_BOXING_NODE_TIMEOUT', '30'))
        if not 1 <= self.timeout <= 86400:
            raise ValueError('node timeout must be 1..86400 seconds')
        self.endpoints, self.pool = {}, None
        remote = {side: node for side, node in controllers.items() if node != 'local'}
        if remote and not self.octl:
            raise RuntimeError('octl is required for node fighters; install the Ostadix node tools')
        if remote:
            listing = self.command(['node', 'list'])
            peers = {p['node_id']: p for p in listing}
            for side, node in remote.items():
                if node not in peers or not peers[node].get('remembered'):
                    raise RuntimeError('Node ' + node + ' is not paired. Use o node pair first.')
                address = os.environ.get('OSTADIX_BOXING_' + side.upper() + '_ADDRESS') or peers[node]['address']
                profile = self.command(['node', 'profile', '--node', node, '--address', address])
                if profile['node_id'] != node:
                    raise RuntimeError('profile identity mismatch')
                self.endpoints[side] = (address, profile['backend_catalog_sha256'])
            (self.output_dir / 'nodes.json').write_text(canonical_json(self.endpoints) + '\n')
            self.pool = ThreadPoolExecutor(max_workers=len(remote))

    def command(self, arguments, source=None):
        proc = subprocess.run([self.octl] + arguments, input=source, text=True, capture_output=True,
                              timeout=self.timeout + 5)
        if proc.returncode:
            if source is not None:
                # Failed native operations still have useful full receipts.
                try:
                    receipt = json.loads(proc.stdout)
                    if receipt.get('schema') == 'ostadix.hosted-operation-receipt/v1':
                        return receipt
                except (ValueError, AttributeError):
                    pass
            raise RuntimeError('octl failed; no retry: ' + (proc.stderr or proc.stdout)[-2000:])
        return json.loads(proc.stdout)

    def remote_step(self, snapshot, side):
        node = self.controllers[side]
        address, catalog = self.endpoints[side]
        encoded = base64.b64encode(canonical_json(snapshot).encode()).decode()
        worker = ('python' + '[91]^(\n'
                  "__oval_result__ = canonical_json(compute_fighter(json.loads(base64.b64decode('" + encoded + "')), '" + side + "'))\n)_" + 'python[91]')
        source = 'O' + '^(\n' + self.engine_source + '\n' + worker + '\n)_' + 'O\n'
        if len(source.encode()) > 1024 * 1024:
            raise RuntimeError('worker document exceeds hosted node 1 MiB limit')
        task = 'boxing-' + snapshot['match_id'] + '-' + str(snapshot['tick']) + '-' + side
        attempt = uuid.uuid4().hex
        receipt_path = self.output_dir / 'receipts' / (str(snapshot['tick']) + '-' + side + '.json')
        receipt_path.parent.mkdir(exist_ok=True)
        try:
            receipt = self.command(['node', 'run', '--node', node, '--address', address,
                '--expected-catalog-sha256', catalog, '--task-id', task, '--attempt-id', attempt,
                '--connect-timeout-seconds', str(min(10, self.timeout)),
                '--io-timeout-seconds', str(self.timeout), '--deadline-seconds', str(self.timeout), '-'], source)
            receipt_path.write_text(canonical_json(receipt) + '\n')
            for key, expected in [('schema', 'ostadix.hosted-operation-receipt/v1'), ('node_id', node),
                                  ('task_id', task), ('attempt_id', attempt),
                                  ('source_sha256', hashlib.sha256(source.encode()).hexdigest())]:
                if receipt.get(key) != expected:
                    raise RuntimeError('node receipt mismatch: ' + key)
            if receipt['outcome']['status'] != 'succeeded':
                raise RuntimeError('node failed: ' + canonical_json(receipt['outcome']))
            value = receipt['outcome']['value']
            if value['t'] == 'text':
                payload = value['v']['utf8']
            elif value['t'] == 'str':
                payload = value['v']
            else:
                raise RuntimeError('worker result must be text JSON')
            return json.loads(payload)
        except Exception as exc:
            receipt_path.with_suffix('.error.json').write_text(canonical_json({
                'node': node, 'task_id': task, 'attempt_id': attempt,
                'tick': snapshot['tick'], 'side': side, 'error': str(exc),
                'completion': 'not accepted; may be unknown', 'retried': False}) + '\n')
            raise

    def steps(self, snapshot):
        pending = {side: self.pool.submit(self.remote_step, snapshot, side)
                   for side in self.endpoints} if self.pool else {}
        replies = {side: compute_fighter(snapshot, side) for side in ('red', 'blue') if side not in pending}
        for side, future in pending.items():
            replies[side] = future.result()
        return replies

    def close(self):
        if self.pool:
            self.pool.shutdown(wait=True, cancel_futures=True)

# ==============================================================================
# INJURY SNAPSHOTS & OFFLINE RINGSIDE INSPECTOR
# ==============================================================================
INJURY_METRICS = [
    {'key': 'l_eye_swelling', 'label': 'Left eye swelling', 'region': 'left-eye', 'unit': 'index', 'limit': 60,
     'detail': 'At 60 the simulated left eye is shut. Vision loss changes defensive reactions and spacing; the sprite shows bruising and swelling.'},
    {'key': 'r_eye_swelling', 'label': 'Right eye swelling', 'region': 'right-eye', 'unit': 'index', 'limit': 60,
     'detail': 'At 60 the simulated right eye is shut. The blind side changes defensive reactions; inspect the matching brow cut separately.'},
    {'key': 'l_brow_cut', 'label': 'Left brow cut', 'region': 'left-eye', 'unit': 'index', 'limit': 70,
     'detail': 'At 70 a brow cut is severe in this game. Cuts contribute to simulated blood loss and ringside inspection. Corner treatment can reduce the index.'},
    {'key': 'r_brow_cut', 'label': 'Right brow cut', 'region': 'right-eye', 'unit': 'index', 'limit': 70,
     'detail': 'The right brow is tracked independently. Scrub across a hit or corner treatment to see the exact change; 70 is the severe-cut threshold.'},
    {'key': 'nose_fracture', 'label': 'Nose trauma', 'region': 'nose', 'unit': 'index', 'limit': 50,
     'detail': 'Nose impacts add trauma to this arcade counter. The facial sprite changes as it increases. This is not a diagnosis or a probability of fracture.'},
    {'key': 'jaw_concussion', 'label': 'Jaw / concussion', 'region': 'jaw', 'unit': 'index', 'limit': 85,
     'detail': 'Head impacts increase this arcade index. High values can trigger wobbling or a knockdown; corner recovery can lower it. It is not a clinical scale.'},
    {'key': 'liver_trauma', 'label': 'Liver trauma', 'region': 'body', 'unit': 'index', 'limit': 65,
     'detail': 'Body trauma reduces stamina recovery above 40 and stride force above 50. A high value can arm a delayed collapse; watch the countdown below.'},
    {'key': 'rib_fracture', 'label': 'Rib trauma', 'region': 'body', 'unit': 'index', 'limit': None,
     'detail': 'Body impacts accumulate this separate trauma counter. Its value records damage in the simulation; it does not establish a medical fracture.'},
    {'key': 'blood_loss_ml', 'label': 'Simulated blood loss', 'region': 'blood', 'unit': 'ml', 'limit': None,
     'detail': 'Cumulative simulated loss from cuts. The unit belongs to the arcade model and does not estimate real blood loss. It is shown without a clinical severity label.'},
]

def injury_snapshot(arena, tick, controllers):
    """Capture plain, detached data at a committed tick, without advancing physics."""
    fighters = []
    for index, fighter in enumerate((arena.f1, arena.f2)):
        if isinstance(controllers, dict):
            controller = controllers.get(fighter.name, controllers.get('f' + str(index + 1), controllers.get('red' if index == 0 else 'blue', 'local')))
        elif isinstance(controllers, (list, tuple)):
            controller = controllers[index] if index < len(controllers) else 'local'
        else:
            controller = str(controllers)
        item = {key: getattr(fighter, key) for key in (
            'name', 'corner', 'style', 'is_titan', 'mass', 'x', 'y', 'vx', 'hp',
            'stamina', 'guard', 'state', 'state_frame', 'state_duration',
            'punches_thrown', 'punches_landed', 'knockdowns_taken', 'knockdowns_scored',
            'damage_dealt', 'finishing_threat')}
        item.update({'id': 'f' + str(index + 1), 'controller': controller,
                     'injury': dict(vars(fighter.injury)),
                     'sprite': fighter.get_pixel_matrix(tick)})
        fighters.append(item)
    return {'tick': int(tick), 'round': arena.round_num, 'clock_tick': arena.clock_tick,
            'match_over': arena.match_over, 'fighters': fighters,
            'commentary': list(arena.commentary_log)}

def terminal_injury_report(arena, side=None):
    """Human-readable values for both fighters, including less visible body injuries."""
    lines = ['INJURY EXAMINATION · arcade values, not medical measurements']
    fighters = (arena.f1, arena.f2) if side is None else ((arena.f1,) if side in ('red', 'f1', 'TITAN', 0) else (arena.f2,))
    for fighter in fighters:
        inj = fighter.injury
        lines.append(f'{fighter.name} [{fighter.state}] HP {fighter.hp:.1f} · stamina {fighter.stamina:.1f} · guard {fighter.guard:.1f}')
        lines.append(f'  Damage dealt {fighter.damage_dealt:.2f} + finishing danger {fighter.finishing_threat:.2f} = {fighter.damage_dealt + fighter.finishing_threat:.2f} damage/danger score')
        lines.append(f'  Eye swelling L {inj.l_eye_swelling:.2f} / R {inj.r_eye_swelling:.2f} · shut L {inj.is_left_eye_shut()} / R {inj.is_right_eye_shut()}')
        lines.append(f'  Brow cuts L {inj.l_brow_cut:.2f} / R {inj.r_brow_cut:.2f} · nose {inj.nose_fracture:.2f} · jaw {inj.jaw_concussion:.2f}')
        lines.append(f'  Liver {inj.liver_trauma:.2f} · ribs {inj.rib_fracture:.2f} · simulated blood loss {inj.blood_loss_ml:.2f} ml')
        lines.append(f'  Mouthguard {"in" if inj.has_mouthguard else "out"} · liver countdown {inj.delayed_liver_timer} ticks · doctor checked {inj.doc_checked} / stopped {inj.doc_stopped}')
        lines.append(f'  Position {fighter.x:.2f}, {fighter.y:.2f} · velocity {fighter.vx:+.3f} · mass {fighter.mass:.1f} kg · landed {fighter.punches_landed}/{fighter.punches_thrown}')
    return '\n'.join(lines)

def terminal_injury_closeup(arena, side):
    """Enlarge the selected fighter's injury sprite for a paused terminal exam."""
    fighter = arena.f1 if side in ('red', 'f1', 'TITAN', 0) else arena.f2
    codes = {'L': 'skin_light', 'M': 'skin_mid', 'D': 'skin_dark', 'E': 'eye_white',
             'W': 'waist_gold', 'B': 'boot', 'b': 'bruise', 'h': 'hematoma',
             'g': 'gash', 'w': 'wound', 'c': 'blood', 'C': 'blood_bright',
             'k': 'blood_dark', 'o': 'bone', '=': 'mouthguard', 'X': 'bruise',
             'G': 'glove_titan' if fighter.is_titan else 'glove_phantom',
             'T': 'trunks_titan' if fighter.is_titan else 'trunks_phantom',
             'H': 'hair_titan' if fighter.is_titan else 'hair_phantom'}
    sprite = fighter.get_pixel_matrix(arena.clock_tick)
    lines = [f'{fighter.name} · FACE CLOSE-UP / FRONT VIEW', 'Left and right refer to the fighter. Purple: bruising · red: cuts/blood']
    for title, rows, left, right, width in (('', sprite[:7], 2, 12, 4),
                                           ('TORSO CLOSE-UP', sprite[7:11], 2, 12, 4)):
        if title:
            lines.append(title)
        for row in rows:
            cells = []
            for ch in row[left:right]:
                rgb = PAL.get(codes.get(ch, 'bg')) or PAL['bg']
                cells.append(f'\033[48;2;{rgb[0]};{rgb[1]};{rgb[2]}m' + ' ' * width)
            lines.append('  ' + ''.join(cells) + '\033[0m')
    lines.append(terminal_injury_report(arena, side))
    return '\n'.join(lines)

def export_injury_report(output_dir, frames, events, result):
    """Write an offline inspector and the complete tick/event data beside it."""
    import json
    from pathlib import Path
    directory = Path(output_dir).expanduser().resolve()
    directory.mkdir(parents=True, exist_ok=True)
    payload = {'schema': 'ostadix.boxing.injury-replay/v1', 'result': result,
               'frames': frames, 'events': events, 'metrics': INJURY_METRICS,
               'palette': PAL}
    serialized = json.dumps(payload, ensure_ascii=False, allow_nan=False, separators=(',', ':'))
    # Escape HTML-significant characters even in a non-executable JSON script.
    embedded = serialized.replace('&', '\\u0026').replace('<', '\\u003c').replace('>', '\\u003e').replace('\u2028', '\\u2028').replace('\u2029', '\\u2029')
    page = r'''<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Ostadix Boxing · Ringside injury replay</title>
<style>
:root{color-scheme:dark;--bg:#11111b;--panel:#1e1e2e;--ink:#cdd6f4;--muted:#a6adc8;--line:#45475a;--accent:#cba6f7;--red:#f38ba8;--blue:#89b4fa;--green:#a6e3a1;--yellow:#f9e2af}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font:15px/1.5 system-ui,sans-serif}main{max-width:1260px;margin:auto;padding:30px 24px 50px}h1,h2,h3,p{margin:0}h1{font-size:clamp(28px,4vw,44px);letter-spacing:-1.5px;line-height:1.15}h2{font-size:19px}h3{font-size:15px}.eyebrow{color:var(--accent);letter-spacing:2.5px;font-size:11px;font-weight:800;margin-bottom:8px}.muted,small{color:var(--muted)}.masthead{display:flex;justify-content:space-between;align-items:center;gap:24px;margin-bottom:24px}.tag{border:1px solid var(--line);border-radius:30px;padding:6px 12px;font-size:12px;white-space:nowrap}.summary{display:grid;grid-template-columns:1.2fr 2fr 1fr 1fr;gap:1px;background:var(--line);border:1px solid var(--line);border-radius:14px;overflow:hidden;margin:20px 0}.summary>div{background:var(--panel);padding:16px 18px;min-width:0}.summary strong{display:block;font-size:19px;overflow-wrap:anywhere}.summary small{text-transform:uppercase;font-size:10px;letter-spacing:1.5px}.panel{background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:20px}.timeline{margin-bottom:18px}.toolbar{display:flex;align-items:center;gap:10px;flex-wrap:wrap}button,select{font:inherit;background:#313244;border:1px solid var(--line);border-radius:7px;color:var(--ink);padding:8px 13px;cursor:pointer}button:hover{border-color:var(--accent)}button:focus-visible,a:focus-visible,input:focus-visible,select:focus-visible{outline:3px solid var(--accent);outline-offset:3px}button[aria-pressed=true]{background:#49355f;border-color:var(--accent);color:#f5e0dc}.primary{background:var(--accent);color:var(--bg);border-color:var(--accent);font-weight:700}.timeline input{accent-color:var(--accent);width:100%;margin:15px 0 5px}.timeline-labels{display:flex;justify-content:space-between;font-size:12px;color:var(--muted)}.spacer{flex:1}.fighters{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:18px}.fighter{text-align:left;display:flex;justify-content:space-between;gap:14px;padding:14px 18px;border-radius:12px;background:var(--panel);min-width:0}.fighter strong{display:block;font-size:18px}.fighter small{display:block;overflow-wrap:anywhere}.fighter:first-child strong{color:var(--red)}.fighter:last-child strong{color:var(--blue)}.fighter[aria-pressed=true]{background:#292337}.fighter-stat{text-align:right;white-space:nowrap}.layout{display:grid;grid-template-columns:340px minmax(0,1fr);gap:18px}.canvas-wrap{background:#181825;border-radius:9px;margin:16px 0 12px;position:relative;border:1px solid #313244;display:grid;place-items:center;min-height:294px}.sprite{width:240px;height:288px;max-width:100%;image-rendering:pixelated;cursor:crosshair}.portrait-label{position:absolute;left:12px;top:9px;color:var(--muted);font:11px ui-monospace,monospace}.regions{display:flex;flex-wrap:wrap;gap:6px;margin:12px 0}.regions button{font-size:12px;padding:6px 9px}.readout{font:12px/1.7 ui-monospace,monospace;color:var(--muted);margin-top:12px;white-space:pre-wrap;overflow-wrap:anywhere}.note{font-size:12px;color:var(--muted);margin-top:16px;border-top:1px solid var(--line);padding-top:13px}.metrics{width:100%;border-collapse:collapse;font-size:13px}.metrics th{text-align:left;color:var(--muted);font-size:10px;text-transform:uppercase;letter-spacing:1px;padding:12px 8px;border-bottom:1px solid var(--line)}.metrics td{padding:10px 8px;border-bottom:1px solid #313244;vertical-align:middle}.metrics button{padding:0;background:none;border:0;border-radius:0;text-align:left;font-size:13px}.metrics tr.selected{background:#292337}.metric-value{font:13px ui-monospace,monospace;white-space:nowrap}.metric-bar{height:4px;width:100%;min-width:40px;background:#45475a;border-radius:9px;margin-top:5px}.metric-bar span{height:4px;display:block;background:var(--yellow);border-radius:9px}.metric-description{border-left:3px solid var(--accent);padding:12px 15px;background:#181825;border-radius:0 7px 7px 0;font-size:13px;margin:16px 0}.metric-description p{margin-top:6px;color:var(--muted)}.trend{width:100%;height:120px;display:block;background:#181825;border-radius:7px}.trend-labels{display:flex;justify-content:space-between;font:11px ui-monospace,monospace;color:var(--muted);margin:5px 0 16px}.events{max-height:330px;overflow:auto;display:grid;gap:7px;margin-top:12px}.event{display:block;text-align:left;padding:11px 13px;background:#181825;width:100%;font-size:12px}.event strong{display:block;color:var(--ink);font-size:13px}.event span{display:block;color:var(--muted);margin-top:4px}.event.current{border-color:var(--yellow)}.legend{display:flex;gap:13px;flex-wrap:wrap;font-size:11px;color:var(--muted);margin-top:10px}.swatch{width:8px;height:8px;display:inline-block;border-radius:2px;margin-right:4px}.bottom{margin-top:18px}.evidence{margin-top:20px;font-size:13px;color:var(--muted)}.evidence summary{cursor:pointer}.evidence pre{white-space:pre-wrap;overflow-wrap:anywhere;font-size:11px;background:#181825;padding:15px;border-radius:8px}a{color:var(--blue)}.error{color:var(--yellow);margin:10px 0;white-space:pre-wrap}.empty{padding:18px 0;color:var(--muted);font-size:13px}#commentary{white-space:pre-wrap;font-size:13px;margin-top:10px}.zoom{font-size:11px;padding:5px 7px}
@media(max-width:850px){.layout{grid-template-columns:1fr}.visual{display:grid;grid-template-columns:1fr 1fr;gap:0 20px}.visual h2,.visual>.muted,.visual>.note{grid-column:1/-1}.visual .canvas-wrap{grid-row:3/7}.summary{grid-template-columns:1fr 1fr}.metrics td,.metrics th{padding:10px 5px}}@media(max-width:520px){main{padding:20px 12px}.masthead{align-items:flex-start;flex-direction:column;gap:12px}.fighters{grid-template-columns:1fr}.visual{display:block}.summary strong{font-size:16px}.panel{padding:15px}.metric-value{font-size:11px}}
</style></head><body><main>
<header class="masthead"><div><p class="eyebrow">OSTADIX / RINGSIDE LAB</p><h1>Every impact. Every change.</h1><p class="muted" style="margin-top:10px">Inspect both fighters, one committed tick at a time.</p></div><span id="status" class="tag" role="status">Loading replay</span></header>
<div class="summary"><div><small>Official result</small><strong id="winner">—</strong></div><div><small>Method</small><strong id="method">—</strong><p id="finalScores" class="muted" style="font-size:12px;margin-top:6px"></p></div><div><small>Recorded states</small><strong id="ticks">—</strong></div><div><small>Match seed</small><strong id="seed">—</strong></div></div>
<p class="muted" style="font-size:12px;margin-bottom:18px">Damage/danger score = cumulative damage dealt + finishing danger. Finishing danger is a fictional index of knockout/stoppage pressure. A knockout or stoppage ends the match immediately; a completed match otherwise uses the cumulative scores.</p>
<p id="error" class="error" hidden></p>
<section class="panel timeline" aria-label="Replay controls"><div class="toolbar"><button id="play" class="primary" type="button">Play replay</button><button id="previous" type="button" aria-label="Previous tick">←</button><button id="next" type="button" aria-label="Next tick">→</button><label for="speed">Speed</label><select id="speed"><option value="250">4 ticks/s</option><option value="100" selected>10 ticks/s</option><option value="30">33 ticks/s</option></select><span class="spacer"></span><strong id="position">Tick 0</strong></div><label for="scrubber" class="muted" style="font-size:12px">Match timeline — drag to examine any recorded state</label><input id="scrubber" type="range" min="0" max="0" value="0" step="1"><div class="timeline-labels"><span id="firstTick"></span><span>Space: play/pause · ←/→: one tick · 1/2: fighter</span><span id="lastTick"></span></div></section>
<div class="fighters" aria-label="Choose a fighter"><button class="fighter" id="fighter0" type="button" aria-pressed="true"><span><strong>TITAN</strong><small class="controller"></small></span><span class="fighter-stat"></span></button><button class="fighter" id="fighter1" type="button" aria-pressed="false"><span><strong>PHANTOM</strong><small class="controller"></small></span><span class="fighter-stat"></span></button></div>
<div class="layout"><section class="panel visual"><h2 id="fighterTitle">Fighter examination</h2><p class="muted" style="font-size:12px;margin-top:5px">Click the fighter or choose an anatomical region.</p><div class="canvas-wrap"><span class="portrait-label" id="portraitLabel">FRONT VIEW / INJURY OVERLAY</span><canvas id="sprite" class="sprite" width="240" height="288" role="img" aria-label="Enlarged fighter injury sprite"></canvas></div><div class="toolbar"><label for="zoom">View</label><select id="zoom" class="zoom"><option value="full">Full body</option><option value="head">Face close-up</option><option value="body">Torso close-up</option></select></div><div id="regions" class="regions" aria-label="Anatomical region"></div><div class="legend"><span><i class="swatch" style="background:#8c2d7d"></i>Bruising</span><span><i class="swatch" style="background:#ff2837"></i>Cut / blood</span><span><i class="swatch" style="background:#cba6f7"></i>Selected area</span></div><div id="phys" class="readout"></div><p class="note">Arcade injury model. Indices are game state, not percentages or clinical measurements. Left and right always refer to the fighter. The front-view sprite remains visible during knockdowns so injuries can still be inspected.</p></section>
<section class="panel"><div class="toolbar"><h2 id="regionTitle">All injuries</h2><span class="spacer"></span><small id="metricHint">Select a metric to examine its history.</small></div><table class="metrics"><thead><tr><th scope="col">Injury metric</th><th scope="col">Value</th><th scope="col">Model state</th></tr></thead><tbody id="metrics"></tbody></table><div class="metric-description"><h3 id="detailTitle"></h3><p id="detailText"></p></div><svg id="trend" class="trend" viewBox="0 0 650 120" role="img" aria-label="Selected injury value across the match"></svg><div class="trend-labels"><span id="trendStart"></span><span id="trendPeak"></span><span id="trendEnd"></span></div><h3>Condition & equipment</h3><div id="conditions" class="readout"></div><div class="bottom"><div class="toolbar"><h2>Injury events</h2><span class="spacer"></span><label for="futureEvents" style="font-size:12px"><input id="futureEvents" type="checkbox" checked> Include later events</label></div><p class="muted" style="font-size:12px">Select an event to jump to that impact and examine the change.</p><div id="events" class="events"></div></div></section></div>
<section class="panel bottom"><h2>Ringside commentary</h2><div id="commentary"></div></section>
<details class="evidence"><summary>Match data & execution record</summary><p style="margin-top:10px">This self-contained page includes every captured tick and injury event. <a href="match.json" download>Download the complete JSON record</a>.</p><pre id="evidence"></pre></details>
<noscript><p class="error">Enable JavaScript to inspect this offline replay, or open match.json for the complete injury record.</p></noscript>
</main><script id="replay-data" type="application/json">__BOXING_REPLAY_DATA__</script><script>
'use strict';
const data = JSON.parse(document.getElementById('replay-data').textContent);
const byId = function(id){return document.getElementById(id);};
const frames = data.frames, metrics = data.metrics;
let frameIndex = Math.max(0, frames.length - 1), fighterIndex = 0, region = 'all', metricKey = 'l_eye_swelling', timer = null;
const regionNames = {'all':'All injuries','left-eye':'Left eye & brow','right-eye':'Right eye & brow','nose':'Nose','jaw':'Jaw & mouth','body':'Body & ribs','blood':'Blood loss'};
const result = data.result;
byId('status').textContent = result.status || 'UNKNOWN';
byId('winner').textContent = result.winner || (String(result.status).toLowerCase() === 'concluded' ? 'DRAW' : 'UNDECIDED');
byId('method').textContent = result.method || 'No official result';
const finalScores = result.scores || [];
const finalDamage = result.damage_dealt || {}, finalDanger = result.finishing_threat || {};
byId('finalScores').style.whiteSpace = 'pre-line';
byId('finalScores').textContent = 'Damage + finishing danger = total\nTITAN ' + fmt(finalDamage.red) + ' + ' + fmt(finalDanger.red) + ' = ' + fmt(Array.isArray(finalScores) ? finalScores[0] : finalScores.red) + '\nPHANTOM ' + fmt(finalDamage.blue) + ' + ' + fmt(finalDanger.blue) + ' = ' + fmt(Array.isArray(finalScores) ? finalScores[1] : finalScores.blue);
byId('ticks').textContent = frames.length.toLocaleString();
byId('seed').textContent = String(result.seed == null ? '—' : result.seed);
byId('evidence').textContent = JSON.stringify(result, null, 2);
if(result.error){byId('error').hidden = false;byId('error').textContent = result.error;}
function fmt(value){return Number.isFinite(Number(value)) ? Number(value).toFixed(2) : '—';}
function combatMerit(fighter){return Number(fighter.damage_dealt || 0) + Number(fighter.finishing_threat || 0);}
function stop(){if(timer !== null){clearInterval(timer);timer = null;}byId('play').textContent = 'Play replay';}
function play(){if(timer !== null){stop();return;}if(frameIndex >= frames.length - 1){frameIndex = 0;render();}byId('play').textContent = 'Pause replay';timer = setInterval(function(){if(frameIndex >= frames.length - 1){stop();return;}frameIndex++;render();},Number(byId('speed').value));}
function chooseRegion(value){region = value;const subset = metrics.filter(function(m){return region === 'all' || m.region === region;});if(!subset.some(function(m){return m.key === metricKey;})){metricKey = subset[0].key;}render();}
Object.keys(regionNames).forEach(function(key){const button = document.createElement('button');button.type = 'button';button.textContent = regionNames[key];button.dataset.region = key;button.addEventListener('click',function(){chooseRegion(key);});byId('regions').appendChild(button);});
function svgElement(tag, attrs){const e = document.createElementNS('http://www.w3.org/2000/svg',tag);Object.keys(attrs).forEach(function(k){e.setAttribute(k,String(attrs[k]));});return e;}
function chart(metric){
    const svg=byId('trend');svg.replaceChildren();
    const values=frames.map(function(f){return Number(f.fighters[fighterIndex].injury[metric.key]||0);});
    const maximum=values.reduce(function(a,b){return Math.max(a,b);},0),peak=Math.max(1,maximum),width=626,height=94;
    const points=values.map(function(v,i){return (12+i*width/Math.max(1,values.length-1))+','+(106-v/peak*height);}).join(' ');
    svg.appendChild(svgElement('line',{x1:12,y1:106,x2:638,y2:106,stroke:'#45475a'}));
    svg.appendChild(svgElement('polyline',{points:points,fill:'none',stroke:'#cba6f7','stroke-width':2}));
    const x=12+frameIndex*width/Math.max(1,values.length-1);
    svg.appendChild(svgElement('line',{x1:x,y1:10,x2:x,y2:110,stroke:'#f9e2af','stroke-dasharray':'3 3'}));
    svg.appendChild(svgElement('circle',{cx:x,cy:106-values[frameIndex]/peak*height,r:4,fill:'#f9e2af'}));
    svg.setAttribute('aria-label',metric.label+' over '+values.length+' recorded states. Current '+fmt(values[frameIndex])+', peak '+fmt(maximum)+'.');
    byId('trendStart').textContent='tick '+frames[0].tick;
    byId('trendPeak').textContent='peak '+fmt(maximum)+' '+metric.unit;
    byId('trendEnd').textContent='tick '+frames[frames.length-1].tick;
}
const spriteCodes={L:'skin_light',M:'skin_mid',D:'skin_dark',E:'eye_white',W:'waist_gold',B:'boot',b:'bruise',h:'hematoma',g:'gash',w:'wound',c:'blood',C:'blood_bright',k:'blood_dark',o:'bone','=':'mouthguard',X:'bruise'};
function sprite(f){const canvas=byId('sprite'),ctx=canvas.getContext('2d');const zoom=byId('zoom').value;const crop=zoom==='head'?[2,0,10,7]:zoom==='body'?[1,6,13,7]:[0,0,15,18];canvas.dataset.crop=JSON.stringify(crop);const scale=Math.min(canvas.width/crop[2],canvas.height/crop[3]);const ox=(canvas.width-crop[2]*scale)/2,oy=(canvas.height-crop[3]*scale)/2;canvas.dataset.transform=JSON.stringify([scale,ox,oy]);ctx.clearRect(0,0,canvas.width,canvas.height);ctx.fillStyle='#181825';ctx.fillRect(0,0,canvas.width,canvas.height);f.sprite.forEach(function(row,y){Array.from(row).forEach(function(ch,x){if(x<crop[0]||x>=crop[0]+crop[2]||y<crop[1]||y>=crop[1]+crop[3])return;let key=spriteCodes[ch];if(ch==='G')key=f.is_titan?'glove_titan':'glove_phantom';if(ch==='T')key=f.is_titan?'trunks_titan':'trunks_phantom';if(ch==='H')key=f.is_titan?'hair_titan':'hair_phantom';const rgb=data.palette[key];if(!rgb)return;ctx.fillStyle='rgb('+rgb.join(',')+')';ctx.fillRect(ox+(x-crop[0])*scale,oy+(y-crop[1])*scale,scale,scale);});});const rects={'left-eye':[7,2,3,3],'right-eye':[3,2,3,3],'nose':[5,3,3,2],'jaw':[4,5,5,2],'body':[3,7,7,3],'blood':[3,2,7,9]};if(rects[region]){const r=rects[region];ctx.strokeStyle='#cba6f7';ctx.lineWidth=2;ctx.setLineDash([4,3]);ctx.strokeRect(ox+(r[0]-crop[0])*scale,oy+(r[1]-crop[1])*scale,r[2]*scale,r[3]*scale);ctx.setLineDash([]);}canvas.setAttribute('aria-label',f.name+' front-view injury overlay at tick '+frames[frameIndex].tick+', state '+f.state+'. Use anatomical region buttons for accessible inspection.');byId('portraitLabel').textContent=(zoom==='full'?'FRONT VIEW':zoom==='head'?'FACE CLOSE-UP':'TORSO CLOSE-UP')+' / '+f.state;}
function eventMatchesFighter(event,f){return event.fighter===f.name||event.fighter===f.id||event.fighter===fighterIndex||event.fighter===String(fighterIndex);}
function renderEvents(f,frame){const area=byId('events');area.replaceChildren();const keys=new Set(metrics.filter(function(m){return region==='all'||m.region===region;}).map(function(m){return m.key;}));const events=data.events.filter(function(e){return eventMatchesFighter(e,f)&&(byId('futureEvents').checked||e.tick<=frame.tick)&&(region==='all'||Object.keys(e.changes||{}).some(function(k){return keys.has(k);}));});if(!events.length){const p=document.createElement('p');p.className='empty';p.textContent='No recorded injury changes for this fighter and region.';area.appendChild(p);return;}events.slice().reverse().forEach(function(e){const b=document.createElement('button');b.type='button';b.className='event'+(e.tick===frame.tick?' current':'');const title=document.createElement('strong');title.textContent='Tick '+e.tick+' · '+(e.attacker?e.attacker+' → ':'')+f.name+' · '+(e.punch||e.kind||'Condition change');const body=document.createElement('span');const changes=Object.keys(e.changes||{}).map(function(key){const m=metrics.find(function(v){return v.key===key;});const c=e.changes[key];return (m?m.label:key)+': '+fmt(c.before)+' → '+fmt(c.after);});body.textContent=(e.zone?e.zone+' · ':'')+(e.damage!==undefined?'damage '+fmt(e.damage)+' · ':'')+(e.finishing_threat!==undefined?'finishing danger '+fmt(e.finishing_threat)+' · ':'')+changes.join(' / ');b.append(title,body);b.addEventListener('click',function(){stop();const i=frames.findIndex(function(v){return v.tick>=e.tick;});frameIndex=i<0?frames.length-1:i;render();});area.appendChild(b);});}
function render(){if(!frames.length)return;const frame=frames[frameIndex],f=frame.fighters[fighterIndex];byId('scrubber').value=String(frameIndex);byId('position').textContent='Round '+frame.round+' · tick '+frame.tick;byId('fighterTitle').textContent=f.name+' / '+f.state;frame.fighters.forEach(function(v,i){const button=byId('fighter'+i);button.setAttribute('aria-pressed',String(i===fighterIndex));button.querySelector('.controller').textContent=typeof v.controller==='string'?v.controller:JSON.stringify(v.controller);button.querySelector('.fighter-stat').style.whiteSpace='pre-line';button.querySelector('.fighter-stat').textContent='HP '+fmt(v.hp)+' · '+v.state+'\nDamage + danger '+fmt(combatMerit(v));});byId('regionTitle').textContent=regionNames[region];Array.from(byId('regions').children).forEach(function(b){b.setAttribute('aria-pressed',String(b.dataset.region===region));});sprite(f);byId('phys').textContent='Position '+fmt(f.x)+', '+fmt(f.y)+' · vx '+fmt(f.vx)+'\nMass '+fmt(f.mass)+' kg · guard '+fmt(f.guard)+'\nStamina '+fmt(f.stamina)+' · landed '+f.punches_landed+'/'+f.punches_thrown+'\nKnockdowns taken '+f.knockdowns_taken+' / scored '+f.knockdowns_scored+'\nDamage dealt '+fmt(f.damage_dealt)+'\nFinishing danger '+fmt(f.finishing_threat)+'\nDamage/danger score '+fmt(combatMerit(f));const table=byId('metrics');table.replaceChildren();metrics.filter(function(m){return region==='all'||m.region===region;}).forEach(function(m){const value=Number(f.injury[m.key]||0),row=document.createElement('tr');if(m.key===metricKey)row.className='selected';const label=document.createElement('td'),button=document.createElement('button');button.type='button';button.textContent=m.label;button.addEventListener('click',function(){metricKey=m.key;render();});label.appendChild(button);const number=document.createElement('td');number.className='metric-value';number.textContent=fmt(value)+' '+m.unit;const state=document.createElement('td');state.textContent=m.limit===null?'Cumulative':value===0?'Clear':value>=m.limit?'Threshold reached':value>=m.limit*0.5?'Elevated':'Present';if(m.limit!==null){const bar=document.createElement('div');bar.className='metric-bar';const fill=document.createElement('span');fill.style.width=Math.min(100,value/m.limit*100)+'%';fill.style.background=value>=m.limit?'#f38ba8':value>0?'#f9e2af':'#a6e3a1';bar.appendChild(fill);state.appendChild(bar);}row.append(label,number,state);table.appendChild(row);});const metric=metrics.find(function(m){return m.key===metricKey;});byId('detailTitle').textContent=metric.label+' · '+fmt(f.injury[metric.key])+' '+metric.unit;byId('detailText').textContent=metric.detail;chart(metric);const inj=f.injury;byId('conditions').textContent='Mouthguard: '+(inj.has_mouthguard?'IN':'OUT')+' · liver collapse timer: '+inj.delayed_liver_timer+' ticks\nEyes shut: left '+(inj.l_eye_swelling>=60?'YES':'no')+', right '+(inj.r_eye_swelling>=60?'YES':'no')+'\nDoctor checked: '+(inj.doc_checked?'yes':'no')+' · doctor stopped: '+(inj.doc_stopped?'yes':'no');renderEvents(f,frame);byId('commentary').textContent=frame.commentary.join('\n');}
byId('play').addEventListener('click',play);byId('previous').addEventListener('click',function(){stop();frameIndex=Math.max(0,frameIndex-1);render();});byId('next').addEventListener('click',function(){stop();frameIndex=Math.min(frames.length-1,frameIndex+1);render();});byId('scrubber').addEventListener('input',function(){stop();frameIndex=Number(this.value);render();});byId('speed').addEventListener('change',function(){if(timer!==null){stop();play();}});byId('zoom').addEventListener('change',render);byId('futureEvents').addEventListener('change',render);
[0,1].forEach(function(i){byId('fighter'+i).addEventListener('click',function(){fighterIndex=i;render();});});
byId('sprite').addEventListener('click',function(event){const canvas=event.currentTarget,rect=canvas.getBoundingClientRect(),crop=JSON.parse(canvas.dataset.crop),t=JSON.parse(canvas.dataset.transform);const x=((event.clientX-rect.left)*canvas.width/rect.width-t[1])/t[0]+crop[0],y=((event.clientY-rect.top)*canvas.height/rect.height-t[2])/t[0]+crop[1];chooseRegion(y>=7?'body':y>=5?'jaw':x>=5.5&&x<=7.5&&y>=3.5?'nose':x<7?'right-eye':'left-eye');});
document.addEventListener('keydown',function(e){if(['INPUT','SELECT','BUTTON','A','TEXTAREA'].includes(document.activeElement.tagName))return;if(e.code==='Space'){e.preventDefault();play();}else if(e.key==='ArrowLeft'){e.preventDefault();byId('previous').click();}else if(e.key==='ArrowRight'){e.preventDefault();byId('next').click();}else if(e.key==='1'||e.key==='2'){fighterIndex=Number(e.key)-1;render();}});
