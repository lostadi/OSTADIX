</script></body></html>'''
    json_path = directory / 'match.json'
    html_path = directory / 'report.html'
    json_path.write_text(serialized + '\n', encoding='utf-8')
    html_path.write_text(page.replace('__BOXING_REPLAY_DATA__', embedded), encoding='utf-8')
    return {'html': str(html_path), 'json': str(json_path)}

# ==============================================================================
# MAIN SIMULATION RUNNER
# ==============================================================================
_tty_out = None

def term_write(s):
    if _tty_out:
        try:
            _tty_out.write(s)
            _tty_out.flush()
            return
        except Exception:
            pass
    try:
        sys.stderr.write(s)
        sys.stderr.flush()
    except Exception:
        sys.stdout.write(s)
        sys.stdout.flush()

class BoxingTerminal:
    def __init__(self):
        self.fd, self.saved, self.foreground, self.previous_ttou = None, None, None, None
        if os.environ.get('OSTADIX_BOXING_HEADLESS', '0') != '1':
            try:
                import termios, tty, signal
                self.fd = os.open('/dev/tty', os.O_RDWR)
                self.saved = termios.tcgetattr(self.fd)
                # O backends have their own process groups. Borrow the terminal
                # foreground while handling input, then return it to the caller.
                self.foreground = os.tcgetpgrp(self.fd)
                self.previous_ttou = signal.signal(signal.SIGTTOU, signal.SIG_IGN)
                os.tcsetpgrp(self.fd, os.getpgrp())
                tty.setcbreak(self.fd)
                attrs = termios.tcgetattr(self.fd)
                attrs[3] &= ~termios.ISIG
                termios.tcsetattr(self.fd, termios.TCSANOW, attrs)
            except (OSError, ImportError, ValueError):
                self.close()

    def keys(self):
        if self.fd is None:
            return ''
        import select
        if select.select([self.fd], [], [], 0)[0]:
            return os.read(self.fd, 64).decode(errors='ignore')
        return ''

    def draw(self, text):
        if self.fd is not None:
            # Keep the cursor visible even if the O parent is interrupted.
            remaining = memoryview(('\033[H\033[2J' + text + '\033[0m\n').encode())
            while remaining:
                remaining = remaining[os.write(self.fd, remaining):]

    def close(self):
        if self.fd is not None:
            import termios, signal
            try:
                if self.saved is not None:
                    termios.tcsetattr(self.fd, termios.TCSADRAIN, self.saved)
                os.write(self.fd, b'\033[0m\033[?25h\n')
                if self.foreground is not None:
                    os.tcsetpgrp(self.fd, self.foreground)
            finally:
                os.close(self.fd)
                self.fd = None
                if self.previous_ttou is not None:
                    signal.signal(signal.SIGTTOU, self.previous_ttou)

def positive_env(name, default):
    value = int(os.environ.get(name, str(default)))
    if value < 1:
        raise ValueError(name + ' must be positive')
    return value

def run_championship_match(engine_source=''):
    arena = BoxingArena()
    arena.seed = int(os.environ.get('OSTADIX_BOXING_SEED', '42'))
    arena.max_rounds = positive_env('OSTADIX_BOXING_ROUNDS', 3)
    arena.round_time_sec = positive_env('OSTADIX_BOXING_ROUND_SECONDS', 60)
    max_ticks = positive_env('OSTADIX_BOXING_MAX_TICKS', 1) if os.environ.get('OSTADIX_BOXING_MAX_TICKS') else None
    delay = float(os.environ.get('OSTADIX_BOXING_DELAY', '0.065'))
    if not math.isfinite(delay) or delay < 0:
        raise ValueError('OSTADIX_BOXING_DELAY must be finite and nonnegative')
    controllers = {side: os.environ.get('OSTADIX_BOXING_' + side.upper() + '_NODE', 'local') for side in ('red', 'blue')}
    if any(not node.strip() for node in controllers.values()):
        raise ValueError('fighter node must be local or a paired node ID')
    base = Path(os.environ.get('XDG_STATE_HOME', str(Path.home() / '.local/state'))) / 'ostadix/boxing'
    output_dir = Path(os.environ.get('OSTADIX_BOXING_OUT') or str(base / (time.strftime('%Y%m%d-%H%M%S') + '-' + arena.match_id[:8]))).expanduser().resolve()
    output_dir.mkdir(parents=True, exist_ok=True)
    if (output_dir / 'match.json').exists() or (output_dir / 'engine.O').exists():
        output_dir = output_dir / arena.match_id
        output_dir.mkdir()
    (output_dir / 'engine.O').write_text(engine_source)
    frames = [injury_snapshot(arena, 0, controllers)]
    tick, transport, terminal = 0, None, None
    status, error, paused, selected_side = 'incomplete', None, False, None
    result = {}
    try:
        transport = BoxingNodes(engine_source, controllers, output_dir)
        terminal = BoxingTerminal()
        term_write('OSTADIX BOXING: TITAN [' + controllers['red'] + '] vs PHANTOM [' + controllers['blue'] + ']\n')
        while not arena.match_over:
            keys = terminal.keys()
            quit_requested = False
            for key in keys:
                if key.lower() == 'q' or key == '\x03':
                    quit_requested = True
                    break
                if key == ' ':
                    paused = not paused
                elif key.lower() == 'i':
                    selected_side, paused = None, True
                elif key == '1':
                    selected_side, paused = 'red', True
                elif key == '2':
                    selected_side, paused = 'blue', True
            if quit_requested:
                status = 'interrupted'
                break
            if paused:
                view = terminal_injury_closeup(arena, selected_side) if selected_side else terminal_injury_report(arena)
                terminal.draw(view + '\nPAUSED — 1 Titan / 2 Phantom / i both / Space resume / q end.')
                time.sleep(0.05)
                continue
            if max_ticks is not None and tick >= max_ticks:
                status = 'incomplete'
                break
            advance_match(arena, tick + 1, transport)
            tick += 1
            frames.append(injury_snapshot(arena, tick, controllers))
            if terminal.fd is not None:
                saved_rng = random.getstate()
                try:
                    terminal.draw(render_full_screen(arena, tick))
                finally:
                    random.setstate(saved_rng)
                if delay:
                    time.sleep(delay)
        if arena.match_over:
            status = 'concluded'
    except KeyboardInterrupt:
        status = 'interrupted'
    except Exception as exc:
        status, error = 'error', str(exc)
    finally:
        if transport:
            transport.close()
        if terminal:
            terminal.close()
        result = {'schema': 'boxing.match/v1', 'match_id': arena.match_id, 'status': status,
                  'winner': arena.winner.name if arena.match_over and arena.winner else None,
                  'method': arena.ko_type if arena.match_over else 'No official result',
                  'ticks': tick, 'seed': arena.seed, 'controllers': controllers,
                  'scores': arena.scores, 'scorecards': arena.scorecards,
                  'scoring': 'damage_dealt + finishing_threat; knockout/stoppage takes precedence',
                  'damage_dealt': {side: f.damage_dealt for side, f in (('red', arena.f1), ('blue', arena.f2))},
                  'finishing_threat': {side: f.finishing_threat for side, f in (('red', arena.f1), ('blue', arena.f2))},
                  'engine_sha256': hashlib.sha256(engine_source.encode()).hexdigest(),
                  'error': error, 'output_dir': str(output_dir)}
        paths = export_injury_report(output_dir, frames, arena.events, result)
        term_write(terminal_injury_report(arena) + '\n')
        label = result['winner'] or ('DRAW' if arena.match_over else 'UNDECIDED')
        term_write('Match ' + status.upper() + ' — Winner: ' + label + ' · ' + result['method'] + '\n')
        term_write('Injury replay: ' + str(paths['html']) + '\nMatch data: ' + str(paths['json']) + '\n')
        if error:
            term_write('Match stopped: ' + error + '\nNo failed tick was retried or substituted locally.\n')
        if status == 'concluded':
            print('64-bit Ostadix Boxing Match Complete with Physics: Winner=' + label + ' · ' + result['method'])
        else:
            print('Ostadix Boxing Match ' + status.upper() + ': Winner=UNDECIDED')
    if status == 'error':
        raise RuntimeError(error)
    return result

