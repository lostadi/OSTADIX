+    SocketState *s = (SocketState *)net->opaque;
+    if (s->fd < 0) {
+      return;
+    }
+    // The virtio caller owns and frees buf. Keep its allocation base intact;
+    // the QEMU length prefix belongs to this temporary wire buffer.
+    if (len < 14 || len > 16384) {
+      close(s->fd);
+      s->fd = -1;
+      return;
+    }
+    uint8_t *packet = (uint8_t *)malloc(len + 4);
+    if (packet == NULL) {
+      close(s->fd);
+      s->fd = -1;
+      return;
+    }
+    uint32_t size = htonl(len);
+    memcpy(packet, &size, 4);
+    memcpy(packet + 4, buf, len);
+    int ret = send(s->fd, packet, len + 4, 0);
+    free(packet);
+    // A partial nonblocking send cannot be silently accepted as a full frame.
+    // The browser transport admits complete packets or terminates the session.
+    if (ret != len + 4) {
+      close(s->fd);
+      s->fd = -1;
+    }
