+  switch (address) {
+#ifdef WASI
+    case 0xf5:
+      ostadix_state_finalized = io_len == 1 && (value & 0xff) == 0xa5;
+      break;
+    case 0xf4:
+      // Report directly to WASI; quit_sim deliberately discards this status.
+      fflush(NULL);
+      ::exit(io_len == 1
+        ? static_cast<int>((ostadix_state_finalized ? 0x4f530000 : 0) | (value & 0xff))
+        : 125);
+#endif
+    case 0x80: // diagnostic test port to display progress of POST
