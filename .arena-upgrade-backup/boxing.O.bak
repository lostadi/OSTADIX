let checkpoint_receipt = python[91]^(
import base64, copy, hashlib, json, math, os, random, shutil, sys, time
from pathlib import Path

kind = $combat_kind
programs = $program_expressions
terminal_context = O.eval(programs['arena/terminal.O'])
if kind not in ('boxing', 'medieval'):
    raise ValueError('combat_kind must be boxing or medieval')

def integer_option(name, default, low, high):
    try:
        value = int(os.environ.get(name, str(default)))
    except ValueError:
        raise ValueError(f'{name} must be an integer from {low} to {high}') from None
    if not low <= value <= high:
        raise ValueError(f'{name} must be an integer from {low} to {high}')
    return value

seed = integer_option('OSTADIX_SEED', 42, -2147483648, 2147483647)
warmup = integer_option('OSTADIX_ARENA_CHECKPOINT', 16, 0, 60)
horizon_option = 'OSTADIX_ARENA_HORIZON' if 'OSTADIX_ARENA_HORIZON' in os.environ else 'OSTADIX_FRAMES'
horizon = integer_option(horizon_option, 144, 1, 360)
switches = {}
for option in ('OSTADIX_ANIMATE', 'OSTADIX_COLOR'):
    value = os.environ.get(option, 'auto').strip().lower()
    if value not in ('auto', '0', '1'):
        raise ValueError(f'{option} must be auto, 0, or 1')
    switches[option] = value
decision_interval = 24
frame_stride = max(1, math.ceil(horizon / 36))
bank = $strategy_bank
languages = {'Pressure': 'JavaScript', 'Adaptive': 'Python', 'Guard': 'Common Lisp'}

def digest(value):
    return hashlib.sha256(json.dumps(value, sort_keys=True, separators=(',', ':'), allow_nan=False).encode()).hexdigest()

def freeze(value, seen=None):
    # Preserve aliases and exact floats, excluding only the presentation buffer.
    if seen is None:
        seen = {}
    if value is None or isinstance(value, (str, int, bool)):
        return value
    if isinstance(value, float):
        if not math.isfinite(value):
            raise ValueError('non-finite simulation state')
        return {'float': value.hex()}
    identity = id(value)
    if identity in seen:
        return {'ref': seen[identity]}
    index = len(seen)
    seen[identity] = index
    if isinstance(value, dict):
        return {'id': index, 'dict': [[freeze(k, seen), freeze(value[k], seen)] for k in sorted(value, key=repr)]}
    if isinstance(value, (list, tuple)):
        return {'id': index, 'type': type(value).__name__, 'items': [freeze(item, seen) for item in value]}
    if hasattr(value, '__dict__'):
        return {'id': index, 'type': type(value).__name__, 'fields': {
            key: freeze(item, seen) for key, item in sorted(vars(value).items()) if key != 'buf'}}
    raise TypeError('unfingerprintable world value: ' + type(value).__name__)

def world_hash(world):
    return digest(freeze(world))

engine_expression = $engine_expression
engine_source = engine_expression.src
# The actual combat script already loaded its engine into this O actor.
arena_class = BoxingArena if kind == 'boxing' else MedievalArena
random.seed(seed)
live_world = arena_class()
live_identity = id(live_world)
for tick in range(warmup):
    if live_world.match_over:
        break
    live_world.step(tick)
checkpoint_tick = live_world.clock_tick
world_checkpoint = copy.deepcopy(live_world)
checkpoint_rng = random.getstate()
checkpoint_world_hash = world_hash(live_world)
checkpoint_hash = digest({'world': checkpoint_world_hash, 'rng': freeze(checkpoint_rng)})
strategy_hashes = {name: hashlib.sha256(expr.src.encode()).hexdigest() for name, expr in bank.items()}
program_sources = {'engine.O': engine_source, **{name: expression.src for name, expression in programs.items()}}
source_hashes = {name: hashlib.sha256(text.encode()).hexdigest() for name, text in program_sources.items()}
__oval_result__ = {'arena': kind, 'seed': seed, 'tick': checkpoint_tick,
                   'checkpoint_sha256': checkpoint_hash, 'strategies': strategy_hashes,
                   'judge_source': program_sources['arena/judge.O'],
                   'analyze_source': program_sources['arena/analyze.O']}
)_python[91]

let trials = python[91]^(
def observe(world):
    return {'arena': kind, 'tick': world.clock_tick, 'hp': world.f1.hp,
            'opponent_hp': world.f2.hp, 'stamina': world.f1.stamina,
            'opponent_stamina': world.f2.stamina, 'distance': abs(world.f1.x - world.f2.x)}

def pixel_frame(world, tick):
    # Some artwork adds floor stains. Draw a clone so observation cannot change
    # the physical future, and also preserve the simulation's random stream.
    state = random.getstate()
    try:
        painted = copy.deepcopy(world)
        painted.render_frame(tick)
        pixels = bytes(max(0, min(255, int(channel))) for row in painted.buf for rgb in row for channel in rgb)
    finally:
        random.setstate(state)
    return {'tick': tick, 'width': world.w, 'height': world.h,
            'rgb': base64.b64encode(pixels).decode(), 'own_hp': world.f1.hp, 'foe_hp': world.f2.hp}

def simulate(world, name, record_frames=True):
    random.setstate(checkpoint_rng)
    trace, decisions, frames, ledger = [], [], [], []
    if record_frames:
        frames.append(pixel_frame(world, checkpoint_tick))
    for offset in range(horizon):
        if world.match_over:
            break
        if offset % decision_interval == 0:
            scoped_state = observe(world)
            # First-class O expression reentry, with a detached explicit scope.
            policy = O.eval(bank[name], O.scope({'state': scoped_state}))
            normalized = world.set_tactics(world.f1, policy)
            decisions.append({'tick': world.clock_tick, 'scope_sha256': digest(scoped_state),
                              'source_sha256': strategy_hashes[name], 'policy': normalized})
        event = {'own_hp_before': world.f1.hp, 'foe_hp_before': world.f2.hp,
                 'own_stamina_before': world.f1.stamina,
                 'own_knockdowns_before': world.f1.knockdowns_taken,
                 'foe_knockdowns_before': world.f2.knockdowns_taken}
        world.step(checkpoint_tick + offset)
        event.update({'tick': world.clock_tick, 'own_hp_after': world.f1.hp,
                      'foe_hp_after': world.f2.hp, 'own_stamina_after': world.f1.stamina,
                      'own_knockdowns_after': world.f1.knockdowns_taken,
                      'foe_knockdowns_after': world.f2.knockdowns_taken})
        ledger.append(event)
        trace.append({'tick': world.clock_tick, 'world_sha256': world_hash(world),
                      'rng_sha256': digest(freeze(random.getstate()))})
        if record_frames and ((offset + 1) % frame_stride == 0 or world.match_over or offset + 1 == horizon):
            frames.append(pixel_frame(world, world.clock_tick))
    official = (1 if world.winner is world.f1 else -1 if world.winner is world.f2 else 0) if world.match_over else 0
    result = {'name': name, 'language': languages[name], 'official_outcome': official, 'ledger': ledger,
              'status': 'CONCLUDED' if world.match_over else 'UNDECIDED',
              'winner': world.winner.name if world.match_over and world.winner else 'UNDECIDED',
              'trace_sha256': digest(trace), 'trace': trace, 'decisions': decisions,
              'frames': frames, 'steps': len(trace)}
    return result

futures = {name: simulate(copy.deepcopy(world_checkpoint), name) for name in bank}
if id(live_world) != live_identity or world_hash(live_world) != checkpoint_world_hash:
    raise AssertionError('counterfactual trials mutated the suspended live arena')
__oval_result__ = [{key: item[key] for key in ('name', 'language', 'official_outcome', 'ledger', 'status', 'winner', 'trace_sha256', 'steps')}
                   for item in futures.values()]
)_python[91]

