let analyze_program = quote^(
# SQL owns combat accounting: derive scoring facts from the per-tick ledger.
let ledger_json = python^(
import json, math
trials = $trials
fields = ('own_hp_before', 'own_hp_after', 'foe_hp_before', 'foe_hp_after',
          'own_stamina_before', 'own_stamina_after', 'own_knockdowns_before',
          'own_knockdowns_after', 'foe_knockdowns_before', 'foe_knockdowns_after')
if not isinstance(trials, list) or not trials:
    raise ValueError('combat accounting requires trial records')
for trial in trials:
    if trial['official_outcome'] not in (-1, 0, 1):
        raise ValueError('invalid official outcome')
    if len(trial['ledger']) != trial['steps']:
        raise ValueError('combat ledger must cover every simulation step')
    previous = -1
    for event in trial['ledger']:
        if type(event['tick']) is not int or event['tick'] <= previous:
            raise ValueError('combat ledger ticks must increase')
        previous = event['tick']
        for field in fields:
            if isinstance(event[field], bool) or not isinstance(event[field], (float, int)) or not math.isfinite(event[field]):
                raise ValueError('combat ledger values must be finite numbers')
__oval_result__ = "'" + json.dumps(trials, allow_nan=False).replace("'", "''") + "'"
)_python

sql^(
WITH trials AS (
  SELECT key AS trial_id, value AS trial FROM json_each($ledger_json)
), events AS (
  SELECT trial_id, entry.value AS event,
         row_number() OVER (PARTITION BY trial_id ORDER BY CAST(entry.key AS INTEGER)) AS first_tick,
         row_number() OVER (PARTITION BY trial_id ORDER BY CAST(entry.key AS INTEGER) DESC) AS last_tick
  FROM trials, json_each(trial, '$.ledger') AS entry
), totals AS (
  SELECT trial_id,
         sum(max(0.0, json_extract(event, '$.foe_hp_before') - json_extract(event, '$.foe_hp_after'))) AS dealt,
         sum(max(0.0, json_extract(event, '$.own_hp_before') - json_extract(event, '$.own_hp_after'))) AS taken,
         sum(json_extract(event, '$.foe_knockdowns_after') - json_extract(event, '$.foe_knockdowns_before')
           - json_extract(event, '$.own_knockdowns_after') + json_extract(event, '$.own_knockdowns_before')) AS knockdowns,
         max(CASE WHEN last_tick = 1 THEN json_extract(event, '$.own_stamina_after') END)
           - max(CASE WHEN first_tick = 1 THEN json_extract(event, '$.own_stamina_before') END) AS stamina
  FROM events GROUP BY trial_id
)
SELECT json_group_array(json_set(trial, '$.metrics', json_object(
  'damage_dealt', coalesce(dealt, 0.0), 'damage_taken', coalesce(taken, 0.0),
  'net_knockdowns', coalesce(knockdowns, 0), 'stamina_delta', coalesce(stamina, 0.0),
  'official_outcome', json_extract(trial, '$.official_outcome'))))
FROM trials LEFT JOIN totals USING(trial_id);
)_sql
)_quote

let judge_program = quote^(
# Rank bounded counterfactual futures. Official outcome sorts before heuristic.
let rows_json = python^(
import json
"'" + json.dumps($trials, allow_nan=False).replace("'", "''") + "'"
)_python

sql^(
WITH facts AS (
  SELECT json_extract(value, '$.name') AS name,
         json_extract(value, '$.metrics.official_outcome') AS outcome,
         json_extract(value, '$.metrics.damage_dealt') AS dealt,
         json_extract(value, '$.metrics.damage_taken') AS taken,
         json_extract(value, '$.metrics.net_knockdowns') AS knockdowns,
         json_extract(value, '$.metrics.stamina_delta') AS stamina
  FROM json_each($rows_json)
), scored AS (
  SELECT name, outcome,
         -- TUNING POINT: the five terms below define the arena's preference.
         1000.0 * outcome
         + 2.0 * dealt
         - 0.5 * taken
         + 25.0 * knockdowns
         + 0.025 * stamina AS score
  FROM facts
)
SELECT json_group_array(json_object('name', name, 'score', score, 'outcome', outcome))
FROM (SELECT * FROM scored ORDER BY outcome DESC, score DESC, name ASC);
)_sql
)_quote

let view_program = quote^(
# A pure view: O.eval(O.quote(source), O.scope({"payload": receipt})).
# Returns an HTML OValue; the caller decides whether and where to save it.
html^(
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="dark">
<title>OSTADIX / COUNTERFACTUAL ARENA</title>
<style>
:root{color-scheme:dark;--base:#1e1e2e;--mantle:#181825;--crust:#11111b;--surface:#313244;--text:#cdd6f4;--muted:#a6adc8;--lavender:#b4befe;--teal:#94e2d5;--peach:#fab387;--red:#f38ba8;--line:#45475a;font-family:"Fira Code","SFMono-Regular",Consolas,monospace;font-size:14px}
*{box-sizing:border-box}[hidden]{display:none!important}
body{margin:0;background:var(--base);color:var(--text)}
button,input,select{font:inherit}
button,select{background:var(--surface);border:1px solid var(--line);border-radius:6px;color:var(--text);padding:.7rem 1rem;cursor:pointer}
button:hover,select:hover{border-color:var(--lavender)}button:disabled{opacity:.45;cursor:default}
button:focus-visible,select:focus-visible,input:focus-visible,summary:focus-visible{outline:2px solid var(--teal);outline-offset:4px}
button.primary{background:var(--lavender);border-color:var(--lavender);color:var(--crust);font-weight:650}
main{max-width:1640px;margin:auto;padding:34px clamp(16px,3.4vw,58px) 54px}
header{display:flex;align-items:center;justify-content:space-between;gap:18px;padding-bottom:28px;border-bottom:1px solid var(--line)}
.brand{font-weight:750;letter-spacing:.05em;font-size:16px}.brand span{color:var(--muted);font-weight:400;margin-left:.5rem}
.arena-tag{border:1px solid var(--line);padding:8px 13px;border-radius:30px;color:var(--lavender);white-space:nowrap}
.intro{display:flex;align-items:flex-end;justify-content:space-between;gap:26px;margin:34px 0 28px}
h1{font-size:clamp(26px,3.1vw,44px);font-weight:550;line-height:1.18;letter-spacing:-.055em;margin:0 0 15px;max-width:780px}
p{line-height:1.7;margin:0;color:var(--muted);max-width:76ch}.context{font-size:12px}
.receipt{display:flex;gap:22px;flex-wrap:wrap;justify-content:flex-end}.receipt div{min-width:130px}
.receipt dt{font-size:11px;color:var(--muted);margin-bottom:8px}.receipt dd{margin:0;font-size:15px}
.verified{color:var(--teal)}.unverified{color:var(--peach)}
.judge{margin:-4px 0 24px;font-size:11px}.judge summary{cursor:pointer;color:var(--muted);padding:6px 0}.judge p{margin:13px 0;font-size:11px}.judge pre{margin:0;padding:18px;background:var(--mantle);border:1px solid var(--line);border-radius:8px;overflow:auto;line-height:1.7;font-size:11px;max-height:28rem}.judge code{font-family:inherit}
.candidates{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}
.candidate{min-width:0;background:var(--mantle);border:1px solid var(--line);border-radius:10px;overflow:hidden}.candidate.selected{border-color:var(--lavender)}
.candidate-head{padding:17px 18px 15px;display:flex;align-items:flex-start;justify-content:space-between;gap:12px}
.candidate h2{font-size:19px;font-weight:550;line-height:1.2;margin:0 0 8px;overflow-wrap:anywhere}
.language{font-size:11px;color:var(--muted)}.chosen{font-size:10px;background:var(--lavender);color:var(--crust);padding:5px 7px;border-radius:4px;white-space:nowrap}
.canvas-wrap{position:relative;background:var(--crust);width:100%;aspect-ratio:16/10;display:flex;align-items:center;justify-content:center;border-top:1px solid var(--surface);border-bottom:1px solid var(--surface)}
canvas{display:block;image-rendering:pixelated;image-rendering:crisp-edges;width:100%;height:100%;object-fit:contain}
.empty{padding:20px;text-align:center;color:var(--muted);font-size:12px}
.frame-state{display:flex;justify-content:space-between;gap:10px;margin:13px 18px 0;font-size:10px;color:var(--muted)}
.health{display:grid;grid-template-columns:1fr 1fr;gap:18px;padding:15px 18px 18px}
.health-label{display:flex;align-items:baseline;justify-content:space-between;gap:8px;font-size:11px;color:var(--muted)}.health-label strong{font-size:15px;color:var(--text);font-weight:500}
.bar{height:4px;background:var(--surface);margin-top:9px;border-radius:2px;overflow:hidden}.bar i{display:block;height:100%;width:0;background:var(--lavender)}.bar.foe i{background:var(--peach)}
.score-row{border-top:1px solid var(--surface);padding:16px 18px;display:flex;align-items:center;justify-content:space-between;gap:16px}
.score-row small{font-size:10px;color:var(--muted)}.score-value{font-size:28px;font-variant-numeric:tabular-nums;color:var(--lavender);letter-spacing:-.04em}
.official{display:flex;flex-direction:column;gap:6px;text-align:right;font-size:12px}.official span{color:var(--muted);font-size:10px}
.breakdown{border-top:1px solid var(--surface);padding:13px 18px 16px}.breakdown summary{cursor:pointer;font-size:11px;color:var(--muted)}
.metrics{margin-top:12px;display:grid;gap:10px}.metric{display:flex;justify-content:space-between;gap:14px;font-size:11px}.metric span:first-child{color:var(--muted)}.metric span:last-child{font-variant-numeric:tabular-nums}
.timeline{margin-top:22px;padding:20px 0;border-bottom:1px solid var(--line)}.timeline-top{display:flex;align-items:center;justify-content:space-between;gap:20px;margin-bottom:17px}
.transport{display:flex;gap:9px;align-items:center}.time-readout{font-size:13px;white-space:nowrap}.time-readout span{color:var(--muted);font-size:11px}
.range-row{display:flex;align-items:center;gap:18px}.range-row span{font-size:10px;color:var(--muted);white-space:nowrap}
input[type=range]{width:100%;accent-color:var(--lavender);cursor:pointer;min-height:26px;margin:0}.note{margin-top:13px;font-size:11px;line-height:1.7}
.technical{margin-top:26px}.technical>summary{cursor:pointer;font-size:12px;padding:9px 0;color:var(--text)}
.provenance{margin-top:15px;padding:20px;border:1px solid var(--line);border-radius:8px;background:var(--mantle)}.provenance p{font-size:12px;margin-bottom:19px}
.proofs{display:grid;grid-template-columns:150px minmax(0,1fr);gap:13px 18px;font-size:11px}.proofs dt{color:var(--muted)}.proofs dd{margin:0;overflow-wrap:anywhere;line-height:1.6}
.provenance h3{font-size:12px;font-weight:500;margin:24px 0 14px}.hash-list{display:grid;gap:12px;font-size:10px}
.hash{display:grid;grid-template-columns:minmax(140px,1fr) minmax(0,3fr);gap:18px;align-items:start}.hash span:first-child{color:var(--muted);overflow-wrap:anywhere}.hash code{color:var(--text);overflow-wrap:anywhere;line-height:1.7}
.footer{margin-top:28px;color:var(--muted);font-size:10px;line-height:1.8}.error{color:var(--red);border:1px solid var(--red);padding:20px;margin-top:24px}
.sr-only{position:absolute;width:1px;height:1px;padding:0;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
@media(min-width:1450px){.canvas-wrap{aspect-ratio:16/11}}
@media(max-width:1050px){.intro{display:block}.receipt{justify-content:flex-start;margin-top:25px}.candidates{gap:12px}.candidate-head,.score-row{padding-left:13px;padding-right:13px}.score-row{align-items:flex-start;flex-direction:column}.official{text-align:left}.health{gap:10px;padding-left:13px;padding-right:13px}.candidate h2{font-size:16px}.chosen{font-size:9px}}
@media(max-width:760px){main{padding-top:22px}header{align-items:flex-start}.brand{font-size:12px}.brand span{display:block;margin:6px 0 0;font-size:10px}.arena-tag{font-size:10px}.intro{margin:26px 0}.candidates{grid-template-columns:1fr}.candidate-head,.score-row{padding:17px 18px}.score-row{flex-direction:row;align-items:center}.official{text-align:right}.candidate h2{font-size:19px}.canvas-wrap{aspect-ratio:16/9}.timeline{position:sticky;bottom:0;background:var(--base);z-index:2;padding:14px 0;border-top:1px solid var(--line);margin-top:20px}.timeline-top{gap:12px;margin-bottom:9px}.transport{gap:6px}.transport button,.transport select{padding:.65rem .7rem;font-size:11px}.time-readout{font-size:12px}.time-readout span{display:block;text-align:right;margin-top:4px}.range-row{gap:10px}.note{font-size:10px}.proofs{grid-template-columns:1fr;gap:7px}.proofs dd{margin-bottom:10px}.hash{grid-template-columns:1fr;gap:5px}.receipt{gap:19px}.receipt div{min-width:115px}}
@media(prefers-reduced-motion:reduce){*{scroll-behavior:auto}}
</style>
</head>
<body>
<main>
<header><div class="brand">OSTADIX <span>/ COUNTERFACTUAL ARENA</span></div><div class="arena-tag" id="arena-name">Arena replay</div></header>
<section class="intro" aria-labelledby="title"><div><h1 id="title">One checkpoint.<br>Three possible futures.</h1><p class="context" id="context">Compare decisions from the same application state.</p></div><dl class="receipt"><div><dt>Chosen policy</dt><dd id="chosen-policy">—</dd></div><div><dt>Chosen replay</dt><dd id="replay-verification">—</dd></div><div><dt>Original actor</dt><dd id="actor-preservation">—</dd></div></dl></section>
<details class="judge"><summary>Selection rule: arena/judge.O</summary><p>The recorded rule computes policy scores for this run. Each candidate's official combat result is shown separately.</p><pre><code id="judge-source">Source not supplied in this receipt.</code></pre></details>
<section class="candidates" id="candidates" aria-label="Candidate policy replays"></section>
<section class="timeline" aria-label="Replay controls"><div class="timeline-top"><div class="transport"><button type="button" class="primary" id="play" aria-label="Play all candidate replays">Play</button><button type="button" id="restart">Restart</button><label class="sr-only" for="speed">Replay speed</label><select id="speed"><option value="4">½× speed</option><option value="8" selected>1× speed</option><option value="16">2× speed</option></select></div><output class="time-readout" id="time-readout" for="timeline">Tick —</output></div><div class="range-row"><span id="range-start">—</span><label for="timeline" class="sr-only">Shared simulation tick</label><input type="range" id="timeline" min="0" max="1" value="0" step="1"><span id="range-end">—</span></div><p class="note">Every arena follows the same tick. Scrub to compare recorded states; a finished branch holds its last frame.</p></section>
<details class="technical"><summary>Execution evidence and source fingerprints</summary><div class="provenance"><p>O evaluates each policy in its named language. Candidate simulations resume the same application checkpoint, including random state. The selected policy is replayed and its trace hash is compared. This receipt describes application state restoration; it does not claim runtime or process migration.</p><dl class="proofs" id="proofs"></dl><h3>Policy traces · SHA-256</h3><div class="hash-list" id="trace-hashes"></div><h3>Sources · SHA-256</h3><div class="hash-list" id="source-hashes"></div></div></details>
<p class="footer">Policy scores rank the simulated branches. The official result comes from the combat engine and can remain undecided at the horizon. Replay verification covers the selected trace; source hashes identify the inputs used for this run.</p>
<div id="error" class="error" role="alert" hidden></div>
</main>
<script type="application/json" id="arena-payload">python^(
import json
data = $payload
encoded = json.dumps(data, ensure_ascii=True, allow_nan=False, separators=(",", ":"))
# Script text is raw HTML even for application/json. Encode every markup
# delimiter before returning trusted HTML so hostile names cannot end the tag.
encoded = encoded.replace("&", "\\u0026").replace("<", "\\u003c").replace(">", "\\u003e")
__oval_result__ = OHtml(encoded)
)_python</script>
<script>
"use strict";
(() => {
  const el = id => document.getElementById(id);
  const put = (id, value) => { el(id).textContent = String(value); };
  const number = value => Number.isFinite(Number(value)) ? Number(value) : 0;
  const fixed = value => number(value).toFixed(1);
  const signed = value => (number(value) > 0 ? "+" : "") + fixed(value);
  const make = (tag, className, value) => {
    const node = document.createElement(tag);
    if (className) node.className = className;
    if (value !== undefined) node.textContent = String(value);
    return node;
  };
  try {
    const data = JSON.parse(el("arena-payload").textContent);
    if (data.schema !== "ostadix.arena/v1" || !Array.isArray(data.branches)) throw new Error("Unsupported arena receipt.");
    const branches = data.branches;
    put("arena-name", data.arena === "medieval" ? "Medieval combat" : "Boxing");
    if (branches.length !== 3) put("title", "One checkpoint. " + branches.length + " possible futures.");
    put("context", "Seed " + data.seed + " / checkpoint tick " + data.checkpoint_tick + " / " + data.horizon + "-tick horizon");
    put("chosen-policy", data.selected || "No policy selected");
    put("replay-verification", data.replay_verified ? "Hash verified" : "Not verified");
    el("replay-verification").className = data.replay_verified ? "verified" : "unverified";
    put("actor-preservation", data.actor_preserved ? "Preserved" : "Not verified");
    el("actor-preservation").className = data.actor_preserved ? "verified" : "unverified";
    if (typeof data.judge_source === "string") put("judge-source", data.judge_source);
    const addProof = (name, value) => { el("proofs").append(make("dt", "", name), make("dd", "", value)); };
    addProof("Receipt", data.schema);
    addProof("Checkpoint SHA-256", data.checkpoint_sha256 || "Unavailable");
    addProof("Chosen trace replay", data.replay_verified ? "Verified by trace hash equality" : "Not verified");
    addProof("Persistent actor", data.actor_preserved ? "Preserved across candidate evaluations" : "Preservation not verified");
    const addHash = (target, name, hash) => {
      const row = make("div", "hash");
      row.append(make("span", "", name), make("code", "", hash || "Unavailable"));
      el(target).append(row);
    };
    Object.entries(data.source_sha256 || {}).forEach(([name, hash]) => addHash("source-hashes", name, hash));
    if (!Object.keys(data.source_sha256 || {}).length) el("source-hashes").append(make("span", "", "No source fingerprints supplied."));
    const views = branches.map(branch => {
      const frames = (Array.isArray(branch.frames) ? branch.frames : []).slice().sort((a, b) => a.tick - b.tick);
      const article = make("article", "candidate" + (branch.name === data.selected ? " selected" : ""));
      const head = make("div", "candidate-head");
      const identity = make("div");
      identity.append(make("h2", "", branch.name), make("div", "language", "Policy evaluated in " + branch.language));
      head.append(identity);
      if (branch.name === data.selected) head.append(make("span", "chosen", "Chosen"));
      const wrap = make("div", "canvas-wrap");
      const canvas = make("canvas");
      canvas.setAttribute("role", "img");
      canvas.setAttribute("aria-label", branch.name + " recorded combat frame");
      const empty = make("div", "empty", "No recorded frames for this branch.");
      empty.hidden = frames.length > 0;
      canvas.hidden = frames.length === 0;
      wrap.append(canvas, empty);
      const state = make("div", "frame-state");
      const frameTick = make("span", "", "Tick —");
      const frameStatus = make("span", "", "");
      state.append(frameTick, frameStatus);
      const health = make("div", "health");
      const healthElements = ["Controlled fighter", "Opponent"].map((label, index) => {
        const cell = make("div");
        const line = make("div", "health-label");
        const value = make("strong", "", "—");
        line.append(make("span", "", label), value);
        const bar = make("div", "bar" + (index ? " foe" : ""));
        const fill = make("i");
        bar.setAttribute("aria-hidden", "true");
        bar.append(fill);
        cell.append(line, bar);
        health.append(cell);
        return {value, fill};
      });
      const score = make("div", "score-row");
      const scoreBlock = make("div");
      scoreBlock.append(make("small", "", "Policy score"), make("div", "score-value", signed(branch.score)));
      const official = make("div", "official");
      official.append(make("span", "", "Official result"), make("strong", "", branch.winner || "UNDECIDED"), make("span", "", branch.status || "Unknown"));
      score.append(scoreBlock, official);
      const detail = make("details", "breakdown");
      detail.append(make("summary", "", "Score inputs"));
      const metrics = make("div", "metrics");
      const metricLabels = [["damage_dealt", "Damage dealt"], ["damage_taken", "Damage taken"], ["net_knockdowns", "Net knockdowns"], ["stamina_delta", "Stamina change"], ["official_outcome", "Official outcome term"]];
      metricLabels.forEach(([key, label]) => {
        const row = make("div", "metric");
        const value = branch.metrics && branch.metrics[key];
        row.append(make("span", "", label), make("span", "", value == null ? "Unavailable" : signed(value)));
        metrics.append(row);
      });
      detail.append(metrics);
      article.append(head, wrap, state, health, score, detail);
      el("candidates").append(article);
      addHash("trace-hashes", branch.name + " (" + branch.language + ")", branch.trace_sha256);
      return {branch, frames, canvas, empty, frameTick, frameStatus, healthElements, cache: new Map(), shown: -1};
    });
    if (!branches.length) el("candidates").append(make("p", "empty", "This receipt contains no candidate branches."));
    const recordedTicks = Array.from(new Set(views.flatMap(view => view.frames.map(frame => number(frame.tick))))).sort((a,b) => a-b);
    const start = Math.min(number(data.checkpoint_tick), recordedTicks[0] === undefined ? number(data.checkpoint_tick) : recordedTicks[0]);
    const end = recordedTicks.length ? recordedTicks[recordedTicks.length - 1] : start;
    const range = el("timeline");
    range.min = String(start); range.max = String(end); range.value = String(start);
    put("range-start", start); put("range-end", end);
    let playing = false, animation = 0, lastTime = 0, clockTick = start;
    const pause = () => {
      playing = false;
      cancelAnimationFrame(animation);
      put("play", "Play");
      el("play").setAttribute("aria-label", "Play all candidate replays");
    };
    const decode = (view, index) => {
      if (view.cache.has(index)) return view.cache.get(index);
      const frame = view.frames[index];
      const width = Number(frame.width), height = Number(frame.height);
      if (!Number.isInteger(width) || !Number.isInteger(height) || width < 1 || height < 1 || width * height > 2000000) throw new Error("Invalid frame dimensions.");
      const raw = atob(frame.rgb);
      if (raw.length !== width * height * 3) throw new Error("RGB frame length does not match its dimensions.");
      const rgba = new Uint8ClampedArray(width * height * 4);
      for (let pixel = 0, offset = 0; offset < raw.length; pixel += 4, offset += 3) {
        rgba[pixel] = raw.charCodeAt(offset); rgba[pixel+1] = raw.charCodeAt(offset+1); rgba[pixel+2] = raw.charCodeAt(offset+2); rgba[pixel+3] = 255;
      }
      const pixels = new ImageData(rgba, width, height);
      view.cache.set(index, pixels);
      return pixels;
    };
    const draw = tick => {
      range.value = String(tick);
      const output = el("time-readout");
      output.replaceChildren(document.createTextNode("Tick " + tick + " "), make("span", "", "/ " + end));
      views.forEach(view => {
        let index = -1;
        for (let i = 0; i < view.frames.length && number(view.frames[i].tick) <= tick; i++) index = i;
        if (index < 0) {
          view.canvas.hidden = true; view.empty.hidden = false; view.shown = -1;
          view.empty.textContent = view.frames.length ? "First recorded frame is at tick " + view.frames[0].tick + "." : "No recorded frames for this branch.";
          view.frameTick.textContent = "Tick —"; view.frameStatus.textContent = "";
          view.healthElements.forEach(health => { health.value.textContent = "—"; health.fill.style.width = "0%"; });
          return;
        }
        const frame = view.frames[index];
        view.frameTick.textContent = "Frame at tick " + frame.tick;
        view.frameStatus.textContent = tick > number(view.frames[view.frames.length-1].tick) ? "Branch ended" : index === view.frames.length - 1 ? "Final recorded frame" : "";
        if (view.shown === index) { view.canvas.hidden = false; view.empty.hidden = true; return; }
        try {
          const pixels = decode(view, index);
          view.canvas.width = pixels.width; view.canvas.height = pixels.height;
          const context = view.canvas.getContext("2d");
          if (!context) throw new Error("Canvas rendering is unavailable in this browser.");
          context.imageSmoothingEnabled = false;
          context.putImageData(pixels, 0, 0);
          view.canvas.hidden = false; view.empty.hidden = true;
          view.canvas.setAttribute("aria-label", view.branch.name + " at tick " + frame.tick + ", fighter HP " + fixed(frame.own_hp) + ", opponent HP " + fixed(frame.foe_hp));
          view.healthElements.forEach((health, fighter) => {
            const key = fighter ? "foe_hp" : "own_hp";
            const hp = number(frame[key]);
            const maximum = Math.max(1, ...view.frames.map(item => number(item[key])));
            health.value.textContent = fixed(hp);
            health.fill.style.width = Math.min(100, Math.max(0, hp / maximum * 100)) + "%";
          });
          view.shown = index;
        } catch (error) {
          view.canvas.hidden = true; view.empty.hidden = false;
          view.empty.textContent = "Frame unavailable: " + error.message;
        }
      });
    };
    const loop = now => {
      if (!playing) return;
      if (lastTime) {
        const interval = recordedTicks.length > 1 ? (end - start) / (recordedTicks.length - 1) : 1;
        clockTick = Math.min(end, clockTick + Math.min(now - lastTime, 250) / 1000 * number(el("speed").value) * Math.max(1, interval));
      }
      lastTime = now;
      draw(Math.floor(clockTick));
      if (clockTick >= end) { pause(); return; }
      animation = requestAnimationFrame(loop);
    };
    el("play").addEventListener("click", () => {
      if (playing) { pause(); return; }
      if (clockTick >= end) clockTick = start;
      playing = true; lastTime = 0;
      put("play", "Pause"); el("play").setAttribute("aria-label", "Pause all candidate replays");
      animation = requestAnimationFrame(loop);
    });
    range.addEventListener("input", () => { pause(); clockTick = number(range.value); draw(clockTick); });
    el("restart").addEventListener("click", () => { pause(); clockTick = start; draw(start); });
    document.addEventListener("visibilitychange", () => { if (document.hidden) pause(); });
    if (end <= start) { el("play").disabled = true; el("restart").disabled = true; range.disabled = true; }
    draw(start);
  } catch (error) {
    el("error").hidden = false;
    el("error").textContent = "The arena replay could not be loaded: " + error.message;
    el("play").disabled = true; el("restart").disabled = true; el("timeline").disabled = true;
  }
})();
</script>
</body>
</html>
)_html
)_quote

let terminal_program = quote^(
# Inspect the calling O evaluator's stdout, which hosted backends do not inherit.
# A controlling terminal alone is insufficient: `O boxing.O | cat` stays static.
python^(
import os, stat, struct, sys

def terminal_probe():
    result = {'device': None, 'interactive': False, 'columns': 80, 'rows': 24,
              'platform': sys.platform}
    try:
        if sys.platform == 'darwin':
            import ctypes
            lib = ctypes.CDLL('/usr/lib/libproc.dylib', use_errno=True)
            lib.proc_pidinfo.argtypes = [ctypes.c_int, ctypes.c_int, ctypes.c_uint64,
                                         ctypes.c_void_p, ctypes.c_int]
            lib.proc_pidinfo.restype = ctypes.c_int
            lib.proc_pidpath.argtypes = [ctypes.c_int, ctypes.c_void_p, ctypes.c_uint32]
            lib.proc_pidpath.restype = ctypes.c_int
            lib.proc_pidfdinfo.argtypes = [ctypes.c_int, ctypes.c_int, ctypes.c_int,
                                           ctypes.c_void_p, ctypes.c_int]
            lib.proc_pidfdinfo.restype = ctypes.c_int

            def process_info(pid):
                # Darwin proc_bsdshortinfo is 64 bytes; parent PID is uint32 #2.
                info = ctypes.create_string_buffer(64)
                path = ctypes.create_string_buffer(4096)
                if lib.proc_pidinfo(pid, 13, 0, info, len(info)) != len(info):
                    raise OSError('process metadata unavailable')
                if lib.proc_pidpath(pid, path, len(path)) <= 0:
                    raise OSError('process executable unavailable')
                return struct.unpack_from('=I', info.raw, 4)[0], os.fsdecode(path.value)

            def stdout_device(pid):
                # Darwin vnode_fdinfowithpath: 24-byte file info, 152-byte vnode,
                # then MAXPATHLEN (1024) bytes. Pipes have no vnode path.
                info = ctypes.create_string_buffer(1200)
                if lib.proc_pidfdinfo(pid, 1, 2, info, len(info)) != len(info):
                    return None
                return os.fsdecode(info.raw[176:].split(bytes([0]), 1)[0])

        elif sys.platform.startswith('linux') or sys.platform == 'android':
            def process_info(pid):
                # Parentheses in the process name must not shift /proc fields.
                with open('/proc/' + str(pid) + '/stat', encoding='utf-8') as handle:
                    fields = handle.read().rsplit(')', 1)[1].split()
                return int(fields[1]), os.readlink('/proc/' + str(pid) + '/exe')

            def stdout_device(pid):
                return os.readlink('/proc/' + str(pid) + '/fd/1')

        else:
            return result

        # The Python shim is a child of O's backend process. The evaluator is
        # the outermost adjacent process with that same executable. Never walk
        # into the shell: its terminal would misidentify piped O output.
        evaluator = os.getppid()
        parent, executable = process_info(evaluator)
        for unused in range(8):
            if parent <= 1:
                break
            next_parent, parent_executable = process_info(parent)
            if parent_executable != executable:
                break
            evaluator, parent = parent, next_parent
        else:
            return result

        device = stdout_device(evaluator)
        if not device or not os.path.isabs(device):
            return result
        expected = os.stat(device)
        if not stat.S_ISCHR(expected.st_mode):
            return result
        # Read-only inspection does not claim or write to a terminal. O_NOCTTY
        # avoids acquiring a controlling terminal; O_NONBLOCK bounds the open.
        flags = os.O_RDONLY | os.O_NONBLOCK | getattr(os, 'O_NOCTTY', 0)
        descriptor = os.open(device, flags)
        try:
            opened = os.fstat(descriptor)
            if (not stat.S_ISCHR(opened.st_mode) or opened.st_rdev != expected.st_rdev
                    or not os.isatty(descriptor)):
                return result
            if os.tcgetpgrp(descriptor) != os.getpgid(evaluator):
                return result
            size = os.get_terminal_size(descriptor)
            result.update(device=device, interactive=True,
                          columns=min(1000, max(20, size.columns or 80)),
                          rows=min(300, max(5, size.lines or 24)))
        finally:
            os.close(descriptor)
    except (OSError, ValueError, IndexError, AttributeError, ImportError):
        # Restricted /proc or libproc access is a static-output condition.
        pass
    return result

__oval_result__ = terminal_probe()
)_python
)_quote

let raster_program = quote^(
# Native C17 terminal rasterizer. Evaluate with O.scope({"frames": frames}).
# RGB frames are ordered top to bottom; an odd final row has a black lower half.
# One batch compiles once. No cursor control, terminal writes, or platform APIs.
let raster_spec = python^(
import base64
import binascii

incoming = $frames
if not isinstance(incoming, list) or not 1 <= len(incoming) <= 37:
    raise ValueError("raster frames must contain 1..37 frames")
dimensions = None
for frame in incoming:
    if not isinstance(frame, dict):
        raise ValueError("raster frame must be a mapping")
    width, height = frame.get('width'), frame.get('height')
    if any(type(value) is not int or not 1 <= value <= 300 for value in (width, height)):
        raise ValueError("raster width and height must be integers in 1..300")
    if dimensions is None:
        dimensions = (width, height)
    elif dimensions != (width, height):
        raise ValueError("raster frames must have identical dimensions")
    tick = frame.get('tick')
    if type(tick) is not int or not 0 <= tick <= 2147483647:
        raise ValueError("raster tick must be an integer in 0..2147483647")
width, height = dimensions
if width * height * len(incoming) > 1000000:
    raise ValueError("raster batch exceeds 1000000 pixels")
byte_count = width * height * 3
encoded_length = ((byte_count + 2) // 3) * 4
packed = bytearray()
for frame in incoming:
    encoded = frame.get('rgb')
    if not isinstance(encoded, str) or len(encoded) != encoded_length:
        raise ValueError("raster RGB must be base64 with exactly width*height*3 bytes")
    try:
        rgb = base64.b64decode(encoded, validate=True)
    except (ValueError, binascii.Error):
        raise ValueError("raster RGB is not valid base64") from None
    if len(rgb) != byte_count:
        raise ValueError("raster RGB byte count does not match dimensions")
    packed.extend(rgb)
# Only checked byte values enter C source; input strings are never interpolated.
__oval_result__ = {
    'width': width, 'height': height, 'frame_count': len(incoming),
    'initializer': '{' + ','.join(str(value) for value in packed) + '}',
}
)_python

c^(
#include <stdint.h>
#include <stdio.h>
#include <string.h>

static const unsigned WIDTH = python^( $raster_spec['width'] )_python;
static const unsigned HEIGHT = python^( $raster_spec['height'] )_python;
static const unsigned FRAME_COUNT = python^( $raster_spec['frame_count'] )_python;
static const uint8_t PIXELS[] = python^( $raster_spec['initializer'] )_python;

/* Emit JSON directly: UTF-8 survives intact; controls and quotes are escaped. */
static void json_byte(unsigned char value) {
    switch (value) {
        case '"': fputs("\\\"", stdout); break;
        case '\\': fputs("\\\\", stdout); break;
        case '\n': fputs("\\n", stdout); break;
        case '\r': fputs("\\r", stdout); break;
        case '\t': fputs("\\t", stdout); break;
        default:
            if (value < 32) printf("\\u%04x", (unsigned)value);
            else putchar(value);
    }
}

static void json_text(const char *text) {
    while (*text) json_byte((unsigned char)*text++);
}

static void color(unsigned layer, const uint8_t *rgb) {
    char sequence[32];
    snprintf(sequence, sizeof sequence, "\033[%u;2;%u;%u;%um", layer,
             (unsigned)rgb[0], (unsigned)rgb[1], (unsigned)rgb[2]);
    json_text(sequence);
}

static void frame(unsigned index) {
    const uint8_t black[3] = {0, 0, 0};
    const size_t start = (size_t)index * WIDTH * HEIGHT * 3;
    putchar('"');
    for (unsigned y = 0; y < HEIGHT; y += 2) {
        const uint8_t *last_top = NULL;
        const uint8_t *last_bottom = NULL;
        for (unsigned x = 0; x < WIDTH; ++x) {
            const uint8_t *top = PIXELS + start + ((size_t)y * WIDTH + x) * 3;
            const uint8_t *bottom = y + 1 < HEIGHT
                ? top + (size_t)WIDTH * 3 : black;
            if (!last_top || memcmp(top, last_top, 3) != 0) color(38, top);
            if (!last_bottom || memcmp(bottom, last_bottom, 3) != 0) color(48, bottom);
            /* U+2580 UPPER HALF BLOCK, encoded independently of the C locale. */
            json_byte(0xe2); json_byte(0x96); json_byte(0x80);
            last_top = top;
            last_bottom = bottom;
        }
        json_text("\033[0m\n");
    }
    putchar('"');
}

int main(void) {
    printf("{\"width\":%u,\"height\":%u,\"frame_count\":%u,\"frames\":[",
           WIDTH, HEIGHT, FRAME_COUNT);
    for (unsigned index = 0; index < FRAME_COUNT; ++index) {
        if (index) putchar(',');
        frame(index);
    }
    fputs("]}\n", stdout);
    return ferror(stdout) ? 1 : 0;
}
)_c
)_quote

