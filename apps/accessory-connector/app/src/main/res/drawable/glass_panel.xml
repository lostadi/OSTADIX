<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <solid android:color="@color/accessory_surface" />
            <stroke android:width="1dp" android:color="@color/accessory_glass_edge" />
        </shape>
    </item>
    <item android:bottom="1dp" android:left="1dp" android:right="1dp" android:top="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="27dp" />
            <gradient
                android:angle="315"
                android:endColor="#102B3854"
                android:startColor="#4DFFFFFF" />
        </shape>
    </item>
</layer-list>
