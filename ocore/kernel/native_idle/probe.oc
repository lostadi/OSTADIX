        if plan == 0 || configure_startup(plan,&CONFIG[0],15) != 1 { fail(0x1b0 + index as u64); }
        let cspace: u64 = cspace_handle_for_slot(index);
        if cspace == 0 || set_quota_for_owner(cspace,48) != 1 { fail(0x1c0 + index as u64); }
        SPACES[index] = create_loaded_for_owner(cspace,plan);
        if SPACES[index] == 0 || !loaded_protections_hold(SPACES[index]) || root_cr3(SPACES[index]) == ocore_management_cr3() || release_plan(plan) != 1 { fail(0x1d0 + index as u64); }
        PHYSICALS[index] = isolation_physical(SPACES[index]);
        let mut process_id: u64 = 4101 + index as u64;
        if LINUX_TASK_STARTUP { process_id = LINUX_TASK_ID_BASE + index as u64; }
        OWNERS[index] = install_for_owner(index,process_id,domain,SPACES[index],cspace,ocore_process_kernel_stack_top(index),loaded_entry(SPACES[index]),loaded_stack_pointer(SPACES[index]));
        if OWNERS[index] == 0 || bind_process(namespace,OWNERS[index]) != 1 { fail(0x1e0 + index as u64); }
        if index != 1 { window_open(); let result: i64 = provision(OWNERS[index],100 + index as u64,1); window_close(); if result != 0 { fail(0x1f0 + index as u64); } }
        THREADS[index] = install_loaded(index,4201 + index as u64,OWNERS[index],loaded_entry(SPACES[index]),loaded_stack_pointer(SPACES[index]),ocore_process_kernel_stack_top(index),0,0,1,1);
        if THREADS[index] == 0 { fail(0x200 + index as u64); }
        if LINUX_TASK_STARTUP {
            // The unchanged native4101/4201 identities are intentionally not
            // Linux leaders. Reject them, then install real equal PID/TID IDs.
            if admit_linux_single_task(THREADS[index]) != 0 || thread_cancel(THREADS[index]) != 1
                || thread_reap(THREADS[index]) != 1 { fail(0x360 + index as u64); }
            THREADS[index] = install_loaded(index,process_id,OWNERS[index],loaded_entry(SPACES[index]),loaded_stack_pointer(SPACES[index]),ocore_process_kernel_stack_top(index),0,0,1,1);
            if THREADS[index] == 0 || admit_linux_single_task(THREADS[index]) != 1
                || admit_linux_single_task(THREADS[index]) != 1 { fail(0x364 + index as u64); }
        }
        index += 1;
    }
    if arm_personality(THREADS[0],OWNERS[0],PHYSICALS[0],THREADS[1],OWNERS[1],PHYSICALS[1],THREADS[2],OWNERS[2],PHYSICALS[2],THREADS[3],OWNERS[3],PHYSICALS[3]) != 1 { fail(0x210); }
    ocore_restore_management_context();
    if (NEGATIVE_CASE >= 11 && NEGATIVE_CASE <= 15) || NEGATIVE_CASE == 18 {
        if NEGATIVE_CASE == 11 { idle_probe_set_gs(0x12340000); }
        if NEGATIVE_CASE == 12 { idle_probe_set_fs(0x98765000); }
        capture_admission(&mut ADMISSION_BEFORE[0]);
        if NEGATIVE_CASE == 18 { NEGATIVE_RETURN = negative_action(18); }
        else { if NEGATIVE_CASE == 13 { NEGATIVE_RETURN = idle_probe_bad_stack_enable(ocore_process_kernel_stack_top(0)); }
        else {
            if NEGATIVE_CASE == 15 { NEGATIVE_RETURN = kernel_scheduler_take_idle(0); }
            else { NEGATIVE_RETURN = enable_personality_idle(); }
        }
        }
        capture_admission(&mut ADMISSION_AFTER[0]);
        NEGATIVE_READY = 1; write(&PREFIX[0],19); number(0x4e45474154495645);
        disable_interrupts(); loop { halt(); }
    }
    if IDLE_ENABLED && enable_personality_idle() != 1 { fail(0x415); }
    if IDLE_ENABLED && request_sleep(1) != 0xffff_ffff_ffff_fff8 { fail(0x416); }
    write(&PREFIX[0],19); number(0x41524d4544);
    enable_interrupts(); loop { halt(); }
}
