module runtime::linux_credentials;

// Immutable Linux credential-read metadata for an explicitly admitted native
// process generation. Only serialized trusted process-start policy calls
// admit/read_for/retire. No guest pointer, numeric UID, namespace text or syscall
// argument grants admission, native capabilities or filesystem authority.
// Setters, supplementary groups, access checks, set-ID exec and user namespaces
// are not supplied. This is not a Linux provider closure or original libc.
use runtime::process::MAX_PROCESSES;
use runtime::process::process_handle_for_slot;
use runtime::process::process_state;
use runtime::process::PROCESS_STATE_READY;
use runtime::process::PROCESS_STATE_RUNNING;
use runtime::process::is_live as process_is_live;
use runtime::process::domain_for;
use runtime::process::address_space_for;
use runtime::process::cspace_for;
use runtime::process::current_process_handle;
use runtime::process::current_address_space_handle;
use runtime::process::current_cspace_handle;
use runtime::process::current_personality_id;
use runtime::domain::personality_for;
use runtime::personality::PERSONALITY_LINUX_MINIMAL;
use runtime::address_space::is_live as space_is_live;
use runtime::capability::cspace_is_live;

// These fixed arrays match the existing four-PCB registry. A changed registry
// bound fails closed at initialization instead of indexing smaller storage.
static mut INITIALIZED: u8 = 0;
static mut OWNERS: [u64; 4] = [0; 4];
static mut SPACES: [u64; 4] = [0; 4];
static mut CSPACES: [u64; 4] = [0; 4];
static mut VALUES: [u64; 16] = [0; 16];

pub unsafe fn init() -> u64 {
    if INITIALIZED != 0 || MAX_PROCESSES != 4 { return 0; }
    // Static storage is zero at boot. This API cannot clear live credentials.
    INITIALIZED = 1;
    return 1;
}

unsafe fn slot_for(process: u64) -> usize {
    if INITIALIZED != 1 || process == 0 { return MAX_PROCESSES; }
    let mut slot: usize = 0;
    while slot < MAX_PROCESSES {
        if process_handle_for_slot(slot) == process { return slot; }
        slot += 1;
    }
    return MAX_PROCESSES;
}

unsafe fn live_identity(process: u64) -> bool {
    let state: u64 = process_state(process);
    return (state == PROCESS_STATE_READY || state == PROCESS_STATE_RUNNING)
        && personality_for(domain_for(process)) == PERSONALITY_LINUX_MINIMAL
        && space_is_live(address_space_for(process))
        && cspace_is_live(cspace_for(process));
}

// Values belong to the exact policy used for initial auxv construction.
// The trusted start owner calls before first execution; READY alone is not
// evidence of never having run, and this module does not track CPU history.
// Linux reserves (uid_t)-1/(gid_t)-1, so it is not an admitted identity here.
// Publication is last and admission cannot overwrite any occupied record,
// including an unretired record whose PCB slot has since been reused.
pub unsafe fn admit(process: u64, uid: u64, euid: u64, gid: u64, egid: u64) -> u64 {
    let slot: usize = slot_for(process);
    if slot >= MAX_PROCESSES || OWNERS[slot] != 0
        || current_process_handle() != 0
        || process_state(process) != PROCESS_STATE_READY
        || !live_identity(process)
        || uid >= 0xffff_ffff || euid >= 0xffff_ffff
        || gid >= 0xffff_ffff || egid >= 0xffff_ffff { return 0; }
    SPACES[slot] = address_space_for(process);
    CSPACES[slot] = cspace_for(process);
    VALUES[slot * 4] = uid;
    VALUES[slot * 4 + 1] = euid;
    VALUES[slot * 4 + 2] = gid;
    VALUES[slot * 4 + 3] = egid;
    OWNERS[slot] = process;
    return 1;
}

// Trusted process-start owner can use these immutable values for auxv instead
// of maintaining a second credential source. This is not an arbitrary-process
// user syscall. An unadmitted or changed PCB/AS/CSpace returns ESRCH.
pub unsafe fn read_for(process: u64, field: usize) -> i64 {
    if field >= 4 { return -22; }
    let slot: usize = slot_for(process);
    if slot >= MAX_PROCESSES || OWNERS[slot] != process
        || !live_identity(process)
        || SPACES[slot] != address_space_for(process)
        || CSPACES[slot] != cspace_for(process) { return -3; }
    return VALUES[slot * 4 + field] as i64;
}

pub unsafe fn dispatch(number: u64) -> i64 {
    if number != 102 && number != 107 && number != 104 && number != 108 { return -38; }
    let mut field: usize = 0;
    if number == 102 { field = 0; }
    if number == 107 { field = 1; }
    if number == 104 { field = 2; }
    if number == 108 { field = 3; }
    let owner: u64 = current_process_handle();
    let slot: usize = slot_for(owner);
    if slot >= MAX_PROCESSES || process_state(owner) != PROCESS_STATE_RUNNING
        || current_personality_id() != PERSONALITY_LINUX_MINIMAL
        || current_address_space_handle() != SPACES[slot]
        || current_cspace_handle() != CSPACES[slot] { return -3; }
    return read_for(owner, field);
}

// Only management retires metadata, after final PCB generation destruction.
// EXITED/REAPABLE/TEARDOWN tombstones deliberately remain registered and cannot
// be overwritten. Refusing a live/stale/unrelated handle has no side effects.
pub unsafe fn retire(process: u64) -> u64 {
    if INITIALIZED != 1 || process == 0 || process_is_live(process)
        || current_process_handle() != 0 { return 0; }
    let mut slot: usize = 0;
    while slot < MAX_PROCESSES {
        if OWNERS[slot] == process {
            OWNERS[slot] = 0;
            SPACES[slot] = 0;
            CSPACES[slot] = 0;
            let mut field: usize = 0;
            while field < 4 { VALUES[slot * 4 + field] = 0; field += 1; }
            return 1;
        }
        slot += 1;
    }
    return 0;
}
