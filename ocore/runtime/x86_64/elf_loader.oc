module runtime::elf_loader;

use runtime::image_vfs::object_length;
use runtime::image_vfs::read_retained_byte;
use runtime::image_vfs::release_object;

pub const ELF_LOAD_OK: u64 = 0;
pub const ELF_ERROR_MALFORMED: u64 = 1;
pub const ELF_ERROR_OVERLAP: u64 = 2;
pub const ELF_ERROR_WX: u64 = 3;
pub const ELF_ERROR_RANGE: u64 = 4;
pub const ELF_ERROR_CAPACITY: u64 = 5;

pub const MAX_ELF_PLANS: usize = 4;
pub const MAX_ELF_SEGMENTS: usize = 8;
pub const LINUX_STARTUP_DESCRIPTOR_WORDS: usize = 15;

const PLAN_EMPTY: u8 = 0;
const PLAN_BUILDING: u8 = 1;
const PLAN_VALIDATED: u8 = 2;
const PLAN_COMMITTED: u8 = 3;
const PLAN_RETIRED: u8 = 4;
const PLAN_HANDLE_TAG: u64 = 0xd600_0000;
const HANDLE_TAG_MASK: u64 = 0xff00_0000;
const HANDLE_INDEX_MASK: u64 = 0x00ff_ffff;

const ELF_HEADER_SIZE: usize = 64;
const ELF_PROGRAM_HEADER_SIZE: usize = 56;
const ELF_PT_LOAD: u64 = 1;
const ELF_PT_DYNAMIC: u64 = 2;
const ELF_PT_INTERP: u64 = 3;
const ELF_PF_X: u64 = 1;
const ELF_PF_W: u64 = 2;
const ELF_PF_R: u64 = 4;
const PAGE_SIZE: usize = 4096;
const LOAD_WINDOW_START: usize = 0x02000000;
const LOAD_WINDOW_END: usize = 0x02100000;
const STACK_BASE: usize = 0x013fc000;
const STACK_SIZE: usize = 0x00004000;
const INITIAL_STACK_BYTES: usize = 80;

static mut STATES: [u8; 4] = [0; 4];
static mut GENERATIONS: [u32; 4] = [0; 4];
static mut OBJECTS: [u64; 4] = [0; 4];
static mut OBJECT_LENGTHS: [usize; 4] = [0; 4];
static mut ENTRIES: [usize; 4] = [0; 4];
static mut STACK_POINTERS: [usize; 4] = [0; 4];
static mut SEGMENT_COUNTS: [usize; 4] = [0; 4];
static mut PROGRAM_HEADERS: [usize; 4] = [0; 4];
static mut PROGRAM_COUNTS: [usize; 4] = [0; 4];
static mut STACK_CONFIGURED: [u8; 4] = [0; 4];
static mut STACK_IMAGES: [u8; 65536] = [0; 65536];
// Loader calls, including configure/materialize/commit, are serialized by the
// native process-start owner. Configuration uses kernel-owned scratch and is
// published only after validation; inputs must remain immutable for the call.
static mut STACK_SCRATCH: [u8; 16384] = [0; 16384];

static mut SEGMENT_OFFSETS: [usize; 32] = [0; 32];
static mut SEGMENT_VADDRS: [usize; 32] = [0; 32];
static mut SEGMENT_FILESZS: [usize; 32] = [0; 32];
static mut SEGMENT_MEMSZS: [usize; 32] = [0; 32];
static mut SEGMENT_FLAGS: [u64; 32] = [0; 32];
static mut SEGMENT_PAGE_STARTS: [usize; 32] = [0; 32];
static mut SEGMENT_PAGE_ENDS: [usize; 32] = [0; 32];

static mut LAST_ERROR: u64 = ELF_LOAD_OK;
static mut VALIDATIONS: u64 = 0;
static mut REJECTIONS: u64 = 0;
static mut COMMITS: u64 = 0;
static mut INITIALIZED: u8 = 0;
static mut POISONED: u8 = 0;

fn plan_index(handle: u64) -> usize {
    return (handle & HANDLE_INDEX_MASK) as usize;
}

fn plan_generation(handle: u64) -> u32 {
    return (handle >> 32) as u32;
}

fn segment_index(slot: usize, segment: usize) -> usize {
    return slot * MAX_ELF_SEGMENTS + segment;
}

unsafe fn make_handle(slot: usize) -> u64 {
    return ((GENERATIONS[slot] as u64) << 32)
        | PLAN_HANDLE_TAG
        | slot as u64;
}

unsafe fn checked_plan(handle: u64, accept_committed: bool) -> usize {
    if INITIALIZED == 0
        || POISONED != 0
        || (handle & HANDLE_TAG_MASK) != PLAN_HANDLE_TAG {
        return MAX_ELF_PLANS;
    }
    let slot: usize = plan_index(handle);
    if slot >= MAX_ELF_PLANS
        || GENERATIONS[slot] != plan_generation(handle) {
        return MAX_ELF_PLANS;
    }
    if STATES[slot] == PLAN_VALIDATED {
        return slot;
    }
    if accept_committed && STATES[slot] == PLAN_COMMITTED {
        return slot;
    }
    return MAX_ELF_PLANS;
}

unsafe fn clear_slot(slot: usize) -> void {
    OBJECTS[slot] = 0;
    OBJECT_LENGTHS[slot] = 0;
    ENTRIES[slot] = 0;
    STACK_POINTERS[slot] = 0;
    SEGMENT_COUNTS[slot] = 0;
    PROGRAM_HEADERS[slot] = 0;
    PROGRAM_COUNTS[slot] = 0;
    if STACK_CONFIGURED[slot] != 0 {
        let mut byte: usize = 0;
        while byte < STACK_SIZE {
            STACK_IMAGES[slot * STACK_SIZE + byte] = 0;
            byte += 1;
        }
    }
    STACK_CONFIGURED[slot] = 0;
    let mut segment: usize = 0;
    while segment < MAX_ELF_SEGMENTS {
        let index: usize = segment_index(slot, segment);
        SEGMENT_OFFSETS[index] = 0;
        SEGMENT_VADDRS[index] = 0;
        SEGMENT_FILESZS[index] = 0;
        SEGMENT_MEMSZS[index] = 0;
        SEGMENT_FLAGS[index] = 0;
        SEGMENT_PAGE_STARTS[index] = 0;
        SEGMENT_PAGE_ENDS[index] = 0;
        segment += 1;
    }
}

unsafe fn retire_or_reuse(slot: usize) -> void {
    clear_slot(slot);
    if GENERATIONS[slot] == 0xffff_ffff {
        STATES[slot] = PLAN_RETIRED;
    } else {
        GENERATIONS[slot] += 1;
        STATES[slot] = PLAN_EMPTY;
    }
}

unsafe fn read_byte(object: u64, offset: usize, result: *mut u8) -> bool {
    return read_retained_byte(object, offset, result) != 0;
}

unsafe fn read_u16(object: u64, offset: usize, result: *mut u64) -> bool {
    if result as usize == 0 {
        return false;
    }
    let mut value: u64 = 0;
    let mut byte: usize = 0;
    while byte < 2 {
        let mut part: u8 = 0;
        if !read_byte(object, offset + byte, (&mut part)) {
            return false;
        }
        value = value | ((part as u64) << (byte * 8));
        byte += 1;
    }
    volatile_store(result, value);
    return true;
}

unsafe fn read_u32(object: u64, offset: usize, result: *mut u64) -> bool {
    if result as usize == 0 {
        return false;
    }
    let mut value: u64 = 0;
    let mut byte: usize = 0;
    while byte < 4 {
        let mut part: u8 = 0;
        if !read_byte(object, offset + byte, (&mut part)) {
            return false;
        }
        value = value | ((part as u64) << (byte * 8));
        byte += 1;
    }
    volatile_store(result, value);
    return true;
}

unsafe fn read_u64(object: u64, offset: usize, result: *mut u64) -> bool {
    if result as usize == 0 {
        return false;
    }
    let mut value: u64 = 0;
    let mut byte: usize = 0;
    while byte < 8 {
        let mut part: u8 = 0;
        if !read_byte(object, offset + byte, (&mut part)) {
            return false;
        }
        value = value | ((part as u64) << (byte * 8));
        byte += 1;
    }
    volatile_store(result, value);
    return true;
}

fn power_of_two(value: u64) -> bool {
    return value != 0 && (value & (value - 1)) == 0;
}

unsafe fn reject(slot: usize, error: u64) -> u64 {
    if slot < MAX_ELF_PLANS && OBJECTS[slot] != 0 {
        if release_object(OBJECTS[slot]) == 0 {
            POISONED = 1;
        }
        clear_slot(slot);
        STATES[slot] = PLAN_EMPTY;
    }
    LAST_ERROR = error;
    REJECTIONS += 1;
    return 0;
}

pub unsafe fn init() -> u64 {
    if INITIALIZED != 0 {
        return 0;
    }
    let mut slot: usize = 0;
    while slot < MAX_ELF_PLANS {
        STATES[slot] = PLAN_EMPTY;
        GENERATIONS[slot] = 1;
        clear_slot(slot);
        slot += 1;
    }
    LAST_ERROR = ELF_LOAD_OK;
    VALIDATIONS = 0;
    REJECTIONS = 0;
    COMMITS = 0;
    POISONED = 0;
    INITIALIZED = 1;
    if !invariants_hold() {
        INITIALIZED = 0;
        return 0;
    }
    return 1;
}

// Validate one already-retained immutable VFS object. This function consumes
// that retained reference on both success (the plan owns it) and rejection.
// No address-space allocation is attempted until a complete plan exists.
pub unsafe fn validate(object: u64) -> u64 {
    LAST_ERROR = ELF_LOAD_OK;
    if INITIALIZED == 0 || POISONED != 0 || object == 0 {
        LAST_ERROR = ELF_ERROR_MALFORMED;
        REJECTIONS += 1;
        return 0;
    }
    let length: usize = object_length(object);
    let mut slot: usize = 0;
    while slot < MAX_ELF_PLANS && STATES[slot] != PLAN_EMPTY {
        slot += 1;
    }
    if slot >= MAX_ELF_PLANS {
        if release_object(object) == 0 {
            POISONED = 1;
        }
        LAST_ERROR = ELF_ERROR_CAPACITY;
        REJECTIONS += 1;
        return 0;
    }
    clear_slot(slot);
    STATES[slot] = PLAN_BUILDING;
    OBJECTS[slot] = object;
    OBJECT_LENGTHS[slot] = length;
    if length < ELF_HEADER_SIZE {
        return reject(slot, ELF_ERROR_MALFORMED);
    }

    let expected_ident: [u8; 7] = [0x7f, 0x45, 0x4c, 0x46, 2, 1, 1];
    let mut ident: usize = 0;
    while ident < 7 {
        let mut actual: u8 = 0;
        if !read_byte(object, ident, (&mut actual))
            || actual != expected_ident[ident] {
            return reject(slot, ELF_ERROR_MALFORMED);
        }
        ident += 1;
    }
    ident = 7;
    while ident < 16 {
        let mut padding: u8 = 0;
        if !read_byte(object, ident, (&mut padding)) || padding != 0 {
            return reject(slot, ELF_ERROR_MALFORMED);
        }
        ident += 1;
    }

    let mut elf_type: u64 = 0;
    let mut machine: u64 = 0;
    let mut version: u64 = 0;
    let mut entry_value: u64 = 0;
    let mut phoff_value: u64 = 0;
    let mut flags: u64 = 0;
    let mut ehsize: u64 = 0;
    let mut phentsize: u64 = 0;
    let mut phnum: u64 = 0;
    if !read_u16(object, 16, (&mut elf_type))
        || !read_u16(object, 18, (&mut machine))
        || !read_u32(object, 20, (&mut version))
        || !read_u64(object, 24, (&mut entry_value))
        || !read_u64(object, 32, (&mut phoff_value))
        || !read_u32(object, 48, (&mut flags))
        || !read_u16(object, 52, (&mut ehsize))
        || !read_u16(object, 54, (&mut phentsize))
        || !read_u16(object, 56, (&mut phnum))
        || elf_type != 2
        || machine != 62
        || version != 1
        || flags != 0
        || ehsize != ELF_HEADER_SIZE as u64
        || phentsize != ELF_PROGRAM_HEADER_SIZE as u64
        || phnum == 0
        || phnum > 16
        || phoff_value < ELF_HEADER_SIZE as u64
        || phoff_value > length as u64 {
        return reject(slot, ELF_ERROR_MALFORMED);
    }
    let phoff: usize = phoff_value as usize;
    let program_count: usize = phnum as usize;
    if program_count > (length - phoff) / ELF_PROGRAM_HEADER_SIZE {
        return reject(slot, ELF_ERROR_MALFORMED);
    }
    if entry_value < LOAD_WINDOW_START as u64
        || entry_value >= LOAD_WINDOW_END as u64 {
        return reject(slot, ELF_ERROR_RANGE);
    }
    ENTRIES[slot] = entry_value as usize;

    let mut executable_entry: bool = false;
    let mut program: usize = 0;
    while program < program_count {
        let base: usize = phoff + program * ELF_PROGRAM_HEADER_SIZE;
        let mut program_type: u64 = 0;
        let mut program_flags: u64 = 0;
        let mut file_offset_value: u64 = 0;
        let mut virtual_value: u64 = 0;
        let mut file_size_value: u64 = 0;
        let mut memory_size_value: u64 = 0;
        let mut alignment: u64 = 0;
        if !read_u32(object, base, (&mut program_type))
            || !read_u32(object, base + 4, (&mut program_flags))
            || !read_u64(object, base + 8, (&mut file_offset_value))
            || !read_u64(object, base + 16, (&mut virtual_value))
            || !read_u64(object, base + 32, (&mut file_size_value))
            || !read_u64(object, base + 40, (&mut memory_size_value))
            || !read_u64(object, base + 48, (&mut alignment)) {
            return reject(slot, ELF_ERROR_MALFORMED);
        }
        if program_type == ELF_PT_DYNAMIC || program_type == ELF_PT_INTERP {
            return reject(slot, ELF_ERROR_MALFORMED);
        }
        if program_type == ELF_PT_LOAD {
            if SEGMENT_COUNTS[slot] >= MAX_ELF_SEGMENTS {
                return reject(slot, ELF_ERROR_CAPACITY);
            }
            if program_flags > (ELF_PF_R | ELF_PF_W | ELF_PF_X)
                || (program_flags & ELF_PF_R) == 0 {
                return reject(slot, ELF_ERROR_MALFORMED);
            }
            if (program_flags & ELF_PF_W) != 0
                && (program_flags & ELF_PF_X) != 0 {
                return reject(slot, ELF_ERROR_WX);
            }
            if file_size_value > memory_size_value
                || memory_size_value == 0
                || file_offset_value > length as u64
                || file_size_value > length as u64 - file_offset_value
                || virtual_value < LOAD_WINDOW_START as u64
                || virtual_value >= LOAD_WINDOW_END as u64
                || memory_size_value
                    > LOAD_WINDOW_END as u64 - virtual_value {
                return reject(slot, ELF_ERROR_RANGE);
            }
            if alignment != 0 && alignment != 1 {
                if !power_of_two(alignment)
                    || alignment > 0x0020_0000
                    || (virtual_value & (alignment - 1))
                        != (file_offset_value & (alignment - 1)) {
                    return reject(slot, ELF_ERROR_MALFORMED);
                }
            }
            let virtual_address: usize = virtual_value as usize;
            let memory_size: usize = memory_size_value as usize;
            let page_start: usize = virtual_address
                - (virtual_address & (PAGE_SIZE - 1));
            let raw_end: usize = virtual_address + memory_size;
            let mut page_end: usize = raw_end;
            let tail: usize = raw_end & (PAGE_SIZE - 1);
            if tail != 0 {
                page_end += PAGE_SIZE - tail;
            }
            if page_end <= page_start || page_end > LOAD_WINDOW_END {
                return reject(slot, ELF_ERROR_RANGE);
            }
            let mut prior: usize = 0;
            while prior < SEGMENT_COUNTS[slot] {
                let prior_index: usize = segment_index(slot, prior);
                if page_start < SEGMENT_PAGE_ENDS[prior_index]
                    && page_end > SEGMENT_PAGE_STARTS[prior_index] {
                    return reject(slot, ELF_ERROR_OVERLAP);
                }
                prior += 1;
            }
            let segment: usize = SEGMENT_COUNTS[slot];
            let index: usize = segment_index(slot, segment);
            SEGMENT_OFFSETS[index] = file_offset_value as usize;
            SEGMENT_VADDRS[index] = virtual_address;
            SEGMENT_FILESZS[index] = file_size_value as usize;
            SEGMENT_MEMSZS[index] = memory_size;
            SEGMENT_FLAGS[index] = program_flags;
            SEGMENT_PAGE_STARTS[index] = page_start;
            SEGMENT_PAGE_ENDS[index] = page_end;
            SEGMENT_COUNTS[slot] += 1;
            if (program_flags & ELF_PF_X) != 0
                && ENTRIES[slot] >= virtual_address
                && ENTRIES[slot] < raw_end {
                executable_entry = true;
            }
        }
        program += 1;
    }
    if SEGMENT_COUNTS[slot] == 0 || !executable_entry {
        return reject(slot, ELF_ERROR_MALFORMED);
    }
    // AT_PHDR is truthful only when the entire table is actually present in
    // a file-backed, readable PT_LOAD. A PT_PHDR declaration alone is not
    // sufficient, nor may a pointer into loader/kernel storage reach users.
    let table_bytes: usize = program_count * ELF_PROGRAM_HEADER_SIZE;
    let mut segment: usize = 0;
    while segment < SEGMENT_COUNTS[slot] {
        let index: usize = segment_index(slot, segment);
        if phoff >= SEGMENT_OFFSETS[index] {
            let relative: usize = phoff - SEGMENT_OFFSETS[index];
            if relative <= SEGMENT_FILESZS[index]
                && table_bytes <= SEGMENT_FILESZS[index] - relative {
                PROGRAM_HEADERS[slot] = SEGMENT_VADDRS[index] + relative;
                PROGRAM_COUNTS[slot] = program_count;
                break;
            }
        }
        segment += 1;
    }
    STACK_POINTERS[slot] = STACK_BASE + STACK_SIZE - INITIAL_STACK_BYTES;
    STATES[slot] = PLAN_VALIDATED;
    VALIDATIONS += 1;
    LAST_ERROR = ELF_LOAD_OK;
    if !invariants_hold() {
        POISONED = 1;
        return 0;
    }
    return make_handle(slot);
}

pub unsafe fn is_validated(plan: u64) -> bool {
    return checked_plan(plan, true) < MAX_ELF_PLANS;
}

pub unsafe fn entry(plan: u64) -> usize {
    let slot: usize = checked_plan(plan, true);
    if slot >= MAX_ELF_PLANS {
        return 0;
    }
    return ENTRIES[slot];
}

pub unsafe fn stack_base(plan: u64) -> usize {
    if checked_plan(plan, true) >= MAX_ELF_PLANS {
        return 0;
    }
    return STACK_BASE;
}

pub unsafe fn stack_size(plan: u64) -> usize {
    if checked_plan(plan, true) >= MAX_ELF_PLANS {
        return 0;
    }
    return STACK_SIZE;
}

pub unsafe fn stack_pointer(plan: u64) -> usize {
    let slot: usize = checked_plan(plan, true);
    if slot >= MAX_ELF_PLANS { return 0; }
    return STACK_POINTERS[slot];
}

pub unsafe fn segment_count(plan: u64) -> usize {
    let slot: usize = checked_plan(plan, true);
    if slot >= MAX_ELF_PLANS {
        return 0;
    }
    return SEGMENT_COUNTS[slot];
}

unsafe fn checked_segment(plan: u64, segment: usize) -> usize {
    let slot: usize = checked_plan(plan, true);
    if slot >= MAX_ELF_PLANS || segment >= SEGMENT_COUNTS[slot] {
        return MAX_ELF_PLANS * MAX_ELF_SEGMENTS;
    }
    return segment_index(slot, segment);
}

pub unsafe fn segment_vaddr(plan: u64, segment: usize) -> usize {
    let index: usize = checked_segment(plan, segment);
    if index >= MAX_ELF_PLANS * MAX_ELF_SEGMENTS {
        return 0;
    }
    return SEGMENT_VADDRS[index];
}

pub unsafe fn segment_filesz(plan: u64, segment: usize) -> usize {
    let index: usize = checked_segment(plan, segment);
    if index >= MAX_ELF_PLANS * MAX_ELF_SEGMENTS {
        return 0;
    }
    return SEGMENT_FILESZS[index];
}

pub unsafe fn segment_memsz(plan: u64, segment: usize) -> usize {
    let index: usize = checked_segment(plan, segment);
    if index >= MAX_ELF_PLANS * MAX_ELF_SEGMENTS {
        return 0;
    }
    return SEGMENT_MEMSZS[index];
}

pub unsafe fn segment_flags(plan: u64, segment: usize) -> u64 {
    let index: usize = checked_segment(plan, segment);
    if index >= MAX_ELF_PLANS * MAX_ELF_SEGMENTS {
        return 0;
    }
    return SEGMENT_FLAGS[index];
}

pub unsafe fn segment_page_start(plan: u64, segment: usize) -> usize {
    let index: usize = checked_segment(plan, segment);
    if index >= MAX_ELF_PLANS * MAX_ELF_SEGMENTS {
        return 0;
    }
    return SEGMENT_PAGE_STARTS[index];
}

pub unsafe fn segment_page_end(plan: u64, segment: usize) -> usize {
    let index: usize = checked_segment(plan, segment);
    if index >= MAX_ELF_PLANS * MAX_ELF_SEGMENTS {
        return 0;
    }
    return SEGMENT_PAGE_ENDS[index];
}

pub unsafe fn materialize_segment_range(
    plan: u64,
    segment: usize,
    range_offset: usize,
    destination: *mut u8,
    length: usize
) -> u64 {
    let slot: usize = checked_plan(plan, false);
    if slot >= MAX_ELF_PLANS
        || destination as usize == 0
        || segment >= SEGMENT_COUNTS[slot] {
        return 0;
    }
    let index: usize = segment_index(slot, segment);
    if range_offset > SEGMENT_MEMSZS[index]
        || length > SEGMENT_MEMSZS[index] - range_offset {
        return 0;
    }
    let mut byte: usize = 0;
    while byte < length {
        let memory_offset: usize = range_offset + byte;
        let mut value: u8 = 0;
        if memory_offset < SEGMENT_FILESZS[index]
            && !read_byte(
                OBJECTS[slot],
                SEGMENT_OFFSETS[index] + memory_offset,
                (&mut value)
            ) {
            return 0;
        }
        volatile_store(destination + byte, value);
        byte += 1;
    }
    return 1;
}

unsafe fn initial_stack_word(slot: usize, word: usize) -> u64 {
    if word == 3 {
        return 6;
    }
    if word == 4 {
        return PAGE_SIZE as u64;
    }
    if word == 5 {
        return 9;
    }
    if word == 6 {
        return ENTRIES[slot] as u64;
    }
    return 0;
}

fn native_range(pointer: usize, length: usize) -> bool {
    return length == 0 || (pointer != 0 && pointer <= 0xffff_ffff_ffff_ffff - length);
}

unsafe fn startup_reject(error: u64) -> u64 {
    LAST_ERROR = error;
    return 0;
}

// Packed vectors contain exactly `count` NUL-terminated byte strings. Empty
// arguments are valid; extra/missing terminators and trailing bytes are not.
unsafe fn packed_strings(pointer: *const u8, length: usize, count: usize) -> bool {
    if !native_range(pointer as usize, length) { return false; }
    if count == 0 { return length == 0; }
    if length == 0 || count > length { return false; }
    let mut found: usize = 0;
    let mut byte: usize = 0;
    while byte < length {
        if volatile_load(pointer + byte) == 0 { found += 1; }
        byte += 1;
    }
    return found == count && volatile_load(pointer + length - 1) == 0;
}

unsafe fn stack_word(offset: usize, value: u64) -> void {
    let mut byte: usize = 0;
    while byte < 8 {
        STACK_SCRATCH[offset + byte] = ((value >> (byte * 8)) & 0xff) as u8;
        byte += 1;
    }
}

unsafe fn stack_aux(offset: usize, kind: u64, value: u64) -> usize {
    stack_word(offset, kind);
    stack_word(offset + 8, value);
    return offset + 16;
}

// Trusted native process-start API, not a user-pointer syscall. The 15-word
// descriptor contains argv pointer/bytes/argc, env pointer/bytes/envc,
// execfn pointer/bytes (including its sole NUL), random pointer/bytes (16),
// uid/euid/gid/egid and secure (0 or 1), in that order. Credentials and fresh
// entropy must come from the owning platform policy; this module invents
// neither. Pointer inputs refer only to immutable trusted native allocations.
// A future exec syscall must first copy/authorize all user inputs separately.
// This supplies startup data only: static ET_EXEC/load-window policy remains,
// and no dynamic loader, TLS, libc or complete application profile is admitted.
pub unsafe fn configure_startup(plan: u64, descriptor: *const u64, words: usize) -> u64 {
    let slot: usize = checked_plan(plan, false);
    if slot >= MAX_ELF_PLANS || words != LINUX_STARTUP_DESCRIPTOR_WORDS || (descriptor as usize & 7) != 0
        || !native_range(descriptor as usize, 120) {
        return startup_reject(ELF_ERROR_MALFORMED);
    }
    let mut input: [u64; 15] = [0; 15];
    let mut field: usize = 0;
    while field < 15 { input[field] = volatile_load(descriptor + field); field += 1; }
    let argv: *const u8 = input[0] as *const u8;
    let argv_bytes: usize = input[1] as usize;
    let argc: usize = input[2] as usize;
    let env: *const u8 = input[3] as *const u8;
    let env_bytes: usize = input[4] as usize;
    let envc: usize = input[5] as usize;
    let execfn: *const u8 = input[6] as *const u8;
    let execfn_bytes: usize = input[7] as usize;
    let random: *const u8 = input[8] as *const u8;
    if argv_bytes > STACK_SIZE || env_bytes > STACK_SIZE - argv_bytes
        || execfn_bytes > STACK_SIZE - argv_bytes - env_bytes
        || 16 as usize > STACK_SIZE - argv_bytes - env_bytes - execfn_bytes
        || argc > STACK_SIZE / 8 || envc > STACK_SIZE / 8 {
        return startup_reject(ELF_ERROR_CAPACITY);
    }
    if !packed_strings(argv, argv_bytes, argc)
        || !packed_strings(env, env_bytes, envc)
        || !packed_strings(execfn, execfn_bytes, 1)
        || input[9] != 16 || !native_range(random as usize, 16)
        || input[10] > 0xffff_ffff || input[11] > 0xffff_ffff
        || input[12] > 0xffff_ffff || input[13] > 0xffff_ffff || input[14] > 1 {
        return startup_reject(ELF_ERROR_MALFORMED);
    }
    let data_bytes: usize = argv_bytes + env_bytes + execfn_bytes + 16;
    let mut aux_pairs: usize = 10; // Nine entries and AT_NULL.
    if PROGRAM_HEADERS[slot] != 0 { aux_pairs += 3; }
    let table_words: usize = 1 + argc + 1 + envc + 1 + aux_pairs * 2;
    let data_start: usize = STACK_SIZE - data_bytes;
    if table_words > data_start / 8 { return startup_reject(ELF_ERROR_CAPACITY); }
    let pointer_offset: usize = (data_start - table_words * 8) & 0xffff_ffff_ffff_fff0;
    let mut byte: usize = 0;
    while byte < STACK_SIZE { STACK_SCRATCH[byte] = 0; byte += 1; }
    let mut cursor: usize = pointer_offset;
    stack_word(cursor, argc as u64); cursor += 8;
    byte = 0;
    while byte < argv_bytes {
        if byte == 0 || volatile_load(argv + byte - 1) == 0 {
            stack_word(cursor, (STACK_BASE + data_start + byte) as u64); cursor += 8;
        }
        STACK_SCRATCH[data_start + byte] = volatile_load(argv + byte); byte += 1;
    }
    stack_word(cursor, 0); cursor += 8;
    let env_start: usize = data_start + argv_bytes;
    byte = 0;
    while byte < env_bytes {
        if byte == 0 || volatile_load(env + byte - 1) == 0 {
            stack_word(cursor, (STACK_BASE + env_start + byte) as u64); cursor += 8;
        }
        STACK_SCRATCH[env_start + byte] = volatile_load(env + byte); byte += 1;
    }
    stack_word(cursor, 0); cursor += 8;
    let execfn_start: usize = env_start + env_bytes;
    byte = 0;
    while byte < execfn_bytes {
        STACK_SCRATCH[execfn_start + byte] = volatile_load(execfn + byte); byte += 1;
    }
    let random_start: usize = execfn_start + execfn_bytes;
    byte = 0;
    while byte < 16 { STACK_SCRATCH[random_start + byte] = volatile_load(random + byte); byte += 1; }
    cursor = stack_aux(cursor, 6, PAGE_SIZE as u64);
    cursor = stack_aux(cursor, 9, ENTRIES[slot] as u64);
    cursor = stack_aux(cursor, 11, input[10]);
    cursor = stack_aux(cursor, 12, input[11]);
    cursor = stack_aux(cursor, 13, input[12]);
    cursor = stack_aux(cursor, 14, input[13]);
    cursor = stack_aux(cursor, 23, input[14]);
    cursor = stack_aux(cursor, 25, (STACK_BASE + random_start) as u64);
    cursor = stack_aux(cursor, 31, (STACK_BASE + execfn_start) as u64);
    if PROGRAM_HEADERS[slot] != 0 {
        cursor = stack_aux(cursor, 3, PROGRAM_HEADERS[slot] as u64);
        cursor = stack_aux(cursor, 4, ELF_PROGRAM_HEADER_SIZE as u64);
        cursor = stack_aux(cursor, 5, PROGRAM_COUNTS[slot] as u64);
    }
    cursor = stack_aux(cursor, 0, 0);
    byte = 0;
    while byte < STACK_SIZE {
        STACK_IMAGES[slot * STACK_SIZE + byte] = STACK_SCRATCH[byte];
        STACK_SCRATCH[byte] = 0;
        byte += 1;
    }
    STACK_POINTERS[slot] = STACK_BASE + pointer_offset;
    STACK_CONFIGURED[slot] = 1;
    LAST_ERROR = ELF_LOAD_OK;
    return 1;
}

pub unsafe fn materialize_stack_range(
    plan: u64,
    range_offset: usize,
    destination: *mut u8,
    length: usize
) -> u64 {
    let slot: usize = checked_plan(plan, false);
    if slot >= MAX_ELF_PLANS
        || destination as usize == 0
        || !native_range(destination as usize, length)
        || range_offset > STACK_SIZE
        || length > STACK_SIZE - range_offset {
        return 0;
    }
    let stack_data_start: usize = STACK_SIZE - INITIAL_STACK_BYTES;
    let mut byte: usize = 0;
    while byte < length {
        let absolute: usize = range_offset + byte;
        let mut value: u8 = 0;
        if STACK_CONFIGURED[slot] != 0 {
            value = STACK_IMAGES[slot * STACK_SIZE + absolute];
        } else if absolute >= stack_data_start {
            let relative: usize = absolute - stack_data_start;
            let word: u64 = initial_stack_word(slot, relative / 8);
            value = ((word >> ((relative & 7) * 8)) & 0xff) as u8;
        }
        volatile_store(destination + byte, value);
        byte += 1;
    }
    return 1;
}

pub unsafe fn commit_for_process_start(
    plan: u64,
    result_entry: *mut usize,
    result_stack_pointer: *mut usize
) -> u64 {
    let slot: usize = checked_plan(plan, false);
    if slot >= MAX_ELF_PLANS
        || result_entry as usize == 0
        || result_stack_pointer as usize == 0
        || OBJECTS[slot] == 0
        || release_object(OBJECTS[slot]) == 0 {
        return 0;
    }
    OBJECTS[slot] = 0;
    STATES[slot] = PLAN_COMMITTED;
    volatile_store(result_entry, ENTRIES[slot]);
    volatile_store(result_stack_pointer, STACK_POINTERS[slot]);
    COMMITS += 1;
    return 1;
}

pub unsafe fn abort(plan: u64) -> u64 {
    let slot: usize = checked_plan(plan, false);
    if slot >= MAX_ELF_PLANS
        || OBJECTS[slot] == 0
        || release_object(OBJECTS[slot]) == 0 {
        return 0;
    }
    retire_or_reuse(slot);
    return 1;
}

pub unsafe fn release_plan(plan: u64) -> u64 {
    let slot: usize = checked_plan(plan, true);
    if slot >= MAX_ELF_PLANS || STATES[slot] != PLAN_COMMITTED {
        return 0;
    }
    retire_or_reuse(slot);
    return 1;
}

pub unsafe fn last_error() -> u64 {
    return LAST_ERROR;
}

pub unsafe fn validation_count() -> u64 {
    return VALIDATIONS;
}

pub unsafe fn rejection_count() -> u64 {
    return REJECTIONS;
}

pub unsafe fn commit_count() -> u64 {
    return COMMITS;
}

pub unsafe fn invariants_hold() -> bool {
    if INITIALIZED == 0 || POISONED != 0 {
        return false;
    }
    let mut slot: usize = 0;
    while slot < MAX_ELF_PLANS {
        if GENERATIONS[slot] == 0 {
            return false;
        }
        let state: u8 = STATES[slot];
        if state == PLAN_EMPTY || state == PLAN_RETIRED {
            if (state == PLAN_RETIRED && GENERATIONS[slot] != 0xffff_ffff)
                || OBJECTS[slot] != 0
                || OBJECT_LENGTHS[slot] != 0
                || ENTRIES[slot] != 0
                || STACK_POINTERS[slot] != 0
                || SEGMENT_COUNTS[slot] != 0 {
                return false;
            }
        } else {
            if state == PLAN_VALIDATED || state == PLAN_COMMITTED {
                if OBJECT_LENGTHS[slot] < ELF_HEADER_SIZE
                || ENTRIES[slot] < LOAD_WINDOW_START
                || ENTRIES[slot] >= LOAD_WINDOW_END
                || STACK_CONFIGURED[slot] > 1
                || (PROGRAM_HEADERS[slot] == 0 && PROGRAM_COUNTS[slot] != 0)
                || (PROGRAM_HEADERS[slot] != 0 && (PROGRAM_COUNTS[slot] == 0
                    || PROGRAM_COUNTS[slot] > 16 || PROGRAM_HEADERS[slot] < LOAD_WINDOW_START
                    || PROGRAM_HEADERS[slot] >= LOAD_WINDOW_END))
                || (STACK_CONFIGURED[slot] == 0 && STACK_POINTERS[slot] != STACK_BASE + STACK_SIZE - INITIAL_STACK_BYTES)
                || (STACK_CONFIGURED[slot] != 0 && (STACK_POINTERS[slot] < STACK_BASE
                    || STACK_POINTERS[slot] > STACK_BASE + STACK_SIZE - 16
                    || (STACK_POINTERS[slot] & 15) != 0))
                || SEGMENT_COUNTS[slot] == 0
                || SEGMENT_COUNTS[slot] > MAX_ELF_SEGMENTS
                || (state == PLAN_VALIDATED && OBJECTS[slot] == 0)
                || (state == PLAN_COMMITTED && OBJECTS[slot] != 0) {
                    return false;
                }
                let mut segment: usize = 0;
                while segment < SEGMENT_COUNTS[slot] {
                    let index: usize = segment_index(slot, segment);
                    if SEGMENT_MEMSZS[index] == 0
                    || SEGMENT_FILESZS[index] > SEGMENT_MEMSZS[index]
                    || SEGMENT_PAGE_STARTS[index] < LOAD_WINDOW_START
                    || SEGMENT_PAGE_ENDS[index] > LOAD_WINDOW_END
                    || SEGMENT_PAGE_STARTS[index] >= SEGMENT_PAGE_ENDS[index]
                    || (SEGMENT_FLAGS[index] & ELF_PF_R) == 0
                    || ((SEGMENT_FLAGS[index] & ELF_PF_W) != 0
                        && (SEGMENT_FLAGS[index] & ELF_PF_X) != 0) {
                        return false;
                    }
                    segment += 1;
                }
            } else {
                if state != PLAN_BUILDING {
                    return false;
                }
            }
        }
        slot += 1;
    }
    return true;
}
