module runtime::linux_process_syscalls;

// Native Linux60/231 boundary for explicitly admitted loaded sole-task/sole-mm
// leaders only. Trusted boot selects a matching read-only policy/cleanup
// provider, independently of gettid/set_tid_address identity admission. No
// guest argument, namespace text or supplied ID can arm this service. The
// provider remains responsible for its exact generation-bound native resources.
// This is a platform ABI service, not original Linux/libc source lowering,
// clone/shared-mm/futex/signals/wait ABI or full process-group support.
use runtime::thread::current_linux_tid;
use runtime::thread::current_handle;
use runtime::process::current_process_handle;
use runtime::process::current_address_space_handle;
use runtime::process::current_cspace_handle;
use runtime::process::current_personality_id;
use runtime::personality::PERSONALITY_LINUX_MINIMAL;
use runtime::scheduler::can_admit_linux_exit_policy;
use runtime::scheduler::request_linux_process_exit;
use runtime::scheduler::linux_process_exit_cleanup_ready;
use runtime::native_abi::SYSCALL_CONTROL_SCHEDULE;

static mut POLICY_ID: u64 = 0;

// Native trusted hooks, never command text or a guest-controlled capability.
// Nonzero ID identifies the matched provider within this kernel boot; it is
// not a password or independent authentication of malicious kernel code.
extern "sysv64" fn kernel_linux_exit_policy_id() -> u64;
extern "sysv64" fn kernel_linux_exit_policy_for(
    process: u64, thread: u64, tid: u64, space: u64, cspace: u64
) -> u64;

pub unsafe fn arm() -> u64 {
    if POLICY_ID != 0 || can_admit_linux_exit_policy() != 1 { return 0; }
    let policy: u64 = kernel_linux_exit_policy_id();
    if policy == 0 { return 0; }
    POLICY_ID = policy; return 1;
}

unsafe fn admitted_current() -> bool {
    if POLICY_ID == 0 || current_personality_id() != PERSONALITY_LINUX_MINIMAL
        || kernel_linux_exit_policy_id() != POLICY_ID { return false; }
    let tid: u64 = current_linux_tid();
    let thread: u64 = current_handle();
    let process: u64 = current_process_handle();
    let space: u64 = current_address_space_handle();
    let cspace: u64 = current_cspace_handle();
    if tid == 0 || thread == 0 || process == 0 || space == 0 || cspace == 0 { return false; }
    return kernel_linux_exit_policy_for(process, thread, tid, space, cspace) == POLICY_ID;
}

pub unsafe fn dispatch(number: u64, raw_status: u64) -> i64 {
    if (number != 60 && number != 231) || !admitted_current() { return -38; }
    let status: u64 = (raw_status & 255) << 8;
    let result: u64 = request_linux_process_exit(number, status);
    if result != SYSCALL_CONTROL_SCHEDULE { return -38; }
    return result as i64;
}

// The matching native cleanup hook calls this before any descriptor/resource
// effect. Actual entry/token/terminal status and exact current sole authority
// are rechecked; scheduler alone owns PCB/TCB transitions. Clear-child-TID is
// metadata only in this sole-mm profile and is never dereferenced here.
pub unsafe fn cleanup_allowed(process: u64, status: u64) -> u64 {
    if process == 0 || process != current_process_handle()
        || !admitted_current() || linux_process_exit_cleanup_ready(status) != 1 { return 0; }
    return 1;
}
