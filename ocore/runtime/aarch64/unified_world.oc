extern "ocore" fn uw_domain_init(domain: u64, pc: u64, x0: u64, pstate: u64) -> u64;
extern "ocore" fn uw_domain_reset(domain: u64, pc: u64, x0: u64, pstate: u64) -> u64;
extern "ocore" fn uw_current_domain() -> u64;
extern "ocore" fn uw_counter_read() -> u64;
extern "ocore" fn uw_counter_frequency() -> u64;
extern "ocore" fn uw_irq_ack() -> u64;
