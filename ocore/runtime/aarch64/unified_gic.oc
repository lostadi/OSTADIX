module runtime::aarch64::unified_gic;

// Two independent, single-PE GICv3 views. Only saved virtual CPU-interface
// banks are touched here; physical distributor/redistributor ownership stays
// with EL2. Ordinary unimplemented IRQ fields are RAZ/WI, never authorities.
extern "ocore" fn uw_vgic_lr_count() -> u64;
extern "ocore" fn uw_vgic_lr_read(domain: u64, index: u64) -> u64;
extern "ocore" fn uw_vgic_lr_write(domain: u64, index: u64, value: u64) -> void;
extern "ocore" fn uw_vgic_vmcr_read(domain: u64) -> u64;
extern "ocore" fn uw_vgic_vmcr_write(domain: u64, value: u64) -> void;
extern "ocore" fn uw_vgic_hcr_read(domain: u64) -> u64;
extern "ocore" fn uw_vgic_hcr_write(domain: u64, value: u64) -> void;
extern "ocore" fn uw_vgic_running_priority(domain: u64) -> u64;

const BAD: u64 = 0xffff_ffff_ffff_ffff;
const DOMAINS: u64 = 8;
const TRANSPORTS: u64 = 4;
const PRIVATE_IRQS: u64 = 0x4800_ffff;
const PENDING: u64 = 0x4000_0000_0000_0000;
const ACTIVE_BIT: u64 = 0x8000_0000_0000_0000;
const GROUP1: u64 = 0x1000_0000_0000_0000;
const HW: u64 = 0x2000_0000_0000_0000;
const DIST: u64 = 0x0800_0000;
const REDIST: u64 = 0x080a_0000;
const PRIVATE: u64 = 0x080b_0000;
static mut READY: u64 = 0;
static mut LRS: u64 = 0;
static mut ERROR: [u64; 8] = [0; 8];
static mut DIAGNOSTIC: [u64; 8] = [0; 8];
static mut CONTROL: [u64; 8] = [0x50; 8];
static mut WAKER: [u64; 8] = [6; 8];
static mut ENABLED: [u8; 512] = [0; 512];
static mut GROUP: [u8; 512] = [0; 512];
static mut EDGE: [u8; 512] = [0; 512];
static mut PRIORITY: [u8; 512] = [0; 512];
static mut LEVEL: [u8; 512] = [0; 512];
static mut LATCH: [u8; 512] = [0; 512];
static mut ACTIVE: [u8; 512] = [0; 512];
static mut HARD_ACTIVE: [u8; 512] = [0; 512];
static mut ACTIVE_PRIORITY: [u8; 512] = [0; 512];
static mut ROUTE: [u64; 512] = [0; 512];
static mut LR_OWNER: [u64; 128] = [BAD; 128];
static mut LR_SOFT: [u8; 128] = [0; 128];
static mut SAVED: [u64; 16] = [0; 16];
static mut DIRTY: [u64; 8] = [1; 8];
static mut CACHE: [u64; 128] = [0; 128];
// Trusted transport declarations, never guest distributor routing values.
static mut CONFIGURED: [u64; 8] = [0; 8];
static mut BINDING_GENERATION: [u64; 8] = [0; 8];
static mut TRANSPORT_IRQS: [u64; 32] = [0; 32];

unsafe fn assigned(domain: u64, irq: u64) -> bool {
    if domain >= DOMAINS || irq >= 64 || CONFIGURED[domain as usize] != 1 { return false; }
    let bit: u64 = 1 << (irq as usize);
    if (PRIVATE_IRQS & bit) != 0 { return true; }
    let mut transport: u64 = 0;
    while transport < TRANSPORTS {
        if (TRANSPORT_IRQS[(domain * TRANSPORTS + transport) as usize] & bit) != 0 { return true; }
        transport += 1;
    }
    return false;
}
fn item(domain: u64, irq: u64) -> usize { return (domain * 64 + irq) as usize; }
fn slot(domain: u64, lr: u64) -> usize { return (domain * 16 + lr) as usize; }
unsafe fn deny(domain: u64, reason: u64) -> u64 {
    if domain < DOMAINS { DIAGNOSTIC[domain as usize] = reason; }
    return 0;
}
unsafe fn fatal(domain: u64, reason: u64) -> bool {
    ERROR[domain as usize] = reason;
    DIAGNOSTIC[domain as usize] = reason;
    return false;
}
unsafe fn valid(domain: u64) -> bool {
    return READY == 1 && domain < DOMAINS && CONFIGURED[domain as usize] == 1 && ERROR[domain as usize] == 0;
}

// Fold actual hardware-updated saved LRs before changing software state. The
// first pass validates EVERY slot before any bank/state mutation. Clearing and
// rebuilding saved LRs preserves active priority registers, which assembly
// saves/restores separately, and avoids duplicate virtual INTIDs.
unsafe fn fold(domain: u64) -> bool {
    DIRTY[domain as usize] = 1;
    let mut seen: u64 = 0;
    let mut lr: u64 = 0;
    while lr < LRS {
        let value: u64 = uw_vgic_lr_read(domain, lr);
        SAVED[lr as usize] = value;
        let state: u64 = value >> 62;
        let owner: u64 = LR_OWNER[slot(domain, lr)];
        if state != 0 {
            let irq: u64 = value & 0xffff_ffff;
            if !assigned(domain, irq) || owner != irq || (value & HW) != 0 || (value & GROUP1) == 0 {
                return fatal(domain, 100);
            }
            if (seen & (1 << (irq as usize))) != 0 { return fatal(domain, 101); }
            seen |= 1 << (irq as usize);
        }
        lr += 1;
    }
    lr = 0;
    while lr < LRS {
        let value: u64 = SAVED[lr as usize];
        let owner: u64 = LR_OWNER[slot(domain, lr)];
        if owner != BAD {
            let index: usize = item(domain, owner);
            ACTIVE[index] = ((value & ACTIVE_BIT) != 0) as u8;
            HARD_ACTIVE[index] = ACTIVE[index];
            if ACTIVE[index] == 1 { ACTIVE_PRIORITY[index] = (value >> 48) as u8; }
            if (value & PENDING) != 0 && LR_SOFT[slot(domain, lr)] == 1 { LATCH[index] = 1; }
        }
        LR_OWNER[slot(domain, lr)] = BAD;
        LR_SOFT[slot(domain, lr)] = 0;
        uw_vgic_lr_write(domain, lr, 0);
        CACHE[slot(domain, lr)] = 0;
        lr += 1;
    }
    return true;
}
unsafe fn pending(domain: u64, irq: u64) -> bool {
    let index: usize = item(domain, irq);
    return LATCH[index] == 1 || (EDGE[index] == 0 && LEVEL[index] == 1);
}
unsafe fn can_deliver(domain: u64, irq: u64) -> bool {
    let index: usize = item(domain, irq);
    return ENABLED[index] == 1 && GROUP[index] == 1 && (CONTROL[domain as usize] & 2) != 0
        && (WAKER[domain as usize] & 2) == 0;
}
unsafe fn install(domain: u64, lr: u64, irq: u64, active: bool, priority: u8) -> void {
    let index: usize = item(domain, irq);
    let mut value: u64 = irq | GROUP1 | ((priority as u64) << 48);
    if active { value |= ACTIVE_BIT; }
    // Level IRQs are resampled after deactivation, rather than creating P+A
    // repeatedly while the handler is active. Edge/SW events remain latched.
    if can_deliver(domain, irq) && pending(domain, irq) && (!active || EDGE[index] == 1) {
        value |= PENDING;
        LR_SOFT[slot(domain, lr)] = LATCH[index];
        LATCH[index] = 0;
    }
    LR_OWNER[slot(domain, lr)] = irq;
    uw_vgic_lr_write(domain, lr, value);
    CACHE[slot(domain, lr)] = value;
}

// Clear one saved bank only. Unconfigured rows own no interrupt route.
unsafe fn clear_state(domain: u64, clear_bank: bool) -> void {
    DIRTY[domain as usize] = 1;
    ERROR[domain as usize] = 0; DIAGNOSTIC[domain as usize] = 0;
    CONTROL[domain as usize] = 0x50; WAKER[domain as usize] = 6;
    let mut irq: u64 = 0;
    while irq < 64 {
        let index: usize = item(domain, irq);
        ENABLED[index] = 0; GROUP[index] = 0; PRIORITY[index] = 0;
        LEVEL[index] = 0; LATCH[index] = 0; ACTIVE[index] = 0; HARD_ACTIVE[index] = 0;
        ACTIVE_PRIORITY[index] = 0; ROUTE[index] = 0;
        EDGE[index] = (irq < 16) as u8; irq += 1;
    }
    let mut lr: u64 = 0;
    while lr < 16 {
        LR_OWNER[slot(domain, lr)] = BAD; LR_SOFT[slot(domain, lr)] = 0;
        CACHE[slot(domain, lr)] = 0;
        if clear_bank && lr < LRS { uw_vgic_lr_write(domain, lr, 0); }
        lr += 1;
    }
    if clear_bank {
        uw_vgic_hcr_write(domain, 0); uw_vgic_vmcr_write(domain, 0);
    }
}

// Only the trusted domain/transport table may configure these declarations.
// A generation is an internal binding identity, not bearer authority.
// The domain table must unconfigure and configure its new generation on a
// restore; interrupt-state reset alone deliberately preserves the binding.
// Transport0 is the existing namespace wire on both boot profiles.
pub unsafe fn configure(domain: u64, generation: u64, first: u64, second: u64, third: u64, fourth: u64) -> u64 {
    if READY != 1 || domain >= DOMAINS || CONFIGURED[domain as usize] != 0
        || generation == 0 || generation > 0xffff_ffff
        || generation <= BINDING_GENERATION[domain as usize] { return 0; }
    // Transport IRQs are SPIs in this private 64-IRQ view. Intrinsic SGIs and
    // timer PPIs are never transferable, and two transports cannot share an IRQ.
    if ((first | second | third | fourth) & 0xffff_ffff) != 0
        || (first & (second | third | fourth)) != 0
        || (second & (third | fourth)) != 0 || (third & fourth) != 0 { return 0; }
    clear_state(domain, true);
    let base: usize = (domain * TRANSPORTS) as usize;
    TRANSPORT_IRQS[base] = first; TRANSPORT_IRQS[base + 1] = second;
    TRANSPORT_IRQS[base + 2] = third; TRANSPORT_IRQS[base + 3] = fourth;
    BINDING_GENERATION[domain as usize] = generation;
    CONFIGURED[domain as usize] = 1;
    uw_vgic_hcr_write(domain, 1); uw_vgic_vmcr_write(domain, 0xff00_0002);
    return 1;
}

pub unsafe fn binding_generation(domain: u64) -> u64 {
    if domain >= DOMAINS || CONFIGURED[domain as usize] != 1 { return 0; }
    return BINDING_GENERATION[domain as usize];
}

pub unsafe fn transport_irqs(domain: u64, generation: u64, transport: u64) -> u64 {
    if domain >= DOMAINS || transport >= TRANSPORTS || CONFIGURED[domain as usize] != 1
        || generation != BINDING_GENERATION[domain as usize] { return 0; }
    return TRANSPORT_IRQS[(domain * TRANSPORTS + transport) as usize];
}

pub unsafe fn unconfigure(domain: u64, generation: u64) -> u64 {
    if domain >= DOMAINS || CONFIGURED[domain as usize] != 1
        || generation != BINDING_GENERATION[domain as usize] { return 0; }
    CONFIGURED[domain as usize] = 0;
    let mut transport: u64 = 0;
    while transport < TRANSPORTS {
        TRANSPORT_IRQS[(domain * TRANSPORTS + transport) as usize] = 0; transport += 1;
    }
    clear_state(domain, true);
    return 1;
}

// Trusted reset preserves the declared bindings. The caller has cleared this
// domain's architectural bank, including APRs; no other bank is touched.
pub unsafe fn reset(domain: u64) -> u64 {
    if domain >= DOMAINS || CONFIGURED[domain as usize] != 1 || LRS == 0 || LRS > 16 { return 0; }
    clear_state(domain, true);
    uw_vgic_hcr_write(domain, 1); uw_vgic_vmcr_write(domain, 0xff00_0002);
    return 1;
}

pub unsafe fn init() -> u64 {
    READY = 0; LRS = uw_vgic_lr_count();
    if LRS == 0 || LRS > 16 { return 0; }
    let mut domain: u64 = 0;
    while domain < DOMAINS {
        clear_state(domain, CONFIGURED[domain as usize] == 1);
        CONFIGURED[domain as usize] = 0; BINDING_GENERATION[domain as usize] = 0;
        let mut transport: u64 = 0;
        while transport < TRANSPORTS {
            TRANSPORT_IRQS[(domain * TRANSPORTS + transport) as usize] = 0; transport += 1;
        }
        domain += 1;
    }
    READY = 1; return 1;
}

pub unsafe fn poll(domain: u64) -> u64 {
    // Idle still compares EVERY actual saved LR. Same-level callbacks defer
    // bank validation to this mandatory poll-before-restore.
    if !valid(domain) { return 0; }
    if DIRTY[domain as usize] == 0 {
        let mut same: bool = true;
        let mut lr: u64 = 0;
        while lr < LRS {
            if uw_vgic_lr_read(domain, lr) != CACHE[slot(domain, lr)] { same = false; }
            lr += 1;
        }
        if same { return 1; }
    }
    if !fold(domain) { return 0; }
    let mut used: u64 = 0;
    let mut chosen: u64 = 0;
    let mut irq: u64 = 0;
    // Active LRs cannot be displaced by pending requests. CPU running-priority
    // state remains in the separately banked AP0R/AP1R registers.
    while irq < 64 {
        let index: usize = item(domain, irq);
        if HARD_ACTIVE[index] == 1 {
            if used == LRS { fatal(domain, 102); return 0; }
            install(domain, used, irq, true, ACTIVE_PRIORITY[index]);
            chosen |= 1 << (irq as usize); used += 1;
        }
        irq += 1;
    }
    while used < LRS {
        let mut best: u64 = BAD;
        let mut priority: u64 = 256;
        irq = 0;
        while irq < 64 {
            if assigned(domain, irq) && (chosen & (1 << (irq as usize))) == 0 {
                let index: usize = item(domain, irq);
                if ACTIVE[index] == 0 && can_deliver(domain, irq) && pending(domain, irq)
                    && (PRIORITY[index] as u64) < priority {
                    best = irq; priority = PRIORITY[index] as u64;
                }
            }
            irq += 1;
        }
        if best == BAD { break; }
        install(domain, used, best, false, priority as u8);
        chosen |= 1 << (best as usize); used += 1;
    }
    DIRTY[domain as usize] = 0;
    return 1;
}

// WFI resumes when the private CPU interface would assert a virtual IRQ,
// even if PSTATE.I prevents taking that exception. Health/poll success alone
// is not a wake event. This profile admits Group1 software LRs only, with no
// NMI/LPI/HW extensions. Actual APR banks, not LR active state, determine the
// running priority (EOImode can keep those states distinct).
// BAD denotes corrupt native state; 0 and 1 mean asleep and IRQ asserted.
pub unsafe fn wake_pending(domain: u64) -> u64 {
    if poll(domain) != 1 { return BAD; }
    if (uw_vgic_hcr_read(domain) & 1) == 0 { return 0; }
    let vmcr: u64 = uw_vgic_vmcr_read(domain);
    if (vmcr & 2) == 0 { return 0; }
    let pmr: u64 = (vmcr >> 24) & 255;
    let running: u64 = uw_vgic_running_priority(domain);
    if running > 255 { return BAD; }
    let mut bits: u64 = (vmcr >> 18) & 7;
    if (vmcr & 16) != 0 { bits = ((vmcr >> 21) & 7) + 1; }
    // VBPR1 has a minimum implementation value of at least 1. A reset bank
    // can still contain zero before its first hardware restore; using 1 is
    // conservative and agrees with the smallest architectural VBPR1 value.
    if bits == 0 { bits = 1; }
    let mask: u64 = (255 << (bits as usize)) & 255;
    let mut lr: u64 = 0;
    while lr < LRS {
        let value: u64 = uw_vgic_lr_read(domain, lr);
        let priority: u64 = (value >> 48) & 255;
        if (value >> 62) == 1 && (value & GROUP1) != 0 && priority < pmr
            && (running == 255 || (priority & mask) < (running & mask)) { return 1; }
        lr += 1;
    }
    return 0;
}

pub unsafe fn set_level(domain: u64, irq: u64, asserted: u64) -> u64 {
    if !valid(domain) || irq < 16 || !assigned(domain, irq) || asserted > 1 { return deny(domain, 10); }
    let index: usize = item(domain, irq);
    if LEVEL[index] == asserted as u8 { return 1; }
    if !fold(domain) { return 0; }
    if EDGE[index] == 1 && asserted == 1 && LEVEL[index] == 0 { LATCH[index] = 1; }
    LEVEL[index] = asserted as u8;
    return 1;
}

// Future backend adapters carry the trusted binding generation and transport.
pub unsafe fn set_transport_level(domain: u64, generation: u64, transport: u64, irq: u64, asserted: u64) -> u64 {
    if domain >= DOMAINS || transport >= TRANSPORTS || irq >= 64
        || CONFIGURED[domain as usize] != 1 || generation != BINDING_GENERATION[domain as usize]
        || (TRANSPORT_IRQS[(domain * TRANSPORTS + transport) as usize] & (1 << (irq as usize))) == 0 { return 0; }
    return set_level(domain, irq, asserted);
}

pub unsafe fn send_sgi(domain: u64, value: u64, group: u64) -> u64 {
    if !valid(domain) || group != 1 { return deny(domain, 11); }
    // No RSS, reserved high fields or CPU outside this private single-PE view.
    let allowed: u64 = 0x00ff_01ff_0fff_ffff;
    if (value & ~allowed) != 0 { return deny(domain, 12); }
    if (value & (1 << 40)) != 0 { return 1; } // All OTHER private PEs: none.
    if (value & 0x00ff_00ff_00ff_0000) != 0 || (value & 1) == 0 { return 1; }
    let irq: u64 = (value >> 24) & 15;
    if !fold(domain) { return 0; }
    LATCH[item(domain, irq)] = 1;
    return 1;
}

fn width_ok(ipa: u64, width: u64) -> bool {
    return (width == 1 || width == 2 || width == 4 || width == 8) && (ipa & (width - 1)) == 0;
}
fn part(value: u64, offset: u64, width: u64) -> u64 {
    if width == 8 { return value; }
    return (value >> ((offset * 8) as usize)) & ((1 << ((width * 8) as usize)) - 1);
}
fn replace_part(old: u64, value: u64, offset: u64, width: u64) -> u64 {
    if width == 8 { return value; }
    let mask: u64 = ((1 << ((width * 8) as usize)) - 1) << ((offset * 8) as usize);
    return (old & ~mask) | ((value << ((offset * 8) as usize)) & mask);
}
fn identifier(offset: u64) -> u64 {
    if offset == 0xffd0 { return 0x44; }
    if offset == 0xffe0 { return 0x92; }
    if offset == 0xffe4 { return 0xb4; }
    if offset == 0xffe8 { return 0x30; }
    if offset == 0xffec { return 0; }
    if offset == 0xfff0 { return 0x0d; }
    if offset == 0xfff4 { return 0xf0; }
    if offset == 0xfff8 { return 0x05; }
    if offset == 0xfffc { return 0xb1; }
    return BAD;
}
// Class: group, enable-set/clear, pending-set/clear, active-set/clear.
fn bitmap_class(offset: u64) -> u64 {
    if offset >= 0x80 && offset < 0x100 { return 1; }
    if offset >= 0x100 && offset < 0x180 { return 2; }
    if offset >= 0x180 && offset < 0x200 { return 3; }
    if offset >= 0x200 && offset < 0x280 { return 4; }
    if offset >= 0x280 && offset < 0x300 { return 5; }
    if offset >= 0x300 && offset < 0x380 { return 6; }
    if offset >= 0x380 && offset < 0x400 { return 7; }
    return 0;
}
fn bitmap_base(kind: u64) -> u64 {
    if kind == 1 { return 0x80; }
    return 0x100 + (kind - 2) * 0x80;
}
unsafe fn bitmap_read(domain: u64, offset: u64, kind: u64, private: bool) -> u64 {
    let first: u64 = ((offset - bitmap_base(kind)) / 4) * 32;
    let mut result: u64 = 0;
    let mut bit: u64 = 0;
    while bit < 32 {
        let irq: u64 = first + bit;
        if assigned(domain, irq) && ((private && irq < 32) || (!private && irq >= 32)) {
            let index: usize = item(domain, irq);
            let mut set: bool = false;
            if kind == 1 { set = GROUP[index] == 1; }
            if kind == 2 || kind == 3 { set = ENABLED[index] == 1; }
            if kind == 4 || kind == 5 { set = pending(domain, irq); }
            if kind == 6 || kind == 7 { set = ACTIVE[index] == 1; }
            if set { result |= 1 << (bit as usize); }
        }
        bit += 1;
    }
    return result;
}
unsafe fn bitmap_write(domain: u64, offset: u64, kind: u64, value: u64, private: bool) -> void {
    let first: u64 = ((offset - bitmap_base(kind)) / 4) * 32;
    let mut bit: u64 = 0;
    while bit < 32 {
        let irq: u64 = first + bit;
        if assigned(domain, irq) && ((private && irq < 32) || (!private && irq >= 32)) {
            let index: usize = item(domain, irq);
            let set: bool = (value & (1 << (bit as usize))) != 0;
            if kind == 1 { GROUP[index] = set as u8; }
            if set {
                if kind == 2 { ENABLED[index] = 1; }
                if kind == 3 { ENABLED[index] = 0; }
                if kind == 4 { LATCH[index] = 1; }
                if kind == 5 { LATCH[index] = 0; }
                if kind == 6 {
                    if ACTIVE[index] == 0 { ACTIVE_PRIORITY[index] = PRIORITY[index]; }
                    ACTIVE[index] = 1;
                }
                if kind == 7 { ACTIVE[index] = 0; HARD_ACTIVE[index] = 0; }
            }
        }
        bit += 1;
    }
}

pub unsafe fn mmio_read(domain: u64, ipa: u64, width: u64) -> u64 {
    if !valid(domain) || !width_ok(ipa, width) { deny(domain, 20); return BAD; }
    let mut private: bool = false;
    let mut offset: u64 = 0;
    if ipa >= DIST && ipa + width <= DIST + 65536 { offset = ipa - DIST; }
    else {
        if ipa >= PRIVATE && ipa + width <= PRIVATE + 65536 { offset = ipa - PRIVATE; private = true; }
        else {
            if ipa >= REDIST && ipa + width <= REDIST + 65536 {
                offset = ipa - REDIST;
                if offset >= 8 && offset + width <= 16 { return part(16, offset - 8, width); }
                if width <= 4 && (offset & 3) + width <= 4 {
                    let base: u64 = offset & ~3;
                    if base == 0 || base == 0x10 { return 0; }
                    if base == 4 { return part(0x43b, offset & 3, width); }
                    if base == 0x14 { return part(WAKER[domain as usize], offset & 3, width); }
                    let id: u64 = identifier(base);
                    if id != BAD { return part(id, offset & 3, width); }
                }
            }
            deny(domain, 21); return BAD;
        }
    }
    let base: u64 = offset & ~3;
    if !private && width <= 4 && (offset & 3) + width <= 4 {
        if base == 0 { return part(CONTROL[domain as usize], offset & 3, width); }
        if base == 4 { return part(1 | (5 << 19), offset & 3, width); } //64IDs,6IDbits;noLPIs/ITS.
        if base == 8 { return part(0x43b, offset & 3, width); }
        if base == 12 || base == 16 { return 0; }
        let id: u64 = identifier(base);
        if id != BAD { return part(id, offset & 3, width); }
    }
    let kind: u64 = bitmap_class(offset);
    if kind != 0 && width <= 4 && (offset & 3) + width <= 4 {
        if !fold(domain) { return BAD; }
        return part(bitmap_read(domain, base, kind, private), offset & 3, width);
    }
    if offset >= 0x400 && offset + width <= 0x800 {
        let mut value: u64 = 0; let mut byte: u64 = 0;
        while byte < width {
            let irq: u64 = offset - 0x400 + byte;
            if assigned(domain, irq) && ((private && irq < 32) || (!private && irq >= 32)) {
                value |= (PRIORITY[item(domain, irq)] as u64) << ((byte * 8) as usize);
            }
            byte += 1;
        }
        return value;
    }
    // Affinity routing is always enabled. Original9front still clears this
    // legacy CPU-target bank during initialization; it cannot route any IRQ.
    if !private && offset >= 0x800 && offset + width <= 0xc00 { return 0; }
    if offset >= 0xc00 && offset < 0xd00 && width <= 4 && (offset & 3) + width <= 4 {
        let first: u64 = ((base - 0xc00) / 4) * 16;
        let mut value: u64 = 0; let mut n: u64 = 0;
        while n < 16 {
            let irq: u64 = first + n;
            if assigned(domain, irq) && ((private && irq < 32) || (!private && irq >= 32)) {
                value |= (EDGE[item(domain, irq)] as u64) << ((n * 2 + 1) as usize);
            }
            n += 1;
        }
        return part(value, offset & 3, width);
    }
    if offset >= 0xd00 && offset + width <= 0xd80 && width <= 4 { return 0; } //NS GroupMod RAZ.
    if !private && offset >= 0x6000 && offset + width <= 0x8000 && (offset & 7) + width <= 8 {
        let irq: u64 = (offset - 0x6000) / 8;
        if irq >= 32 && assigned(domain, irq) { return part(ROUTE[item(domain, irq)], offset & 7, width); }
        return 0;
    }
    deny(domain, 22); return BAD;
}

pub unsafe fn mmio_write(domain: u64, ipa: u64, width: u64, value: u64) -> u64 {
    if !valid(domain) || !width_ok(ipa, width) { return deny(domain, 30); }
    let mut private: bool = false;
    let mut offset: u64 = 0;
    if ipa >= DIST && ipa + width <= DIST + 65536 { offset = ipa - DIST; }
    else {
        if ipa >= PRIVATE && ipa + width <= PRIVATE + 65536 { offset = ipa - PRIVATE; private = true; }
        else {
            if ipa >= REDIST && ipa + width <= REDIST + 65536 && width <= 4 {
                offset = ipa - REDIST;
                if offset >= 0x14 && offset + width <= 0x18 {
                    let next: u64 = replace_part(WAKER[domain as usize], value, offset - 0x14, width);
                    if (next & ~6) != 0 { return deny(domain, 31); }
                    if !fold(domain) { return 0; }
                    WAKER[domain as usize] = 0;
                    if (next & 2) != 0 { WAKER[domain as usize] = 6; }
                    return 1;
                }
                if offset == 0 && value == 0 { return 1; } //LPIsdisabled; never accept tableDMA.
            }
            return deny(domain, 32);
        }
    }
    let base: u64 = offset & ~3;
    if !private && base == 0 && width <= 4 && (offset & 3) + width <= 4 {
        let next: u64 = replace_part(CONTROL[domain as usize], value, offset & 3, width);
        if (next & ~0x53) != 0 { return deny(domain, 33); }
        if !fold(domain) { return 0; }
        CONTROL[domain as usize] = 0x50 | (next & 3);
        return 1;
    }
    let kind: u64 = bitmap_class(offset);
    if kind != 0 && width <= 4 && (offset & 3) + width <= 4 {
        if !fold(domain) { return 0; }
        let shifted: u64 = part(value, 0, width) << (((offset & 3) * 8) as usize);
        let mut merged: u64 = shifted;
        if kind == 1 { merged = replace_part(bitmap_read(domain, base, kind, private), value, offset & 3, width); }
        bitmap_write(domain, base, kind, merged, private);
        return 1;
    }
    if offset >= 0x400 && offset + width <= 0x800 {
        if !fold(domain) { return 0; }
        let mut byte: u64 = 0;
        while byte < width {
            let irq: u64 = offset - 0x400 + byte;
            if assigned(domain, irq) && ((private && irq < 32) || (!private && irq >= 32)) {
                PRIORITY[item(domain, irq)] = ((value >> ((byte * 8) as usize)) & 0xf8) as u8;
            }
            byte += 1;
        }
        return 1;
    }
    if !private && offset >= 0x800 && offset + width <= 0xc00 { return 1; }
    if offset >= 0xc00 && offset < 0xd00 && width <= 4 && (offset & 3) + width <= 4 {
        let old: u64 = mmio_read(domain, ipa - (offset & 3), 4);
        if old == BAD { return 0; }
        let next: u64 = replace_part(old, value, offset & 3, width);
        if (next & 0x5555_5555) != 0 { return deny(domain, 34); }
        if !fold(domain) { return 0; }
        let first: u64 = ((base - 0xc00) / 4) * 16;
        let mut n: u64 = 0;
        while n < 16 {
            let irq: u64 = first + n;
            if irq >= 16 && assigned(domain, irq) && ((private && irq < 32) || (!private && irq >= 32)) {
                EDGE[item(domain, irq)] = ((next >> ((n * 2 + 1) as usize)) & 1) as u8;
            }
            n += 1;
        }
        return 1;
    }
    if offset >= 0xd00 && offset + width <= 0xd80 && width <= 4 && value == 0 { return 1; }
    if !private && offset >= 0x6000 && offset + width <= 0x8000 && (offset & 7) + width <= 8 {
        let irq: u64 = (offset - 0x6000) / 8;
        if irq < 32 || !assigned(domain, irq) {
            if value == 0 { return 1; }
            return deny(domain, 35);
        }
        let next: u64 = replace_part(ROUTE[item(domain, irq)], value, offset & 7, width);
        if (next & ~0x8000_0000) != 0 { return deny(domain, 36); }
        DIRTY[domain as usize] = 1;
        ROUTE[item(domain, irq)] = next; //OnlyCPU0inthisguest,neverphysicalrouting.
        return 1;
    }
    return deny(domain, 37);
}

pub unsafe fn healthy(domain: u64) -> u64 { return valid(domain) as u64; }
pub unsafe fn diagnostic(domain: u64) -> u64 {
    if domain >= DOMAINS { return BAD; }
    return DIAGNOSTIC[domain as usize];
}
