module runtime::aarch64::plan9_probe;

use runtime::common::namespace_store::init as store_init;
use runtime::common::namespace_store::provision_clock;
use runtime::common::namespace_peer::init as peer_init;
use runtime::common::namespace_peer::poll as peer_poll;
use runtime::aarch64::plan9_namespace_uart::init as namespace_uart_init;
use runtime::aarch64::plan9_namespace_uart::mmio_read as namespace_uart_read;
use runtime::aarch64::plan9_namespace_uart::mmio_write as namespace_uart_write;
use runtime::aarch64::plan9_namespace_uart::healthy as namespace_uart_healthy;
use runtime::aarch64::plan9_namespace_uart::diagnostic as namespace_uart_diagnostic;

// Additive, single-domain original-9front execution probe. Only guest RAM and
// an explicitly assigned GICv3 distributor and SGI/PPI bank are mapped. The
// complete redistributor RD-control window is mediated without LPI authority.
// PL011 is mediated here;
// PCI configuration reads report an empty bus. No disk, NIC, host filesystem,
// default Linux domain, or shared-store persistence is granted by this probe.
extern "ocore" fn p9_serial_putc(value: u64) -> void;
extern "ocore" fn p9_serial_try_read() -> u64;
extern "ocore" fn p9_serial_init() -> void;
extern "ocore" fn p9_halt() -> never;
extern "ocore" fn p9_memory_barrier() -> void;
extern "ocore" fn p9_counter_read() -> u64;
extern "ocore" fn p9_counter_frequency() -> u64;
extern "ocore" fn p9_namespace_enabled() -> u64;

static ONLINE: [u8; 39] = b"KW original Plan9 isolated EL2: online\n";
static DENIED: [u8; 32] = b"KW Plan9 probe rejected access: ";
static mut RX: [u8; 1024] = [0; 1024];
static mut RX_HEAD: usize = 0;
static mut RX_COUNT: usize = 0;
static mut REGS: [u32; 64] = [0; 64];
static mut EXITS: u64 = 0;
static mut RTC_FLOOR: u64 = 0;
static mut RTC_START: u64 = 0;
static mut RTC_FREQUENCY: u64 = 0;
static mut NAMESPACE: u64 = 0;
static mut PEER_LAST: u64 = 0;

unsafe fn snapshot_busy(value: u64) -> void {
    if NAMESPACE == 1 {
        volatile_store(0x6d00_0008 as *mut u64, value);
        p9_memory_barrier();
    }
}

@export
@no_mangle
pub unsafe fn p9_namespace_irq_level(asserted: u64) -> void {
    if NAMESPACE != 1 { return; }
    let mut address: usize = 0x0800_0284;
    if asserted != 0 { address = 0x0800_0204; }
    volatile_store(address as *mut u32, 0x40000);
    p9_memory_barrier();
}

unsafe fn emit(bytes: *const u8, length: usize) -> void {
    let mut i: usize = 0;
    while i < length { p9_serial_putc(volatile_load(bytes + i) as u64); i += 1; }
}
unsafe fn hex(value: u64) -> void {
    let mut shift: usize = 60;
    loop {
        let digit: u64 = (value >> shift) & 15;
        if digit < 10 { p9_serial_putc(48 + digit); } else { p9_serial_putc(87 + digit); }
        if shift == 0 { break; } shift -= 4;
    }
}
unsafe fn reject(esr: u64, ipa: u64, pc: u64) -> never {
    emit((&DENIED[0]), 32); hex(esr); p9_serial_putc(32); hex(ipa);
    p9_serial_putc(32); hex(pc); p9_serial_putc(10); p9_halt();
}
unsafe fn irq() -> void {
    let mut address: usize = 0x0800_0284;
    if RX_COUNT != 0 && (REGS[0x38 / 4] & 0x50) != 0 { address = 0x0800_0204; }
    volatile_store(address as *mut u32, 2);
    p9_memory_barrier();
}
unsafe fn receive() -> void {
    let mut count: usize = 0;
    while count < 64 && RX_COUNT < 1024 {
        let value: u64 = p9_serial_try_read();
        if (value & 256) == 0 { break; }
        RX[(RX_HEAD + RX_COUNT) % 1024] = value as u8;
        RX_COUNT += 1; count += 1;
    }
    irq();
}
unsafe fn read_uart(offset: u64) -> u64 {
    if offset == 0 {
        if RX_COUNT == 0 { return 0; }
        let value: u64 = RX[RX_HEAD] as u64;
        RX_HEAD = (RX_HEAD + 1) % 1024; RX_COUNT -= 1; irq(); return value;
    }
    if offset == 0x18 {
        let mut value: u64 = 0x80;
        if RX_COUNT == 0 { value |= 0x10; }
        if RX_COUNT == 1024 { value |= 0x40; }
        return value;
    }
    if offset == 0x3c || offset == 0x40 {
        let mut raw: u64 = 0; if RX_COUNT != 0 { raw = 0x50; }
        if offset == 0x40 { raw &= REGS[0x38 / 4] as u64; }
        return raw;
    }
    if offset < 0x100 && (offset & 3) == 0 { return REGS[(offset / 4) as usize] as u64; }
    return 0;
}
unsafe fn write_uart(offset: u64, value: u64) -> void {
    if offset == 0 { p9_serial_putc(value & 255); return; }
    if offset < 0x100 && (offset & 3) == 0 { REGS[(offset / 4) as usize] = value as u32; irq(); return; }
    reject(0x901, offset, value);
}

@export
@no_mangle
pub unsafe fn p9_probe_init() -> u64 {
    p9_serial_init(); emit((&ONLINE[0]), 39);
    // Original 9front reads its DTB at a fixed GPA, not Linux's x0 contract.
    if volatile_load(0x4800_0000 as *const u32) != 0xedfe_0dd0 { return 0; }
    // No guest operation may enable the outer controller's LPI table DMA.
    // Merely disabling QEMU's ITS does not disable its has-lpi capability.
    if (volatile_load(0x080a_0000 as *const u32) & 1) != 0 { return 0; }
    // Explicit private provisioning word, never mapped into guest RAM.
    NAMESPACE = p9_namespace_enabled();
    if NAMESPACE > 1 { return 0; }
    RTC_FLOOR = volatile_load(0x6d00_0000 as *const u64);
    if NAMESPACE == 1 {
        snapshot_busy(1);
        let epoch: u64 = RTC_FLOOR;
        RTC_FLOOR = volatile_load(0x6d00_0010 as *const u64);
        if store_init(0x6c00_0000, 16_777_216, epoch) != 1 || provision_clock(RTC_FLOOR) != 1
            || peer_init(epoch) != 1 || namespace_uart_init(epoch) != 1 { return 0; }
    }
    RTC_START = p9_counter_read(); RTC_FREQUENCY = p9_counter_frequency();
    if RTC_FLOOR == 0 || RTC_FLOOR > 0xffff_ffff || RTC_FREQUENCY == 0 { return 0; }
    PEER_LAST = RTC_START;
    snapshot_busy(0);
    return 1;
}

@export
@no_mangle
pub unsafe fn p9_probe_exit(frame_address: usize, esr: u64, far: u64, hpfar: u64) -> u64 {
    snapshot_busy(1);
    let result: u64 = handle_exit(frame_address, esr, far, hpfar);
    snapshot_busy(0);
    return result;
}

unsafe fn handle_exit(frame_address: usize, esr: u64, far: u64, hpfar: u64) -> u64 {
    let frame: *mut u64 = frame_address as *mut u64;
    let pc: u64 = volatile_load(frame + 31);
    let ec: u64 = esr >> 26;
    let ipa: u64 = ((hpfar & 0x0000_ffff_ffff_fff0) << 8) | (far & 4095);
    EXITS += 1; receive();
    if NAMESPACE == 1 {
        let now: u64 = p9_counter_read();
        if now - PEER_LAST >= RTC_FREQUENCY / 10 { peer_poll(); PEER_LAST = now; }
        if namespace_uart_healthy() != 1 { reject(0x950, namespace_uart_diagnostic(), pc); }
    }
    if ec == 1 { volatile_store(frame + 31, pc + 4); return 0; }
    if ec == 0x16 || ec == 0x17 {
        // HVC exceptions return after the instruction. HCR.TSC traps SMC
        // before execution, so its saved ELR still names the SMC itself.
        if ec == 0x17 { volatile_store(frame + 31, pc + 4); }
        let function: u64 = volatile_load(frame);
        if function == 0x8400_0000 { volatile_store(frame, 2); return 0; }
        if function == 0x8400_000a { volatile_store(frame, 0xffff_ffff_ffff_ffff); return 0; }
        // No other CPUs or power-management authority are granted.
        volatile_store(frame, 0xffff_ffff_ffff_fffe); return 0;
    }
    if ec != 0x24 || (esr & (1 << 24)) == 0 || (esr & (1 << 25)) == 0
        || (esr & (1 << 10)) != 0 || (esr & (1 << 7)) != 0 { reject(esr, ipa, pc); }
    let width: u64 = (1 as u64) << (((esr >> 22) & 3) as usize);
    let register: usize = ((esr >> 16) & 31) as usize;
    let writing: bool = (esr & 64) != 0;
    if width > 4 || (ipa & (width - 1)) != 0 { reject(esr, ipa, pc); }
    let mut value: u64 = 0; if register != 31 { value = volatile_load(frame + register); }
    if ipa >= 0x0900_0000 && ipa + width <= 0x0900_1000 {
        if writing { write_uart(ipa - 0x0900_0000, value); }
        else { value = read_uart(ipa - 0x0900_0000); }
    } else {
        if NAMESPACE == 1 && ipa >= 0x0900_1000 && ipa + width <= 0x0900_2000 {
            if width != 4 { reject(esr, ipa, pc); }
            if writing {
                if namespace_uart_write(ipa - 0x0900_1000, value) != 1 { reject(0x951, namespace_uart_diagnostic(), pc); }
            } else { value = namespace_uart_read(ipa - 0x0900_1000); }
            if namespace_uart_healthy() != 1 { reject(0x952, namespace_uart_diagnostic(), pc); }
        } else {
        if ipa >= 0x080a_0000 && ipa + width <= 0x080b_0000 {
            if writing || width != 4 { reject(esr, ipa, pc); }
            let offset: u64 = ipa - 0x080a_0000;
            // Fixed one-CPU facade: CTLR has no EnableLPIs/RWP; TYPER has
            // CPU0+LAST and no PLPIS/VLPIS; WAKER describes an awake CPU.
            if offset == 0 || offset == 12 || offset == 20 { value = 0; }
            else {
                if offset == 4 { value = 0x43b; }
                else { if offset == 8 { value = 0x10; } else { reject(esr, ipa, pc); } }
            }
        } else {
            if ipa == 0x0901_0000 && width == 4 && !writing {
                value = (RTC_FLOOR + (p9_counter_read() - RTC_START) / RTC_FREQUENCY) & 0xffff_ffff;
            } else {
                if ipa >= 0x3f00_0000 && ipa + width <= 0x4000_0000 && !writing {
                    value = 0xffff_ffff;
                } else { reject(esr, ipa, pc); }
            }
        }
        }
    }
    if !writing && register != 31 {
        let mask: u64 = ((1 as u64) << ((width * 8) as usize)) - 1;
        value &= mask;
        if (esr & (1 << 21)) != 0 && (value & ((1 as u64) << ((width * 8 - 1) as usize))) != 0 { value |= ~mask; }
        if (esr & (1 << 15)) == 0 { value &= 0xffff_ffff; }
        volatile_store(frame + register, value);
    }
    volatile_store(frame + 31, pc + 4); receive(); return 0;
}

@export
@no_mangle
pub unsafe fn p9_probe_unexpected(esr: u64, far: u64, pc: u64) -> never { reject(esr, far, pc); }
