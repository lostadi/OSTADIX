use runtime::aarch64::kernel_world_virtio::mmio_read as device_read;
use runtime::aarch64::kernel_world_virtio::mmio_write as device_write;
use runtime::aarch64::kernel_world_virtio::poll as device_poll;
use runtime::aarch64::kernel_world_virtio::healthy as device_healthy;
use runtime::aarch64::kernel_world_virtio::fault_kind as device_fault_kind;
use runtime::aarch64::kernel_world_virtio::diagnostic as device_diagnostic;
use runtime::aarch64::kernel_world_virtio::detail as device_detail;
use runtime::aarch64::kernel_world_virtio::arm_hold_next_read;
