    if !next_version(object) { return error(5); }
    if RESPONSE_CAP < 7 { return 0; }
    if length != 0xffff_ffff_ffff_ffff { if !resize(object, length) { return error(5); } }
    if name_length != 0 {
        zero(node(object) + 72, 256); copy(node(object) + 72, name, name_length); setfield(object, 64, name_length as u64); changed(parent);
    }
    if mode != 0xffff_ffff { setfield(object, 32, mode); }
    // Synthetic atime is not an authority source. Accept requested timestamp
    // updates for ordinary cp/touch; persist the explicit mtime when supplied.
    changed(object); if mtime != 0xffff_ffff { setfield(object, 56, mtime); seal(object); }
    start(127, 7); return OUT;
}

pub unsafe fn handle(session: u64, request: *const u8, req_len: usize, response: *mut u8, response_cap: usize) -> usize {
    if READY == 0 || request as usize == 0 || response as usize == 0 || req_len < 7 || req_len > MAX_FRAME || response_cap < 7 { return 0; }
    REQUEST = request as usize; REQUEST_LEN = req_len; RESPONSE = response as usize; RESPONSE_CAP = response_cap;
    if RESPONSE_CAP > MAX_FRAME { RESPONSE_CAP = MAX_FRAME; }
    TAG = le(REQUEST + 5, 2); POSITION = 7; BAD = 0; OUT = 0;
    if le(REQUEST, 4) != req_len as u64 { return error(1); }
    let grant: usize = current_grant(session);
    if grant == GRANT_SLOTS { return error(4); }
    let kind: u64 = byte(REQUEST + 4);
    if kind == 100 { return version(grant, session); }
    if VERSIONED[grant] == 0 || req_len > MSIZE[grant] { return error(1); }
    if kind == 104 { return attach(grant, session); }
    if kind == 108 {
        take(2); if !exact() { return error(1); } if !start(109, 7) { return 0; } return OUT;
    }
    if kind == 110 { return walk(grant, session); }
    if kind == 112 { return open(grant, session, false); }
    if kind == 114 { return open(grant, session, true); }
    if kind == 116 { return read(grant, session); }
    if kind == 118 { return write(grant, session); }
    if kind == 120 { return clunk(grant, session, false); }
    if kind == 122 { return clunk(grant, session, true); }
    if kind == 124 { return getstat(grant, session); }
    if kind == 126 { return wstat(grant, session); }
    return error(9);
}
