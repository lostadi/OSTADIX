bash^(
set -eu

policy_limit=$policy_limit
best_index=-1
best_score=0

consider_reply() {
    index=\$1
    present=\$2
    score=\$3
    stop_reason=\$4
    max_policy_score=\$5

    case "\$present:\$score:\$stop_reason:\$max_policy_score" in
        0:*|1:-[0-9]*:[0-9]*:-[0-9]*|1:-[0-9]*:[0-9]*:[0-9]*|1:[0-9]*:[0-9]*:-[0-9]*|1:[0-9]*:[0-9]*:[0-9]*) ;;
        *) printf '%s\n' 'invalid typed LLMReply metadata' >&2; exit 2 ;;
    esac
    [ "\$present" -eq 1 ] || return 0
    [ "\$stop_reason" -eq 0 ] || return 0
    [ "\$max_policy_score" -le "\$policy_limit" ] || return 0
    if [ "\$best_index" -eq -1 ] || [ "\$score" -gt "\$best_score" ]; then
        best_index=\$index
        best_score=\$score
    fi
}

consider_reply 0 $present_0 $score_0 $stop_reason_0 $max_policy_score_0
consider_reply 1 $present_1 $score_1 $stop_reason_1 $max_policy_score_1
consider_reply 2 $present_2 $score_2 $stop_reason_2 $max_policy_score_2

if [ "\$best_index" -eq -1 ]; then
    printf '%s\n' 'LLMResult has no policy-safe finished reply' >&2
    exit 2
fi
printf '{"source_index":%s,"score_milli":%s}\n' "\$best_index" "\$best_score"
)_bash
