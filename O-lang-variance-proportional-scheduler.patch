+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::hgraph::schedule::{ReadyOp, ReadySchedule};
+    use crate::hgraph::{EdgeId, NodeId};
+    use crate::ir::{InvokeMode, PlanNode, PlanNodeKind};
+
+    fn op(index: usize, blocked_by: Vec<usize>) -> ReadyOp {
+        ReadyOp {
+            plan_node: PlanNodeId(index),
+            edge: EdgeId(index as u64),
+            output: NodeId(index as u64),
+            inputs: Vec::new(),
+            ordinal: index as u64,
+            actor: None,
+            blocked_by,
+        }
+    }
+
+    fn independent_plan(count: usize) -> ExecutionPlan {
+        ExecutionPlan {
+            roots: (0..count).map(PlanNodeId).collect(),
+            nodes: (0..count)
+                .map(|index| PlanNode {
+                    id: PlanNodeId(index),
+                    kind: PlanNodeKind::Call {
+                        fn_name: format!("root_{index}"),
+                        mode: InvokeMode::Eager,
+                        arg_count: 0,
+                    },
+                })
+                .collect(),
+            edges: Vec::new(),
+        }
+    }
+
+    #[test]
+    fn balanced_roots_produce_zero_feedback_gain() {
+        let schedule = ReadySchedule {
+            ops: vec![op(0, vec![]), op(1, vec![])],
+        };
+        let plan = independent_plan(2);
+        let priority = VariancePriority::new(&schedule, &plan).unwrap();
+        let decision = priority
+            .rank_ready(
+                &[0, 1],
+                &[false, false],
+                &[None, None],
+                0.0,
+                &[10.0, 10.0],
+                SchedulerPolicy::VarianceBalanced,
+                4.0,
+                16.0,
+                &[PlanNodeId(0), PlanNodeId(1)],
+            )
+            .unwrap();
+        assert_eq!(decision.variance_ms2, 0.0);
+        assert_eq!(decision.gain, 0.0);
+    }
+
+    #[test]
+    fn root_variance_boosts_work_on_the_lagging_root() {
+        let schedule = ReadySchedule {
+            ops: vec![op(0, vec![]), op(1, vec![])],
+        };
+        let plan = independent_plan(2);
+        let priority = VariancePriority::new(&schedule, &plan).unwrap();
+        let decision = priority
+            .rank_ready(
+                &[0, 1],
+                &[false, false],
+                &[None, None],
+                0.0,
+                &[20.0, 5.0],
+                SchedulerPolicy::VarianceBalanced,
+                4.0,
+                16.0,
+                &[PlanNodeId(0), PlanNodeId(1)],
+            )
+            .unwrap();
+        assert!(decision.gain > 0.0);
+        assert_eq!(decision.ranked[0].plan_node, PlanNodeId(0));
+        assert!(decision.ranked[0].variance_boost_ms > 0.0);
+        assert_eq!(decision.ranked[1].variance_boost_ms, 0.0);
+    }
+
+    #[test]
+    fn more_variance_creates_more_feedback_gain() {
+        let schedule = ReadySchedule {
+            ops: vec![op(0, vec![]), op(1, vec![])],
+        };
+        let plan = independent_plan(2);
+        let priority = VariancePriority::new(&schedule, &plan).unwrap();
+        let low = priority
+            .rank_ready(
+                &[0, 1],
+                &[false, false],
+                &[None, None],
+                0.0,
+                &[10.0, 9.0],
+                SchedulerPolicy::VarianceBalanced,
+                4.0,
+                16.0,
+                &[PlanNodeId(0), PlanNodeId(1)],
+            )
+            .unwrap();
+        let high = priority
+            .rank_ready(
+                &[0, 1],
+                &[false, false],
+                &[None, None],
+                0.0,
+                &[20.0, 2.0],
+                SchedulerPolicy::VarianceBalanced,
+                4.0,
+                16.0,
+                &[PlanNodeId(0), PlanNodeId(1)],
+            )
+            .unwrap();
+        assert!(high.gain > low.gain);
+    }
+
+    #[test]
+    fn feedback_gain_saturates_at_configured_maximum() {
+        let schedule = ReadySchedule {
+            ops: vec![op(0, vec![]), op(1, vec![])],
+        };
+        let plan = independent_plan(2);
+        let priority = VariancePriority::new(&schedule, &plan).unwrap();
+        let decision = priority
+            .rank_ready(
+                &[0, 1],
+                &[false, false],
+                &[None, None],
+                0.0,
+                &[1_000.0, 1.0],
+                SchedulerPolicy::VarianceBalanced,
+                1_000.0,
+                3.0,
+                &[PlanNodeId(0), PlanNodeId(1)],
+            )
+            .unwrap();
+        assert!((decision.gain - 3.0).abs() < 1.0e-9);
+    }
+
+    #[test]
+    fn ordinal_policy_uses_stable_source_order() {
+        let schedule = ReadySchedule {
+            ops: vec![op(0, vec![]), op(1, vec![])],
+        };
+        let plan = independent_plan(2);
+        let priority = VariancePriority::new(&schedule, &plan).unwrap();
+        let decision = priority
+            .rank_ready(
+                &[1, 0],
+                &[false, false],
+                &[None, None],
+                0.0,
+                &[1.0, 1_000.0],
+                SchedulerPolicy::Ordinal,
+                4.0,
+                16.0,
+                &[PlanNodeId(0), PlanNodeId(1)],
+            )
+            .unwrap();
+        assert_eq!(
+            decision
+                .ranked
+                .iter()
+                .map(|item| item.plan_node)
+                .collect::<Vec<_>>(),
+            vec![PlanNodeId(0), PlanNodeId(1)]
+        );
+        assert_eq!(decision.gain, 0.0);
+    }
+
+    #[test]
+    fn completed_root_finish_time_remains_in_variance_objective() {
+        let schedule = ReadySchedule {
+            ops: vec![op(0, vec![]), op(1, vec![])],
+        };
+        let plan = independent_plan(2);
+        let priority = VariancePriority::new(&schedule, &plan).unwrap();
+        let decision = priority
+            .rank_ready(
+                &[1],
+                &[true, false],
+                &[Some(5.0), None],
+                10.0,
+                &[10.0, 20.0],
+                SchedulerPolicy::VarianceBalanced,
+                4.0,
+                16.0,
+                &[PlanNodeId(0), PlanNodeId(1)],
+            )
+            .unwrap();
+        assert_eq!(decision.roots[0].predicted_completion_ms, 5.0);
+        assert_eq!(decision.roots[1].predicted_completion_ms, 30.0);
+        assert!(decision.gain > 0.0);
+        assert!(decision.ranked[0].variance_boost_ms > 0.0);
