+    #[test]
+    fn ewma_profile_learns_observed_cost() {
+        let kind = PlanNodeKind::Call {
+            fn_name: "demo".into(),
+            mode: InvokeMode::Eager,
+            arg_count: 0,
+        };
+        let ir = OIr::Invoke {
