+            anyhow::anyhow!("missing effect summary for plan node {}", edge.from.0)
+        })?;
+        let after_effect = effects.get(edge.to.0).ok_or_else(|| {
+            anyhow::anyhow!("missing effect summary for plan node {}", edge.to.0)
+        })?;
