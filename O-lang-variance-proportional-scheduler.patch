+/// One root's predicted remaining completion time at a scheduling decision.
+#[derive(Debug, Clone)]
+pub struct RootEstimate {
+    pub root: PlanNodeId,
+    /// Estimated unfinished critical-path work from the current frontier.
+    pub remaining_ms: f64,
+    /// Predicted absolute completion time measured from coordinator start.
+    pub predicted_completion_ms: f64,
+    /// Whether this root has already committed; completed roots retain their
+    /// measured finish time in the variance objective.
+    pub completed: bool,
+}
+
+/// Priority assigned to one operation in the legal ready frontier.
+#[derive(Debug, Clone)]
+pub struct RankedReady {
+    pub op_index: usize,
+    pub plan_node: PlanNodeId,
+    pub priority: f64,
+    pub critical_path_ms: f64,
+    pub variance_boost_ms: f64,
+    pub target_root: Option<PlanNodeId>,
+}
+
+/// Full explanation of one priority calculation. Coordinators may retain these
+/// snapshots for testing, profiling, and paper artifact output.
+#[derive(Debug, Clone)]
+pub struct PriorityDecision {
+    pub ranked: Vec<RankedReady>,
+    pub roots: Vec<RootEstimate>,
+    pub mean_completion_ms: f64,
+    pub variance_ms2: f64,
+    pub normalized_variance: f64,
+    pub gain: f64,
+}
+
+/// Static dependency analysis supporting dynamic variance-based decisions.
+#[derive(Debug, Clone)]
+pub struct VariancePriority {
+    successors: Vec<Vec<usize>>,
+    topological: Vec<usize>,
+    roots: Vec<(PlanNodeId, usize)>,
+    ordinals: Vec<u64>,
+}
+
+impl VariancePriority {
+    pub fn new(schedule: &ReadySchedule, plan: &ExecutionPlan) -> Result<Self, String> {
+        let count = schedule.ops.len();
+        let mut successors = vec![Vec::new(); count];
+        let mut indegree = vec![0usize; count];
+        for (index, op) in schedule.ops.iter().enumerate() {
+            for &dependency in &op.blocked_by {
+                if dependency >= count {
+                    return Err(format!(
+                        "operation {index} has out-of-bounds dependency {dependency}"
+                    ));
+                }
+                successors[dependency].push(index);
+                indegree[index] += 1;
+            }
+        }
+        for list in &mut successors {
+            list.sort_unstable();
+            list.dedup();
+        }
+
+        let mut ready: BTreeSet<(u64, usize)> = (0..count)
+            .filter(|&index| indegree[index] == 0)
+            .map(|index| (schedule.ops[index].ordinal, index))
+            .collect();
+        let mut topological = Vec::with_capacity(count);
+        while let Some((ordinal, index)) = ready.iter().next().copied() {
+            ready.remove(&(ordinal, index));
+            topological.push(index);
+            for &successor in &successors[index] {
+                indegree[successor] -= 1;
+                if indegree[successor] == 0 {
+                    ready.insert((schedule.ops[successor].ordinal, successor));
+                }
+            }
+        }
+        if topological.len() != count {
+            return Err(format!(
+                "variance scheduler dependency graph contains a cycle: scheduled {} of {count}",
+                topological.len()
+            ));
+        }
+
+        let by_plan = schedule
+            .ops
+            .iter()
+            .enumerate()
+            .map(|(index, op)| (op.plan_node, index))
+            .collect::<HashMap<_, _>>();
+        let roots = plan
+            .roots
+            .iter()
+            .filter_map(|root| by_plan.get(root).copied().map(|index| (*root, index)))
+            .collect();
+        let ordinals = schedule.ops.iter().map(|op| op.ordinal).collect();
+
+        Ok(Self {
+            successors,
+            topological,
+            roots,
+            ordinals,
+        })
+    }
+
+    pub fn rank_ready(
+        &self,
+        ready: &[usize],
+        completed: &[bool],
+        completion_times_ms: &[Option<f64>],
+        now_ms: f64,
+        costs_ms: &[f64],
+        policy: SchedulerPolicy,
+        variance_gain: f64,
+        max_gain: f64,
+        plan_nodes: &[PlanNodeId],
+    ) -> Result<PriorityDecision, String> {
+        let count = self.successors.len();
+        if completed.len() != count
+            || completion_times_ms.len() != count
+            || costs_ms.len() != count
+            || plan_nodes.len() != count
+        {
+            return Err("variance scheduler input lengths do not match operation count".to_string());
+        }
+        let now_ms = if now_ms.is_finite() { now_ms.max(0.0) } else { 0.0 };
+        for &index in ready {
+            if index >= count {
+                return Err(format!("ready operation index {index} is out of bounds"));
+            }
+        }
+
+        if policy == SchedulerPolicy::Ordinal {
+            let mut ranked = ready
+                .iter()
+                .copied()
+                .map(|index| RankedReady {
+                    op_index: index,
+                    plan_node: plan_nodes[index],
+                    priority: 0.0,
+                    critical_path_ms: 0.0,
+                    variance_boost_ms: 0.0,
+                    target_root: None,
+                })
+                .collect::<Vec<_>>();
+            ranked.sort_by_key(|item| (self.ordinals[item.op_index], item.op_index));
+            return Ok(PriorityDecision {
+                ranked,
+                roots: Vec::new(),
+                mean_completion_ms: 0.0,
+                variance_ms2: 0.0,
+                normalized_variance: 0.0,
+                gain: 0.0,
+            });
+        }
+
+        let root_count = self.roots.len();
+        let mut tail = vec![vec![0.0f64; root_count]; count];
+        for &index in self.topological.iter().rev() {
+            if completed[index] {
+                continue;
+            }
+            for (root_position, &(_, root_index)) in self.roots.iter().enumerate() {
+                if completed[root_index] {
+                    continue;
+                }
+                let downstream = self.successors[index]
+                    .iter()
+                    .map(|&successor| tail[successor][root_position])
+                    .fold(0.0f64, f64::max);
+                if index == root_index || downstream > 0.0 {
+                    tail[index][root_position] = costs_ms[index].max(EPSILON) + downstream;
+                }
+            }
+        }
+
+        let mut root_remaining = Vec::with_capacity(root_count);
+        for (root_position, &(root, root_index)) in self.roots.iter().enumerate() {
+            let remaining = if completed[root_index] {
+                0.0
+            } else {
+                ready
+                    .iter()
+                    .map(|&index| tail[index][root_position])
+                    .fold(0.0f64, f64::max)
+            };
+            let predicted_completion_ms = completion_times_ms[root_index]
+                .unwrap_or(now_ms + remaining);
+            root_remaining.push(RootEstimate {
+                root,
+                remaining_ms: remaining,
+                predicted_completion_ms,
+                completed: completed[root_index],
+            });
+        }
+
+        let completion_estimates = root_remaining
+            .iter()
+            .map(|root| root.predicted_completion_ms)
+            .collect::<Vec<_>>();
+        let mean = if completion_estimates.is_empty() {
+            0.0
+        } else {
+            completion_estimates.iter().sum::<f64>() / completion_estimates.len() as f64
+        };
+        let variance = if completion_estimates.is_empty() {
+            0.0
+        } else {
+            completion_estimates
+                .iter()
+                .map(|value| {
+                    let delta = *value - mean;
+                    delta * delta
+                })
+                .sum::<f64>()
+                / completion_estimates.len() as f64
+        };
+        let normalized_variance = if mean > EPSILON {
+            variance / (mean * mean)
+        } else {
+            0.0
+        };
+        let gain = (variance_gain.max(0.0) * normalized_variance)
+            .min(max_gain.max(0.0));
+
+        let mut ranked = Vec::with_capacity(ready.len());
+        for &index in ready {
+            let critical_path_ms = tail[index].iter().copied().fold(0.0f64, f64::max);
+            let mut pressure = 0.0f64;
+            let mut target_root = None;
+            for (root_position, estimate) in root_remaining.iter().enumerate() {
+                if estimate.completed || estimate.remaining_ms <= EPSILON {
+                    continue;
+                }
+                let lag = (estimate.predicted_completion_ms - mean).max(0.0);
+                if lag <= 0.0 {
+                    continue;
+                }
+                let contribution = tail[index][root_position] / estimate.remaining_ms;
+                let candidate = lag * contribution.clamp(0.0, 1.0);
+                if candidate > pressure {
+                    pressure = candidate;
+                    target_root = Some(estimate.root);
+                }
+            }
+            let variance_boost_ms = gain * pressure;
+            ranked.push(RankedReady {
+                op_index: index,
+                plan_node: plan_nodes[index],
+                priority: critical_path_ms + variance_boost_ms,
+                critical_path_ms,
+                variance_boost_ms,
+                target_root,
+            });
+        }
+
+        ranked.sort_by(|left, right| {
+            right
+                .priority
+                .partial_cmp(&left.priority)
+                .unwrap_or(std::cmp::Ordering::Equal)
+                .then_with(|| {
+                    right
+                        .critical_path_ms
+                        .partial_cmp(&left.critical_path_ms)
+                        .unwrap_or(std::cmp::Ordering::Equal)
+                })
+                .then_with(|| {
+                    self.ordinals[left.op_index]
+                        .cmp(&self.ordinals[right.op_index])
+                })
+                .then_with(|| left.op_index.cmp(&right.op_index))
+        });
+
+        Ok(PriorityDecision {
+            ranked,
+            roots: root_remaining,
+            mean_completion_ms: mean,
+            variance_ms2: variance,
+            normalized_variance,
+            gain,
+        })
+    }
+}
