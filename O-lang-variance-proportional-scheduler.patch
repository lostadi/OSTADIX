+//! Variance-proportional critical-path priority for the HGraph executor.
+//!
+//! Dependency legality and dispatch priority are deliberately separate:
+//! [`ReadySchedule`](crate::hgraph::schedule::ReadySchedule) decides which
+//! operations are legal to run, while this module decides which legal operation
+//! should receive a scarce worker slot first.
+//!
+//! The policy optimizes for root completion rather than task count. For every
+//! scheduling decision it:
+//!
+//! 1. predicts each root's absolute completion time from measured elapsed time
+//!    plus its remaining critical path, or keeps its measured finish time once
+//!    complete;
+//! 2. computes the variance of those root completion estimates;
+//! 3. converts normalized variance into a feedback gain; and
+//! 4. boosts ready operations that lie on the longest-lagging root paths.
+//!
+//! When roots are already balanced the feedback gain approaches zero and the
+//! policy reduces to ordinary critical-path priority. Higher imbalance causes
+//! a proportionally larger correction toward the lagging roots.
+
+use std::collections::{BTreeSet, HashMap};
+use std::time::Duration;
+
+use crate::hgraph::schedule::ReadySchedule;
+use crate::ir::{ExecutionMode, ExecutionPlan, OIr, PlanNodeId, PlanNodeKind};
+
+const EPSILON: f64 = 1.0e-9;
+
+/// Ready-frontier selection policy.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum SchedulerPolicy {
+    /// Stable source ordinal only. Useful as a diagnostic/reference policy.
+    Ordinal,
+    /// Critical-path priority plus variance-proportional root balancing.
+    VarianceBalanced,
+}
+
+/// Runtime configuration for ready-frontier selection.
+#[derive(Debug, Clone)]
+pub struct SchedulerConfig {
+    pub policy: SchedulerPolicy,
+    /// Maximum number of pure worker-safe operations dispatched in one batch.
+    pub parallelism: usize,
+    /// Multiplier applied to normalized root-completion variance.
+    pub variance_gain: f64,
+    /// Hard bound on feedback gain so a bad estimate cannot dominate forever.
+    pub max_gain: f64,
+    /// EWMA weight assigned to the newest measured operation duration.
+    pub ewma_alpha: f64,
+}
+
+impl Default for SchedulerConfig {
+    fn default() -> Self {
+        let parallelism = std::thread::available_parallelism()
+            .map(|n| n.get())
+            .unwrap_or(1)
+            .clamp(1, 32);
+        Self {
+            policy: SchedulerPolicy::VarianceBalanced,
+            parallelism,
+            variance_gain: 4.0,
+            max_gain: 16.0,
+            ewma_alpha: 0.25,
+        }
+    }
+}
+
+impl SchedulerConfig {
+    /// Read optional runtime controls without making configuration mandatory.
+    ///
+    /// - `O_GRAPH_SCHEDULER=ordinal|variance`
+    /// - `O_GRAPH_WORKERS=<positive integer>`
+    /// - `O_GRAPH_VARIANCE_GAIN=<non-negative float>`
+    /// - `O_GRAPH_MAX_GAIN=<non-negative float>`
+    /// - `O_GRAPH_COST_ALPHA=<float in (0,1]>`
+    pub fn from_env() -> Self {
+        let mut config = Self::default();
+        if let Ok(value) = std::env::var("O_GRAPH_SCHEDULER") {
+            config.policy = if value.eq_ignore_ascii_case("ordinal") {
+                SchedulerPolicy::Ordinal
+            } else {
+                SchedulerPolicy::VarianceBalanced
+            };
+        }
+        if let Some(value) = parse_env_usize("O_GRAPH_WORKERS") {
+            config.parallelism = value.max(1);
+        }
+        if let Some(value) = parse_env_f64("O_GRAPH_VARIANCE_GAIN") {
+            config.variance_gain = value.max(0.0);
+        }
+        if let Some(value) = parse_env_f64("O_GRAPH_MAX_GAIN") {
+            config.max_gain = value.max(0.0);
+        }
+        if let Some(value) = parse_env_f64("O_GRAPH_COST_ALPHA") {
+            if value > 0.0 && value <= 1.0 {
+                config.ewma_alpha = value;
+            }
+        }
+        config
+    }
+}
+
+fn parse_env_usize(name: &str) -> Option<usize> {
+    std::env::var(name).ok()?.trim().parse().ok()
+}
+
+fn parse_env_f64(name: &str) -> Option<f64> {
+    let value: f64 = std::env::var(name).ok()?.trim().parse().ok()?;
+    value.is_finite().then_some(value)
+}
+
+/// Historical duration estimates used by the scheduler.
+///
+/// Estimates are keyed by operation family (for example `exec:python:shim`),
+/// so later operations and later documents can reuse measured costs. Tests and
+/// embedding hosts may also install a node-specific estimate.
+#[derive(Debug, Clone, Default)]
+pub struct SchedulerProfile {
+    estimates_ms: HashMap<String, f64>,
+    samples: HashMap<String, u64>,
+    node_overrides_ms: HashMap<PlanNodeId, f64>,
+}
+
+impl SchedulerProfile {
+    pub fn estimate_ms(&self, id: PlanNodeId, kind: &PlanNodeKind, ir: &OIr) -> f64 {
+        if let Some(value) = self.node_overrides_ms.get(&id) {
+            return value.max(EPSILON);
+        }
+        let key = operation_key(kind);
+        self.estimates_ms
+            .get(&key)
+            .copied()
+            .unwrap_or_else(|| static_estimate_ms(kind, ir))
+            .max(EPSILON)
+    }
+
+    pub fn observe(
+        &mut self,
+        kind: &PlanNodeKind,
+        elapsed: Duration,
+        alpha: f64,
+    ) {
+        let sample_ms = elapsed.as_secs_f64() * 1_000.0;
+        if !sample_ms.is_finite() || sample_ms < 0.0 {
+            return;
+        }
+        let key = operation_key(kind);
+        let alpha = alpha.clamp(EPSILON, 1.0);
+        let previous = self
+            .estimates_ms
+            .get(&key)
+            .copied()
+            .unwrap_or(sample_ms.max(EPSILON));
+        let updated = alpha * sample_ms.max(EPSILON) + (1.0 - alpha) * previous;
+        self.estimates_ms.insert(key.clone(), updated);
+        *self.samples.entry(key).or_insert(0) += 1;
+    }
+
+    /// Explicit estimate override, primarily useful for experiments and tests.
+    pub fn set_node_estimate_ms(&mut self, id: PlanNodeId, estimate_ms: f64) {
+        if estimate_ms.is_finite() && estimate_ms > 0.0 {
+            self.node_overrides_ms.insert(id, estimate_ms);
+        }
+    }
+
+    pub fn sample_count(&self, kind: &PlanNodeKind) -> u64 {
+        self.samples
+            .get(&operation_key(kind))
+            .copied()
+            .unwrap_or(0)
+    }
+}
+
+fn operation_key(kind: &PlanNodeKind) -> String {
+    match kind {
+        PlanNodeKind::Text => "text".to_string(),
+        PlanNodeKind::Load { .. } => "load".to_string(),
+        PlanNodeKind::Store { .. } => "store".to_string(),
+        PlanNodeKind::Call { fn_name, .. } => format!("call:{fn_name}"),
+        PlanNodeKind::Request { kind, .. } => format!("request:{}", kind.label()),
+        PlanNodeKind::Group { mode, .. } => format!("group:{mode:?}"),
+        PlanNodeKind::Schedule { kind, .. } => format!("schedule:{}", kind.label()),
+        PlanNodeKind::Exec { lang, backend, .. } => {
+            format!("exec:{lang}:{:?}", backend.execution)
+        }
+    }
+}
+
+fn static_estimate_ms(kind: &PlanNodeKind, ir: &OIr) -> f64 {
+    match kind {
+        PlanNodeKind::Text => 0.01,
+        PlanNodeKind::Load { .. } => 0.05,
+        PlanNodeKind::Store { .. } => 0.10,
+        PlanNodeKind::Call { .. } => 0.50,
+        PlanNodeKind::Request { .. } => 8.0,
+        PlanNodeKind::Group { .. } => 0.20,
+        PlanNodeKind::Schedule { .. } => 0.20,
+        PlanNodeKind::Exec { backend, .. } => {
+            let body_len = match ir {
+                OIr::Exec { body, .. } => body.len() as f64,
+                _ => 0.0,
+            };
+            match backend.execution {
+                ExecutionMode::Shim => 20.0 + body_len * 0.25,
+                ExecutionMode::InlineAst => 0.75 + body_len * 0.05,
+                ExecutionMode::InlineValue => 0.50 + body_len * 0.05,
+            }
+        }
+    }
+}
