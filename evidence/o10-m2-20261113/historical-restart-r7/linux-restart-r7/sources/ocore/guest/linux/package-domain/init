#!/bin/sh
set -eu
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
mkdir -p /dev /proc /sys /newroot
mountpoint -q /dev || mount -t devtmpfs devtmpfs /dev
mountpoint -q /proc || mount -t proc proc /proc
mountpoint -q /sys || mount -t sysfs sysfs /sys
exec </dev/console >/dev/console 2>&1
attempt=0
while [ ! -b /dev/vda ] && [ "$attempt" -lt 200 ]; do
    sleep 0.1
    attempt=$((attempt + 1))
done
if ! mount -t ext4 -o rw /dev/vda /newroot; then
    echo 'OKERNEL PACKAGE DOMAIN FAILURE: cannot mount governed root disk'
    exec /bin/sh -i
fi
mkdir -p /newroot/dev /newroot/proc /newroot/sys
mount --move /dev /newroot/dev
mount --move /proc /newroot/proc
mount --move /sys /newroot/sys
exec switch_root /newroot /sbin/package-domain-init
